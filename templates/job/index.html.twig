    <script>
        // Function to save job
            function saveJob(jobId) {
                fetch('/jobs/'+jobId+'/save', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest",
                    },
                    body: JSON.stringify({jobId: jobId}),
                })
                .then((response) => response.json())
                .then((data) => {
                    showToast(data.status, data.message);
                })
                .catch((error) => {
                    showToast('error', error);
                });
            }
        
        // Function to initialize button handlers (works with dynamically loaded content)
        function initializeJobDetailButtons() {
            // Use event delegation for save buttons
            $(document).off('click', '.btn-save').on('click', '.btn-save', function (event) {
                event.stopPropagation();
                event.preventDefault();
                let jobId = this.id.split("_")[1];
                const userId = '{{ app.user ? app.user.id : 0 }}';
                if(userId == 0){
                    showToast('error', 'Please login to save this job. Redirecting to login page..');
                    window.setTimeout(function(){
                        window.location.href = "{{ path('app_login') }}";
                    }, 1000);
                    return;
                }
                saveJob(jobId, this);
            });
            
            // Use event delegation for apply buttons
            $(document).off('click', '#apply-button').on('click', '#apply-button', function (event) {
                event.stopPropagation();
                event.preventDefault();
                const jobId = $(this).data('job-id') || $(this).attr('data-job-id');
                const userId = $(this).data('user-id') || $(this).attr('data-user-id') || '{{ app.user ? app.user.id : 0 }}';
                if(userId == 0){
                    showToast('error', 'Please login to apply this job. Redirecting to login page..');
                    window.setTimeout(function(){
                        window.location.href = "{{ path('app_login') }}";
                    }, 1000);
                    return;
                }
                if (typeof applyForJob === 'function') {
                    applyForJob(userId, jobId);
                }
            });
            
            // Share button click handler
            $(document).off('click', '.share-btn').on('click', '.share-btn', function(e) {
                e.stopPropagation();
                e.preventDefault();
                const $dropdown = $(this).find('.share-dropdown');
                const isActive = $dropdown.hasClass('active');
                
                // Close all other dropdowns
                $('.share-dropdown').removeClass('active');
                
                if (!isActive) {
                    $dropdown.addClass('active');
                    
                    // Initialize ShareThis if not already initialized
                    if (typeof window.__sharethis__ !== 'undefined' && window.__sharethis__.initialize) {
                        setTimeout(function() {
                            const shareButtons = $dropdown.find('.sharethis-inline-share-buttons');
                            if (shareButtons.length > 0 && shareButtons.children().length === 0) {
                                try {
                                    window.__sharethis__.initialize();
                                } catch(err) {
                                    console.log('ShareThis already initialized');
                                }
                            }
                        }, 100);
                    }
                }
            });
            
            // Close share dropdown when clicking outside
            $(document).off('click', '.share-dropdown').on('click', '.share-dropdown', function(e) {
                e.stopPropagation();
            });
            
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.share-btn').length && !$(e.target).closest('.share-dropdown').length) {
                    $('.share-dropdown').removeClass('active');
                }
            });
        }
        
        document.addEventListener("DOMContentLoaded", function () {
            initializeJobDetailButtons();
        });
    </script>
