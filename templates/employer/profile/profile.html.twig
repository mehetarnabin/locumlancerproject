{% extends 'employer/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block employer_body %}
<style>
/* Profile card styles matching provider design */
.profile-card, .section-card, .profile-right-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(16,24,40,0.06);
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: none !important;
  border: none !important;
}

.profile-card:hover,
.section-card:hover,
.profile-right-card:hover {
  box-shadow: 0 6px 18px rgba(16,24,40,0.06) !important;
  transform: none !important;
  background: #fff !important;
}

.card-title {
  font-size: 1.1rem;
  font-weight: 500;
  margin: 0;
  color: #000000;
}

.profile-avatar-box {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #85BB65;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-icon-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}

.info-item {
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 6px;
  transition: all 0.2s ease-in-out;
  cursor: default;
}

.info-item:hover {
  background: #F4F9F1 !important;
  box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15) !important;
  transform: translateY(-1px) !important;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.info-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.history-item {
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 8px;
  transition: all 0.2s ease-in-out;
  cursor: default;
}

.history-item:hover {
  background: #F4F9F1 !important;
  box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15) !important;
  transform: translateY(-1px) !important;
}

.history-item:last-child {
  margin-bottom: 0;
}

.history-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.history-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.quick-link-item {
  padding: 10px 0;
  border-bottom: 1px solid #e6eef6;
}

.quick-link-item:last-child {
  border-bottom: none;
}

.quick-link-item a {
  color: #000;
  text-decoration: none;
  font-size: 0.9375rem;
  display: block;
  transition: color 0.2s;
}

.quick-link-item a:hover {
  color: #85BB65;
}

.section-placeholder {
  text-align: center;
  padding: 40px 20px;
  color: #6B7280;
  font-size: 0.9375rem;
}

/* Share & Quick Links styling */
.upload-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.upload-btn-custom {
  display: flex;
  align-items: center;
  padding: 10px 14px;
  border-radius: 10px;
  background: #F4F9F1;
  border: 1px solid #85BB65;
  box-shadow: 0 2px 6px rgba(11,22,40,0.03);
  text-decoration: none;
  color: #000000;
  transition: all 0.2s ease;
}

.upload-btn-custom:hover {
  background: #E8F5E3;
  border-color: #6FA050;
  color: #000000;
  text-decoration: none;
}

.upload-btn-custom .cstm-btn-text {
  flex: 1;
  color: #000000;
}

/* Documents and Work Preferences buttons */
.documents-view-btn {
  background: #85BB65 !important;
  border: 2px solid #85BB65 !important;
  color: #ffffff !important;
  padding: 10px 20px !important;
  border-radius: 8px !important;
  font-weight: 500 !important;
  font-size: 0.95rem !important;
  text-decoration: none !important;
  transition: all 0.2s ease !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
}

.documents-view-btn:hover {
  background: #6FA050 !important;
  border-color: #6FA050 !important;
  color: #ffffff !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 8px rgba(133, 187, 101, 0.2) !important;
}

/* Card header row */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.link-plain {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: #000000;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.link-plain:hover {
  color: #85BB65;
}

/* Ensure proper flex layout */
.row.g-4 > .col-12.col-md-4 {
  display: flex !important;
  flex-direction: column !important;
}

.row.g-4 > .col-12.col-md-4 > .card {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
  height: 100% !important;
}

/* Ensure Personal Information and Your History cards match heights */
.row.g-4 > .col-12.col-lg-6 {
  display: flex !important;
  flex-direction: column !important;
}

.row.g-4 > .col-12.col-lg-6 > .profile-card,
.row.g-4 > .col-12.col-lg-6 > .profile-right-card {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
  height: 100% !important;
}

.app-card-settings {
  border: none;
  background: #fff;
  margin-bottom: 0;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(16,24,40,0.06);
  padding: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.app-card-settings .card-body {
  padding: 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Profile Edit Mode Styles */
#infoEdit {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  z-index: 10;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  min-height: 100%;
}

#infoEdit .info-item {
  padding: 10px 0;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 0;
  border-bottom: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
}

#infoEdit .info-item:last-child {
  border-bottom: none;
}

#infoEdit .info-item .d-flex {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  flex: 1;
  display: flex;
  align-items: center;
}

#infoEdit .info-item .d-flex .form-control,
#infoEdit .info-item .form-control,
#infoEdit .form-control,
#infoEdit select.form-control {
  flex: 1;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 4px 0;
  font-size: 0.875rem;
  border: none;
  border-radius: 0;
  background: transparent;
  color: #000;
  line-height: 1.4;
}

#infoEdit select.form-control {
  appearance: auto;
  -webkit-appearance: menulist;
  -moz-appearance: menulist;
  border: none;
  border-radius: 0;
  background: transparent;
}

#infoEdit .form-control:focus,
#infoEdit select.form-control:focus {
  outline: none;
  border: none;
  box-shadow: none;
}

#infoEdit .info-item svg {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  flex-shrink: 0;
}

#infoEdit .d-flex.gap-2 {
  gap: 8px !important;
  width: 100%;
  align-items: center;
}

#infoEdit label.btn {
  position: relative;
  overflow: hidden;
}

#infoEdit label.btn input[type="file"] {
  position: absolute;
  left: -9999px;
  opacity: 0;
}

#infoEdit .form-label {
  display: block;
  margin-bottom: 4px;
  font-weight: 500;
  color: #000;
  font-size: 0.875rem;
}

#infoEdit {
  padding: 20px !important;
}

#infoEdit .form-control,
#infoEdit input[type="text"],
#infoEdit input[type="email"] {
  border: none !important;
  border-top: none !important;
  border-bottom: none !important;
  box-shadow: none !important;
  padding: 4px 0 !important;
}

#personalSection {
  position: relative;
  flex-shrink: 0;
}

.action-btn-edit {
  background: #F4F9F1;
  border: 1px solid #e6eef6;
  box-shadow: 0 2px 6px rgba(11,22,40,0.03);
  border-radius: 10px;
  padding: 4px 12px;
  display: flex;
  gap: 6px;
  align-items: center;
  font-size: 14px;
  cursor: pointer;
}

#infoEdit .action-btn-edit {
  padding: 3px 10px;
  font-size: 13px;
  border-radius: 8px;
}

#infoEdit .action-btn-edit .icon-image {
  width: 18px;
  height: 18px;
}

.action-btn-edit:hover {
  color: #85BB65 !important;
  border: 1px solid #e6eef6 !important;
  border-color: #e6eef6 !important;
  transition: color 0.2s ease-in-out !important;
  transform: none !important;
  box-shadow: none !important;
}

.action-btn-edit:hover svg {
  color: #85BB65 !important;
}
</style>

<div class="container-xl">
  <div class="row mt-4">
    <div class="col-12 col-lg-8">
      <div class="row g-4">
        {# Personal Information card - Not Full Width #}
        <div class="col-12 col-lg-6 d-flex flex-column">
          <div id="personalSection" class="profile-card" style="position: relative; min-height: 400px; height: 100%; padding: 20px; overflow: visible; box-sizing: border-box; display: flex; flex-direction: column;">
            {# View Mode #}
            <div id="infoView" style="position: relative; width: 100%; padding: 0; box-sizing: border-box; overflow: visible;">
              <div class="d-flex justify-content-between align-items-center mb-3" style="margin-top: 0;">
                <h6 class="app-card-title mb-0">Personal Information</h6>
                <div id="actionIcons">
                  <a href="javascript:void(0);" id="editToggle" class="link-plain" title="Edit">
                    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
                    </svg>
                  </a>
                </div>
              </div>

              <div class="d-flex gap-2 align-items-center" style="margin-bottom: 6px; margin-top: 12px;">
                <div class="profile-avatar-box">
                  <div class="profile-icon-box">
                    {% if user.profilePictureFilename %}
                      <img id="profileAvatarView" src="{{ asset('uploads/' ~ user.id ~ '/' ~ user.profilePictureFilename) }}" alt="profile" style="width:100%;height:100%;object-fit:cover;">
                    {% else %}
                      <img id="profileAvatarView" src="{{ asset('assets/admin/images/user.png') }}" alt="profile" style="width:60%;height:60%;object-fit:contain;">
                    {% endif %}
                  </div>
                </div>
                <div style="flex:1;">
                  <div class="fw-semibold fs-5">{{ user.name }}</div>
                </div>
              </div>

              <div style="margin-top: 16px; padding: 0; width: 100%; box-sizing: border-box; overflow: visible;">
                    <!-- Nickname -->
                    <div class="info-item" style="margin-bottom: 6px; width: 100%; box-sizing: border-box; overflow: hidden;">
                      <div class="d-flex gap-2 align-items-center" style="min-width: 0;">
                        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="12" cy="7" r="4" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div class="text-muted small" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0;">{{ user.nickname ?: 'No nickname provided' }}</div>
                      </div>
                    </div>

                    <!-- Email -->
                    <div class="info-item" style="margin-bottom: 6px;">
                          <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g id="style=stroke">
                            <g id="email">
                            <path id="vector (Stroke)" fill-rule="evenodd" clip-rule="evenodd" d="M3.88534 5.2371C3.20538 5.86848 2.75 6.89295 2.75 8.5V15.5C2.75 17.107 3.20538 18.1315 3.88534 18.7629C4.57535 19.4036 5.61497 19.75 7 19.75H17C18.385 19.75 19.4246 19.4036 20.1147 18.7629C20.7946 18.1315 21.25 17.107 21.25 15.5V8.5C21.25 6.89295 20.7946 5.86848 20.1147 5.2371C19.4246 4.59637 18.385 4.25 17 4.25H7C5.61497 4.25 4.57535 4.59637 3.88534 5.2371ZM2.86466 4.1379C3.92465 3.15363 5.38503 2.75 7 2.75H17C18.615 2.75 20.0754 3.15363 21.1353 4.1379C22.2054 5.13152 22.75 6.60705 22.75 8.5V15.5C22.75 17.393 22.2054 18.8685 21.1353 19.8621C20.0754 20.8464 18.615 21.25 17 21.25H7C5.38503 21.25 3.92465 20.8464 2.86466 19.8621C1.79462 18.8685 1.25 17.393 1.25 15.5V8.5C1.25 6.60705 1.79462 5.13152 2.86466 4.1379Z" fill="#000000"></path>
                            <path id="vector (Stroke)_2" fill-rule="evenodd" clip-rule="evenodd" d="M19.3633 7.31026C19.6166 7.63802 19.5562 8.10904 19.2285 8.3623L13.6814 12.6486C12.691 13.4138 11.3089 13.4138 10.3185 12.6486L4.77144 8.3623C4.44367 8.10904 4.38328 7.63802 4.63655 7.31026C4.88982 6.98249 5.36083 6.9221 5.6886 7.17537L11.2356 11.4616C11.6858 11.8095 12.3141 11.8095 12.7642 11.4616L18.3113 7.17537C18.6391 6.9221 19.1101 6.98249 19.3633 7.31026Z" fill="#000000"></path>
                            </g>
                            </g>
                            </svg>
                        <div class="text-muted small" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0;">{{ user.email }}</div>
                  </div>
                        </div>

                    <!-- Address -->
                    <div class="info-item" style="margin-bottom: 6px;">
                      <div class="d-flex gap-2 align-items-center">
                        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 20.5H17.5C18.0523 20.5 18.5 20.0523 18.5 19.5V6" stroke="#000000" stroke-linecap="round"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4.0749C5 3.48125 5.47736 3 6.0662 3H15.5097C16.0986 3 16.5759 3.48125 16.5759 4.0749V17.4855C16.5759 18.0792 16.0986 18.5604 15.5097 18.5604H6.0662C5.47736 18.5604 5 18.0792 5 17.4855V4.0749ZM8.22161 14.2881C7.8069 13.968 7.8069 13.3524 8.22161 13.0323C8.93304 12.4831 9.8227 12.1568 10.7879 12.1568C11.7532 12.1568 12.6428 12.4831 13.3543 13.0323C13.769 13.3524 13.769 13.968 13.3543 14.2881C12.6428 14.8373 11.7532 15.1636 10.7879 15.1636C9.8227 15.1636 8.93304 14.8373 8.22161 14.2881ZM10.7859 11.4041C11.8824 11.4041 12.7713 10.2832 12.7713 8.90046C12.7713 7.51772 11.8824 6.39679 10.7859 6.39679C9.68945 6.39679 8.80058 7.51772 8.80058 8.90046C8.80058 10.2832 9.68945 11.4041 10.7859 11.4041Z" stroke="#000000"/>
                        </svg>
                        <div class="text-muted small" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0;">{{ employer.address ?: 'No address provided' }}</div>
                      </div>
                    </div>

                    <!-- Phone -->
                    <div class="info-item" style="margin-bottom: 6px;">
                          <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M4.7177 3.0919C5.94388 1.80096 7.9721 2.04283 8.98569 3.47641L10.2467 5.25989C11.0574 6.40656 10.9889 8.00073 10.0214 9.0194L9.7765 9.27719C9.77582 9.27897 9.7751 9.2809 9.77436 9.28299C9.76142 9.31935 9.7287 9.43513 9.7609 9.65489C9.82765 10.1104 10.1793 11.0361 11.607 12.5392C13.0391 14.0469 13.9078 14.4023 14.3103 14.4677C14.484 14.4959 14.5748 14.4714 14.6038 14.4612L15.0124 14.031C15.8862 13.111 17.2485 12.9298 18.347 13.5621L20.2575 14.6617C21.8904 15.6016 22.2705 17.9008 20.9655 19.2747L19.545 20.7703C19.1016 21.2371 18.497 21.6355 17.75 21.7092C15.9261 21.8893 11.701 21.6548 7.27161 16.9915C3.13844 12.64 2.35326 8.85513 2.25401 7.00591L2.92011 6.97016L2.25401 7.00591C2.20497 6.09224 2.61224 5.30855 3.1481 4.7444L4.7177 3.0919ZM7.7609 4.34237C7.24855 3.61773 6.32812 3.57449 5.80528 4.12493L4.23568 5.77743C3.90429 6.12632 3.73042 6.52621 3.75185 6.92552C3.83289 8.43533 4.48307 11.8776 8.35919 15.9584C12.4234 20.2373 16.1676 20.3581 17.6026 20.2165C17.8864 20.1885 18.1783 20.031 18.4574 19.7373L19.8779 18.2417C20.4907 17.5965 20.3301 16.4342 19.5092 15.9618L17.5987 14.8621C17.086 14.567 16.4854 14.6582 16.1 15.064L15.6445 15.5435L15.1174 15.0428C15.6445 15.5435 15.6438 15.5442 15.6432 15.545L15.6417 15.5464L15.6388 15.5495L15.6324 15.556L15.6181 15.5701C15.6078 15.5801 15.5959 15.591 15.5825 15.6028C15.5556 15.6264 15.5223 15.6533 15.4824 15.6816C15.4022 15.7384 15.2955 15.8009 15.1606 15.8541C14.8846 15.963 14.5201 16.0214 14.0699 15.9483C13.1923 15.8058 12.0422 15.1755 10.5194 13.5722C8.99202 11.9642 8.40746 10.7645 8.27675 9.87234C8.21022 9.41827 8.26346 9.05468 8.36116 8.78011C8.40921 8.64508 8.46594 8.53742 8.51826 8.45566C8.54435 8.41489 8.56922 8.38075 8.5912 8.35298C8.60219 8.33909 8.61246 8.32678 8.62182 8.31603L8.63514 8.30104L8.64125 8.29441L8.64415 8.2913L8.64556 8.2898C8.64625 8.28907 8.64694 8.28835 9.17861 8.79333L8.64695 8.28834L8.93376 7.98637C9.3793 7.51731 9.44403 6.