{% extends 'employer/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block employer_body %}
<style>
/* Profile card styles matching provider design */
.profile-card, .section-card, .profile-right-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(16,24,40,0.06);
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: none !important;
  border: none !important;
}

.profile-card:hover,
.section-card:hover,
.profile-right-card:hover {
  box-shadow: 0 6px 18px rgba(16,24,40,0.06) !important;
  transform: none !important;
  background: #fff !important;
}

.card-title {
  font-size: 1.1rem;
  font-weight: 500;
  margin: 0;
}

.profile-avatar-box {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 2px solid #e6eef6;
}

.profile-icon-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}

.info-item {
  padding: 12px 0;
  border-bottom: 1px solid #e6eef6;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.info-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.history-item {
  padding: 12px 0;
  border-bottom: 1px solid #e6eef6;
}

.history-item:last-child {
  border-bottom: none;
}

.history-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.history-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.quick-link-item {
  padding: 10px 0;
  border-bottom: 1px solid #e6eef6;
}

.quick-link-item:last-child {
  border-bottom: none;
}

.quick-link-item a {
  color: #000;
  text-decoration: none;
  font-size: 0.9375rem;
  display: block;
  transition: color 0.2s;
}

.quick-link-item a:hover {
  color: #85BB65;
}

.section-placeholder {
  text-align: center;
  padding: 40px 20px;
  color: #6B7280;
  font-size: 0.9375rem;
}
</style>

<div class="container-xl">
  <div class="row mt-4">
    {# Left Column: Profile Details #}
    <div class="col-12 col-lg-4">
      <div class="profile-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">Profile:</h6>
          <a href="{{ path('app_employer_profile_update') }}" class="link-plain" title="Edit Profile">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </a>
        </div>

        {# Photo Section #}
        <div class="mb-3">
          <div class="info-label mb-2">Photo</div>
          <div class="d-flex align-items-center gap-3">
            <div class="profile-avatar-box">
              <div class="profile-icon-box">
                {% if user.profilePictureFilename %}
                  <img src="{{ asset('uploads/' ~ user.id ~ '/' ~ user.profilePictureFilename) }}" alt="profile" style="width:100%;height:100%;object-fit:cover;">
                {% else %}
                  <img src="{{ asset('assets/admin/images/user.png') }}" alt="profile" style="width:60%;height:60%;object-fit:contain;">
                {% endif %}
              </div>
            </div>
            <div class="info-value">{{ user.name }}</div>
          </div>
        </div>

        {# Personal Information #}
        <div class="info-item">
          <div class="info-label">Name</div>
          <div class="info-value">{{ user.name ?: '—' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Email</div>
          <div class="info-value">{{ user.email ?: '—' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Phone 1</div>
          <div class="info-value">{{ user.phone1 ?: '—' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Phone 2</div>
          <div class="info-value">{{ user.phone2 ?: '—' }}</div>
        </div>

        {# Company Information #}
        <div class="info-item">
          <div class="info-label">Company Name</div>
          <div class="info-value">{{ employer.companyName ?: '—' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Contact Person Name</div>
          <div class="info-value">{{ employer.contactPersonName ?: '—' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Contact Email</div>
          <div class="info-value">{{ employer.contactEmail ?: '—' }}</div>
        </div>
      </div>
    </div>

    {# Middle Column: My History #}
    <div class="col-12 col-lg-4">
      <div class="section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">My History:</h6>
        </div>

        <div class="history-item">
          <div class="history-label">Reviews:</div>
          <div class="history-value">
            {% if averageRating is not null %}
              {{ averageRating }}/5 ({{ reviewsCount }} review{{ reviewsCount != 1 ? 's' : '' }})
            {% else %}
              No reviews yet
            {% endif %}
          </div>
        </div>

        <div class="history-item">
          <div class="history-label">Membership Level:</div>
          <div class="history-value">{{ membershipLevel ?: '—' }}</div>
        </div>

        <div class="history-item">
          <div class="history-label">Years Active:</div>
          <div class="history-value">{{ yearsActive }} year{{ yearsActive != 1 ? 's' : '' }}</div>
        </div>

        <div class="history-item">
          <div class="history-label">Member ID:</div>
          <div class="history-value">{{ user.id|slice(0, 8) }}</div>
        </div>
      </div>
    </div>

    {# Right Column: Quick Links, Documents Center, Calendar #}
    <div class="col-12 col-lg-4">
      {# Quick Links #}
      <div class="profile-right-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">Quick Links:</h6>
        </div>
        <div class="quick-link-item">
          <a href="{{ path('app_employer_dashboard') }}">Manage Membership</a>
        </div>
        <div class="quick-link-item">
          <a href="{{ path('app_employer_invoices') }}">Manage Invoices</a>
        </div>
        <div class="quick-link-item">
          <a href="{{ path('app_employer_jobs') }}">Manage Jobs</a>
        </div>
        <div class="quick-link-item">
          <a href="{{ path('app_employer_dashboard') }}">Request Data Analytics</a>
        </div>
      </div>

      {# Documents Center #}
      <div class="profile-right-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">Documents Center</h6>
        </div>
        <div class="section-placeholder">
          Documents Center
        </div>
      </div>

      {# Calendar #}
      <div class="profile-right-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">Calendar</h6>
        </div>
        <div class="section-placeholder">
          Calendar
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
