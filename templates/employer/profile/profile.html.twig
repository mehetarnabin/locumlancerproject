                      <img id="editProfileImage" src="{{ asset('assets/admin/images/user.png') }}" alt="profile" style="width:60%;height:60%;object-fit:contain;">
                    {% endif %}
                  </div>
                  <label for="profileImageUploadInput" class="position-absolute bottom-0 end-0 bg-light p-1 rounded-circle" style="cursor:pointer; z-index:10;">
