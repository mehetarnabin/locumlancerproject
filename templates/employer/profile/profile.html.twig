            <div id="infoEdit" style="display: none; position: absolute; top: 0; left: 0; right: 0; width: 100%; padding: 12px; box-sizing: border-box; overflow: visible; z-index: 10; background: #fff;">
              <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 8px; flex-shrink: 0;">
                <h6 class="card-title mb-0" style="font-size: 0.95rem; margin: 0;">Personal Information</h6>
                <button type="button" id="cancelBtn" class="link-plain" title="Cancel" style="background: none; border: none; padding: 0; cursor: pointer;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>

              {{ form_start(profileForm, {'attr': {'id': 'profileForm', 'enctype': 'multipart/form-data', 'style': 'flex: 1; display: flex; flex-direction: column; overflow: hidden;'}}) }}
              {{ form_errors(profileForm) }}

              <div class="d-flex gap-2 align-items-center" style="margin-bottom: 8px; flex-shrink: 0;">
                <div class="profile-avatar-box" style="width: 60px; height: 60px;">
                  <div class="profile-icon-box">
                    <img id="profileAvatarEdit" src="{% if user.profilePictureFilename %}{{ asset('uploads/' ~ user.id ~ '/' ~ user.profilePictureFilename) }}{% else %}{{ asset('assets/admin/images/user.png') }}{% endif %}" alt="profile" style="width:100%;height:100%;object-fit:cover;">
                  </div>
                </div>
                <div style="flex:1;">
                  {{ form_widget(profileForm.name, {'attr': {'class': 'form-control', 'style': 'font-size: 1rem; font-weight: 600; padding: 5px 8px;'}}) }}
                </div>
                <div>
                  {{ form_widget(profileForm.profilePictureFilename, {'attr': {'id': 'profilePictureInput', 'class': 'd-none', 'accept': 'image/*', 'onchange': 'previewProfileImage(this)'}}) }}
                  <label for="profilePictureInput" class="btn btn-sm" style="background: #85BB65; color: #fff; border: none; padding: 5px 10px; border-radius: 5px; font-size: 0.8rem; cursor: pointer; margin: 0; white-space: nowrap;">
                    Photo
                  </label>
                </div>
              </div>

