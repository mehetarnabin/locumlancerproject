{% extends 'employer/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block employer_body %}
<style>
/* Profile card styles matching provider design */
.profile-card, .section-card, .profile-right-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(16,24,40,0.06);
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: none !important;
  border: none !important;
}

.profile-card:hover,
.section-card:hover,
.profile-right-card:hover {
  box-shadow: 0 6px 18px rgba(16,24,40,0.06) !important;
  transform: none !important;
  background: #fff !important;
}

.card-title {
  font-size: 1.1rem;
  font-weight: 500;
  margin: 0;
  color: #000000;
}

.profile-avatar-box {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #85BB65;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-icon-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}

.info-item {
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 6px;
  transition: all 0.2s ease-in-out;
  cursor: default;
}

.info-item:hover {
  background: #F4F9F1 !important;
  box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15) !important;
  transform: translateY(-1px) !important;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.info-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.history-item {
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 8px;
  transition: all 0.2s ease-in-out;
  cursor: default;
}

.history-item:hover {
  background: #F4F9F1 !important;
  box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15) !important;
  transform: translateY(-1px) !important;
}

.history-item:last-child {
  margin-bottom: 0;
}

.history-label {
  font-size: 0.875rem;
  color: #6B7280;
  margin-bottom: 4px;
  font-weight: 400;
}

.history-value {
  font-size: 0.9375rem;
  color: #000;
  font-weight: 400;
}

.quick-link-item {
  padding: 10px 0;
  border-bottom: 1px solid #e6eef6;
}

.quick-link-item:last-child {
  border-bottom: none;
}

.quick-link-item a {
  color: #000;
  text-decoration: none;
  font-size: 0.9375rem;
  display: block;
  transition: color 0.2s;
}

.quick-link-item a:hover {
  color: #85BB65;
}

.section-placeholder {
  text-align: center;
  padding: 40px 20px;
  color: #6B7280;
  font-size: 0.9375rem;
}

/* Share & Quick Links styling */
.upload-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.upload-btn-custom {
  display: flex;
  align-items: center;
  padding: 10px 14px;
  border-radius: 10px;
  background: #F4F9F1;
  border: 1px solid #85BB65;
  box-shadow: 0 2px 6px rgba(11,22,40,0.03);
  text-decoration: none;
  color: #000000;
  transition: all 0.2s ease;
}

.upload-btn-custom:hover {
  background: #E8F5E3;
  border-color: #6FA050;
  color: #000000;
  text-decoration: none;
}

.upload-btn-custom .cstm-btn-text {
  flex: 1;
  color: #000000;
}

/* Documents and Work Preferences buttons */
.documents-view-btn {
  background: #85BB65 !important;
  border: 2px solid #85BB65 !important;
  color: #ffffff !important;
  padding: 10px 20px !important;
  border-radius: 8px !important;
  font-weight: 500 !important;
  font-size: 0.95rem !important;
  text-decoration: none !important;
  transition: all 0.2s ease !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
}

.documents-view-btn:hover {
  background: #6FA050 !important;
  border-color: #6FA050 !important;
  color: #ffffff !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 8px rgba(133, 187, 101, 0.2) !important;
}

/* Card header row */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.link-plain {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: #000000;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.link-plain:hover {
  color: #85BB65;
}

/* Ensure proper flex layout */
.row.g-4 > .col-12.col-md-4 {
  display: flex !important;
  flex-direction: column !important;
}

.row.g-4 > .col-12.col-md-4 > .card {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
  height: 100% !important;
}

.app-card-settings {
  border: none;
  background: #fff;
  margin-bottom: 0;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(16,24,40,0.06);
  padding: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.app-card-settings .card-body {
  padding: 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Profile Edit Mode Styles */
#infoEdit {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  padding: 12px;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

#infoEdit .info-item {
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 8px;
}

#infoEdit .info-item .d-flex {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

#infoEdit .info-item .d-flex .form-control,
#infoEdit .info-item .form-control,
#infoEdit .form-control,
#infoEdit select.form-control {
  flex: 1;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 6px 10px;
  font-size: 0.875rem;
  border: 1px solid #e6eef6;
  border-radius: 6px;
  background: #fff;
  color: #000;
  line-height: 1.4;
}

#infoEdit select.form-control {
  appearance: auto;
  -webkit-appearance: menulist;
  -moz-appearance: menulist;
}

#infoEdit .info-item svg {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  flex-shrink: 0;
}

#infoEdit .d-flex.gap-2 {
  gap: 8px !important;
  width: 100%;
  align-items: center;
}

#infoEdit label.btn {
  position: relative;
  overflow: hidden;
}

#infoEdit label.btn input[type="file"] {
  position: absolute;
  left: -9999px;
  opacity: 0;
}

#infoEdit .info-item {
  width: 100%;
  margin-bottom: 8px;
}

#infoEdit .form-label {
  display: block;
  margin-bottom: 4px;
  font-weight: 500;
  color: #000;
  font-size: 0.875rem;
}

#infoEdit .info-item .d-flex {
  width: 100%;
  align-items: center;
}

#personalSection {
  position: relative;
}
</style>

<div class="container-xl">
  <div class="row mt-4">
    <div class="col-12 col-lg-8">
      <div class="row g-4">
        {# Personal Information card - Full Width #}
        <div class="col-12 d-flex flex-column mb-5">
          <div id="personalSection" class="profile-card" style="position: relative; min-height: auto; padding: 32px; overflow: visible; box-sizing: border-box; display: flex; flex-direction: column;">
            {# View Mode #}
            <div id="infoView" style="position: relative; width: 100%; padding: 0; box-sizing: border-box; overflow: visible;">
              <div class="d-flex justify-content-between align-items-center mb-4" style="margin-top: 0; padding-top: 0;">
                <h5 class="card-title mb-0" style="font-size: 1.25rem; font-weight: 600;">Personal Information</h5>
                <div id="actionIcons">
                  <button type="button" id="editToggle" class="link-plain" title="Edit" style="background: none; border: none; padding: 0; cursor: pointer;">
                    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="d-flex gap-3 align-items-center" style="margin-bottom: 24px; margin-top: 16px;">
                <div class="profile-avatar-box" style="width: 120px; height: 120px; border: 3px solid #85BB65;">
                  <div class="profile-icon-box">
                    {% if user.profilePictureFilename %}
                      <img id="profileAvatarView" src="{{ asset('uploads/' ~ user.id ~ '/' ~ user.profilePictureFilename) }}" alt="profile" style="width:100%;height:100%;object-fit:cover;">
                    {% else %}
                      <img id="profileAvatarView" src="{{ asset('assets/admin/images/user.png') }}" alt="profile" style="width:60%;height:60%;object-fit:contain;">
                    {% endif %}
                  </div>
                </div>
                <div style="flex:1;">
                  <div class="fw-semibold" style="color: #000000; font-size: 1.5rem; font-weight: 600;">{{ user.name }}</div>
                </div>
              </div>

              <div style="margin-top: 16px; padding: 0; width: 100%; box-sizing: border-box; overflow: hidden; min-height: 0;">
                    <!-- Name - Full Width -->
                    <div class="info-item" style="margin-bottom: 6px; width: 100%; box-sizing: border-box; overflow: hidden;">
