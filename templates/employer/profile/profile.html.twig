                    </div>
                  </div>
                    </div>

                    <!-- Row 2: Company Name | Contact Person Name -->
                    <div class="row g-2" style="margin-bottom: 6px; margin-left: 0; margin-right: 0;">
                      <div class="col-12 col-md-6" style="padding-left: 0; padding-right: 6px;">
                        <div class="info-item" style="margin-bottom: 0;">
                          <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 20.5H17.5C18.0523 20.5 18.5 20.0523 18.5 19.5V6" stroke="#000000" stroke-linecap="round"/>
