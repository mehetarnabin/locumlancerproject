                            <path d="M13.2595 1.87983C13.3257 1.47094 13.7122 1.19357 14.1211 1.25976C14.1464 1.26461 14.2279 1.27983 14.2705 1.28933C14.3559 1.30834 14.4749 1.33759 14.6233 1.38082C14.9201 1.46726 15.3347 1.60967 15.8323 1.8378C16.8286 2.29456 18.1544 3.09356 19.5302 4.46936C20.906 5.84516 21.705 7.17097 22.1617 8.16725C22.3899 8.66487 22.5323 9.07947 22.6187 9.37625C22.6619 9.52466 22.6912 9.64369 22.7102 9.72901C22.7197 9.77168 22.7267 9.80594 22.7315 9.83125L22.7373 9.86245C22.8034 10.2713 22.5286 10.6739 22.1197 10.7401C21.712 10.8061 21.3279 10.53 21.2601 10.1231C21.258 10.1121 21.2522 10.0828 21.2461 10.0551C21.2337 9.9997 21.2124 9.91188 21.1786 9.79572C21.1109 9.56339 20.9934 9.21806 20.7982 8.79238C20.4084 7.94207 19.7074 6.76789 18.4695 5.53002C17.2317 4.29216 16.0575 3.59117 15.2072 3.20134C14.7815 3.00618 14.4362 2.88865 14.2038 2.82097C14.0877 2.78714 13.9417 2.75363 13.8863 2.7413C13.4793 2.67347 13.1935 2.28755 13.2595 1.87983Z" fill="#000000"/>
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M13.4861 5.32931C13.5999 4.93103 14.015 4.70041 14.4133 4.81421L14.2072 5.53535C14.4133 4.81421 14.4136 4.81431 14.414 4.81441L14.4147 4.81462L14.4162 4.81506L14.4196 4.81604L14.4273 4.81835L14.4471 4.82451C14.4622 4.82934 14.481 4.83562 14.5035 4.84358C14.5484 4.85952 14.6077 4.88218 14.6805 4.91339C14.8262 4.97582 15.0253 5.07224 15.2698 5.21695C15.7593 5.50664 16.4275 5.98781 17.2124 6.77279C17.9974 7.55776 18.4786 8.22595 18.7683 8.71541C18.913 8.95992 19.0094 9.15899 19.0718 9.30467C19.103 9.37748 19.1257 9.43683 19.1416 9.48175C19.1496 9.5042 19.1559 9.52303 19.1607 9.5381L19.1669 9.55789L19.1692 9.56564L19.1702 9.56898L19.1706 9.57051L19.1708 9.57124C19.1709 9.5716 19.171 9.57195 18.4499 9.77799L19.171 9.57195C19.2848 9.97023 19.0542 10.3853 18.6559 10.4991C18.261 10.612 17.8496 10.3862 17.7317 9.99414L17.728 9.98336C17.7227 9.96833 17.7116 9.93875 17.6931 9.89555C17.6561 9.80921 17.589 9.66798 17.4774 9.47939C17.2544 9.10265 16.8517 8.5334 16.1518 7.83345C15.4518 7.13349 14.8826 6.73079 14.5058 6.50782C14.3172 6.3962 14.176 6.32911 14.0897 6.2921C14.0465 6.27359 14.0169 6.26256 14.0019 6.25722L13.9911 6.25353C13.599 6.13565 13.3733 5.7242 13.4861 5.32931Z" fill="#000000"/>
                            </svg>
                          {{ form_widget(profileForm.phone1, {'attr': {'class': 'form-control', 'placeholder': 'Phone number'}}) }}
                          {{ form_errors(profileForm.phone1) }}
                      </div>
                    </div>

                    <!-- Company Name -->
                    <div class="info-item">
                          <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 20.5H17.5C18.0523 20.5 18.5 20.0523 18.5 19.5V6" stroke="#000000" stroke-linecap="round"/>
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4.0749C5 3.48125 5.47736 3 6.0662 3H15.5097C16.0986 3 16.5759 3.48125 16.5759 4.0749V17.4855C16.5759 18.0792 16.0986 18.5604 15.5097 18.5604H6.0662C5.47736 18.5604 5 18.0792 5 17.4855V4.0749ZM8.22161 14.2881C7.8069 13.968 7.8069 13.3524 8.22161 13.0323C8.93304 12.4831 9.8227 12.1568 10.7879 12.1568C11.7532 12.1568 12.6428 12.4831 13.3543 13.0323C13.769 13.3524 13.769 13.968 13.3543 14.2881C12.6428 14.8373 11.7532 15.1636 10.7879 15.1636C9.8227 15.1636 8.93304 14.8373 8.22161 14.2881ZM10.7859 11.4041C11.8824 11.4041 12.7713 10.2832 12.7713 8.90046C12.7713 7.51772 11.8824 6.39679 10.7859 6.39679C9.68945 6.39679 8.80058 7.51772 8.80058 8.90046C8.80058 10.2832 9.68945 11.4041 10.7859 11.4041Z" stroke="#000000"/>
                          </svg>
                        <input type="text" name="companyName" value="{{ employer.companyName }}" class="form-control" placeholder="Company Name">
                        </div>
                      </div>

                    <!-- Contact Person Name -->
                    <div class="info-item">
                        <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="7" r="4" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        <input type="text" name="contactPersonName" value="{{ employer.contactPersonName }}" class="form-control" placeholder="Contact Person Name">
                      </div>
                    </div>

                    <!-- Contact Email -->
                    <div class="info-item">
                          <div class="d-flex gap-2 align-items-center">
                            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g id="style=stroke">
                            <g id="email">
                            <path id="vector (Stroke)" fill-rule="evenodd" clip-rule="evenodd" d="M3.88534 5.2371C3.20538 5.86848 2.75 6.89295 2.75 8.5V15.5C2.75 17.107 3.20538 18.1315 3.88534 18.7629C4.57535 19.4036 5.61497 19.75 7 19.75H17C18.385 19.75 19.4246 19.4036 20.1147 18.7629C20.7946 18.1315 21.25 17.107 21.25 15.5V8.5C21.25 6.89295 20.7946 5.86848 20.1147 5.2371C19.4246 4.59637 18.385 4.25 17 4.25H7C5.61497 4.25 4.57535 4.59637 3.88534 5.2371ZM2.86466 4.1379C3.92465 3.15363 5.38503 2.75 7 2.75H17C18.615 2.75 20.0754 3.15363 21.1353 4.1379C22.2054 5.13152 22.75 6.60705 22.75 8.5V15.5C22.75 17.393 22.2054 18.8685 21.1353 19.8621C20.0754 20.8464 18.615 21.25 17 21.25H7C5.38503 21.25 3.92465 20.8464 2.86466 19.8621C1.79462 18.8685 1.25 17.393 1.25 15.5V8.5C1.25 6.60705 1.79462 5.13152 2.86466 4.1379Z" fill="#000000"></path>
                            <path id="vector (Stroke)_2" fill-rule="evenodd" clip-rule="evenodd" d="M19.3633 7.31026C19.6166 7.63802 19.5562 8.10904 19.2285 8.3623L13.6814 12.6486C12.691 13.4138 11.3089 13.4138 10.3185 12.6486L4.77144 8.3623C4.44367 8.10904 4.38328 7.63802 4.63655 7.31026C4.88982 6.98249 5.36083 6.9221 5.6886 7.17537L11.2356 11.4616C11.6858 11.8095 12.3141 11.8095 12.7642 11.4616L18.3113 7.17537C18.6391 6.9221 19.1101 6.98249 19.3633 7.31026Z" fill="#000000"></path>
                            </g>
                            </g>
                            </svg>
                        <input type="email" name="contactEmail" value="{{ employer.contactEmail }}" class="form-control" placeholder="Contact Email">
                          </div>
                        </div>
                      </div>
                  
                  {# Hide unused form fields to prevent duplicates #}
                  {% if profileForm.gender is defined %}
                    {{ form_widget(profileForm.gender, {'attr': {'class': 'd-none'}}) }}
                  {% endif %}
                  {% if profileForm.phone2 is defined %}
                    {{ form_widget(profileForm.phone2, {'attr': {'class': 'd-none'}}) }}
                  {% endif %}
                  {% if profileForm.address is defined %}
                    {{ form_widget(profileForm.address, {'attr': {'class': 'd-none'}}) }}
                  {% endif %}
                  {{ form_widget(profileForm.profilePictureFilename, {'attr': {'id': 'profilePictureInput', 'class': 'd-none', 'accept': 'image/*', 'onchange': 'previewProfileImage(this)'}}) }}
                  {# Prevent form_end from rendering additional fields #}
                  {{ form_end(profileForm, {'render_rest': false}) }}
            </div>
          </div>
        </div>

        {# Your History Section - Next to Personal Information #}
        <div class="col-12 col-lg-6 d-flex flex-column">
          <div class="profile-right-card h-fix-auto" style="min-height: 400px; height: 100%; padding: 20px; display: flex; flex-direction: column; box-sizing: border-box;">
            <div class="d-flex justify-content-between align-items-center mb-3" style="margin-top: 0;">
              <h6 class="app-card-title mb-0">Your History</h6>
                </div>
            <div class="card-body" style="padding: 0; flex: 1; display: flex; flex-direction: column; justify-content: flex-start; margin-top: 0; overflow: hidden; min-height: 0;">
              <div class="history-item" style="margin-bottom: 12px; width: 100%; box-sizing: border-box;">
                <div class="d-flex gap-2 align-items-start" style="min-width: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  <div style="flex: 1; min-width: 0;">
                    <div class="history-label">Your Average Rating</div>
                    <div class="history-value">
                        {% if averageRating is not null %}
                          {{ averageRating|number_format(1) }}/5 ({{ reviewsCount }} review{{ reviewsCount != 1 ? 's' : '' }})
                        {% else %}
                          Not Rated Yet
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              <div class="history-item" style="margin-bottom: 12px; width: 100%; box-sizing: border-box;">
                <div class="d-flex gap-2 align-items-start" style="min-width: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                  <div style="flex: 1; min-width: 0;">
                    <div class="history-label">Job Postings</div>
                    <div class="history-value">{{ jobsCount }}</div>
                    </div>
                  </div>
                </div>
              <div class="history-item" style="margin-bottom: 12px; width: 100%; box-sizing: border-box;">
                <div class="d-flex gap-2 align-items-start" style="min-width: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  <div style="flex: 1; min-width: 0;">
                    <div class="history-label">Years Active</div>
                    <div class="history-value">{{ yearsActive }} year{{ yearsActive != 1 ? 's' : '' }}</div>
                    </div>
                  </div>
                </div>
              <div class="history-item" style="margin-bottom: 12px; width: 100%; box-sizing: border-box;">
                <div class="d-flex gap-2 align-items-start" style="min-width: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  <div style="flex: 1; min-width: 0;">
                    <div class="history-label">Membership</div>
                    <div class="history-value">{{ membershipLevel ?: '—' }}</div>
                    </div>
                  </div>
                </div>
              <div class="history-item" style="margin-bottom: 0; width: 100%; box-sizing: border-box;">
                <div class="d-flex gap-2 align-items-start" style="min-width: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  <div style="flex: 1; min-width: 0;">
                    <div class="history-label">Membership ID</div>
                    <div class="history-value">{{ user.id|slice(0, 8)|upper }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {# Calendar Section - Swapped to left column, same size as Documents was #}
      <div class="row g-4" style="margin-top: 24px; width: 100%;">
        <div class="col-12">
          <div class="section-card" style="display: flex; flex-direction: column; min-height: 400px; width: 100%;">
            <div class="card-header-row d-flex justify-content-between align-items-center mb-0" style="flex-shrink: 0; padding: 20px 20px 12px 20px;">
              <div class="card-title-wrapper">
                <h5 class="card-title mb-0" style="font-size: 1.1rem; font-weight: 600;">Calendar</h5>
              </div>
            </div>
            <div class="card-body" style="padding: 20px !important; flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 200px;">
              <div id="calendar-container" style="flex: 1; min-height: 0; overflow: hidden;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# Right Column: Quick Links and Documents - Far Right #}
    <div class="col-12 col-lg-4 d-flex flex-column" style="align-self: flex-start;">
      <div class="profile-right-card h-fix-auto" style="margin-top: 0;">
        <div class="card-header-row d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">Quick Links</h5>
          <div class="d-flex gap-2 align-items-center">
            <button id="employer-select-all-quick-links" class="btn btn-sm" style="background: #85BB65; color: #fff; border: none; padding: 4px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 500; display: none;" title="Select All">
              Select All
            </button>
            <button id="employer-toggle-checkmarks" class="cstm-toggle-btn" title="Toggle Checkmarks" style="background: transparent; border: none; padding: 4px; cursor: pointer;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6L9 17L4 12" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="card-body">
          <div class="upload-list">
            <a href="{{ path('app_employer_dashboard') }}" class="upload-btn-custom employer-quick-link-card" data-link="membership">
              <span class="cstm-btn-text">Manage Membership</span>
              <span class="cstm-btn-checkmark">
                <input type="checkbox" class="upload-check employer-quick-link-checkbox ms-2" data-link="membership">
              </span>
            </a>
            <a href="{{ path('app_employer_invoices') }}" class="upload-btn-custom employer-quick-link-card" data-link="invoices">
              <span class="cstm-btn-text">Manage Invoices</span>
              <span class="cstm-btn-checkmark">
                <input type="checkbox" class="upload-check employer-quick-link-checkbox ms-2" data-link="invoices">
              </span>
            </a>
            <a href="{{ path('app_employer_jobs') }}" class="upload-btn-custom employer-quick-link-card" data-link="jobs">
              <span class="cstm-btn-text">Manage Jobs</span>
              <span class="cstm-btn-checkmark">
                <input type="checkbox" class="upload-check employer-quick-link-checkbox ms-2" data-link="jobs">
              </span>
            </a>
            <a href="{{ path('app_employer_analytics') }}" class="upload-btn-custom employer-quick-link-card" data-link="analytics">
              <span class="cstm-btn-text">Request Data Analytics</span>
              <span class="cstm-btn-checkmark">
                <input type="checkbox" class="upload-check employer-quick-link-checkbox ms-2" data-link="analytics">
              </span>
            </a>
          </div>
        </div>
      </div>

      {# Documents Section - Swapped to right column, same size as Calendar was (square) #}
      <div class="section-card" style="display: flex; flex-direction: column; width: 100%; aspect-ratio: 1; margin-top: 24px;">
        <div class="card-header-row d-flex justify-content-between align-items-center mb-0" style="flex-shrink: 0; padding: 20px 20px 12px 20px;">
          <div class="card-title-wrapper">
            <h5 class="card-title mb-0" style="font-size: 1.1rem; font-weight: 600;">Documents</h5>
          </div>
        </div>
        <div class="card-body" style="padding: 20px !important; flex: 1; display: flex; flex-direction: column; overflow: hidden;">
          <!-- Documents View Area -->
          <div id="documents-upload-area" class="d-flex flex-column align-items-center justify-content-center" style="flex: 1; {% if documents is defined and documents is not empty %}display: none;{% endif %}">
            <div class="mb-2">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
            <p class="mb-3" style="color: #6B7280; font-size: 0.8rem; margin: 0; text-align: center;">No documents uploaded yet.</p>
            <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
              <a href="{{ path('app_employer_documents') }}" class="btn btn-sm documents-view-btn" style="background: #85BB65; color: #fff; border: none; padding: 6px 16px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <span>View</span>
              </a>
            </div>
          </div>

          <!-- Hidden file input -->
          <input type="file" id="documents-file-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" style="display: none;" multiple>
          
          <!-- Uploaded Documents List -->
          <div id="documents-list" class="d-flex flex-column gap-2" style="flex: 1; overflow-y: auto; max-height: 300px; {% if documents is not defined or documents is empty %}display: none;{% endif %}">
            {{ include('employer/profile/_documents_list.html.twig', { 'documents': documents|default([]) }) }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block footer_scripts %}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js'></script>
<style>
/* Hide employer quick link checkboxes by default */
.employer-quick-link-checkbox,
.upload-check.employer-quick-link-checkbox {
  display: none !important;
  cursor: pointer;
  width: 18px;
  height: 18px;
}

/* Show checkboxes when toggled */
.employer-quick-link-checkbox.show,
.upload-check.employer-quick-link-checkbox.show {
  display: block !important;
}

/* Ensure checkmark container is properly styled */
.employer-quick-link-card .cstm-btn-checkmark {
  margin-left: 15px;
  display: flex;
  align-items: center;
  margin-right: 20px;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Employer Quick Links - Toggle checkmarks
    const employerToggleCheckmarks = document.getElementById('employer-toggle-checkmarks');
    const employerSelectAllBtn = document.getElementById('employer-select-all-quick-links');
    let employerCheckmarksVisible = false;
    let employerAllSelected = false;

    if (employerToggleCheckmarks) {
        employerToggleCheckmarks.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            employerCheckmarksVisible = !employerCheckmarksVisible;
            const checkboxes = document.querySelectorAll('.employer-quick-link-checkbox');
            
            checkboxes.forEach(checkbox => {
                if (employerCheckmarksVisible) {
                    checkbox.classList.add('show');
                } else {
                    checkbox.classList.remove('show');
                }
            });
            
            // Show/hide Select All button
            if (employerSelectAllBtn) {
                if (employerCheckmarksVisible) {
                    employerSelectAllBtn.style.display = 'block';
                } else {
                    employerSelectAllBtn.style.display = 'none';
                }
            }
        });
    }

    // Employer Quick Links - Select All functionality
    if (employerSelectAllBtn) {
        employerSelectAllBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            employerAllSelected = !employerAllSelected;
            const checkboxes = document.querySelectorAll('.employer-quick-link-checkbox');
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = employerAllSelected;
            });
            
            // Update button text
            this.textContent = employerAllSelected ? 'Deselect All' : 'Select All';
        });
    }

    // Prevent link navigation when clicking on checkbox
    document.querySelectorAll('.employer-quick-link-card').forEach(card => {
        card.addEventListener('click', function(e) {
            if (e.target.type === 'checkbox' || e.target.closest('.employer-quick-link-checkbox')) {
                e.preventDefault();
                e.stopPropagation();
                // Update Select All button state
                updateEmployerSelectAllButton();
                return false;
            }
        });
    });

    // Function to update Select All button state
    function updateEmployerSelectAllButton() {
        if (!employerSelectAllBtn) return;
        
        const checkboxes = document.querySelectorAll('.employer-quick-link-checkbox');
        const checkedCount = document.querySelectorAll('.employer-quick-link-checkbox:checked').length;
        const totalCount = checkboxes.length;
        
        if (checkedCount === 0) {
            employerAllSelected = false;
            employerSelectAllBtn.textContent = 'Select All';
        } else if (checkedCount === totalCount) {
            employerAllSelected = true;
            employerSelectAllBtn.textContent = 'Deselect All';
        } else {
            employerAllSelected = false;
            employerSelectAllBtn.textContent = 'Select All';
        }
    }

    // Listen to checkbox changes
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('employer-quick-link-checkbox')) {
            updateEmployerSelectAllButton();
        }
    });
    // Profile Edit/View Toggle
    const infoView = document.getElementById('infoView');
    const infoEdit = document.getElementById('infoEdit');
    const editToggle = document.getElementById('editToggle');
    const cancelBtn = document.getElementById('cancelBtn');
    const cancelBtn2 = document.getElementById('cancelBtn2');
    const actionIcons = document.getElementById('actionIcons');
    const personalSection = document.getElementById('personalSection');
    const profileForm = document.getElementById('profileForm');
    const originalData = {};

    // Store original form values
    if (profileForm) {
        profileForm.querySelectorAll('input, select, textarea').forEach(el => {
            if (el.name) {
                originalData[el.name] = el.value;
            }
        });
    }

    // Switch to edit mode
    function switchToEditMode(e) {
        if (e) e.preventDefault();
        if (!infoView || !infoEdit) return;
        
        const viewHeight = infoView.offsetHeight;
        const sectionHeight = personalSection ? personalSection.offsetHeight : viewHeight;
        
        // Preserve the parent container's height
        if (personalSection) {
            personalSection.style.minHeight = sectionHeight + 'px';
            personalSection.style.height = sectionHeight + 'px';
            personalSection.style.overflow = 'hidden';
        }
        
        infoView.style.display = 'none';
        
        infoEdit.style.display = 'flex';
        infoEdit.style.position = 'absolute';
        infoEdit.style.top = '0';
        infoEdit.style.left = '0';
        infoEdit.style.right = '0';
        infoEdit.style.bottom = '0';
        infoEdit.style.width = '100%';
        infoEdit.style.height = '100%';
        infoEdit.style.zIndex = '10';
        infoEdit.style.background = '#fff';
        infoEdit.style.overflow = 'hidden';
        infoEdit.style.padding = '20px';
    }

    // Switch to view mode
    function switchToViewMode() {
        if (!infoView || !infoEdit) return;
        
        infoEdit.style.display = 'none';
        infoEdit.style.position = '';
        infoEdit.style.top = '';
        infoEdit.style.left = '';
        infoEdit.style.right = '';
        infoEdit.style.bottom = '';
        infoEdit.style.width = '';
        infoEdit.style.height = '';
        infoEdit.style.zIndex = '';
        infoEdit.style.overflow = '';
        infoEdit.style.padding = '';
        
        infoView.style.display = 'block';
        
        if (personalSection) {
            personalSection.style.overflow = 'visible';
            // Reset height to allow natural sizing
            personalSection.style.minHeight = '400px';
            personalSection.style.height = '100%';
        }
    }

    // Edit toggle click handler
    if (editToggle) {
        editToggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            switchToEditMode(e);
        });
    }

    // Cancel button handlers
    if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
            // Restore original values
            if (profileForm) {
                profileForm.querySelectorAll('input, select, textarea').forEach(el => {
                    if (el.name && originalData[el.name] !== undefined) {
                        el.value = originalData[el.name];
                    }
                });
            }
            switchToViewMode();
        });
    }

    // Save button handler
    const saveBtn = document.getElementById('saveBtn');
    if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (profileForm) {
                profileForm.dispatchEvent(new Event('submit'));
            }
        });
    }

    // Profile image preview
    window.previewProfileImage = function(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const avatarEdit = document.getElementById('profileAvatarEdit');
                if (avatarEdit) {
                    avatarEdit.src = e.target.result;
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    };

    // AJAX form submission
    if (profileForm) {
        profileForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(profileForm);
            
            // Add employer-specific fields
            const companyName = profileForm.querySelector('input[name="companyName"]');
            if (companyName) {
                formData.append('companyName', companyName.value);
            }
            
            const contactPersonName = profileForm.querySelector('input[name="contactPersonName"]');
            if (contactPersonName) {
                formData.append('contactPersonName', contactPersonName.value);
            }
            
            const contactEmail = profileForm.querySelector('input[name="contactEmail"]');
            if (contactEmail) {
                formData.append('contactEmail', contactEmail.value);
            }
            
            const address = profileForm.querySelector('input[name="address"]');
            if (address) {
                formData.append('address', address.value);
            }
            
            fetch('{{ path("app_employer_profile") }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (response.redirected) {
                    // If redirected, reload the page to show updated data
                    window.location.reload();
                } else {
                    return response.text();
                }
            })
            .then(html => {
                if (html) {
                    // If we got HTML back, reload to show updated profile
                    window.location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while saving. Please try again.');
            });
        });
    }

    // Calendar initialization
    const calendarEl = document.getElementById('calendar-container');
    if (calendarEl) {
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 'auto',
            aspectRatio: 1.8,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            views: {
                dayGridMonth: { buttonText: 'Month' },
                timeGridWeek: { buttonText: 'Week' }
            },
            events: function(fetchInfo, successCallback, failureCallback) {
                // Fetch calendar events from employer interviews
                fetch('/employer/interviews/calendar-data')
                    .then(response => response.json())
                    .then(data => {
                        const events = Array.isArray(data) ? data : [];
                        successCallback(events);
                    })
                    .catch(error => {
                        console.error('Error loading calendar events:', error);
                        successCallback([]);
                    });
            },
            eventClick: function(info) {
                if (info.event.url) {
                    window.open(info.event.url, '_blank');
                    info.jsEvent.preventDefault();
                }
            },
            eventDidMount: function(info) {
                if (info.event.extendedProps.description) {
                    info.el.setAttribute('title', info.event.extendedProps.description);
                }
            }
        });
        calendar.render();
    }
    
    // Documents Management Functionality
    const documentsUploadBtn = document.getElementById('documents-upload-btn');
    const documentsFileInput = document.getElementById('documents-file-input');
    const documentsUploadSpinner = document.getElementById('documents-upload-spinner');
    const documentsButtonText = document.getElementById('documents-button-text');
    const documentsList = document.getElementById('documents-list');
    const documentsUploadArea = document.getElementById('documents-upload-area');
    
    // Handle upload button click
    if (documentsUploadBtn && documentsFileInput) {
        documentsUploadBtn.addEventListener('click', function() {
            documentsFileInput.click();
        });
    }
    
    // Handle file selection
    if (documentsFileInput) {
        documentsFileInput.addEventListener('change', function(e) {
            const files = e.target.files;
            if (files && files.length > 0) {
                const replaceDocumentId = this.dataset.replaceDocumentId;
                uploadDocuments(files, replaceDocumentId);
                // Clear replace flag
                delete this.dataset.replaceDocumentId;
            }
        });
    }
    
    function uploadDocuments(files, replaceDocumentId = null) {
        const formData = new FormData();
        for (let i = 0; i < files.length; i++) {
            formData.append('document', files[i]);
        }
        if (replaceDocumentId) {
            formData.append('replaceDocumentId', replaceDocumentId);
        }
        
        // Show loading state
        if (documentsUploadBtn) {
            documentsUploadBtn.disabled = true;
            if (documentsButtonText) documentsButtonText.textContent = 'Uploading...';
            if (documentsUploadSpinner) documentsUploadSpinner.style.display = 'inline-block';
        }
        
        fetch('{{ path("app_employer_profile_documents_upload") }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update documents list
                if (documentsList && data.documentsListHtml) {
                    documentsList.innerHTML = data.documentsListHtml;
                    documentsList.style.display = 'flex';
                }
                if (documentsUploadArea) {
                    documentsUploadArea.style.display = 'none';
                }
                
                // Re-attach event listeners
                attachDocumentEventListeners();
                
                // Show success message
                if (typeof showToast === 'function') {
                    showToast('Success', data.message || 'Document uploaded successfully', 'success');
                }
            } else {
                alert(data.message || 'Upload failed');
            }
        })
        .catch(error => {
            console.error('Upload error:', error);
            alert('Upload failed. Please try again.');
        })
        .finally(() => {
            // Reset loading state
            if (documentsUploadBtn) {
                documentsUploadBtn.disabled = false;
                if (documentsButtonText) documentsButtonText.textContent = 'Upload Document';
                if (documentsUploadSpinner) documentsUploadSpinner.style.display = 'none';
            }
            if (documentsFileInput) {
                documentsFileInput.value = '';
            }
        });
    }
    
    function attachDocumentEventListeners() {
        // Handle edit button clicks - triggers file input for replacement
        document.querySelectorAll('.edit-document-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                // Trigger file input to replace document
                if (documentsFileInput) {
                    documentsFileInput.click();
                    
                    // Store document ID for replacement
                    documentsFileInput.dataset.replaceDocumentId = this.dataset.documentId;
                }
            });
        });
        
        // Handle delete button clicks
        document.querySelectorAll('.delete-document-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const documentId = this.dataset.documentId;
                const documentName = this.dataset.documentName;
                const csrfToken = this.dataset.csrfToken;
                
                if (!confirm('Are you sure you want to delete "' + documentName + '"?')) {
                    return;
                }
                
                const formData = new FormData();
                formData.append('_token', csrfToken);
                
                fetch('/employer/profile/documents/delete/' + documentId, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update documents list
                        if (documentsList && data.documentsListHtml) {
                            documentsList.innerHTML = data.documentsListHtml;
                            
                            // Show upload area if no documents
                            if (documentsList.innerHTML.trim() === '') {
                                documentsList.style.display = 'none';
                                if (documentsUploadArea) {
                                    documentsUploadArea.style.display = 'flex';
                                }
                            }
                        }
                        
                        // Re-attach event listeners
                        attachDocumentEventListeners();
                        
                        // Show success message
                        if (typeof showToast === 'function') {
                            showToast('Success', data.message || 'Document deleted successfully', 'success');
                        }
                    } else {
                        alert(data.message || 'Delete failed');
                    }
                })
                .catch(error => {
                    console.error('Delete error:', error);
                    alert('Delete failed. Please try again.');
                });
            });
        });
    }
    
    // Initial attachment of event listeners
    attachDocumentEventListeners();
});
</script>
