<div class="messages-content-body">
    <div class="message-detail-header" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
        <a href="{{ path('app_employer_messages') }}" class="back-button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to Messages
        </a>
        <button type="button" class="message-reply-btn" id="reply-button-top" title="Reply">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Reply</span>
        </button>
    </div>
    
    {% if thread_messages is defined and thread_messages|length > 1 %}
        <div class="thread-header">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #5f6368;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15M17 8L12 3M12 3L7 8M12 3V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span><strong>{{ thread_messages|length }}</strong> messages in this conversation</span>
            </div>
        </div>
    {% endif %}

    <!-- Thread Messages - Gmail Style -->
    {% if thread_messages is defined and thread_messages|length > 1 %}
        <div class="thread-messages-container gmail-style-thread" style="margin-bottom: 0;">
            {% for threadMsg in thread_messages %}
                {% set isRoot = threadMsg.id == root_message.id %}
                {% set isReply = not isRoot %}
                <div class="gmail-message-item {% if threadMsg.id == message.id %}active-message{% endif %}" data-message-id="{{ threadMsg.id }}">
                    <div class="gmail-message-header" {% if isReply %}onclick="toggleMessageCollapse(this)" style="cursor: pointer;"{% endif %}>
                        <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                            {% if isReply %}
                                <svg class="collapse-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="transition: transform 0.2s ease; transform: rotate(0deg);">
                                    <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            {% else %}
                                <div style="width: 16px;"></div>
                            {% endif %}
                            
                            {% set msgSenderName = threadMsg.sender.name|default(threadMsg.sender.email) %}
                            {% set msgSenderAvatar = threadMsg.sender.profilePictureFilename ? '/uploads/' ~ threadMsg.sender.id ~ '/' ~ threadMsg.sender.profilePictureFilename : asset('assets/img/user-image.png') %}
                            
                            <img src="{{ msgSenderAvatar }}" alt="" class="gmail-message-avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                            
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <span class="gmail-sender-name" style="font-weight: 600; font-size: 14px; color: #202124;">{{ msgSenderName }}</span>
                                    {% if isReply %}
                                        <span style="font-size: 12px; color: #5f6368;">to me</span>
                                    {% endif %}
                                    <span style="font-size: 12px; color: #9aa0a6; margin-left: auto; font-weight: 400;">{{ threadMsg.createdAt|date('M j, Y, g:i A') }}</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="gmail-message-actions">
                            <!-- Forward button removed -->
                        </div>
                    </div>
                    
                    <div class="gmail-message-content {% if isReply %}collapsible-content{% endif %}" {% if isReply %}style="display: none;"{% endif %}>
                        <div class="gmail-message-body" style="padding: 12px 0 12px 44px; font-size: 14px; line-height: 1.5; color: #202124;">
                            {{ threadMsg.text|raw }}
                        </div>
                        
                        {% if threadMsg.attachment %}
                            <div style="padding: 0 0 12px 44px;">
                                <a href="{{ '/uploads/' ~ threadMsg.sender.id ~ '/' ~ threadMsg.attachment }}" target="_blank" class="message-attachment" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; background: #f1f3f4; border: 1px solid #dadce0; border-radius: 4px; text-decoration: none; color: #1a73e8; font-size: 13px;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>{{ threadMsg.attachment }}</span>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Single Message Detail -->
        <div class="message-detail-content">
            <div class="message-header-info">
                {% set senderName = message.sender.name|default(message.sender.email) %}
                {% set senderAvatar = message.sender.profilePictureFilename ? '/uploads/' ~ message.sender.id ~ '/' ~ message.sender.profilePictureFilename : asset('assets/img/user-image.png') %}
                
                <img src="{{ senderAvatar }}" alt="" class="message-sender-avatar" onerror="this.onerror=null;this.src='{{ asset('assets/img/user-image.png') }}';">
                <div class="message-header-details">
                    <div class="message-sender-name">{{ senderName }}</div>
                    <div class="message-date">{{ message.createdAt|date('F j, Y \\a\\t g:i A') }}</div>
                </div>
            </div>

            <div class="message-body">
                {{ message.text|raw }}
            </div>

            {% if message.attachment %}
                <a href="{{ '/uploads/' ~ message.sender.id ~ '/' ~ message.attachment }}" target="_blank" class="message-attachment">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ message.attachment }}</span>
                </a>
            {% endif %}
        </div>
    {% endif %}

    <!-- Replies Section -->
    <div class="replies-section">
        <h5 class="replies-section-title">Replies</h5>
        
        {% if replies is defined and replies|length > 0 %}
            <div class="replies-list">
                {% for reply in replies %}
                    {% set replySenderName = reply.sender.name|default(reply.sender.email) %}
                    {% set replySenderAvatar = reply.sender.profilePictureFilename ? '/uploads/' ~ reply.sender.id ~ '/' ~ reply.sender.profilePictureFilename : asset('assets/img/user-image.png') %}
                    
                    <div class="reply-item">
                        <div class="reply-header">
                            <img src="{{ replySenderAvatar }}" alt="{{ replySenderName }}" class="reply-avatar" onerror="this.onerror=null;this.src='{{ asset('assets/img/user-image.png') }}';">
                            <div class="reply-sender">{{ replySenderName }}</div>
                            <div class="reply-date">{{ reply.createdAt|date('M j, Y g:i A') }}</div>
                        </div>
                        <div class="reply-text">{{ reply.text|nl2br }}</div>
                        {% if reply.attachment %}
                            <a href="/uploads/{{ reply.sender.id }}/{{ reply.attachment }}" target="_blank" class="reply-attachment">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>{{ reply.attachment }}</span>
                            </a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-replies">No replies yet.</div>
        {% endif %}
    </div>

    <!-- Inline Reply Form - Beautiful and Professional (Placed after all content) -->
    <div id="inline-reply-form" class="inline-reply-form hidden" style="display: none;">
        <div class="inline-reply-header">
            <div class="inline-reply-header-left">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="inline-reply-title">Write a Reply</span>
            </div>
            <button type="button" class="inline-reply-close-btn" onclick="window.openReplyModal()" title="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
        <form id="inline-reply-form-element" action="{{ path('app_employer_message_reply_ajax', {'id': root_message.id}) }}" method="post" enctype="multipart/form-data" class="inline-reply-body">
            <input type="hidden" name="message_id" value="{{ root_message.id }}">
            <div class="inline-reply-subject">
                <input type="text" name="subject" value="Re: {{ root_message.subject|default('Message') }}" readonly class="inline-reply-subject-input">
            </div>
            <div class="inline-reply-editor">
                <textarea name="message" id="inline-reply-message" placeholder="Type your reply here..." required class="inline-reply-textarea"></textarea>
            </div>
            
            <!-- File Attachment Display -->
            <div class="inline-reply-attachments" id="inline-reply-attachments" style="display: none;">
                <div class="inline-reply-attachments-header">
                    <span>Attachments</span>
                </div>
                <ul class="inline-reply-attachment-list" id="inline-reply-attachment-list">
                    <!-- Files will be dynamically added here -->
                </ul>
            </div>
            
            <div class="inline-reply-footer">
                <div class="inline-reply-footer-left">
                    <button type="button" class="inline-reply-attach-btn" onclick="document.getElementById('inline-reply-file-input').click()" title="Attach files">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Attach</span>
                    </button>
                    <input type="file" id="inline-reply-file-input" name="attachment" style="display: none;" multiple>
                </div>
                <div class="inline-reply-footer-right">
                    <button type="submit" class="inline-reply-send-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Send Reply</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- REPLY MODAL BACKDROP -->
<div id="reply-modal-backdrop" class="reply-modal-backdrop hidden" onclick="window.closeReplyModal();"></div>

<!-- REPLY MODAL - REBUILT -->
<div id="reply-modal" class="hidden">
    <div class="reply-modal-header">
        <span class="reply-modal-title">Reply</span>
        <div class="reply-modal-actions">
            <button type="button" class="reply-modal-btn" onclick="window.closeReplyModal(); return false;" title="Close" aria-label="Close reply modal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>
    <form id="reply-modal-form" action="{{ path('app_employer_message_reply_ajax', {'id': root_message.id}) }}" method="post" enctype="multipart/form-data" class="reply-modal-body">
        <div class="reply-modal-field">
            <input type="text" value="Re: {{ root_message.subject|default('Message') }}" readonly>
        </div>
        <div class="reply-modal-editor">
            <textarea name="message" id="reply-modal-message" placeholder="Type your reply here..." required></textarea>
    </div>

        <!-- File Attachment Display -->
        <div class="reply-file-attachment-display" id="reply-file-attachment-display">
            <ul class="reply-file-attachment-list" id="reply-file-attachment-list">
                <!-- Files will be dynamically added here -->
            </ul>
            </div>
        
        <div class="reply-modal-footer">
            <div class="reply-modal-footer-left">
                <button type="submit" class="reply-modal-send-btn" id="reply-modal-send-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Send
                </button>
            </div>
            <div class="reply-modal-footer-right">
                <button type="button" class="reply-modal-toolbar-btn" onclick="document.getElementById('reply-modal-attachment').click()" title="Attach files" id="reply-attachment-btn" aria-label="Attach files">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <input type="file" id="reply-modal-attachment" name="attachment" style="display: none !important;" multiple>
            </div>
            </div>
        </form>
</div>

<!-- COMPOSE MODAL -->
<div id="compose-modal" class="compose-modal hidden">
    <div class="compose-modal-header">
        <span class="compose-modal-title">New Message</span>
        <div class="compose-modal-actions">
            <button type="button" class="compose-modal-btn" onclick="minimizeComposeModal()" title="Minimize">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
            <button type="button" class="compose-modal-btn" onclick="closeComposeModal()" title="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>
    <form id="compose-form" action="{{ path('app_employer_messages_new') }}" method="post" enctype="multipart/form-data" class="compose-modal-body">
