<script>
// Define openReplyModal to show/hide reply modal
window.openReplyModal = function() {
    console.log('openReplyModal called - opening reply modal');
    
    const replyModal = document.getElementById('reply-modal');
    if (!replyModal) {
        console.error('Reply modal not found!');
        return;
    }
    
    // Show modal
    replyModal.classList.remove('hidden');
    replyModal.style.display = 'block';
    
    // Focus on textarea
    setTimeout(() => {
        const textarea = document.getElementById('reply-modal-message');
        if (textarea) {
            textarea.focus();
        }
    }, 100);
};

window.closeReplyModal = function() {
    const modal = document.getElementById('reply-modal');
    const backdrop = document.getElementById('reply-modal-backdrop');
    
    if (modal) {
        modal.classList.add('hidden');
        modal.style.display = 'none';
        const form = document.getElementById('reply-modal-form');
        if (form) {
            form.reset();
        }
        // Clear file attachments
        const fileInput = document.getElementById('reply-modal-attachment');
        if (fileInput) {
            fileInput.value = '';
        }
        const attachmentList = document.getElementById('reply-file-attachment-list');
        if (attachmentList) {
            attachmentList.innerHTML = '';
        }
        const attachmentDisplay = document.getElementById('reply-file-attachment-display');
        if (attachmentDisplay) {
            attachmentDisplay.style.display = 'none';
        }
        if (typeof replySelectedFiles !== 'undefined') {
            replySelectedFiles = [];
        }
        if (typeof updateReplyAttachmentButton === 'function') {
            updateReplyAttachmentButton();
        }
    }
    
    // Hide backdrop
    if (backdrop) {
        backdrop.classList.add('hidden');
        backdrop.style.display = 'none';
    }
};

// Also define as global function (not just window property) for onclick compatibility
function openReplyModal() {
    if (typeof window.openReplyModal === 'function') {
        window.openReplyModal();
    } else {
        // Fallback: try to find and show the reply modal
        const replyModal = document.getElementById('reply-modal');
        if (replyModal) {
            replyModal.classList.remove('hidden');
            replyModal.style.display = 'block';
            setTimeout(() => {
                const textarea = document.getElementById('reply-modal-message');
                if (textarea) {
                    textarea.focus();
                }
            }, 100);
        }
    }
}

function closeReplyModal() {
    if (typeof window.closeReplyModal === 'function') {
        window.closeReplyModal();
    }
}

// Ensure window.openReplyModal is set
if (typeof window.openReplyModal === 'undefined') {
    window.openReplyModal = openReplyModal;
}

// Compose modal functions
function openComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.remove('minimized');
    }
}

function closeComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.add('hidden');
    }
}

function minimizeComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.toggle('minimized');
    }
}

window.openComposeModal = openComposeModal;
window.closeComposeModal = closeComposeModal;
window.minimizeComposeModal = minimizeComposeModal;
</script>
<script>
    // Immediately set button styles when button exists
    (function() {
        function setupReplyButton() {
            const btn = document.getElementById('reply-button-top') || document.querySelector('.message-reply-btn');
            if (btn) {
                btn.style.backgroundColor = '#85BB65';
                btn.style.color = '#ffffff';
                btn.style.border = 'none';
                btn.style.borderRadius = '10px';
                btn.style.padding = '10px 20px';
                btn.style.fontWeight = '600';
                btn.style.fontSize = '14px';
                btn.style.cursor = 'pointer';
                btn.style.display = 'flex';
                btn.style.alignItems = 'center';
                btn.style.gap = '8px';
                btn.style.transition = 'all 0.2s ease';
                btn.style.boxShadow = '0 2px 6px rgba(0, 0, 0, 0.15)';
                btn.removeAttribute('onclick');
                
                // Verify modal exists
                const modal = document.getElementById('reply-modal');
                if (!modal) {
                    console.error('Reply modal not found in DOM!');
                } else {
                    console.log('Reply modal found in DOM');
                }
            }
        }
        // Try immediately
        setupReplyButton();
        // Also try when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupReplyButton);
        } else {
            setupReplyButton();
        }
        // Also try after a short delay
        setTimeout(setupReplyButton, 100);
    })();
</script>
