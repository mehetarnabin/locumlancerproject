</aside>

<script>
function openTimelinePanel() {
    const panel = document.getElementById('timeline-panel');
    const overlay = document.getElementById('timeline-overlay');
    
    if (panel && overlay) {
        panel.classList.add('open');
        overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
        panel.setAttribute('aria-hidden', 'false');
        
        // Add class to split view container to indicate timeline is open
        const splitJobDetails = document.getElementById('split-job-details');
        if (splitJobDetails) {
            splitJobDetails.classList.add('timeline-open');
        }
    }
}

// Make it globally available
window.openTimelinePanel = openTimelinePanel;

function closeTimelinePanel() {
    const panel = document.getElementById('timeline-panel');
    const overlay = document.getElementById('timeline-overlay');
    
    if (panel && overlay) {
        panel.classList.remove('open');
        overlay.classList.remove('show');
        document.body.style.overflow = '';
        panel.setAttribute('aria-hidden', 'true');
        
        // Remove timeline-open class from split view container
        const splitJobDetails = document.getElementById('split-job-details');
        if (splitJobDetails) {
            splitJobDetails.classList.remove('timeline-open');
        }
    }
}

// Make it globally available
window.closeTimelinePanel = closeTimelinePanel;

// Close on Escape key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeTimelinePanel();
    }
});

// Hover-Sensitive Accordion functionality
// Make initializeAccordions globally available for split view
window.initializeAccordions = function(container) {
    if (!container) return;
    
    const accordions = container.querySelectorAll('.app-detail-accordion[data-accordion-section]');
    
    accordions.forEach(function(accordion) {
        const header = accordion.querySelector('.app-detail-accordion-header[data-accordion-toggle]');
        const content = accordion.querySelector('.app-detail-accordion-content');
        
        if (!header || !content) return;
        
        // Skip if already initialized (check for data attribute)
        if (accordion.dataset.accordionInitialized === 'true') return;
        accordion.dataset.accordionInitialized = 'true';
        
        let isLocked = false;
        let hoverTimeout = null;
        
        // Expand function
        function expandAccordion() {
            header.classList.add('expanded');
            content.classList.remove('collapsed');
            content.classList.add('expanded');
        }
        
        // Collapse function
        function collapseAccordion() {
            if (!isLocked) {
                header.classList.remove('expanded');
                content.classList.remove('expanded');
                content.classList.add('collapsed');
            }
        }
        
        // Click handler - lock/unlock the accordion
        function handleClick(e) {
            e.stopPropagation();
            isLocked = !isLocked;
            if (isLocked) {
                expandAccordion();
            } else {
                collapseAccordion();
            }
        }
        
        // Hover handler - expand on hover (if not locked)
        header.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            expandAccordion();
        });
        
        // Mouse leave handler - collapse after delay (if not locked)
        header.addEventListener('mouseleave', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                hoverTimeout = setTimeout(function() {
                    collapseAccordion();
                }, 200);
            }
        });
        
        // Also handle mouse events on content to keep it open when hovering over it
        content.addEventListener('mouseenter', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                expandAccordion();
            }
        });
        
        content.addEventListener('mouseleave', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                hoverTimeout = setTimeout(function() {
                    collapseAccordion();
                }, 200);
            }
        });
        
        // Click handlers
        header.addEventListener('click', handleClick);
    });
};

document.addEventListener('DOMContentLoaded', function() {
    // Initialize accordions for both main view and split view
    function initializeAccordionsLocal(container) {
        if (!container) return;
        
        const accordions = container.querySelectorAll('.app-detail-accordion[data-accordion-section]');
        
        accordions.forEach(function(accordion) {
            const header = accordion.querySelector('.app-detail-accordion-header[data-accordion-toggle]');
            const content = accordion.querySelector('.app-detail-accordion-content');
            
            if (!header || !content) return;
            
            let isLocked = false;
            let hoverTimeout = null;
            
            // Expand function
            function expandAccordion() {
                header.classList.add('expanded');
                content.classList.remove('collapsed');
                content.classList.add('expanded');
            }
            
            // Collapse function
            function collapseAccordion() {
                if (!isLocked) {
                    header.classList.remove('expanded');
                    content.classList.remove('expanded');
                    content.classList.add('collapsed');
                }
            }
            
            // Click handler - lock/unlock the accordion
            function handleClick(e) {
                e.stopPropagation();
                isLocked = !isLocked;
                if (isLocked) {
                    expandAccordion();
                } else {
                    collapseAccordion();
                }
            }
            
            // Hover handler - expand on hover (if not locked)
            header.addEventListener('mouseenter', function() {
                clearTimeout(hoverTimeout);
                expandAccordion();
            });
            
            // Mouse leave handler - collapse after delay (if not locked)
            header.addEventListener('mouseleave', function() {
                if (!isLocked) {
                    clearTimeout(hoverTimeout);
                    hoverTimeout = setTimeout(function() {
                        collapseAccordion();
                    }, 200);
                }
            });
            
            // Also handle mouse events on content to keep it open when hovering over it
            content.addEventListener('mouseenter', function() {
                if (!isLocked) {
                    clearTimeout(hoverTimeout);
                    expandAccordion();
                }
            });
            
            content.addEventListener('mouseleave', function() {
                if (!isLocked) {
                    clearTimeout(hoverTimeout);
                    hoverTimeout = setTimeout(function() {
                        collapseAccordion();
                    }, 200);
                }
            });
            
            // Click handlers
            header.addEventListener('click', handleClick);
        });
    }
    
    // Initialize for main content
    const mainContent = document.querySelector('.app-detail-content');
    if (mainContent) {
        window.initializeAccordions(mainContent);
    }
    
    // Initialize for split view (if it exists)
    const splitViewContent = document.querySelector('.split-view-container .app-detail-content');
    if (splitViewContent) {
        window.initializeAccordions(splitViewContent);
    }
    
    // Watch for split view creation and initialize accordions there too
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    const splitContent = node.querySelector ? node.querySelector('.app-detail-content') : null;
                    if (splitContent) {
                        window.initializeAccordions(splitContent);
                    }
                    // Also check if the node itself is an accordion container
                    if (node.classList && node.classList.contains('app-detail-content')) {
                        window.initializeAccordions(node);
                    }
                    // Check for accordions directly added
                    const directAccordions = node.querySelectorAll ? node.querySelectorAll('.app-detail-accordion[data-accordion-section]') : [];
                    if (directAccordions.length > 0) {
                        directAccordions.forEach(function(accordion) {
                            const container = accordion.closest('.app-detail-content') || accordion.parentElement;
                            if (container) {
                                window.initializeAccordions(container);
                            }
                        });
                    }
                }
            });
        });
    });
    
    // Observe the document body for new elements
    if (document.body) {
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }
});
</script>
