{% set statusColors = {
    'applied': 'applied',
    'in_review': 'review',
    'interview': 'interview',
    'offered': 'offered',
    'accepted': 'accepted',
    'rejected': 'rejected',
    'hired': 'hired',
    'completed': 'completed'
} %}

{% set transitionColors = {
    'review': 'review',
    'interview': 'interview',
    'offer': 'offered',
    'hire': 'hired',
    'complete': 'completed'
} %}

<style>
/* Application Detail Content - Provider Design Style */
#application-detail-content,
.app-detail-content {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
}

/* Provider Design Pattern - Header */
.app-detail-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e6eef6;
}

.app-detail-logo-container {
    flex-shrink: 0;
}

.app-detail-logo {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    background: #F4F9F1;
    padding: 8px;
}

.app-detail-info {
    flex: 1;
    min-width: 0;
}

.app-detail-title {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 8px;
    line-height: 1.3;
}

.app-detail-company {
    font-size: 17px;
    color: #000000;
    margin-bottom: 8px;
    font-weight: 500;
}

.app-detail-location {
    font-size: 15px;
    color: #000000;
    display: flex;
    align-items: center;
    gap: 6px;
}

.app-detail-location i {
    color: #000000;
}

/* Key Metrics Grid - Provider Design Style */
.app-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
}

.app-detail-meta-item {
    background: #F4F9F1;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    display: flex;
    flex-direction: column;
}

.app-detail-meta-label {
    font-size: 14px;
    color: #000000;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.app-detail-meta-label i {
    font-size: 15px;
    color: #000000;
}

.app-detail-meta-value {
    font-size: 17px;
    color: #000000;
    font-weight: 600;
}

/* Section Styling - Provider Design Style */
.app-detail-section {
    margin-bottom: 24px;
}

.app-detail-section-title {
    font-size: 21px;
    font-weight: 700;
    color: #000000 !important;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid #85BB65;
    display: flex;
    align-items: center;
    gap: 8px;
}

.app-detail-section-title i {
    color: #000000 !important;
    font-size: 19px;
}

.app-detail-section-title * {
    color: #000000 !important;
}

.app-detail-description {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 16px;
    color: #000000;
    line-height: 1.6;
    font-size: 15px;
}

.app-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
}

.app-detail-item {
    padding: 12px;
    background: #F4F9F1;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    font-size: 15px;
    color: #000000;
}

.app-detail-item strong {
    color: #000000 !important;
    font-weight: 600;
    margin-right: 8px;
    font-size: 15px;
}

.app-detail-item {
    color: #000000 !important;
    font-size: 15px;
}

.app-detail-item * {
    color: #000000 !important;
}

.app-detail-item span {
    color: #000000 !important;
}

/* History Items */
.app-detail-history {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.app-detail-history-item {
    padding: 12px;
    background: #F4F9F1;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: #000000;
}

.app-detail-history-item i {
    color: #000000;
}

/* File Display */
.app-detail-file {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: #F4F9F1;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    margin-bottom: 12px;
}

.app-detail-file span {
    color: #000000 !important;
}

.app-detail-file * {
    color: #000000 !important;
}

.app-detail-file .icon-image {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

/* Document Accordion */
.app-detail-content .card {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    margin-bottom: 12px;
}

.app-detail-content .card-header {
    background: #F4F9F1;
    border-bottom: 1px solid #e6eef6;
    padding: 0;
}

.app-detail-content .btn-link {
    color: #000000;
    text-decoration: none;
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    font-weight: 500;
    font-size: 15px;
}

.app-detail-content .btn-link:hover {
    color: #85BB65;
}

.app-detail-content .card-body {
    padding: 16px;
}

/* Badge Styling */
.badge-pill {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.badge.is-applied {
    background-color: #99ECFF;
    color: #000000;
}

.badge.is-review {
    background-color: #85E9FF;
    color: #000000;
}

.badge.is-interview {
    background-color: #85BB65;
    color: #ffffff;
}

.badge.is-offered {
    background-color: #5CE1FF;
    color: #000000;
}

.badge.is-hired {
    background-color: #48E1FF;
    color: #000000;
}

.badge.is-completed {
    background-color: #33DAFF;
    color: #000000;
}

/* Responsive */
@media (max-width: 768px) {
    .app-detail-meta {
        grid-template-columns: 1fr;
    }
    
    .app-details-grid {
        grid-template-columns: 1fr;
    }
}

/* Force all text in application detail to be black - override any base template styles */
.app-detail-content h3,
.app-detail-content .app-detail-section-title,
.app-detail-content .app-detail-section-title *,
.app-detail-content .app-detail-item,
.app-detail-content .app-detail-item *,
.app-detail-content .app-detail-item strong,
.app-detail-content .app-detail-item span,
.app-detail-content .app-detail-file,
.app-detail-content .app-detail-file *,
.app-detail-content .app-detail-file span {
    color: #000000 !important;
}

/* Override any green color that might be coming from base template */
#application-detail-content h3,
#application-detail-content .app-detail-section-title,
#application-detail-content .app-detail-section-title *,
#application-detail-content .app-detail-item,
#application-detail-content .app-detail-item *,
#application-detail-content .app-detail-item strong,
#application-detail-content .app-detail-item span {
    color: #000000 !important;
}
</style>

<div class="app-detail-content" data-application-id="{{ application.id }}">
    {# Header Section - Provider Design Style #}
    <div class="app-detail-header">
        <div class="app-detail-logo-container">
            {% if provider.user.profilePicture %}
                <img src="{{ provider.user.profilePicture }}" 
                     alt="{{ provider.user.name }}" 
                     class="app-detail-logo"
                     onerror="this.src='{{ asset('assets/icons/job.png') }}'">
            {% else %}
                <img src="{{ asset('assets/icons/job.png') }}" 
                     alt="{{ provider.user.name }}" 
                     class="app-detail-logo">
            {% endif %}
        </div>
        <div class="app-detail-info">
            <h1 class="app-detail-title">{{ provider.user.name }}</h1>
            <div class="app-detail-company">{{ job.title }}</div>
            <div class="app-detail-location">
                <i class="fas fa-map-marker-alt"></i>
                {% if provider.city or provider.state %}
                    {{ provider.city }}{% if provider.city and provider.state %}, {% endif %}{{ provider.state }}
                {% else %}
                    Location not specified
                {% endif %}
            </div>
        </div>
    </div>

    {# Key Metrics Grid - Provider Design Style #}
    <div class="app-detail-meta">
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-clock"></i> Applied Date
            </div>
            <div class="app-detail-meta-value">{{ application.createdAt|date('m/d/Y') }}</div>
        </div>
        
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-star"></i> Rating
            </div>
            <div class="app-detail-meta-value">{{ application.provider.averagePoint ? application.provider.averagePoint : 'Not Rated' }}</div>
        </div>
        
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-info-circle"></i> Status
            </div>
            <div class="app-detail-meta-value">
                <span class="badge badge-pill" style="font-size: 12px; padding: 6px 12px; background: {% if application.status == 'interview' or application.status == 'interviewing' %}#85BB65{% else %}#10b981{% endif %}; color: #fff; border: none; border-radius: 12px; display: inline-block;">
                    {% if application.status == 'in_review' %}
                        Negotiating
                    {% else %}
                        {{ application.status | replace({'_': ' '}) | title }}
                    {% endif %}
                </span>
            </div>
        </div>
        
        {% if provider.phoneMobile %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneMobile }}</div>
        </div>
        {% elseif provider.phoneWork %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneWork }}</div>
        </div>
        {% elseif provider.phoneHome %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneHome }}</div>
        </div>
        {% endif %}
        
        {% if provider.user.email %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-envelope"></i> Email
            </div>
            <div class="app-detail-meta-value" style="font-size: 15px; word-break: break-word; color: #000000;">{{ provider.user.email }}</div>
        </div>
        {% endif %}
        
        {% if application.interviews|length > 0 %}
        {% set nextInterview = application.interviews|first %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-calendar-check"></i> Next Interview
            </div>
            <div class="app-detail-meta-value">
                {{ nextInterview.date|date('m/d/Y H:i') }}
                {% if nextInterview.meetingPlatform %}
                    <div style="font-size: 12px; color: #666; font-weight: 500;">Via {{ nextInterview.meetingPlatform }}</div>
                {% endif %}
                {% if nextInterview.meetingUrl %}
                    <div style="font-size: 12px;"><a href="{{ nextInterview.meetingUrl }}" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: 500;">Join Meeting</a></div>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

    {# Action History #}
    {% if application.oneFileRequestedAt or application.oneFileProvidedAt or application.interview or application.contractSentAt or application.contractSignedAt or review %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-history"></i> Action History
        </h3>
        <div class="app-detail-history">
            {% if application.oneFileRequestedAt %}
                <div class="app-detail-history-item" style="color: #000000; font-size: 15px;">
                    <i class="fas fa-folder"></i> <strong style="color: #000000;">One File Requested:</strong> <span style="color: #000000;">{{ application.oneFileRequestedAt|date('m/d/Y') }}</span>
                </div>
            {% endif %}
            {% if application.oneFileProvidedAt %}
                <div class="app-detail-history-item" style="color: #000000; font-size: 15px;">
                    <i class="fas fa-check-circle"></i> <strong style="color: #000000;">One File Provided:</strong> <span style="color: #000000;">{{ application.oneFileProvidedAt|date('m/d/Y') }}</span>
                </div>
            {% endif %}
            {% if application.interviews|length > 0 %}
                {% for interview in application.interviews %}
                <div class="app-detail-history-item">
                    <i class="fas fa-calendar-check"></i>
                    <strong>Interview Scheduled:</strong> {{ interview.date|date('m/d/Y H:i') }}
                    {% if interview.meetingPlatform %}
                        <span style="margin-left: 6px; color: #666;">(Via {{ interview.meetingPlatform }})</span>
                    {% endif %}
                    {% if interview.meetingUrl %}
                        <a href="{{ interview.meetingUrl }}" target="_blank" style="margin-left: 8px; color: #2563eb; text-decoration: none; font-weight: 500;">Join</a>
                    {% endif %}
                </div>
                {% endfor %}
            {% endif %}

            {% if application.contractSentAt is not null %}
                <div class="app-detail-history-item" style="color: #000000; font-size: 15px;">
                    <i class="fas fa-file-contract"></i> <strong style="color: #000000;">Contract Sent:</strong> <span style="color: #000000;">{{ application.contractSentAt|date('m/d/Y') }}</span>
                </div>
            {% endif %}
            {% if application.contractSignedAt %}
                <div class="app-detail-history-item" style="color: #000000; font-size: 15px;">
                    <i class="fas fa-signature"></i> <strong style="color: #000000;">Contract Signed:</strong> <span style="color: #000000;">{{ application.contractSignedAt|date('m/d/Y') }}</span>
                </div>
            {% endif %}
            {% if review %}
                <div class="app-detail-history-item" style="color: #000000; font-size: 15px;">
                    <i class="fas fa-star"></i> <strong style="color: #000000;">Reviewed:</strong> <span style="color: #000000;">{{ review.createdAt|date('m/d/Y') }}</span>
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# CV #}
    {% if provider.cvFilename %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-file-pdf"></i> CV
        </h3>
    <div class="app-detail-file">
        <a href="#" class="cv-toggle-btn" data-bs-toggle="modal" data-bs-target="#cvModal-{{ provider.id }}" style="cursor: pointer; display: flex; align-items: center; gap: 12px; text-decoration: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-image" style="stroke: #000000;">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span style="color: #000000; font-size: 15px;">{{ provider.cvFilename }}</span>
        </a>
    </div>

    <!-- CV Modal -->
    <div class="modal fade" id="cvModal-{{ provider.id }}" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document" style="max-width: 90vw;">
            <div class="modal-content" style="height: 90vh;">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" style="margin: 0;">{{ provider.cvFilename }}</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="border: none; background: none; padding: 4px; cursor: pointer;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body" style="padding: 0; height: calc(100% - 60px);">
                    {% set relativePath = 'uploads/' ~ provider.user.id ~ '/' ~ provider.cvFilename %}
                    {% set filePath = asset(relativePath) %}
                    
                    {% if file_exists(relativePath) %}
                        {% if provider.cvFilename ends with '.pdf' %}
                            <iframe src="{{ filePath }}" width="100%" height="100%" style="border: none;"></iframe>
                        {% else %}
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                                <p style="color: #000000; margin-bottom: 12px; font-size: 16px;"><strong>This file type cannot be previewed directly in the modal.</strong></p>
                                <a href="{{ filePath }}" class="btn btn-primary" target="_blank" download style="background: #85BB65; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; text-decoration: none; display: inline-block;">
                                    <i class="fas fa-download"></i> Download {{ provider.cvFilename }}
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                            <div style="text-align: center; color: #ef4444; margin-bottom: 16px;">
                                <i class="fas fa-exclamation-circle" style="font-size: 48px; margin-bottom: 12px;"></i>
                                <p style="font-size: 18px; font-weight: 600; margin-bottom: 8px;">File Not Found</p>
                                <p style="font-size: 14px; color: #666; max-width: 300px;">The requested file "{{ provider.cvFilename }}" could not be found on the server.</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    </div>
    {% endif %}

    {# Document Requests #}
    {% if documentRequests|length > 0 %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-file-alt"></i> Documents
        </h3>
        <div id="documentRequestsAccordion">
            {% for documentRequest in documentRequests %}
                {% set document = documentRequest.document %}
                <div class="card mb-2">
                    <div class="card-header" id="heading{{ documentRequest.id }}">
                        <h5 class="mb-0">
                            <button class="btn btn-link {% if not loop.first %}collapsed{% endif %}" 
                                    type="button" 
                                    data-toggle="collapse" 
                                    data-target="#collapse{{ documentRequest.id }}" 
                                    aria-expanded="{% if loop.first %}true{% else %}false{% endif %}" 
                                    aria-controls="collapse{{ documentRequest.id }}"
                                    style="color: #000000; font-size: 15px;">
                                {{ documentRequest.name }}
                                {% if document %}
                                    <span class="badge badge-success">Provided</span>
                                {% else %}
                                    <span class="badge badge-warning">Pending</span>
                                {% endif %}
                            </button>
                        </h5>
                    </div>
                    <div id="collapse{{ documentRequest.id }}" 
                         class="collapse {% if loop.first %}show{% endif %}" 
                         aria-labelledby="heading{{ documentRequest.id }}" 
                         data-parent="#documentRequestsAccordion">
                        <div class="card-body" style="color: #000000; font-size: 15px;">
                            {% if document %}
                                <p style="color: #000000;"><strong style="color: #000000;">Status:</strong> <span style="color: #000000;">Provided on {{ document.createdAt|date('m/d/Y') }}</span></p>
                                <a href="{{ asset('uploads/' ~ document.user.id ~ '/' ~ document.filename) }}" 
                                   target="_blank" 
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-download"></i> Download
                                </a>
                            {% else %}
                                <p style="color: #000000;">Document not yet provided.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Education #}
    {% if educations is defined and educations|length > 0 %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-graduation-cap"></i> Education
        </h3>
        <div class="app-details-grid">
            {% for education in educations %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>School:</strong> <span style="color: #000000;">{{ education.school }}</span><br>
                {% if education.degree %}<strong>Degree:</strong> <span style="color: #000000;">{{ education.degree }}</span><br>{% endif %}
                {% if education.fieldOfStudy %}<strong>Field:</strong> <span style="color: #000000;">{{ education.fieldOfStudy }}</span><br>{% endif %}
                {% if education.grade %}<strong>Grade:</strong> <span style="color: #000000;">{{ education.grade }}</span><br>{% endif %}
                {% if education.startDate %}<strong>Start:</strong> <span style="color: #000000;">{{ education.startDate|date('m/d/Y') }}</span><br>{% endif %}
                {% if education.endDate %}<strong>End:</strong> <span style="color: #000000;">{{ education.endDate|date('m/d/Y') }}</span>{% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Experience #}
    {% if experiences is defined and experiences|length > 0 %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-briefcase"></i> Experience
        </h3>
        <div class="app-details-grid">
            {% for experience in experiences %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Title:</strong> <span style="color: #000000;">{{ experience.title }}</span><br>
                {% if experience.company %}<strong>Company:</strong> <span style="color: #000000;">{{ experience.company }}</span><br>{% endif %}
                {% if experience.location %}<strong>Location:</strong> <span style="color: #000000;">{{ experience.location }}</span><br>{% endif %}
                {% if experience.employmentType %}<strong>Type:</strong> <span style="color: #000000;">{{ experience.employmentType }}</span><br>{% endif %}
                {% if experience.startDate %}<strong>Start:</strong> <span style="color: #000000;">{{ experience.startDate|date('m/d/Y') }}</span><br>{% endif %}
                {% if experience.endDate %}<strong>End:</strong> <span style="color: #000000;">{{ experience.endDate|date('m/d/Y') }}</span>{% else %}<strong>Current:</strong> <span style="color: #000000;">Yes</span>{% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Insurance #}
    {% if insurances is defined and insurances|length > 0 %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-shield-alt"></i> Insurance
        </h3>
        <div class="app-details-grid">
            {% for insurance in insurances %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Carrier:</strong> <span style="color: #000000;">{{ insurance.carrier }}</span><br>
                {% if insurance.amount %}<strong>Amount:</strong> <span style="color: #000000;">{{ insurance.amount }}</span><br>{% endif %}
                {% if insurance.effectiveDate %}<strong>Effective Date:</strong> <span style="color: #000000;">{{ insurance.effectiveDate|date('m/d/Y') }}</span><br>{% endif %}
                {% if insurance.state %}<strong>State:</strong> <span style="color: #000000;">{{ insurance.state }}</span><br>{% endif %}
                {% if insurance.city %}<strong>City:</strong> <span style="color: #000000;">{{ insurance.city }}</span>{% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Health Assessment #}
    {% if provider.healthAssessment is not empty %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-heartbeat"></i> Health Assessment
        </h3>
        <div class="app-details-grid">
            {% if provider.healthAssessment['substance_abuse'] is defined %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Substance Abuse:</strong> <span style="color: #000000;">{{ provider.healthAssessment['substance_abuse'] }}</span>
            </div>
            {% endif %}
            {% if provider.healthAssessment['job_related'] is defined %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Job Related:</strong> <span style="color: #000000;">{{ provider.healthAssessment['job_related'] }}</span>
            </div>
            {% endif %}
            {% if provider.healthAssessment['travel'] is defined %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Travel:</strong> <span style="color: #000000;">{{ provider.healthAssessment['travel'] }}</span>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# Risk Assessment #}
    {% if provider.riskAssessment is not empty %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-exclamation-triangle"></i> Risk Assessment
        </h3>
        <div class="app-details-grid">
            {% if provider.riskAssessment['substance_abuse'] is defined %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Substance Abuse:</strong> <span style="color: #000000;">{{ provider.riskAssessment['substance_abuse'] }}</span>
            </div>
            {% endif %}
            {% if provider.riskAssessment['job_related'] is defined %}
            <div class="app-detail-item" style="color: #000000; font-size: 15px;">
                <strong>Job Related:</strong> <span style="color: #000000;">{{ provider.riskAssessment['job_related'] }}</span>
            </div>
            {% endif %}
            {% if provider.riskAssessment['travel'] is defined %}
            <div class="app-detail-item">
                <strong>Travel:</strong> {{ provider.riskAssessment['travel'] }}
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>


