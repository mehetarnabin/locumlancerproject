{% set statusColors = {
    'applied': 'applied',
    'in_review': 'review',
    'interview': 'interview',
    'offered': 'offered',
    'accepted': 'accepted',
    'rejected': 'rejected',
    'hired': 'hired',
    'completed': 'completed'
} %}

{% set transitionColors = {
    'review': 'review',
    'interview': 'interview',
    'offer': 'offered',
    'hire': 'hired',
    'complete': 'completed'
} %}

<style>
/* Application Detail Content - Provider Design Style */
#application-detail-content,
.app-detail-content {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
}

/* Provider Design Pattern - Header */
.app-detail-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e6eef6;
}

.app-detail-logo-container {
    flex-shrink: 0;
}

.app-detail-logo {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    background: #F4F9F1;
    padding: 8px;
}

.app-detail-info {
    flex: 1;
    min-width: 0;
}

.app-detail-title {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 8px;
    line-height: 1.3;
}

.app-detail-company {
    font-size: 17px;
    color: #000000;
    margin-bottom: 8px;
    font-weight: 500;
}

.app-detail-location {
    font-size: 15px;
    color: #000000;
    display: flex;
    align-items: center;
    gap: 6px;
}

.app-detail-location i {
    color: #000000;
}

/* Key Metrics Grid - Provider Design Style */
.app-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
}

.app-detail-meta-item {
    background: #F4F9F1;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    display: flex;
    flex-direction: column;
}

.app-detail-meta-label {
    font-size: 14px;
    color: #000000;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.app-detail-meta-label i {
    font-size: 15px;
    color: #000000;
}

.app-detail-meta-value {
    font-size: 17px;
    color: #000000;
    font-weight: 600;
}

/* Section Styling - Provider Design Style */
.app-detail-section {
    margin-bottom: 24px;
}

.app-detail-section-title {
    font-size: 21px;
    font-weight: 700;
    color: #000000 !important;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid #85BB65;
    display: flex;
    align-items: center;
    gap: 8px;
}

.app-detail-section-title i {
    color: #000000 !important;
    font-size: 19px;
}

.app-detail-section-title * {
    color: #000000 !important;
}

.app-detail-description {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 16px;
    color: #000000;
    line-height: 1.6;
    font-size: 15px;
}

.app-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
}

.app-detail-item {
    padding: 12px;
    background: #F4F9F1;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    font-size: 15px;
    color: #000000;
}

.app-detail-item strong {
    color: #000000 !important;
    font-weight: 600;
    margin-right: 8px;
    font-size: 15px;
}

.app-detail-item {
    color: #000000 !important;
    font-size: 15px;
}

.app-detail-item * {
    color: #000000 !important;
}

.app-detail-item span {
    color: #000000 !important;
}

/* Timeline Styles - Matching Provider Design */
.timeline-events {
    padding: 0;
}

.timeline-event {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    margin-bottom: 0;
    position: relative;
}

.timeline-event:last-child {
    margin-bottom: 0;
}

.timeline-event-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f8f9fa;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 2;
}

.timeline-event-content {
    flex: 1;
    background: transparent;
    border: none !important;
    border-left: none !important;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
}

.timeline-event-title {
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin: 0 0 8px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.timeline-detail-item {
    display: flex;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 12px;
    align-items: center;
}

.timeline-detail-item:last-child {
    margin-bottom: 0;
}

.timeline-detail-label {
    color: #6b7280;
    font-weight: 500;
}

.timeline-detail-value {
    color: #121C0C;
    font-weight: 500;
}

.timeline-event-divider {
    height: 1px;
    background: #e6eef6;
    margin: 8px 0;
}

/* Timeline Panel Styles - Matching Provider Design */
.timeline-panel {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: 400px;
    max-width: 90vw;
    background: #fff;
    border-left: 1px solid #e6eef6;
    box-shadow: -2px 0 8px rgba(11,22,40,0.06);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    z-index: 10000;
    visibility: hidden;
    overflow-y: auto;
    overflow-x: hidden;
    pointer-events: none;
}

.timeline-panel.open {
    transform: translateX(0) !important;
    visibility: visible !important;
    pointer-events: auto !important;
}

.timeline-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.timeline-overlay.show {
    display: block;
    opacity: 1;
}

.timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid #e6eef6;
    font-weight: 600;
    background-color: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
}

.timeline-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #121C0C;
}

.timeline-close {
    background: transparent;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: #666;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    padding: 0;
}

.timeline-close:hover {
    background: #f5f5f5;
    color: #333;
}

.timeline-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

/* File Display */
.app-detail-file {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: #F4F9F1;
    border-radius: 8px;
    border: 1px solid #e6eef6;
    margin-bottom: 12px;
}

.app-detail-file span {
    color: #000000 !important;
}

.app-detail-file * {
    color: #000000 !important;
}

.app-detail-file .icon-image {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

/* Hover-Sensitive Accordion Styles */
.app-detail-accordion {
    margin-bottom: 12px;
}

.app-detail-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
}

.app-detail-accordion-header:hover {
    background: #e8f5e9;
    border-color: #85BB65;
}

.app-detail-accordion-header h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    color: #000000 !important;
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
}

.app-detail-accordion-header h3 i {
    color: #000000 !important;
    font-size: 19px;
}

.app-detail-accordion-toggle {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: #000000;
}

.app-detail-accordion-header.expanded .app-detail-accordion-toggle {
    transform: rotate(180deg);
}

.app-detail-accordion-content {
    background: #fff;
    border: 1px solid #e6eef6;
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 16px;
    display: none;
    overflow: hidden;
    transition: all 0.3s ease;
}

.app-detail-accordion-content.expanded {
    display: block;
}

.app-detail-accordion-content.collapsed {
    display: none;
}

/* Document Accordion (Legacy Support) */
.app-detail-content .card {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    margin-bottom: 12px;
}

.app-detail-content .card-header {
    background: #F4F9F1;
    border-bottom: 1px solid #e6eef6;
    padding: 0;
}

.app-detail-content .btn-link {
    color: #000000;
    text-decoration: none;
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    font-weight: 500;
    font-size: 15px;
}

.app-detail-content .btn-link:hover {
    color: #85BB65;
}

.app-detail-content .card-body {
    padding: 16px;
}

/* Badge Styling */
.badge-pill {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.badge.is-applied {
    background-color: #99ECFF;
    color: #000000;
}

.badge.is-review {
    background-color: #85E9FF;
    color: #000000;
}

.badge.is-interview {
    background-color: #85BB65;
    color: #ffffff;
}

.badge.is-offered {
    background-color: #5CE1FF;
    color: #000000;
}

.badge.is-hired {
    background-color: #48E1FF;
    color: #000000;
}

.badge.is-completed {
    background-color: #33DAFF;
    color: #000000;
}

/* Responsive */
@media (max-width: 768px) {
    .app-detail-meta {
        grid-template-columns: 1fr;
    }
    
    .app-details-grid {
        grid-template-columns: 1fr;
    }
}

/* Force all text in application detail to be black - override any base template styles */
.app-detail-content h3,
.app-detail-content .app-detail-section-title,
.app-detail-content .app-detail-section-title *,
.app-detail-content .app-detail-item,
.app-detail-content .app-detail-item *,
.app-detail-content .app-detail-item strong,
.app-detail-content .app-detail-item span,
.app-detail-content .app-detail-file,
.app-detail-content .app-detail-file *,
.app-detail-content .app-detail-file span {
    color: #000000 !important;
}

/* Override any green color that might be coming from base template */
#application-detail-content h3,
#application-detail-content .app-detail-section-title,
#application-detail-content .app-detail-section-title *,
#application-detail-content .app-detail-item,
#application-detail-content .app-detail-item *,
#application-detail-content .app-detail-item strong,
#application-detail-content .app-detail-item span {
    color: #000000 !important;
}

/* Hire and Complete button styling */
#hire-btn, #complete-btn {
    padding: 6px 16px !important;
    border-radius: 10px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    border: none !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
}

#hire-btn {
    background-color: #85BB65 !important;
    color: white !important;
}

#hire-btn:hover {
    background-color: #6fa050 !important;
}

#complete-btn {
    background-color: #85BB65 !important;
    color: white !important;
}

#complete-btn:hover {
    background-color: #6fa050 !important;
}

#hire-btn:disabled, #complete-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}
</style>

<div class="app-detail-content" data-application-id="{{ application.id }}" data-application-status="{{ application.status }}">
    {# Header Section - Provider Design Style #}
    <div class="app-detail-header">
        <div class="app-detail-logo-container">
            {% if provider.user.profilePicture %}
                <img src="{{ provider.user.profilePicture }}" 
                     alt="{{ provider.user.name }}" 
                     class="app-detail-logo"
                     onerror="this.src='{{ asset('assets/icons/job.png') }}'">
            {% else %}
                <img src="{{ asset('assets/icons/job.png') }}" 
                     alt="{{ provider.user.name }}" 
                     class="app-detail-logo">
            {% endif %}
        </div>
        <div class="app-detail-info" style="flex: 1;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
                <div style="flex: 1;">
                    <h1 class="app-detail-title">{{ provider.user.name }}</h1>
                    <div class="app-detail-company">{{ job.title }}</div>
                    <div class="app-detail-location">
                        <i class="fas fa-map-marker-alt"></i>
                        {% if provider.city or provider.state %}
                            {{ provider.city }}{% if provider.city and provider.state %}, {% endif %}{{ provider.state }}
                        {% else %}
                            Location not specified
                        {% endif %}
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button id="timeline-btn" class="btn btn-sm" onclick="window.openTimelinePanel && window.openTimelinePanel(); return false;" style="padding: 6px 16px; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; border: 1px solid #D8D8D8; background-color: #fff; color: #333; white-space: nowrap; display: flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 8V12L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        Timeline
                    </button>
                    {# Dynamic Next Status Button #}
                    {% set nextTransition = null %}
                    {% set nextLabel = null %}
                    
                    {% if application.status == 'applied' %}
                        {% set nextTransition = 'shortlist' %}
                        {% set nextLabel = 'Shortlist' %}
                    {% elseif application.status == 'in_review' or application.status == 'shortlisted' %}
                        {% set nextTransition = 'interview' %}
                        {% set nextLabel = 'Interview' %}
                    {% elseif application.status == 'interview' or application.status == 'interviewing' %}
                        {% set nextTransition = 'negotiate' %}
                        {% set nextLabel = 'Negotiate' %}
                    {% elseif application.status == 'offered' or application.status == 'negotiating' %}
                        {% set nextTransition = 'accept' %}
                        {% set nextLabel = 'Accept' %}
                    {% elseif application.status == 'hired' or application.status == 'accepted' %}
                        {% set nextTransition = 'complete' %}
                        {% set nextLabel = 'Complete' %}
                    {% endif %}

                    {% if nextTransition %}
                        <button id="next-status-btn" class="btn btn-sm" onclick="changeApplicationStatus('{{ nextTransition }}', '{{ application.id }}', '{{ application.job.id }}')" style="padding: 6px 16px; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; border: none; background-color: #85BB65; color: white; white-space: nowrap;">
                            {{ nextLabel }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Key Metrics Grid - Provider Design Style #}
    <div class="app-detail-meta">
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-clock"></i> Applied Date
            </div>
            <div class="app-detail-meta-value">{{ application.createdAt|date('m/d/Y') }}</div>
        </div>
        
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-star"></i> Rating
            </div>
            <div class="app-detail-meta-value">{{ application.provider.averagePoint ? application.provider.averagePoint : 'Not Rated' }}</div>
        </div>
        
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-info-circle"></i> Status
            </div>
            <div class="app-detail-meta-value">
                <span class="badge badge-pill" style="font-size: 12px; padding: 6px 12px; background: {% if application.status == 'interview' or application.status == 'interviewing' %}#85BB65{% else %}#10b981{% endif %}; color: #fff; border: none; border-radius: 12px; display: inline-block;">
                    {% if application.status == 'in_review' %}
                        Negotiating
                    {% else %}
                        {{ application.status | replace({'_': ' '}) | title }}
                    {% endif %}
                </span>
            </div>
        </div>
        
        {% if provider.phoneMobile %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneMobile }}</div>
        </div>
        {% elseif provider.phoneWork %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneWork }}</div>
        </div>
        {% elseif provider.phoneHome %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-phone"></i> Phone
            </div>
            <div class="app-detail-meta-value">{{ provider.phoneHome }}</div>
        </div>
        {% endif %}
        
        {% if provider.user.email %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-envelope"></i> Email
            </div>
            <div class="app-detail-meta-value" style="font-size: 15px; word-break: break-word; color: #000000;">{{ provider.user.email }}</div>
        </div>
        {% endif %}
        
        {% if application.interviews|length > 0 %}
        {% set nextInterview = application.interviews|first %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-calendar-check"></i> Next Interview
            </div>
            <div class="app-detail-meta-value">
                {{ nextInterview.date|date('m/d/Y H:i') }}
                {% if nextInterview.meetingPlatform %}
                    <div style="font-size: 12px; color: #666; font-weight: 500;">Via {{ nextInterview.meetingPlatform }}</div>
                {% endif %}
                {% if nextInterview.meetingUrl %}
                    <div style="font-size: 12px;"><a href="{{ nextInterview.meetingUrl }}" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: 500;">Join Meeting</a></div>
                {% endif %}
            </div>
        </div>
        {% elseif application.interview and application.interview.date %}
        <div class="app-detail-meta-item">
            <div class="app-detail-meta-label">
                <i class="fas fa-calendar-check"></i> Interview
            </div>
            <div class="app-detail-meta-value">{{ application.interview.date|date('m/d/Y H:i') }}</div>
        </div>
        {% endif %}
    </div>


    {# CV #}
    {% if provider.cvFilename %}
    <div class="app-detail-section">
        <h3 class="app-detail-section-title">
            <i class="fas fa-file-pdf"></i> CV
        </h3>
    <div class="app-detail-file">
        <a href="#" class="cv-toggle-btn" data-bs-toggle="modal" data-bs-target="#cvModal-{{ provider.id }}" style="cursor: pointer; display: flex; align-items: center; gap: 12px; text-decoration: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-image" style="stroke: #000000;">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span style="color: #000000; font-size: 15px;">{{ provider.cvFilename }}</span>
        </a>
    </div>

    <!-- CV Modal -->
    <div class="modal fade" id="cvModal-{{ provider.id }}" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document" style="max-width: 90vw;">
            <div class="modal-content" style="height: 90vh;">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" style="margin: 0;">{{ provider.cvFilename }}</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="border: none; background: none; padding: 4px; cursor: pointer;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body" style="padding: 0; height: calc(100% - 60px);">
                    {% set relativePath = 'uploads/' ~ provider.user.id ~ '/' ~ provider.cvFilename %}
                    {% set filePath = asset(relativePath) %}
                    
                    {% if file_exists(relativePath) %}
                        {% if provider.cvFilename ends with '.pdf' %}
                            <iframe src="{{ filePath }}" width="100%" height="100%" style="border: none;"></iframe>
                        {% else %}
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                                <p style="color: #000000; margin-bottom: 12px; font-size: 16px;"><strong>This file type cannot be previewed directly in the modal.</strong></p>
                                <a href="{{ filePath }}" class="btn btn-primary" target="_blank" download style="background: #85BB65; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; text-decoration: none; display: inline-block;">
                                    <i class="fas fa-download"></i> Download {{ provider.cvFilename }}
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
