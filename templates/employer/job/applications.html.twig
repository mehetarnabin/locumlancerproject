/* Action Buttons */
.action-btn {
    background: transparent;
    border: 1px solid #e6eef6;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    border-radius: 10px;
    padding: 4px 12px;
    display: flex;
    gap: 6px;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.action-btn:hover, .dropdown-cstm:hover {
    color: #85BB65;
    border: 1px solid #85BB65;
    transition: all 0.2s ease;
}

.action-btn:hover svg {
    color: #85BB65;
}

/* Filter Panel */
.custom-dropdown {
    position: absolute !important;
    top: 110% !important;
    left: 0 !important;
    background: #fff;
    padding: 10px;
    min-width: 150px;
    z-index: 1000 !important;
    border: 1px solid #e6eef6;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    border-radius: 10px;
}

#filter-panel.filter-panel.custom-dropdown {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    margin-top: 8px !important;
    z-index: 9999 !important;
    overflow: visible !important;
    background: #fff !important;
    border: 1px solid #e6eef6 !important;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03) !important;
    border-radius: 10px !important;
    padding: 0 !important;
    min-width: 280px !important;
}

#filter-panel.filter-panel.custom-dropdown > div {
    padding: 16px !important;
}

#filter-panel .form-control {
    border: 1px solid #e6eef6;
    border-radius: 6px;
    width: 100%;
    box-sizing: border-box;
}

#filter-panel .form-control:focus {
    border-color: #85BB65;
    outline: none;
    box-shadow: 0 0 0 2px rgba(133, 187, 101, 0.1);
}

.hidden {
    display: none !important;
}

#filter-panel.filter-panel.custom-dropdown:not(.hidden) {
    display: block !important;
}

/* Split View Styles */
.split-view-container {
    display: none;
    grid-template-columns: minmax(350px, 1fr) 1.5fr;
    gap: 20px;
    margin-top: 20px;
    height: calc(100vh - 300px);
    min-height: 600px;
    position: relative;
}

.split-view-container.list-collapsed {
    grid-template-columns: 1fr !important;
    gap: 0 !important;
}

.split-view-container.list-collapsed > .split-job-list {
    display: none !important;
}

.split-view-container.list-collapsed > .split-job-details {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
}

.split-view-container .split-job-list {
    width: 100%;
    height: 100%;
    max-height: 100%;
    opacity: 1;
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    min-height: 0;
    scrollbar-width: thin;
    -ms-overflow-style: auto;
}

.split-job-list::-webkit-scrollbar {
    display: block;
    width: 8px;
}

.split-job-list::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.split-job-list::-webkit-scrollbar-thumb {
    background: #85BB65;
    border-radius: 4px;
}

.split-job-list::-webkit-scrollbar-thumb:hover {
    background: #6FA050;
}

.split-job-details {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 20px;
    padding-left: 20px;
    overflow-y: auto;
    overflow-x: visible;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

