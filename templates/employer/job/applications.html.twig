                                {% set todoTask = 'Confirm interview from the list of interview dates' %}
                            {% elseif statusLower == 'negotiating' %}
                                {% set todoTask = 'Review signed offer/contract' %}
                            {% elseif statusLower == 'accepted' %}
                                {% set todoTask = 'Request Credentialing Docs' %}
                            {% elseif statusLower == 'completed' %}
                                {% set todoTask = 'See your review' %}
                            {% endif %}
                            {% if application.documentProvidedAt %}{% set sentItems = sentItems|merge(['Document']) %}{% endif %}
                            {% if application.oneFileProvidedAt %}{% set sentItems = sentItems|merge(['OneFile']) %}{% endif %}
                            {% if application.contractSignedAt %}{% set sentItems = sentItems|merge(['Contract Signed']) %}{% elseif application.contractSentAt %}{% set sentItems = sentItems|merge(['Contract Sent']) %}{% endif %}
                            <div class="split-job-card" data-application-id="{{ application.id }}" data-job-id="{{ job.id }}">
                                <div class="split-job-card-header">
                                    <input type="checkbox" class="job-checkbox" data-application-id="{{ application.id }}" data-job-id="{{ job.id }}" data-status="{{ application.status }}" style="margin-top: 2px;">
                                    {% if provider.user.profilePicture %}
                                        <img src="{{ provider.user.profilePicture }}" alt="Profile" class="split-job-card-logo" />
                                    {% else %}
                                        <div class="split-job-card-logo" style="background: #e6eef6; display: flex; align-items: center; justify-content: center; color: #666; font-weight: 600;">{{ user.name|first|upper }}</div>
                                    {% endif %}
                                    <div class="flex-grow-1">
                                        <div class="split-job-card-title">{{ user.name }}</div>
                                        <div class="split-job-card-company">{{ provider.city }}, {{ provider.state }}</div>
                                    </div>
                                    <div class="d-flex align-items-center" style="gap:8px;">
                                        <div class="todo-icon-wrapper" title="{{ todoTask ?: 'Add To-Do' }}" data-application-id="{{ application.id }}" data-job-id="{{ job.id }}" data-status="{{ application.status }}" data-todo-action="{{ todoTask }}" onclick="return handleEmployerTodoIconClick(event, this)">
                                            {% set todoIconType = 'documents' %}
                                            {% if todoTask %}
                                                {% if 'Revisit Alert' in todoTask %}
                                                    {% set todoIconType = 'alert' %}
                                                {% elseif 'Open Response' in todoTask %}
                                                    {% set todoIconType = 'response' %}
                                                {% elseif 'interview' in todoTask|lower %}
                                                    {% set todoIconType = 'interview' %}
                                                {% elseif 'contract' in todoTask|lower or 'offer' in todoTask|lower %}
                                                    {% set todoIconType = 'contract' %}
                                                {% elseif 'Credentialing' in todoTask %}
                                                    {% set todoIconType = 'credentialing' %}
                                                {% elseif 'review' in todoTask|lower %}
                                                    {% set todoIconType = 'review' %}
                                                {% endif %}
                                            {% endif %}
                                            <div class="todo-icon" data-todo-icon-type="{{ todoIconType }}">
                                                {% if todoIconType == 'alert' %}
                                                    {# Bell icon for Revisit Alert #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                {% elseif todoIconType == 'response' %}
                                                    {# Envelope icon for Open Response #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                {% elseif todoIconType == 'interview' %}
                                                    {# Calendar icon for Confirm interview #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    </svg>
                                                {% elseif todoIconType == 'contract' %}
                                                    {# Document/File icon for Review contract #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                        <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    </svg>
                                                {% elseif todoIconType == 'credentialing' %}
                                                    {# Shield/Check icon for Credentialing Docs #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                {% elseif todoIconType == 'review' %}
                                                    {# Star icon for See your review #}
                                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                {% else %}
                                                    {# Default document icon - match provider _application_list.html.twig #}
                                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M4 6C4 5.44772 4.44772 5 5 5H9.58579C9.851 5 10.1054 5.10536 10.2929 5.29289L12 7H19C19.5523 7 20 7.44772 20 8V18C20 18.5523 19.5523 19 19 19H5C4.44772 19 4 18.5523 4 18V6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                                        <path d="M4 8H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                                        <path d="M16 12L18 14L21 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="provider-sent-icons" title="{{ sentItems|length > 0 ? ('Sent: ' ~ sentItems|join(', ')) : 'No items sent yet' }}" style="display:flex;align-items:center;gap:6px;" onclick="openEmployerDocsModal('{{ application.id }}'); return false;">
                                            {% if application.documentProvidedAt %}
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#10b981;">
                                                    <path d="M6 2H14L18 6V20C18 20.5523 17.5523 21 17 21H6C5.44772 21 5 20.5523 5 20V3C5 2.44772 5.44772 2 6 2Z" stroke="currentColor" stroke-width="1.5"/>
                                                    <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            {% endif %}
                                            {% if application.oneFileProvidedAt %}
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#10b981;">
                                                    <path d="M12 5V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <path d="M7 9V15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <path d="M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                </svg>
                                            {% endif %}
                                            {% if application.contractSignedAt %}
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#10b981;">
                                                    <path d="M4 5H14C15.6569 5 17 6.34315 17 8V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <path d="M17 19L14 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <path d="M9 11L11 13L15 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            {% elseif application.contractSentAt %}
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#f59e0b;">
                                                    <path d="M4 5H14C15.6569 5 17 6.34315 17 8V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <path d="M17 19L14 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                </svg>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="split-job-summary">
                                    <div class="split-job-summary-item">
                                        <span class="split-job-meta-label">Status:</span>
                                        <span class="split-job-meta-value">
                                            {% if application.status == 'in_review' %}
                                                Shortlisted
                                            {% else %}
                                                {{ application.status | replace({'_': ' '}) | title }}
                                            {% endif %}
                                        </span>
                                    </div>
                                    <div class="split-job-summary-item">
                                        <span class="split-job-meta-label">Applied:</span>
                                        <span class="split-job-meta-value">{{ application.createdAt|time_diff }}</span>
                                    </div>
                                    {% if application.interviews|length > 0 %}
                                        <div class="split-job-summary-item" style="display: block; margin-top: 8px; border-top: 1px solid #f3f4f6; padding-top: 8px;">
                                            <div class="split-job-meta-label" style="width: 100%; margin-bottom: 4px;">Scheduled Interview(s):</div>
                                            {% for interview in application.interviews %}
                                                <div style="margin-bottom: 8px; font-size: 13px; background: #f9fafb; padding: 6px; border-radius: 6px;">
                                                    <div style="display: flex; justify-content: space-between; font-weight: 500;">
                                                        <span>{{ interview.date|date('M d, Y') }}</span>
                                                        <span>{{ interview.date|date('h:i A') }}</span>
                                                    </div>
                                                    {% if interview.meetingPlatform %}
                                                        <div style="color: #4b5563; font-size: 12px;">Via {{ interview.meetingPlatform }}</div>
                                                    {% endif %}
                                                    {% if interview.meetingUrl %}
                                                        <div style="margin-top: 2px;"><a href="{{ interview.meetingUrl }}" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: 500;">Join Meeting</a></div>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
                
                <!-- Right Side: Application Details -->
                <div class="split-job-details" id="split-job-details">
                    <!-- Action Buttons at Top Right (Provider Design Style) -->
                    <div id="detail-action-buttons" class="detail-action-buttons">
                        <button id="detail-note-btn" class="action-btn" title="Add Note">
                            <svg class="icon-image" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8 3H14C16.7614 3 19 5.23858 19 8V14.5C19 15.0523 18.5523 15.5 18 15.5H14C12.3431 15.5 11 16.8431 11 18.5V20C11 20.5523 10.5523 21 10 21H8C5.23858 21 3 18.7614 3 16V8C3 5.23858 5.23858 3 8 3Z" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M21 7L15 13L14 16L17 15L23 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Note</span>
                        </button>
                    </div>
                    
                    <div class="split-job-details-content">
                        <div class="no-job-selected">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8 12H16M8 16H16M8 8H12M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            <h4>Select an application to view details</h4>
                            <p>Click on any application from the list to see its full details here.</p>
                        </div>
                        
                        <!-- Application details will be dynamically loaded here -->
                        <div id="application-detail-content" style="{{ applicationDetail ? 'display: block;' : 'display: none;' }}">
                            {% if applicationDetail %}
                                {% include 'employer/job/_applications_maindetail.html.twig' with {'application': applicationDetail} %}
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Notes Panel -->
                    <aside id="notes-panel" class="notes-panel" aria-hidden="true">
                        <div class="notes-panel-header">
                            <span>Notes</span>
                            <button type="button" class="notes-panel-close" onclick="closeNotesPanel()">×</button>
                        </div>
                        <div class="notes-panel-body">
                            <div class="notes-title">
                                <h6>Add notes for this application</h6>
                                <p class="text-muted">Your notes are saved automatically and only visible to you.</p>
                            </div>
                            <textarea id="notes-textarea" class="notes-textarea" placeholder="Write your notes here..."></textarea>
                            <div class="notes-footer">
                                <div class="last-saved" style="display: none;">
                                    Last saved <span class="last-saved-time"></span>
                                </div>
                            </div>
                        </div>
                    </aside>

                    <!-- Timeline Panel -->
                    <aside id="timeline-panel" class="timeline-panel" aria-hidden="true">
                        <div class="timeline-header">
                            <h6 class="timeline-title">Application Timeline</h6>
                            <button type="button" class="timeline-close" onclick="closeTimelinePanel()">×</button>
                        </div>
                        <div class="timeline-body">
                            <div id="timeline-content">
                                <p class="text-muted">Loading timeline...</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </div>

    <!-- To-Do Modal -->
    <div class="modal fade" id="todoModal" tabindex="-1" role="dialog" aria-labelledby="todoModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative;">
                    <h5 class="modal-title" id="todoModalLabel">Add To-Do</h5>
                    <button type="button" class="close-modal-absolute" aria-label="Close" onclick="window.closeEmployerModal('todoModal')" style="position: absolute; right: 15px; top: 15px; background: none; border: none; cursor: pointer; padding: 5px; z-index: 1060; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: background 0.2s;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: #666;">
                            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <!-- Hover effect script -->
                    <script>
                        (function(){
                            var btn = document.currentScript.previousElementSibling;
                            btn.onmouseenter = function(){ this.style.backgroundColor = 'rgba(0,0,0,0.05)'; this.querySelector('svg').style.color = '#000'; };
                            btn.onmouseleave = function(){ this.style.backgroundColor = 'transparent'; this.querySelector('svg').style.color = '#666'; };
                        })();
                    </script>
                </div>
                <div class="modal-body">
                    <p>Select a task to assign to the provider:</p>
                    <div id="todo-options" class="list-group"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="window.closeEmployerModal('todoModal')">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Send Contract Modal -->
    <div class="modal fade" id="contractModal" tabindex="-1" role="dialog" aria-labelledby="contractModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" id="contractModalLabel" style="margin: 0;">Send Contract</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="window.closeEmployerModal('contractModal')" style="border: none; background: none; padding: 4px; margin: 0; opacity: 0.5; transition: opacity 0.2s; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
                {% if applicationDetail %}
                <form method="post" action="{{ path('app_employer_application_sendcontract', {'id': applicationDetail.id}) }}" enctype="multipart/form-data">
                {% else %}
                <form method="post" action="#" enctype="multipart/form-data" id="contractForm">
                {% endif %}
                <div class="modal-body">
                    <div class="form-group">
                        <input type="file" name="contractFile" required />
                    </div>
                </div>
                <div class="modal-footer">
{#                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>#}
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Review Modal -->
    <div class="modal fade" id="reviewModal" tabindex="-1" role="dialog" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" id="reviewModalLabel" style="margin: 0;">Write a Review</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="window.closeEmployerModal('reviewModal')" style="border: none; background: none; padding: 4px; margin: 0; opacity: 0.5; transition: opacity 0.2s; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
                {% if applicationDetail %}
                <form method="post" action="{{ path('app_employer_application_review_provider', {'id': applicationDetail.id}) }}">
                {% else %}
                <form method="post" action="#" id="reviewForm">
                {% endif %}
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label for="message">Message</label>
                            <textarea name="message" class="form-control" required></textarea>
                        </div>

                        {% for label, name in {
                            'Professionalism': 'professionalism',
                            'Quality of Care': 'quality',
                            'Communication': 'communication',
                            'Emotional Intelligence': 'emotional_intelligence'
                        } %}
                            <div class="form-group mb-3">
                                <label>{{ label }}</label>
                                <div class="star-rating">
                                    {% for i in 5..1 %}
                                        <input type="radio" name="{{ name }}" id="{{ name }}-star-{{ i }}" value="{{ i }}" required>
                                        <label for="{{ name }}-star-{{ i }}">★</label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit Review</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Request Document Modal -->
    <div class="modal fade" id="askDocumentModal" tabindex="-1" role="dialog" aria-labelledby="askDocumentLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" id="askDocumentLabel" style="margin: 0;">Request Document</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="window.closeEmployerModal('askDocumentModal')" style="border: none; background: none; padding: 4px; margin: 0; opacity: 0.5; transition: opacity 0.2s; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <form action="{{ path('app_employer_application_askfordocument', {'id': applicationDetail.id}) }}" method="POST"> <!-- Change action URL as needed -->
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="documentName" class="form-label">Document Name</label>
                            <input type="text" class="form-control" id="documentName" name="document_name" required>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Send Request</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- Schedule Interview Modal -->
    <div class="modal fade" id="interviewModal" tabindex="-1" role="dialog" aria-labelledby="interviewLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding: 1rem;">
                    <h5 class="modal-title" id="interviewLabel" style="margin: 0;">Schedule Interview</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="window.closeEmployerModal('interviewModal')" style="border: none; background: none; padding: 4px; margin: 0; opacity: 0.5; transition: opacity 0.2s; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 6L18 18" stroke="#1e293b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <form id="scheduleInterviewForm" action="{{ path('app_employer_application_scheduleinterview', {'id': applicationDetail.id}) }}" method="POST">
