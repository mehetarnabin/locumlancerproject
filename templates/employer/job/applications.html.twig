    <script>
    // Define loadApplicationDetails function in global scope
    function loadApplicationDetails(applicationId) {
        if (!applicationId) return;
        
        const applicationDetailContent = document.getElementById('application-detail-content');
        const noApplicationSelected = document.querySelector('.no-job-selected');
        const detailNoteBtn = document.getElementById('detail-note-btn');
        
        // Show note button
        if (detailNoteBtn) {
            detailNoteBtn.style.display = 'flex';
        }
        
        // Show loading state
        if (applicationDetailContent) {
            applicationDetailContent.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5 class="text-muted">Loading Application Details</h5>
                </div>
            `;
            applicationDetailContent.style.display = 'block';
        }
        if (noApplicationSelected) noApplicationSelected.style.display = 'none';
        
        // Update URL without reload
        const url = window.location.pathname + '?applicationId=' + applicationId;
        window.history.pushState({}, '', url);
        
        // Load application details via AJAX
        const jobId = '{{ job.id }}';
        const detailUrl = `/employer/jobs/${jobId}/applications/${applicationId}/detail`;
        
        fetch(detailUrl, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            }
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    throw new Error(`HTTP ${response.status}: ${text.substring(0, 100)}`);
                });
            }
            return response.text();
        })
        .then(html => {
            if (applicationDetailContent) {
                applicationDetailContent.innerHTML = html;
                applicationDetailContent.style.display = 'block';

                // Extract transition buttons from loaded content and add to top right (excluding reject)
                const loadedContent = applicationDetailContent.querySelector('.app-detail-content');
                if (loadedContent && detailActionButtons) {
                    // Find and remove the action buttons section from content
                    const actionSection = loadedContent.querySelector('.app-detail-section');
                    if (actionSection) {
                        const actionActions = actionSection.querySelector('.app-detail-actions');
                        if (actionActions) {
                            // Clear existing transition buttons (except note button)
                            const existingButtons = detailActionButtons.querySelectorAll('.action-btn:not(#detail-note-btn)');
                            existingButtons.forEach(btn => btn.remove());
                            
                            const transitionButtons = actionActions.querySelectorAll('a');
                            transitionButtons.forEach(btn => {
                                // Skip reject buttons
                                const btnText = btn.textContent.trim().toLowerCase();
