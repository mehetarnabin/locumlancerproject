    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
}

.split-job-details.notes-open::-webkit-scrollbar,
.split-job-details.timeline-open::-webkit-scrollbar {
    display: none !important;
}

.split-job-card {
    background: white;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.split-job-card:hover {
