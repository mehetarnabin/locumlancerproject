  }
  
  if (card && typeof showTodoModalForApplication === 'function') {
    showTodoModalForApplication(card);
  }
  return false;
}

function openEmployerDocsModal(appId) {
  try {
    var modalEl = document.getElementById('assignedDocsModal');
    if (!modalEl) {
      modalEl = document.createElement('div');
      modalEl.className = 'modal fade';
      modalEl.id = 'assignedDocsModal';
      modalEl.tabIndex = -1;
      modalEl.setAttribute('role', 'dialog');
      modalEl.setAttribute('aria-labelledby', 'assignedDocsLabel');
      modalEl.setAttribute('aria-hidden', 'true');
      modalEl.innerHTML = '<div class="modal-dialog modal-xl" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="assignedDocsLabel">Documents</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body" style="display:flex; gap:12px; align-items: stretch;"><div style="width:280px; flex-shrink:0;"><ul id="assignedDocsList" class="list-group"></ul></div><div style="flex:1;"><iframe id="assignedDocPreview" style="width:100%; height:70vh; border:1px solid #e6eef6; border-radius:10px;" src=""></iframe></div></div></div></div>';
      document.body.appendChild(modalEl);
    }
    
    // Open modal immediately
    window.openEmployerModal('assignedDocsModal');

    // Fetch documents
    var listEl = document.getElementById('assignedDocsList');
    var iframeEl = document.getElementById('assignedDocPreview');
    if (listEl) listEl.innerHTML = '<li class="list-group-item text-center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> Loading...</li>';
    if (iframeEl) iframeEl.src = '';
    
    fetch('{{ path("app_employer_application_document_requests", {"id": "PLACEHOLDER_ID"}) }}'.replace('PLACEHOLDER_ID', appId), {
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
    }).then(function(r){ return r.json(); }).then(function(data){
        if (listEl) listEl.innerHTML = '';
        var items = [];
        if (data && data.contractUrl) {
            items.push({ name: 'Contract', url: data.contractUrl });
        }
        var reqs = (data && data.documentRequests) ? data.documentRequests : [];
        reqs.forEach(function(dr){
            var name = dr && dr.name ? dr.name : ((dr && dr.document && dr.document.name) ? dr.document.name : 'Document');
            var url = (dr && dr.document && dr.document.url) ? dr.document.url : null;
            items.push({ name: name, url: url, pending: !url });
        });
        
        var sent = items.filter(function(it){ return !!it.url; });
        if (sent.length === 0) {
            if (listEl) {
                var li = document.createElement('li');
                li.className = 'list-group-item text-muted';
                li.textContent = 'No documents provided yet';
                listEl.appendChild(li);
            }
        } else {
            sent.forEach(function(it, idx){
                var li = document.createElement('li');
                li.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                li.style.cursor = 'pointer';
                var eyeSvg = '<svg class="icon-image" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 12C2 12 5 5 12 5C19 5 22 12 22 12C22 12 19 19 12 19C5 19 2 12 2 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
                li.innerHTML = '<span class="doc-name">' + it.name + '</span><a href="' + it.url + '" target="_blank" class="btn btn-sm btn-link text-primary ms-2" title="Open in new tab" style="padding: 0 4px;">' + eyeSvg + '</a>';
                
                li.addEventListener('click', function(e){
                    if (e.target && e.target.closest('a')) return;
                    // Highlight active
                    listEl.querySelectorAll('.list-group-item').forEach(i => i.classList.remove('active'));
                    li.classList.add('active');
                    if (iframeEl) iframeEl.src = it.url;
                });
                
                // Open first item by default
                if (idx === 0 && iframeEl) {
                    iframeEl.src = it.url;
                    li.classList.add('active');
                }
                
                listEl.appendChild(li);
            });
        }
    }).catch(function(err){
        if (listEl) listEl.innerHTML = '<li class="list-group-item text-danger">Failed to load documents</li>';
        console.error(err);
    });
  } catch(_) {}
}
