                        ensureSplitViewButtons();
                    }
                }, 150);
                
                // Initialize accordions after content is loaded in split view
                // Use the same initialization pattern as detail page
                setTimeout(function() {
                    const loadedContent = applicationDetailContent.querySelector('.app-detail-content');
                    const targetContainer = loadedContent || applicationDetailContent;
                    
                    if (targetContainer && typeof window.initializeAccordions === 'function') {
                        window.initializeAccordions(targetContainer);
                    } else {
                        // Fallback: wait a bit more for the function to be available
                        setTimeout(function() {
                            const loadedContent2 = applicationDetailContent.querySelector('.app-detail-content');
                            const targetContainer2 = loadedContent2 || applicationDetailContent;
                            if (targetContainer2 && typeof window.initializeAccordions === 'function') {
                                window.initializeAccordions(targetContainer2);
                            }
                        }, 200);
                    }
                }, 300);

                // Extract transition buttons from loaded content and add to top right (excluding reject)
                const loadedContent = applicationDetailContent.querySelector('.app-detail-content');
                if (loadedContent && detailActionButtons) {
                    // Find and remove the action buttons section from content
                    const actionSection = loadedContent.querySelector('.app-detail-section');
                    if (actionSection) {
                        const actionActions = actionSection.querySelector('.app-detail-actions');
                        if (actionActions) {
                            // Clear existing transition buttons (except note button)
                            const existingButtons = detailActionButtons.querySelectorAll('.action-btn:not(#detail-note-btn)');
                            existingButtons.forEach(btn => btn.remove());
                            
                            const transitionButtons = actionActions.querySelectorAll('a');
                            transitionButtons.forEach(btn => {
                                // Skip reject buttons
                                const btnText = btn.textContent.trim().toLowerCase();
                                if (btn.classList.contains('is-reject') || btn.classList.contains('is-rejected') || 
                                    btnText === 'reject') {
                                    return;
                                }
                                
                                // Clone and style button for top right
                                const newBtn = btn.cloneNode(true);
                                newBtn.className = 'action-btn';
                                newBtn.style.display = 'flex';
                                newBtn.style.cursor = 'pointer';
                                newBtn.style.padding = '4px 12px';
                                newBtn.style.borderRadius = '10px';
                                newBtn.style.border = '1px solid #e6eef6';
                                newBtn.style.boxShadow = '0 2px 6px rgba(11,22,40,0.03)';
                                newBtn.style.background = '#fff';
                                newBtn.style.alignItems = 'center';
                                newBtn.style.gap = '6px';
                                newBtn.style.fontSize = '13px';
