            if (sidebar.style.display === 'none' || !sidebar.style.display) {
                sidebar.style.display = 'block';
            } else {
                sidebar.style.display = 'none';
            }
        }
    }
    
    // Make function available globally
    window.toggleSearchSidebar = toggleSearchSidebar;

    // Toggle Filter Panel
    function toggleFilterPanel(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        const panel = document.getElementById('filter-panel');
        if (panel) {
            if (panel.style.display === 'none' || !panel.style.display) {
                panel.style.display = 'block';
                panel.classList.remove('hidden');
            } else {
                panel.style.display = 'none';
                panel.classList.add('hidden');
            }
        }
    }
    
    // Make function available globally
    window.toggleFilterPanel = toggleFilterPanel;

    // Close filter panel when clicking outside
    document.addEventListener('click', function(event) {
        const filterBtn = document.getElementById('filter-btn');
        const filterPanel = document.getElementById('filter-panel');
        
        if (filterPanel && filterBtn && !filterPanel.contains(event.target) && !filterBtn.contains(event.target)) {
            filterPanel.style.display = 'none';
            filterPanel.classList.add('hidden');
        }
    });

    // Update Action Buttons based on Application Status
    function updateActionButtons() {
        // Hide all conditional action buttons first
        document.querySelectorAll('.conditional-btn').forEach(function(btn) {
            btn.style.display = 'none';
        });

        {% if applicationDetail %}
            const status = '{{ applicationDetail.status|lower }}';
            
            if (status === 'applied') {
                const btn = document.getElementById('action-request-file-btn');
                if (btn) btn.style.display = 'flex';
            } else if (status === 'in_review' || status === 'shortlisted') {
                const btn = document.getElementById('action-schedule-interview-btn');
                if (btn) btn.style.display = 'flex';
            } else if (status === 'interview' || status === 'interviewing') {
                const btn = document.getElementById('action-request-documents-btn');
                if (btn) btn.style.display = 'flex';
            } else if (status === 'offered' || status === 'negotiating') {
                const offerBtn = document.getElementById('action-send-offer-btn');
                const contractBtn = document.getElementById('action-send-contract-btn');
                if (offerBtn) offerBtn.style.display = 'flex';
                if (contractBtn) contractBtn.style.display = 'flex';
            } else if (status === 'accepted' || status === 'hired') {
                const btn = document.getElementById('action-send-credential-btn');
                if (btn) btn.style.display = 'flex';
            } else if (status === 'completed') {
                const btn = document.getElementById('action-write-review-btn');
                if (btn) btn.style.display = 'flex';
            }
        {% endif %}
    }

    // Call updateActionButtons when page loads
    document.addEventListener('DOMContentLoaded', function() {
        updateActionButtons();
    });

    // Also update when application detail is loaded via AJAX
    if (typeof loadApplicationDetails !== 'undefined') {
        const originalLoadApplicationDetails = loadApplicationDetails;
        loadApplicationDetails = function(applicationId) {
            originalLoadApplicationDetails(applicationId);
            setTimeout(updateActionButtons, 500);
        };
    }
    </script>


    {# Ensure we have the base URL for the review route available in JS #}
    <script>
        const reviewRouteBase = "{{ path('app_employer_application_review_provider', {'id': '00000000-0000-0000-0000-000000000000'}) }}";
        
        if (!window.handleEmployerTodoIconClick) window.handleEmployerTodoIconClick = function(event, element) {
            console.log('Todo icon clicked', element);
            
            // Allow default behavior if it's just a tooltip click or something unrelated
            // But usually we want to control the action
            
            const todoAction = element.getAttribute('data-todo-action');
            const applicationId = element.getAttribute('data-application-id');
            const status = element.getAttribute('data-status');
            
            if (!todoAction) return true;
            
            console.log('Action:', todoAction, 'App ID:', applicationId);
            
            // Check if it's a review action
            if (todoAction.toLowerCase().includes('review')) {
                event.preventDefault();
                event.stopPropagation();
                
                if (!applicationId) {
                    console.error('No application ID found for review action');
                    return false;
                }
                
                // Construct the correct URL
                const actionUrl = reviewRouteBase.replace('00000000-0000-0000-0000-000000000000', applicationId);
                
                // Find the modal and form
                const reviewModal = document.getElementById('reviewModal');
                if (reviewModal) {
                    const form = reviewModal.querySelector('form');
                    if (form) {
                        form.action = actionUrl;
                    }
                    
                    // Show the modal
                    // Check if Bootstrap 5 is available
                    if (window.bootstrap && window.bootstrap.Modal) {
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(reviewModal);
                        modalInstance.show();
                    } else if (typeof $ !== 'undefined' && $(reviewModal).modal) {
                         // Fallback to jQuery/Bootstrap 4 if available
                        $(reviewModal).modal('show');
                    } else {
                        // Fallback manual show
                        reviewModal.classList.add('show');
                        reviewModal.style.display = 'block';
                        document.body.classList.add('modal-open');
                        
                        // Add backdrop if needed
                        if (!document.querySelector('.modal-backdrop')) {
                            const backdrop = document.createElement('div');
                            backdrop.className = 'modal-backdrop fade show';
                            document.body.appendChild(backdrop);
                        }
                    }
                }
                
                return false;
            }
            
            // For other actions, let them proceed (e.g., if they are links or have other handlers)
            // If they are strictly purely "To Do" indicators, we might want to do nothing or show a toast
            
            return true;
        };
        
        // Helper to close modals manually if needed
        window.closeEmployerModal = function(modalId) {
            const modalEl = document.getElementById(modalId);
            if (modalEl) {
                if (window.bootstrap && window.bootstrap.Modal) {
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                } else if (typeof $ !== 'undefined' && $(modalEl).modal) {
                    $(modalEl).modal('hide');
                } else {
                     modalEl.classList.remove('show');
                     modalEl.style.display = 'none';
                     document.body.classList.remove('modal-open');
                     const backdrop = document.querySelector('.modal-backdrop');
                     if (backdrop) backdrop.remove();
                }
            }
        };
    </script>
{% endblock %}

