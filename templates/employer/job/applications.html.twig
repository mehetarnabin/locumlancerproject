                      }
                  } catch(_){}
              }
          }, 50);
          // Attach close handler using our universal function
          var closeBtn = m.querySelector('[data-bs-dismiss="modal"], [data-dismiss="modal"], .btn-close, .close');
          if (closeBtn) {
              try {
                  closeBtn.setAttribute('onclick', 'closeModal(\'' + (m.id || 'modal') + '\'); return false;');
                  // Also add event listener as backup
                  closeBtn.addEventListener('click', function(e){
                      e.preventDefault();
                      e.stopPropagation();
                      if (m.id) {
                          closeModal(m.id);
                      } else {
                          m.classList.remove('show');
                          m.style.display = 'none';
                          document.body.classList.remove('modal-open');
                          var b = document.querySelector('.modal-backdrop');
                          if (b && b.parentElement) b.parentElement.removeChild(b);
                      }
                  });
              } catch(_){}
          }
          
          // Re-attach handlers for dynamically created modals
          if (typeof attachCloseHandlers === 'function') {
              setTimeout(attachCloseHandlers, 100);
          }
      }
  }

  if (iconType === 'review' || actionText.toLowerCase().includes('review')) {
      fetch(reviewDetailsUrl)
        .then(r => r.json())
        .then(data => {
            if (data.success && data.hasReview) {
                // Populate and show read-only modal
                var m = document.getElementById('reviewModal');
                if (m) {
                    m.querySelector('.modal-title').textContent = 'Your Review';
                    var f = m.querySelector('form');
                    if (f) {
                        // Populate fields
                        var msg = f.querySelector('[name="message"]');
                        if (msg) { msg.value = data.review.message; msg.disabled = true; }
                        
                        // Populate stars
                        ['professionalism', 'quality', 'communication', 'emotional_intelligence'].forEach(k => {
                            var val = data.review[k];
                            if (val) {
                                var radio = f.querySelector(`input[name="${k}"][value="${val}"]`);
                                if (radio) radio.checked = true;
                            }
                            // Disable all radios
                            f.querySelectorAll(`input[name="${k}"]`).forEach(r => r.disabled = true);
                        });
                        
                        // Hide submit button
                        var btn = m.querySelector('button[type="submit"]');
                        if (btn) btn.style.display = 'none';
                    }
                    openModal('reviewModal');
                }
            } else {
                // Reset form for writing review
                var m = document.getElementById('reviewModal');
                if (m) {
                    m.querySelector('.modal-title').textContent = 'Write a Review';
                    var f = m.querySelector('form');
                    if (f) {
                        f.reset();
                        f.querySelectorAll('input, textarea').forEach(i => i.disabled = false);
                        var btn = m.querySelector('button[type="submit"]');
                        if (btn) btn.style.display = 'block';
                    }
                    openModal('reviewModal', reviewUrl);
                }
            }
        })
        .catch(e => {
            console.error(e);
            openModal('reviewModal', reviewUrl);
        });
      return false;
  }
  
  // Response check is now done earlier, before popup
  
  if (iconType === 'contract' || actionText.toLowerCase().includes('contract') || actionText.toLowerCase().includes('offer')) {
      var m = document.getElementById('contractModal');
      if (m) {
          var f = m.querySelector('form');
          if (f) f.reset();
      }
      openModal('contractModal', contractUrl);
      return false;
  }
  
  if (iconType === 'interview' || actionText.toLowerCase().includes('interview')) {
      var m = document.getElementById('interviewModal');
      if (m) {
          var f = m.querySelector('form');
          if (f) f.reset();
      }
      openModal('interviewModal', interviewUrl);
      return false;
  }
  
  // Don't handle documents if it's a response task
  var actionTextLowerForDocs = (actionText || '').toLowerCase();
  if (!actionTextLowerForDocs.includes('open response') && !actionTextLowerForDocs.includes('response from employer')) {
      if (iconType === 'credentialing' || iconType === 'documents' || actionTextLowerForDocs.includes('document')) {
           if (actionTextLowerForDocs.includes('ask') || actionTextLowerForDocs.includes('request')) {
               openModal('askDocumentModal', docReqUrl);
           } else {
               if (window.openEmployerDocsModal) window.openEmployerDocsModal(appId);
           }
           return false;
      }
  }
  
  if (card) {
    showTodoModalForApplication(card);
  }
  return false;
};

function openEmployerMessageModal(appId) {
  if (!appId) {
    console.error('Application ID is required');
    return;
  }
  
  var modal = document.getElementById('employerMessageModal');
  if (!modal) {
    console.error('Modal not found');
    return;
  }
  
  // Reset form
  document.getElementById('employerMessageApplicationId').value = appId;
  document.getElementById('employerMessageTo').value = 'Loading...';
  document.getElementById('employerMessageSubject').value = '';
  document.getElementById('employerMessageText').value = '';
  document.getElementById('employerMessageError').style.display = 'none';
  document.getElementById('employerMessageSuccess').style.display = 'none';
  
  // Try to get provider email from the application card in the DOM
  var card = document.querySelector('[data-application-id="' + appId + '"]');
  var providerEmail = '';
  
  if (card) {
    // Try to find email in card - look for any data attributes or text
    // For now, we'll fetch it from the messages endpoint which returns application info
  }
  
  // Fetch provider email from application endpoint
  fetch('{{ path("app_employer_application_messages", {"id": "PLACEHOLDER_ID"}) }}'.replace('PLACEHOLDER_ID', appId), {
    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin'
  })
  .then(function(r) { 
    if (!r.ok) throw new Error('Failed to fetch');
    return r.json(); 
  })
  .then(function(data) {
    // Set provider email if available
    if (data.provider_email) {
      document.getElementById('employerMessageTo').value = data.provider_email;
    } else {
      document.getElementById('employerMessageTo').value = 'Provider Email';
      document.getElementById('employerMessageTo').placeholder = 'Will be sent to provider';
    }
    
    openModal('employerMessageModal');
  })
  .catch(function(e) {
    // Still open modal - email will be fetched server-side
    document.getElementById('employerMessageTo').value = 'Provider Email';
    document.getElementById('employerMessageTo').placeholder = 'Will be sent to provider';
    openModal('employerMessageModal');
  });
}

function sendEmployerMessage() {
  var appId = document.getElementById('employerMessageApplicationId').value;
  var subject = document.getElementById('employerMessageSubject').value.trim();
  var messageText = document.getElementById('employerMessageText').value.trim();
  var errorDiv = document.getElementById('employerMessageError');
  var successDiv = document.getElementById('employerMessageSuccess');
  
  if (!subject || !messageText) {
    errorDiv.textContent = 'Please fill in both subject and message';
    errorDiv.style.display = 'block';
    successDiv.style.display = 'none';
    return;
  }
  
  errorDiv.style.display = 'none';
  successDiv.style.display = 'none';
  
  // Disable send button
  var sendBtn = document.querySelector('#employerMessageModal .btn-primary');
  var originalText = sendBtn.textContent;
  sendBtn.disabled = true;
  sendBtn.textContent = 'Sending...';
  
  fetch('{{ path("app_employer_application_send_message", {"id": "PLACEHOLDER_ID"}) }}'.replace('PLACEHOLDER_ID', appId), {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest'
    },
    credentials: 'same-origin',
    body: JSON.stringify({
      subject: subject,
      message: messageText
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    sendBtn.disabled = false;
    sendBtn.textContent = originalText;
    
    if (data.success) {
      successDiv.textContent = data.message || 'Message sent successfully!';
      successDiv.style.display = 'block';
      errorDiv.style.display = 'none';
      
      // Clear form
      document.getElementById('employerMessageSubject').value = '';
      document.getElementById('employerMessageText').value = '';
      
      // Close modal after 1.5 seconds
      setTimeout(function() {
        closeModal('employerMessageModal');
      }, 1500);
    } else {
      errorDiv.textContent = data.message || 'Failed to send message';
      errorDiv.style.display = 'block';
      successDiv.style.display = 'none';
    }
  })
  .catch(function(e) {
    sendBtn.disabled = false;
    sendBtn.textContent = originalText;
    errorDiv.textContent = 'Error sending message: ' + e.message;
    errorDiv.style.display = 'block';
    successDiv.style.display = 'none';
  });
}

