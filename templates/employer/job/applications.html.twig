    <script>
    function openEmailModal() {
      const overlay = document.getElementById('email-modal-overlay');
      const modal = document.getElementById('email-template-modal');
      if (!overlay || !modal) return;

      // Get application context
      const applicationDetailContent = document.getElementById('application-detail-content');
      let providerName = 'the provider';
      let jobTitle = 'this position';
      
      if (applicationDetailContent) {
        const providerNameEl = applicationDetailContent.querySelector('[data-provider-name]');
        const jobTitleEl = applicationDetailContent.querySelector('[data-job-title]');
        if (providerNameEl) providerName = providerNameEl.textContent.trim();
        if (jobTitleEl) jobTitle = jobTitleEl.textContent.trim();
      }

      const subjectEl = document.getElementById('email-template-subject');
      const messageEl = document.getElementById('email-template-message');
      if (!subjectEl || !messageEl) return;

      // Set default template
      subjectEl.value = `Regarding ${jobTitle}`;
      messageEl.value = `Hi ${providerName},\n\nI hope this message finds you well. I wanted to reach out regarding ${jobTitle}.\n\n[Your message here]\n\nBest regards,\n[Your name]`;

      // Prevent body scrolling
      const scrollY = window.scrollY;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.dataset.scrollY = scrollY;

      overlay.style.display = 'block';
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeAllEmailModals() {
      const overlay = document.getElementById('email-modal-overlay');
      const modals = document.querySelectorAll('.email-modal');
      modals.forEach(m => { m.style.display = 'none'; m.setAttribute('aria-hidden', 'true'); });
      if (overlay) overlay.style.display = 'none';
      
      // Restore body scrolling
      const scrollY = document.body.dataset.scrollY || '0';
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, parseInt(scrollY, 10));
      delete document.body.dataset.scrollY;
    }

    document.addEventListener('DOMContentLoaded', function () {
      const overlay = document.getElementById('email-modal-overlay');
      if (overlay) overlay.addEventListener('click', closeAllEmailModals);

      document.querySelectorAll('.email-modal [data-close]').forEach(btn => {
        btn.addEventListener('click', closeAllEmailModals);
      });

      // Copy handlers
      document.querySelectorAll('[data-copy-message]').forEach(btn => {
        btn.addEventListener('click', () => {
          const sel = btn.getAttribute('data-copy-message');
          const input = document.querySelector(sel);
          if (!input) return;
          navigator.clipboard.writeText(input.value || '').then(() => {
            if (typeof showTodoNotification === 'function') {
              showTodoNotification('success', 'Message copied');
            } else {
              alert('Message copied');
            }
          }).catch(() => {});
        });
      });

      // Open in Gmail
      document.querySelectorAll('[data-open-gmail]').forEach(btn => {
        btn.addEventListener('click', () => {
          const subSel = btn.getAttribute('data-sub');
          const bodySel = btn.getAttribute('data-body');
          const subEl = document.querySelector(subSel);
          const bodyEl = document.querySelector(bodySel);
          const su = encodeURIComponent(subEl ? subEl.value : '');
          const body = encodeURIComponent(bodyEl ? bodyEl.value : '');
          const url = `https://mail.google.com/mail/?view=cm&fs=1&su=${su}&body=${body}`;
          window.open(url, '_blank');
        });
      });

      // Send email handler
      document.querySelectorAll('[data-send-email]').forEach(btn => {
        btn.addEventListener('click', async function() {
          const subSel = btn.getAttribute('data-sub');
          const bodySel = btn.getAttribute('data-body');
          const subEl = document.querySelector(subSel);
          const bodyEl = document.querySelector(bodySel);
          const subject = subEl ? subEl.value : '';
          const message = bodyEl ? bodyEl.value : '';
          
          if (!subject || !message) {
            if (typeof showTodoNotification === 'function') {
              showTodoNotification('error', 'Please fill in both subject and message');
            } else {
              alert('Please fill in both subject and message');
            }
            return;
          }

          // Get application ID
          const urlParams = new URLSearchParams(window.location.search);
          const applicationId = urlParams.get('applicationId');
          const applicationDetailContent = document.getElementById('application-detail-content');
          let appId = applicationId;
          
          if (!appId && applicationDetailContent) {
            const appIdEl = applicationDetailContent.querySelector('[data-application-id]');
            if (appIdEl) appId = appIdEl.getAttribute('data-application-id');
          }

          if (!appId) {
            if (typeof showTodoNotification === 'function') {
              showTodoNotification('error', 'Please select an application first');
            } else {
              alert('Please select an application first');
            }
            return;
          }

          const original = btn.innerHTML;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Sending...';
          btn.disabled = true;
          
          try {
            const response = await fetch('{{ path("app_employer_send_provider_email") }}', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
              body: JSON.stringify({ 
                application_id: appId, 
                subject: subject, 
                message: message
              })
            });
            const result = await response.json();
            if (result && result.success) {
              if (typeof showTodoNotification === 'function') {
                showTodoNotification('success', 'Email sent successfully to provider!');
              } else {
                alert('Email sent successfully!');
              }
              closeAllEmailModals();
            } else {
              if (typeof showTodoNotification === 'function') {
                showTodoNotification('error', 'Failed to send email: ' + (result.message || 'Unknown error'));
              } else {
                alert('Failed to send email: ' + (result.message || 'Unknown error'));
              }
            }
          } catch (e) {
            if (typeof showTodoNotification === 'function') {
              showTodoNotification('error', 'Network error. Please try again.');
            } else {
              alert('Network error. Please try again.');
            }
          } finally {
            btn.innerHTML = original;
            btn.disabled = false;
          }
        });
      });

      // Link email button to email modal
      const emailBtn = document.getElementById('email-btn');
      if (emailBtn) {
        emailBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          openEmailModal();
        });
      }

      // Also handle email buttons in detail action buttons (dynamically added)
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          mutation.addedNodes.forEach(function(node) {
            if (node.nodeType === 1) {
              const emailBtns = node.querySelectorAll ? node.querySelectorAll('#email-btn') : [];
              emailBtns.forEach(function(btn) {
                if (!btn.hasAttribute('data-email-handler-attached')) {
                  btn.setAttribute('data-email-handler-attached', 'true');
                  btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    openEmailModal();
                  });
                }
              });
            }
          });
        });
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
    </script>

<script>
// Hover-Sensitive Accordion functionality - Make globally available for split view
// This matches the implementation from _application_detail.html.twig
window.initializeAccordions = function(container) {
    if (!container) return;
    
    const accordions = container.querySelectorAll('.app-detail-accordion[data-accordion-section]');
    
    accordions.forEach(function(accordion) {
        const header = accordion.querySelector('.app-detail-accordion-header[data-accordion-toggle]');
        const content = accordion.querySelector('.app-detail-accordion-content');
        
        if (!header || !content) return;
        
        // Skip if already initialized (check for data attribute)
        if (accordion.dataset.accordionInitialized === 'true') return;
        accordion.dataset.accordionInitialized = 'true';
        
        let isLocked = false;
        let hoverTimeout = null;
        
        // Expand function
        function expandAccordion() {
            header.classList.add('expanded');
            content.classList.remove('collapsed');
            content.classList.add('expanded');
        }
        
        // Collapse function
        function collapseAccordion() {
            if (!isLocked) {
                header.classList.remove('expanded');
                content.classList.remove('expanded');
                content.classList.add('collapsed');
            }
        }
        
        // Click handler - lock/unlock the accordion
        function handleClick(e) {
            e.stopPropagation();
            isLocked = !isLocked;
            if (isLocked) {
                expandAccordion();
            } else {
                collapseAccordion();
            }
        }
        
        // Hover handler - expand on hover (if not locked)
        header.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            expandAccordion();
        });
        
        // Mouse leave handler - collapse after delay (if not locked)
        header.addEventListener('mouseleave', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                hoverTimeout = setTimeout(function() {
                    collapseAccordion();
                }, 200);
            }
        });
        
        // Also handle mouse events on content to keep it open when hovering over it
        content.addEventListener('mouseenter', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                expandAccordion();
            }
        });
        
        content.addEventListener('mouseleave', function() {
            if (!isLocked) {
                clearTimeout(hoverTimeout);
                hoverTimeout = setTimeout(function() {
                    collapseAccordion();
                }, 200);
            }
        });
        
        // Click handlers
        header.addEventListener('click', handleClick);
    });
};

// Also initialize on DOMContentLoaded for any existing content
document.addEventListener('DOMContentLoaded', function() {
    // Initialize for main content
    const mainContent = document.querySelector('.app-detail-content');
    if (mainContent) {
        window.initializeAccordions(mainContent);
    }
    
    // Initialize for split view (if it exists)
    const splitViewContent = document.querySelector('.split-view-container .app-detail-content');
    if (splitViewContent) {
        window.initializeAccordions(splitViewContent);
    }
    
    // Watch for split view creation and initialize accordions there too
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    const splitContent = node.querySelector ? node.querySelector('.app-detail-content') : null;
                    if (splitContent) {
                        window.initializeAccordions(splitContent);
                    }
                    // Also check if the node itself is an accordion container
                    if (node.classList && node.classList.contains('app-detail-content')) {
                        window.initializeAccordions(node);
                    }
                }
            });
        });
    });
    
    // Observe the document body for new elements
    if (document.body) {
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }
    });
    </script>

