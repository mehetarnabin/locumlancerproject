<script>
// To-Do actions mapping
const TODO_ACTIONS = {
  applied: 'Revisit Alert',
  shortlisted: 'Open Response',
  interview: 'Confirm interview',
  interviewing: 'Confirm interview',
  negotiating: 'Sign offer',
  accepted: 'Open Credentialing Docs',
  completed: 'See your review'
};

function getActiveApplication() {
  const selected = document.querySelector('.split-job-card.active') || document.querySelector('.split-job-card.selected');
  if (!selected) {
    const checked = document.querySelector('.split-job-card input.job-checkbox:checked');
    return checked ? checked.closest('.split-job-card') : null;
  }
  return selected;
}

function showTodoModalForApplication(card) {
  if (!card) return;
  const appId = card.getAttribute('data-application-id');
  const status = card.querySelector('.job-checkbox')?.getAttribute('data-status') || 'applied';
  const optionsEl = document.getElementById('todo-options');
  optionsEl.innerHTML = '';

  const actions = new Set(['applied','shortlisted','interview','negotiating','accepted','completed']);
  actions.forEach(key => {
    const label = TODO_ACTIONS[key];
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'list-group-item list-group-item-action';
    btn.textContent = label;
    btn.addEventListener('click', () => createTodo(appId, key));
    optionsEl.appendChild(btn);
  });

  const modalEl = document.getElementById('todoModal');
  if (typeof $ !== 'undefined' && $(modalEl).modal) {
    $(modalEl).modal('show');
  } else {
    modalEl.style.display = 'block';
  }
}

async function createTodo(appId, actionKey) {
  try {
    const res = await fetch(`${window.location.origin}/employer/applications/${appId}/todo/create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify({ actionKey })
    });
    const data = await res.json();
    if (data.success) {
      alert('To-Do created: ' + data.todo.title);
      const modalEl = document.getElementById('todoModal');
      if (typeof $ !== 'undefined' && $(modalEl).modal) $(modalEl).modal('hide');
      else modalEl.style.display = 'none';
    } else {
      alert(data.message || 'Failed to create To-Do');
    }
  } catch (e) {
    alert('Network error while creating To-Do');
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const todoBtn = document.getElementById('detail-todo-btn');
  const noteBtn = document.getElementById('detail-note-btn');
  function updateDetailButtonsVisibility() {
    const card = getActiveApplication();
    const show = !!card;
    if (todoBtn) todoBtn.style.display = show ? 'inline-flex' : 'none';
    if (noteBtn) noteBtn.style.display = show ? 'inline-flex' : 'none';
  }
  updateDetailButtonsVisibility();
  document.getElementById('split-job-list').addEventListener('click', function(e) {
    const card = e.target.closest('.split-job-card');
    if (card) {
      updateDetailButtonsVisibility();
    }
  });
  if (todoBtn) {
    todoBtn.addEventListener('click', function() {
      const card = getActiveApplication();
      showTodoModalForApplication(card);
    });
  }
});
</script>
