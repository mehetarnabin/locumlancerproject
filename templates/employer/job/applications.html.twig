                                        </svg>
                                        <span>${transitionText}</span>
                                    `;
                                } else if (transitionLower === 'offer') {
                                    newBtn.innerHTML = `
                                        <svg class="icon-image" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>${transitionText}</span>
                                    `;
                                } else if (transitionLower === 'hire') {
                                    newBtn.innerHTML = `
                                        <svg class="icon-image" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.5"/>
                                            <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/>
                                            <path d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="1.5"/>
                                        </svg>
                                        <span>${transitionText}</span>
                                    `;
                                } else {
                                    newBtn.innerHTML = `<span>${transitionText}</span>`;
                                }
                                
                                // Insert before note button
                                if (detailNoteBtn && detailNoteBtn.parentNode) {
                                    detailNoteBtn.parentNode.insertBefore(newBtn, detailNoteBtn);
                                } else {
                                    detailActionButtons.appendChild(newBtn);
                                }
                            });
                            
                            // Remove the original action section from content
                            actionSection.remove();
                        }
                    }
                }
                
                // Re-initialize any modals or interactive elements
                if (typeof $ !== 'undefined' && $.fn.modal) {
                    $('.modal').modal({ show: false });
                }
            }
        })
        .catch(error => {
            console.error('Error loading application details:', error);
            if (applicationDetailContent) {
                applicationDetailContent.innerHTML = `
                    <div class="text-center py-5">
                        <p class="text-danger">Error loading application details. Please try again.</p>
