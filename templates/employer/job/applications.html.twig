/* Todo Popup Styles - Green Border Design */
.todo-popup {
    position: fixed;
    background: white;
    color: #121C0C;
    border-radius: 10px;
    padding: 16px 20px;
    box-shadow: 0 4px 20px rgba(133, 187, 101, 0.15), 0 2px 8px rgba(0, 0, 0, 0.1);
