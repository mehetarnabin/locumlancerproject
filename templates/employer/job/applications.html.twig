  }
  
  if (iconType === 'credentialing' || iconType === 'documents' || actionText.includes('document')) {
       if (actionText.includes('ask') || actionText.includes('request')) {
           window.openEmployerModal('askDocumentModal', docReqUrl);
       } else {
           if (window.openEmployerDocsModal) window.openEmployerDocsModal(appId);
       }
