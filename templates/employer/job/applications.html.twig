            'action-send-contract-btn',
            'action-send-credential-btn',
            'action-write-review-btn'
        ];
        
        conditionalButtonIds.forEach(function(btnId) {
            const btn = document.getElementById(btnId);
            if (btn) {
                btn.classList.remove('show');
                btn.style.display = 'none';
                btn.style.visibility = 'hidden';
                btn.style.opacity = '0';
                btn.style.pointerEvents = 'none';
            }
        });
        
        // Also hide by class selector
        document.querySelectorAll('.conditional-btn').forEach(function(btn) {
            btn.classList.remove('show');
            btn.style.display = 'none';
            btn.style.visibility = 'hidden';
            btn.style.opacity = '0';
            btn.style.pointerEvents = 'none';
        });

        let status = null;

        // Try to get status from loaded application detail content
        const applicationDetailContent = document.getElementById('application-detail-content');
        if (applicationDetailContent) {
            // Try to get from data attribute first (most reliable)
            // Check if application-detail-content itself has the attribute
            let dataStatus = applicationDetailContent.getAttribute('data-application-status');
            if (dataStatus) {
                status = dataStatus.toLowerCase();
            } else {
                // Try to find .app-detail-content child with data attribute
                const detailContainer = applicationDetailContent.querySelector('.app-detail-content[data-application-status], [data-application-status]');
                if (detailContainer) {
                    dataStatus = detailContainer.getAttribute('data-application-status');
                    if (dataStatus) {
                        status = dataStatus.toLowerCase();
                    }
                }
            }
            
            // If not found, try to find status badge in the detail content
            if (!status) {
                const statusBadge = applicationDetailContent.querySelector('.badge-pill, .app-detail-meta-value .badge, [class*="badge"]');
                if (statusBadge) {
                    const statusText = statusBadge.textContent.trim().toLowerCase();
                    // Map status text to status value
                    if (statusText.includes('applied')) status = 'applied';
                    else if (statusText.includes('negotiating')) status = 'in_review';
                    else if (statusText.includes('review') || statusText.includes('shortlisted')) status = 'in_review';
                    else if (statusText.includes('interview')) status = 'interview';
                    else if (statusText.includes('offered')) status = 'offered';
                    else if (statusText.includes('hired') || statusText.includes('accepted')) status = 'hired';
                    else if (statusText.includes('completed')) status = 'completed';
                }
            }
        }

        // If not found, try to get from selected application card
        if (!status) {
            const activeCard = document.querySelector('.card-v2.active-card, .split-job-card.active, .split-job-card.selected');
            if (activeCard) {
                // Try to get from data attribute on card
                const cardStatus = activeCard.getAttribute('data-status');
                if (cardStatus) {
                    status = cardStatus.toLowerCase();
                } else {
                    // Try to get from checkbox
                    const checkbox = activeCard.querySelector('.job-checkbox');
                    if (checkbox) {
                        status = checkbox.getAttribute('data-status');
                        if (status) status = status.toLowerCase();
                    }
                }
            }
        }

        // Fallback to initial applicationDetail if available
        {% if applicationDetail %}
        if (!status) {
            status = '{{ applicationDetail.status|lower }}';
        }
        {% endif %}

        // Update buttons based on status
        if (status) {
            // Normalize status: remove underscores and convert to lowercase
            const normalizedStatus = status.toLowerCase().replace(/_/g, '');
            
            if (normalizedStatus === 'applied') {
                const btn = document.getElementById('action-request-file-btn');
                if (btn) {
                    btn.classList.add('show');
                    btn.style.display = 'flex';
                    btn.style.visibility = 'visible';
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            } else if (normalizedStatus === 'inreview' || normalizedStatus === 'shortlisted') {
                const btn = document.getElementById('action-schedule-interview-btn');
                if (btn) {
                    btn.classList.add('show');
                    btn.style.display = 'flex';
                    btn.style.visibility = 'visible';
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            } else if (normalizedStatus === 'interview' || normalizedStatus === 'interviewing') {
                const btn = document.getElementById('action-request-documents-btn');
                if (btn) {
                    btn.classList.add('show');
                    btn.style.display = 'flex';
                    btn.style.visibility = 'visible';
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            } else if (normalizedStatus === 'offered' || normalizedStatus === 'negotiating') {
                const offerBtn = document.getElementById('action-send-offer-btn');
                const contractBtn = document.getElementById('action-send-contract-btn');
                if (offerBtn) {
                    offerBtn.classList.add('show');
                    offerBtn.style.display = 'flex';
                    offerBtn.style.visibility = 'visible';
                    offerBtn.style.opacity = '1';
                    offerBtn.style.pointerEvents = 'auto';
                }
                if (contractBtn) {
                    contractBtn.classList.add('show');
                    contractBtn.style.display = 'flex';
                    contractBtn.style.visibility = 'visible';
                    contractBtn.style.opacity = '1';
                    contractBtn.style.pointerEvents = 'auto';
                }
            } else if (normalizedStatus === 'accepted' || normalizedStatus === 'hired') {
                const btn = document.getElementById('action-send-credential-btn');
                if (btn) {
                    btn.classList.add('show');
                    btn.style.display = 'flex';
                    btn.style.visibility = 'visible';
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            } else if (normalizedStatus === 'completed') {
                const btn = document.getElementById('action-write-review-btn');
                if (btn) {
                    btn.classList.add('show');
                    btn.style.display = 'flex';
                    btn.style.visibility = 'visible';
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            }
        }
    }

    // IMMEDIATELY hide all conditional buttons on page load (before DOMContentLoaded)
    (function() {
        const conditionalButtonIds = [
            'action-request-file-btn',
            'action-schedule-interview-btn',
            'action-request-documents-btn',
            'action-send-offer-btn',
            'action-send-contract-btn',
            'action-send-credential-btn',
            'action-write-review-btn'
        ];
        
        function forceHideButtons() {
            conditionalButtonIds.forEach(function(btnId) {
                const btn = document.getElementById(btnId);
                if (btn) {
                    btn.classList.remove('show');
                    btn.style.cssText = 'display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important;';
                }
            });
            document.querySelectorAll('.conditional-btn').forEach(function(btn) {
                btn.classList.remove('show');
                btn.style.cssText = 'display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important;';
            });
        }
        
        // Run immediately
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', forceHideButtons);
        } else {
            forceHideButtons();
        }
        
        // Also run after a short delay to catch any dynamically added buttons
        setTimeout(forceHideButtons, 100);
        setTimeout(forceHideButtons, 500);
    })();

    // Call updateActionButtons when page loads
    document.addEventListener('DOMContentLoaded', function() {
        updateActionButtons();
        // Force hide again after update
        setTimeout(function() {
            updateActionButtons();
        }, 100);
    });

    // Also update when application detail is loaded via AJAX
    if (typeof loadApplicationDetails !== 'undefined') {
        const originalLoadApplicationDetails = loadApplicationDetails;
        loadApplicationDetails = function(applicationId) {
            originalLoadApplicationDetails(applicationId);
            setTimeout(updateActionButtons, 500);
            setTimeout(updateHireCompleteButtons, 500);
        };
    }

    // Update Hire/Complete buttons visibility based on status
    function updateHireCompleteButtons() {
        const applicationDetailContent = document.getElementById('application-detail-content');
        if (!applicationDetailContent) return;

        let status = null;
        const detailContainer = applicationDetailContent.querySelector('.app-detail-content[data-application-status], [data-application-status]');
        if (detailContainer) {
            status = detailContainer.getAttribute('data-application-status');
            if (status) status = status.toLowerCase();
        }

        // Fallback: try to get from active card
        if (!status) {
            const activeCard = document.querySelector('.card-v2.active-card, .split-job-card.active');
            if (activeCard) {
                status = activeCard.getAttribute('data-status');
                if (status) status = status.toLowerCase();
            }
        }

        const hireBtn = document.getElementById('hire-btn');
        const completeBtn = document.getElementById('complete-btn');

        if (status === 'hired') {
            if (hireBtn) hireBtn.style.display = 'none';
            if (completeBtn) completeBtn.style.display = 'inline-block';
        } else if (status === 'completed') {
            if (hireBtn) hireBtn.style.display = 'none';
            if (completeBtn) completeBtn.style.display = 'none';
        } else {
            // Show hire button for all other statuses (applied, interview, offered, etc.)
            if (hireBtn) hireBtn.style.display = 'inline-block';
            if (completeBtn) completeBtn.style.display = 'none';
        }
    }

    // Function to update application status (Hire or Complete)
    function updateApplicationStatus(transition) {
        console.log('updateApplicationStatus called with transition:', transition);
        
        const applicationDetailContent = document.getElementById('application-detail-content');
        if (!applicationDetailContent) {
            console.error('application-detail-content not found');
            alert('Unable to find application details. Please refresh the page.');
            return;
        }

        // Try multiple ways to find the application ID
        let applicationId = null;
        let detailContainer = applicationDetailContent.querySelector('.app-detail-content[data-application-id]');
        
        if (detailContainer) {
            applicationId = detailContainer.getAttribute('data-application-id');
        } else {
            // Try finding by any element with data-application-id
            detailContainer = applicationDetailContent.querySelector('[data-application-id]');
            if (detailContainer) {
                applicationId = detailContainer.getAttribute('data-application-id');
            }
        }
        
        // Fallback: try to get from URL
        if (!applicationId) {
            const urlParams = new URLSearchParams(window.location.search);
            applicationId = urlParams.get('applicationId');
        }
        
        if (!applicationId) {
            console.error('Application ID not found');
            alert('Unable to find application ID. Please refresh the page.');
            return;
        }

        // Get job ID from template
        const jobId = '{{ job.id }}';
        
        if (!jobId) {
            console.error('Job ID not found');
            alert('Unable to find job ID. Please refresh the page.');
            return;
        }

        // Disable button during request
        const btn = transition === 'hire' ? document.getElementById('hire-btn') : document.getElementById('complete-btn');
        const originalText = btn ? btn.textContent : '';
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Processing...';
        }

        console.log('Making request to:', `/employer/jobs/${jobId}/transition/${transition}/application/${applicationId}`);

        // Make AJAX request to update status
        const url = `/employer/jobs/${jobId}/transition/${transition}/application/${applicationId}`;
        
        fetch(url, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            },
            redirect: 'follow'
        })
        .then(response => {
            console.log('Response status:', response.status);
            // The controller redirects, so we need to handle that
            if (response.redirected || response.status === 302 || response.status === 200) {
                // Success - reload the entire page to update the application list and status cards
                // This ensures the application moves to the correct section (hired/completed)
                // The controller will redirect with the correct status parameter
                const newStatus = transition === 'hire' ? 'hired' : 'completed';
                const redirectUrl = window.location.pathname + '?applicationId=' + applicationId + '&status=' + newStatus;
                
                console.log('Redirecting to:', redirectUrl);
                // Reload the page with the application ID and status to show the updated status
                window.location.href = redirectUrl;
            } else if (!response.ok) {
                throw new Error(`HTTP ${response.status}: Failed to update status`);
            }
        })
        .catch(error => {
            console.error('Error updating application status:', error);
            alert('Failed to update application status: ' + error.message + '. Please try again.');
            if (btn) {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    }

    // Make function available globally
    window.updateApplicationStatus = updateApplicationStatus;
    window.updateHireCompleteButtons = updateHireCompleteButtons;

    // Call updateHireCompleteButtons when page loads
    document.addEventListener('DOMContentLoaded', function() {
        updateHireCompleteButtons();
    });
    </script>

