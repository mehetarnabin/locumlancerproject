<script>
// To-Do actions mapping
const TODO_ACTIONS = {
  applied: 'Revisit Alert',
  shortlisted: 'Open Response',
  interview: 'Confirm interview from the list of interview dates',
  interviewing: 'Confirm interview from the list of interview dates',
  negotiating: 'Review signed offer/contract',
  accepted: 'Request Credentialing Docs',
  completed: 'See your review'
};

function getActiveApplication() {
  const selected = document.querySelector('.split-job-card.active') || document.querySelector('.split-job-card.selected');
  if (!selected) {
    const checked = document.querySelector('.split-job-card input.job-checkbox:checked');
    return checked ? checked.closest('.split-job-card') : null;
  }
  return selected;
}

function getSelectedApplicationId() {
  const card = getActiveApplication();
  if (card) return card.getAttribute('data-application-id');
  const checked = document.querySelector('.split-job-card input.job-checkbox:checked');
  if (checked) return checked.getAttribute('data-application-id');
  const urlId = new URLSearchParams(window.location.search).get('applicationId');
  return urlId || null;
}

function archiveSelectedApplication() {
  const id = getSelectedApplicationId();
  if (!id) { alert('Please select an application first'); return; }
  fetch('{{ path("app_employer_applications_archive") }}', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify([id])
  }).then(r => r.json()).then(data => {
    if (data && data.success) {
      const card = document.querySelector(`.split-job-card[data-application-id="${id}"]`);
      if (card) card.remove();
      // Also remove from list view
      const listCard = document.getElementById(id);
      if (listCard) listCard.remove();
    } else {
      alert(data.message || 'Failed to archive application');
    }
  }).catch(() => alert('Network error'));
}

function deleteSelectedApplication() {
  const id = getSelectedApplicationId();
  if (!id) { alert('Please select an application first'); return; }
  if (!confirm('Are you sure you want to delete this application?')) return;
  fetch('{{ path("app_employer_applications_delete") }}', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify([id])
  }).then(r => r.json()).then(data => {
    if (data && data.success) {
      const card = document.querySelector(`.split-job-card[data-application-id="${id}"]`);
      if (card) card.remove();
      const listCard = document.getElementById(id);
      if (listCard) listCard.remove();
    } else {
      alert(data.message || 'Failed to delete application');
    }
  }).catch(() => alert('Network error'));
}

function showTodoModalForApplication(card) {
  if (!card) return;
  const appId = card.getAttribute('data-application-id');
  
  // Get Candidate Name and update modal title
  const candidateName = card.querySelector('.split-job-card-title')?.textContent.trim() || 'Candidate';
  const modalTitle = document.getElementById('todoModalLabel');
  if (modalTitle) modalTitle.textContent = 'Add To-Do for ' + candidateName;

  let status = card.querySelector('.job-checkbox')?.getAttribute('data-status') || 'applied';
  // Normalize status
  status = status.toLowerCase().replace(/_/g, '');
  if (status === 'inreview') status = 'shortlisted';

  const optionsEl = document.getElementById('todo-options');
  optionsEl.innerHTML = '';

  const actions = Object.keys(TODO_ACTIONS);
  
  // Sort actions to put current status first
  actions.sort((a, b) => {
      if (a === status) return -1;
      if (b === status) return 1;
      return 0;
  });

  const addedLabels = new Set();
  actions.forEach(key => {
    const label = TODO_ACTIONS[key];
    if (addedLabels.has(label)) return;
    addedLabels.add(label);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'list-group-item list-group-item-action';
    
    // Highlight recommended action
    if (key === status) {
        btn.classList.add('active');
        btn.innerHTML = `<strong>${label}</strong> <span class="badge bg-light text-dark float-end" style="float:right;">Recommended</span>`;
    } else {
        btn.textContent = label;
    }
    
    btn.addEventListener('click', () => createTodo(appId, key));
    optionsEl.appendChild(btn);
  });

  // Use global helper
  window.openEmployerModal('todoModal');
}

async function createTodo(appId, actionKey) {
  try {
    const res = await fetch(`${window.location.origin}/employer/applications/${appId}/todo/create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify({ actionKey })
    });
    const data = await res.json();
    if (data.success) {
      alert('To-Do created: ' + data.todo.title);
      window.closeEmployerModal('todoModal');
    } else {
      alert(data.message || 'Failed to create To-Do');
    }
  } catch (e) {
    alert('Network error while creating To-Do');
  }
}

document.addEventListener('DOMContentLoaded', function() {
  // Fix Job Title header alignment - override inline styles
  function fixJobTitleAlignment() {
    // Specifically target div with class "col-job sortable"
    const jobTitleHeaders = document.querySelectorAll('div.col-job.sortable, .col-job.sortable, div[class*="col-job"][class*="sortable"]');
    jobTitleHeaders.forEach(function(header) {
      // Force left alignment regardless of inline styles
      header.style.setProperty('justify-content', 'flex-start', 'important');
      header.style.setProperty('text-align', 'left', 'important');
      header.style.setProperty('display', 'flex', 'important');
      header.style.setProperty('align-items', 'center', 'important');
      
      // Also ensure all child elements are left-aligned
      const children = header.querySelectorAll('*');
      children.forEach(function(child) {
        child.style.setProperty('text-align', 'left', 'important');
      });
    });
    
    // Also target by data attributes
    const dataJobHeaders = document.querySelectorAll('[data-sort="job"], [data-column="job"]');
    dataJobHeaders.forEach(function(header) {
      if (header.classList.contains('col-job') || header.classList.contains('sortable')) {
        header.style.setProperty('justify-content', 'flex-start', 'important');
        header.style.setProperty('text-align', 'left', 'important');
      }
    });
    
    // Find any div containing "Job Title" text with sortable class
    const allDivs = document.querySelectorAll('div.sortable, div.col-job');
    allDivs.forEach(function(div) {
      const text = div.textContent.trim();
      if (text.includes('Job Title') && (div.classList.contains('col-job') || div.classList.contains('sortable'))) {
        div.style.setProperty('justify-content', 'flex-start', 'important');
        div.style.setProperty('text-align', 'left', 'important');
        div.style.setProperty('display', 'flex', 'important');
        div.style.setProperty('align-items', 'center', 'important');
      }
    });
  }
  
  // Run immediately and after delays to catch dynamically loaded content
  fixJobTitleAlignment();
  setTimeout(fixJobTitleAlignment, 50);
  setTimeout(fixJobTitleAlignment, 100);
  setTimeout(fixJobTitleAlignment, 300);
  setTimeout(fixJobTitleAlignment, 500);
  
  // Also run on any DOM mutations (for dynamically added content)
  const observer = new MutationObserver(function(mutations) {
    fixJobTitleAlignment();
  });
  observer.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['style', 'class']
  });
  
  const todoBtn = document.getElementById('detail-todo-btn');
  const noteBtn = document.getElementById('detail-note-btn');
  const archiveBtn = document.getElementById('archive-btn');
  const deleteBtn = document.getElementById('delete-btn');
  function updateDetailButtonsVisibility() {
    const card = getActiveApplication();
    const show = !!card;
    if (todoBtn) todoBtn.style.display = show ? 'inline-flex' : 'none';
    if (noteBtn) noteBtn.style.display = show ? 'inline-flex' : 'none';
  }
  updateDetailButtonsVisibility();
  document.getElementById('split-job-list').addEventListener('click', function(e) {
    const card = e.target.closest('.split-job-card');
    if (card) {
      updateDetailButtonsVisibility();
    }
  });
  if (todoBtn) {
    todoBtn.addEventListener('click', function() {
      const card = getActiveApplication();
      showTodoModalForApplication(card);
    });
  }
  if (archiveBtn) {
    archiveBtn.addEventListener('click', function(e){
      e.preventDefault();
      archiveSelectedApplication();
    });
  }
  if (deleteBtn) {
    deleteBtn.addEventListener('click', function(e){
      e.preventDefault();
      deleteSelectedApplication();
    });
  }
});

// Global helper for closing modals
window.closeEmployerModal = function(modalId) {
    var m = document.getElementById(modalId);
    if (!m) return;
    
    // Hide manually
    m.classList.remove('show');
    m.style.display = 'none';
    document.body.classList.remove('modal-open');
    
    // Remove backdrop
    var bd = document.querySelector('.modal-backdrop');
    if (bd && bd.parentElement) {
        bd.parentElement.removeChild(bd);
    }
    
    // Try Bootstrap hide
    if (window.bootstrap && window.bootstrap.Modal) {
        try {
            var instance = window.bootstrap.Modal.getInstance(m);
            if (instance) instance.hide();
        } catch(e) {}
    } else if (window.$ && window.$.fn.modal) {
        try { window.$(m).modal('hide'); } catch(e) {}
    }
};

// Global helper for opening modals
window.openEmployerModal = function(modalId, formAction) {
    var m = document.getElementById(modalId);
    if (!m) return;

    if (formAction) {
        var f = m.querySelector('form');
        if (f) f.action = formAction;
    }
    
    // Move to body if needed
    if (m.parentElement !== document.body) document.body.appendChild(m);
    
    // Show using Bootstrap if available
    var shown = false;
    if (window.bootstrap && window.bootstrap.Modal) {
        try {
            var ModalCtor = window.bootstrap.Modal;
            var instance = ModalCtor.getOrCreateInstance ? ModalCtor.getOrCreateInstance(m) : new ModalCtor(m);
            instance.show();
            shown = true;
        } catch(e) {}
    } 
    
    if (!shown && window.$ && window.$.fn.modal) {
        try {
            window.$(m).modal('show');
            shown = true;
        } catch(e) {}
    }
    
    // Fallback or force styles for robustness
    if (!shown || true) { // Always enforce styles to be safe against CSS conflicts
        m.classList.add('show');
        m.style.setProperty('display', 'flex', 'important');
        m.style.setProperty('position', 'fixed', 'important');
        m.style.top = '0';
        m.style.left = '0';
        m.style.width = '100vw';
        m.style.height = '100vh';
        m.style.alignItems = 'center';
        m.style.justifyContent = 'center';
        m.style.background = 'rgba(0,0,0,0.5)';
        m.style.zIndex = '200000';
        
        // Ensure dialog z-index
        var dlg = m.querySelector('.modal-dialog');
        if (dlg) dlg.style.setProperty('z-index', '200001', 'important');
        
        // Backdrop
        if (!document.querySelector('.modal-backdrop')) {
            var bd = document.createElement('div');
            bd.className = 'modal-backdrop fade show';
            bd.style.zIndex = '199999';
            document.body.appendChild(bd);
        }
    }
    
    // Force pointer events and styles
    m.style.setProperty('pointer-events', 'auto', 'important');
    var dlg = m.querySelector('.modal-dialog');
    if (dlg) dlg.style.setProperty('pointer-events', 'auto', 'important');

    // Attach robust close handlers
    var closeBtns = m.querySelectorAll('[data-bs-dismiss="modal"], [data-dismiss="modal"], .btn-close');
    closeBtns.forEach(function(btn) {
        // Use capture phase to ensure we catch the click before anyone else
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            window.closeEmployerModal(modalId);
        }, true);
        
        // Also force cursor pointer
        btn.style.cursor = 'pointer';
        btn.style.pointerEvents = 'auto'; // ensure not disabled
    });
};

function handleEmployerTodoIconClick(e, el) {
  if (e) {
    e.preventDefault();
    e.stopPropagation();
  }
  
  var card = el.closest('.split-job-card');
  
  var appId = el.getAttribute('data-application-id') || (card ? card.getAttribute('data-application-id') : '') || (function(){ try { return getSelectedApplicationId ? getSelectedApplicationId() : null; } catch(_){ return null; } })() || (new URLSearchParams(window.location.search).get('applicationId') || '');
  
  // Determine action type
  var icon = el.querySelector('.todo-icon');
  var iconType = icon ? icon.getAttribute('data-todo-icon-type') : '';
  
  var actionText = (el.getAttribute('data-todo-action') || '').toLowerCase();
  var status = (el.getAttribute('data-status') || '').toLowerCase().replace(/_/g,'');
  if (!iconType || iconType === '') {
    if (status === 'completed') iconType = 'review';
    else if (status === 'interview' || status === 'interviewing') iconType = 'interview';
    else if (status === 'negotiating' || status === 'offered') iconType = 'contract';
    else if (status === 'accepted' || status === 'hired') iconType = 'credentialing';
    else iconType = 'documents';
  }
  if (!actionText || actionText === '') {
    if (iconType === 'review') actionText = 'See your review';
    else if (iconType === 'interview') actionText = 'Confirm interview from the list of interview dates';
    else if (iconType === 'contract') actionText = 'Review signed offer/contract';
    else if (iconType === 'credentialing') actionText = 'Request Credentialing Docs';
    else actionText = 'Documents';
  }
  
  // URLs
  var reviewUrl = '{{ path("app_employer_application_review_provider", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
  var contractUrl = '{{ path("app_employer_application_sendcontract", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
  var interviewUrl = '{{ path("app_employer_application_scheduleinterview", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
  var docReqUrl = '{{ path("app_employer_application_askfordocument", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
  var reviewDetailsUrl = '{{ path("app_employer_application_review_details", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);

  if ((iconType === 'review' || actionText.includes('review')) && !actionText.includes('contract')) {
      fetch(reviewDetailsUrl)
        .then(r => r.json())
        .then(data => {
            if (data.success && data.hasReview) {
                // Populate and show read-only modal
                var m = document.getElementById('reviewModal');
                if (m) {
                    var title = m.querySelector('.modal-title');
                    if (title) title.textContent = 'Your Review';
                    
                    var f = m.querySelector('form');
                    if (f) {
                        // Populate fields
                        var msg = f.querySelector('[name="message"]');
                        if (msg) { msg.value = data.review.message; msg.disabled = true; }
                        
                        // Populate stars
                        ['professionalism', 'quality', 'communication', 'emotional_intelligence'].forEach(k => {
                            var val = data.review[k];
                            if (val) {
                                var radio = f.querySelector(`input[name="${k}"][value="${val}"]`);
                                if (radio) radio.checked = true;
                            }
                            // Disable all radios
                            f.querySelectorAll(`input[name="${k}"]`).forEach(r => r.disabled = true);
                        });
                        
                        // Hide submit button
                        var btn = m.querySelector('button[type="submit"]');
                        if (btn) btn.style.display = 'none';
                    }
                    window.openEmployerModal('reviewModal');
                }
            } else {
                // Reset form for writing review
                var m = document.getElementById('reviewModal');
                if (m) {
                    var title = m.querySelector('.modal-title');
                    if (title) title.textContent = 'Write a Review';
                    
                    var f = m.querySelector('form');
                    if (f) {
                        f.reset();
                        f.querySelectorAll('input, textarea').forEach(i => i.disabled = false);
                        var btn = m.querySelector('button[type="submit"]');
                        if (btn) btn.style.display = 'block';
                    }
                    window.openEmployerModal('reviewModal', reviewUrl);
                }
            }
        })
        .catch(e => {
            console.error(e);
            window.openEmployerModal('reviewModal', reviewUrl);
        });
      return false;
  }
  
  if (iconType === 'contract' || actionText.includes('contract') || actionText.includes('offer')) {
      var m = document.getElementById('contractModal');
      if (m) {
          var f = m.querySelector('form');
          if (f) f.reset();
      }
      window.openEmployerModal('contractModal', contractUrl);
      return false;
  }
  
  if (iconType === 'interview' || actionText.includes('interview')) {
      var m = document.getElementById('interviewModal');
      if (m) {
          var f = m.querySelector('form');
          if (f) f.reset();
      }
      var detailsUrl = '{{ path("app_employer_application_interview_details", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
      fetch(detailsUrl)
        .then(function(r){ return r.json(); })
        .then(function(data){
            try {
                if (m) {
                    var body = m.querySelector('.modal-body');
                    if (body) {
                        var existing = body.querySelector('.existing-interviews');
                        if (existing && existing.parentElement) {
                            existing.parentElement.removeChild(existing);
                        }
                        var container = document.createElement('div');
                        container.className = 'existing-interviews';
                        if (data && data.success && data.interviews && data.interviews.length > 0) {
                            var html = '<div class="card card-body bg-light mb-3">';
                            html += '<h6 class="mb-2">Scheduled Interviews</h6>';
                            html += '<ul class="list-group">';
                            data.interviews.forEach(function(iv){
                                var dateStr = iv.date ? new Date(iv.date).toLocaleString() : 'TBD';
                                var plat = iv.platform || '';
                                var url = iv.url || '';
                                html += '<li class="list-group-item d-flex justify-content-between align-items-center">';
                                html += '<div><strong>' + dateStr + '</strong>' + (plat ? '<br><small class="text-muted">' + plat + '</small>' : '') + '</div>';
                                html += '<div class="btn-group">';
                                if (url) {
                                    html += '<a href="' + url + '" target="_blank" class="btn btn-sm btn-outline-primary">Open</a>';
                                }
                                html += '<button type="button" class="btn btn-sm btn-outline-secondary edit-interview-btn" data-id="' + iv.id + '" data-date="' + (iv.date || '') + '" data-platform="' + plat + '" data-url="' + url + '">Edit</button>';
                                html += '</div>';
                                html += '</li>';
                            });
                            html += '</ul>';
                            html += '</div>';
                            container.innerHTML = html;
                            
                            // Add edit listeners
                            container.querySelectorAll('.edit-interview-btn').forEach(function(btn){
                                btn.addEventListener('click', function(){
                                    var f = m.querySelector('form');
                                    if (!f) return;
                                    
                                    // Populate fields
                                    if (this.getAttribute('data-date')) {
                                        var d = new Date(this.getAttribute('data-date'));
                                        d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                                        var dateVal = d.toISOString().slice(0, 16);
                                        var dateInput = f.querySelector('[name="interview_date"]') || f.querySelector('[name="meeting_date"]');
                                        if (dateInput) dateInput.value = dateVal;
                                    }
                                    
                                    var platInput = f.querySelector('[name="meeting_platform"]') || f.querySelector('[name="platform"]');
                                    if (platInput) platInput.value = this.getAttribute('data-platform');
                                    
                                    var urlInput = f.querySelector('[name="meeting_url"]') || f.querySelector('[name="link"]');
                                    if (urlInput) urlInput.value = this.getAttribute('data-url');
                                    
                                    // Update Action
                                    var updateUrl = '{{ path("app_employer_application_updateinterview", {"id": "APP_ID", "interviewId": "INT_ID"}) }}'
                                        .replace('APP_ID', appId)
                                        .replace('INT_ID', this.getAttribute('data-id'));
                                    f.action = updateUrl;
                                    
                                    // Update Button Text
                                    var submitBtn = f.querySelector('button[type="submit"]');
                                    if (submitBtn) {
                                        submitBtn.textContent = 'Update Interview';
                                        submitBtn.classList.remove('btn-primary');
                                        submitBtn.classList.add('btn-warning');
                                    }
                                    
                                    // Show Cancel Button
                                    var cancelBtn = f.querySelector('.cancel-edit-btn');
                                    if (!cancelBtn) {
                                        cancelBtn = document.createElement('button');
                                        cancelBtn.type = 'button';
                                        cancelBtn.className = 'btn btn-secondary cancel-edit-btn ms-2';
                                        cancelBtn.textContent = 'Cancel Edit';
                                        cancelBtn.addEventListener('click', function(){
                                            f.reset();
                                            f.action = interviewUrl;
                                            if (submitBtn) {
                                                submitBtn.textContent = 'Schedule Interview';
                                                submitBtn.classList.add('btn-primary');
                                                submitBtn.classList.remove('btn-warning');
                                            }
                                            this.remove();
                                        });
                                        if (submitBtn) submitBtn.parentElement.appendChild(cancelBtn);
                                    }
                                });
                            });
                        if (data.interviews && data.interviews.length > 0) {
