        // Use event delegation for timeline buttons (handles dynamically loaded content)
        // Wait for document to be ready, or attach immediately if document exists
        function attachEventDelegation() {
            if (document.body) {
                document.addEventListener('click', function(e) {
                    // Handle timeline button clicks - but only if not in split view (split view has its own handler)
                    const isInSplitView = document.getElementById('split-view-container') && 
                                         window.getComputedStyle(document.getElementById('split-view-container')).display === 'grid';
                    
                    if (!isInSplitView && (e.target.closest('#timeline-btn') || e.target.closest('#detail-timeline-btn'))) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (typeof window.openTimelinePanel === 'function') {
                            window.openTimelinePanel();
                        } else {
                            console.error('openTimelinePanel function not available');
                        }
                    }
                    
                    // Handle timeline close button clicks
                    if (e.target.closest('.timeline-close')) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (typeof window.closeTimelinePanel === 'function') {
                            window.closeTimelinePanel();
                        }
                    }
                    
                    // Handle timeline overlay clicks
                    if (e.target.id === 'timeline-overlay' || e.target.classList.contains('timeline-overlay')) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (typeof window.closeTimelinePanel === 'function') {
                            window.closeTimelinePanel();
                        }
                    }
                }, true); // Use capture phase to catch events early
            } else {
                // Document not ready yet, wait for it
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', attachEventDelegation);
                } else {
                    setTimeout(attachEventDelegation, 0);
                }
            }
        }
        
        // Try to attach immediately, or wait for document
        if (typeof document !== 'undefined') {
            attachEventDelegation();
        }
    })();
    
    // Define loadApplicationDetails function in global scope
    function loadApplicationDetails(applicationId) {
