                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5 class="text-muted">Loading Application Details</h5>
                </div>
            `;
            applicationDetailContent.style.display = 'block';
        }
        if (noApplicationSelected) noApplicationSelected.style.display = 'none';
        
        // Update URL without reload
        const url = window.location.pathname + '?applicationId=' + applicationId;
        window.history.pushState({}, '', url);
        
        // Load application details via AJAX
        const jobId = '{{ job.id }}';
        const detailUrl = `/employer/jobs/${jobId}/applications/${applicationId}/detail`;
        
        fetch(detailUrl, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            }
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    throw new Error(`HTTP ${response.status}: ${text.substring(0, 100)}`);
                });
            }
            return response.text();
        })
        .then(html => {
            if (applicationDetailContent) {
                applicationDetailContent.innerHTML = html;
                applicationDetailContent.style.display = 'block';

                // Re-attach event handlers for hire/complete buttons after content is loaded
                const hireBtn = applicationDetailContent.querySelector('#hire-btn');
                const completeBtn = applicationDetailContent.querySelector('#complete-btn');
                
                if (hireBtn) {
                    hireBtn.onclick = function() {
                        updateApplicationStatus('hire');
                    };
                }
                
                if (completeBtn) {
                    completeBtn.onclick = function() {
                        updateApplicationStatus('complete');
                    };
