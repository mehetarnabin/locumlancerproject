/* Checkbox Styling */
.split-job-list input[type="checkbox"].job-checkbox,
.job-list-container input[type="checkbox"].job-checkbox {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid #cfd9e3;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    margin: 0;
    transition: all 0.2s ease;
    box-sizing: border-box;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
}

.split-job-list input[type="checkbox"].job-checkbox:hover,
.job-list-container input[type="checkbox"].job-checkbox:hover {
    border-color: #85BB65;
    background-color: #f7fef4;
}

.split-job-list input[type="checkbox"].job-checkbox:checked,
.job-list-container input[type="checkbox"].job-checkbox:checked {
    background-color: #85BB65;
    border-color: #85BB65;
}

.split-job-list input[type="checkbox"].job-checkbox:checked::after,
.job-list-container input[type="checkbox"].job-checkbox:checked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%) rotate(45deg);
    width: 5px;
    height: 10px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    box-sizing: border-box;
}

.list-toggle-btn {
