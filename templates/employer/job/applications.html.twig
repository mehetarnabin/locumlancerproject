                                newBtn.style.transition = 'all 0.2s ease';
                                newBtn.style.whiteSpace = 'nowrap';
                                newBtn.style.fontWeight = '500';
                                newBtn.style.textDecoration = 'none';
                                
                                // Add icon based on transition type
                                const transitionText = newBtn.textContent.trim();
                                const transitionLower = transitionText.toLowerCase();
                                
                                if (transitionLower === 'interview') {
                                    newBtn.innerHTML = `
