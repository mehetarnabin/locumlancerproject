                                    <label class="form-check-label" for="doc_license">State License</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="document_names[]" value="DEA Registration" id="doc_dea">
                                    <label class="form-check-label" for="doc_dea">DEA Registration</label>
                                </div>
