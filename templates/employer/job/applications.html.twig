    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filter Panel Toggle
        const filterBtn = document.getElementById('filter-btn');
        const filterPanel = document.getElementById('filter-panel');
        
        if (filterBtn && filterPanel) {
            filterBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const isHidden = filterPanel.classList.contains('hidden');
                if (isHidden) {
                    filterPanel.classList.remove('hidden');
                    filterPanel.style.display = 'block';
                } else {
                    filterPanel.classList.add('hidden');
                    filterPanel.style.display = 'none';
                }
            });
            
            // Close filter panel when clicking outside
            document.addEventListener('click', function(e) {
                if (filterPanel && filterBtn && !filterPanel.contains(e.target) && !filterBtn.contains(e.target)) {
                    filterPanel.classList.add('hidden');
                    filterPanel.style.display = 'none';
                }
            });
        }
        
        // Apply Filter
        const applyFilterBtn = document.getElementById('apply-filter-btn');
        if (applyFilterBtn) {
            applyFilterBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const statusFilter = document.getElementById('filter-status');
                const dateFilter = document.getElementById('filter-date-applied');
                
                const params = new URLSearchParams();
                if (statusFilter && statusFilter.value) {
                    params.append('status', statusFilter.value);
                }
                if (dateFilter && dateFilter.value) {
                    params.append('days', dateFilter.value);
                }
                
                const currentUrl = window.location.pathname;
                window.location.href = currentUrl + (params.toString() ? '?' + params.toString() : '');
            });
        }
        
        // Clear Filter
        const clearFilterBtn = document.getElementById('clear-filter-btn');
        if (clearFilterBtn) {
            clearFilterBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const currentUrl = window.location.pathname;
                window.location.href = currentUrl;
            });
        }
        
        // Split View Toggle
        const gridViewBtn = document.getElementById('grid-view-btn');
        const listViewContainer = document.getElementById('list-view-container');
        const splitViewContainer = document.getElementById('split-view-container');
        const splitJobList = document.getElementById('split-job-list');
        const splitJobDetails = document.getElementById('split-job-details');
        const applicationDetailContent = document.getElementById('application-detail-content');
        const noApplicationSelected = document.querySelector('.no-job-selected');
        const detailNoteBtn = document.getElementById('detail-note-btn');
        
        let selectedApplicationId = null;
        
        if (gridViewBtn && listViewContainer && splitViewContainer) {
            gridViewBtn.addEventListener('click', function() {
                const isSplitView = splitViewContainer.style.display === 'grid';
                
                if (isSplitView) {
                    // Switch to list view
                    splitViewContainer.style.display = 'none';
                    listViewContainer.style.display = 'block';
                    gridViewBtn.classList.remove('active');
                    gridViewBtn.innerHTML = `
                        <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3H10V10H3V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 3H21V10H14V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3 14H10V21H3V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Split View
                    `;
                    selectedApplicationId = null;
                    if (detailNoteBtn) detailNoteBtn.style.display = 'none';
                } else {
                    // Switch to split view
                    splitViewContainer.style.display = 'grid';
                    listViewContainer.style.display = 'none';
                    gridViewBtn.classList.add('active');
                    gridViewBtn.innerHTML = `
                        <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 6H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M3 11H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M3 16H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        List View
                    `;
                    
                    // Auto-select first application or current application
                    setTimeout(function() {
                        const currentAppId = new URLSearchParams(window.location.search).get('applicationId');
                        let cardToSelect = null;
                        
                        if (currentAppId && splitJobList) {
                            cardToSelect = splitJobList.querySelector(`.split-job-card[data-application-id="${currentAppId}"]`);
                        }
                        
                        if (!cardToSelect && splitJobList) {
                            cardToSelect = splitJobList.querySelector('.split-job-card');
                        }
                        
                        if (cardToSelect) {
                            selectApplicationCard(cardToSelect);
                        }
                    }, 200);
                }
            });
        }
        
        // Application card selection
        if (splitJobList) {
            splitJobList.addEventListener('click', function(e) {
                const appCard = e.target.closest('.split-job-card');
                if (appCard && !e.target.classList.contains('job-checkbox')) {
                    selectApplicationCard(appCard);
                }
            });
        }
        
        function selectApplicationCard(appCard) {
            // Remove active class from all cards
            document.querySelectorAll('.split-job-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to selected card
            appCard.classList.add('active');
            
            // Check the checkbox for the selected application
            const checkbox = appCard.querySelector('.job-checkbox');
            if (checkbox) {
                checkbox.checked = true;
                // Auto-deselect others
                document.querySelectorAll('.job-checkbox').forEach(cb => {
                    if (cb !== checkbox) {
                        cb.checked = false;
                    }
                });
            }
            
            // Get application ID and load details
            selectedApplicationId = appCard.dataset.applicationId;
            loadApplicationDetails(selectedApplicationId);
        }
        
        function loadApplicationDetails(applicationId) {
            if (!applicationId) return;
            
            // Show note button
            if (detailNoteBtn) {
                detailNoteBtn.style.display = 'flex';
            }
            
            // Show loading state
            if (applicationDetailContent) {
                applicationDetailContent.innerHTML = `
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5 class="text-muted">Loading Application Details</h5>
                    </div>
                `;
                applicationDetailContent.style.display = 'block';
            }
            if (noApplicationSelected) noApplicationSelected.style.display = 'none';
            
            // Load application details via URL
            const url = window.location.pathname + '?applicationId=' + applicationId;
            window.history.pushState({}, '', url);
            
            // Reload the page to show the selected application
            // In a real implementation, you'd use AJAX to load just the details
            // For now, we'll use the existing page structure
            setTimeout(function() {
                window.location.href = url;
            }, 100);
        }
        
        // Auto-deselection for checkboxes
        document.querySelectorAll('.job-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    // Uncheck all other checkboxes
                    document.querySelectorAll('.job-checkbox').forEach(cb => {
                        if (cb !== this) {
                            cb.checked = false;
                        }
                    });
                    
                    // If in split view, select the corresponding card
                    if (splitViewContainer && splitViewContainer.style.display === 'grid') {
                        const appId = this.dataset.applicationId;
                        if (appId) {
                            const card = splitJobList.querySelector(`.split-job-card[data-application-id="${appId}"]`);
                            if (card) {
                                selectApplicationCard(card);
                            }
                        }
                    }
                }
            });
        });
        
        // Notes Panel Functions
        window.openNotesPanel = function() {
            const notesPanel = document.getElementById('notes-panel');
            const jobDetails = document.getElementById('split-job-details');
            
            if (!notesPanel) return;
            
            // Close timeline if open
            const timelinePanel = document.getElementById('timeline-panel');
            if (timelinePanel && timelinePanel.classList.contains('open')) {
                closeTimelinePanel();
            }
            
            // Load notes from localStorage
            const appId = selectedApplicationId || new URLSearchParams(window.location.search).get('applicationId');
            if (appId) {
                const savedNotes = localStorage.getItem('application_notes_' + appId);
                const notesTextarea = document.getElementById('notes-textarea');
                if (notesTextarea && savedNotes) {
                    notesTextarea.value = savedNotes;
                }
            }
            
            notesPanel.classList.add('open');
            notesPanel.setAttribute('aria-hidden', 'false');
            
            if (jobDetails) {
                jobDetails.classList.add('notes-open');
            }
        };
        
        window.closeNotesPanel = function() {
            const notesPanel = document.getElementById('notes-panel');
            const jobDetails = document.getElementById('split-job-details');
            
            if (notesPanel) {
                notesPanel.classList.remove('open');
                notesPanel.setAttribute('aria-hidden', 'true');
            }
            
            if (jobDetails) {
                jobDetails.classList.remove('notes-open');
            }
        };
        
        // Note button click handler
        if (detailNoteBtn) {
            detailNoteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                openNotesPanel();
            });
        }
        
        // Auto-save notes
        const notesTextarea = document.getElementById('notes-textarea');
        if (notesTextarea) {
            let saveTimeout;
            notesTextarea.addEventListener('input', function() {
                clearTimeout(saveTimeout);
                saveTimeout = setTimeout(function() {
                    const appId = selectedApplicationId || new URLSearchParams(window.location.search).get('applicationId');
                    if (appId) {
                        localStorage.setItem('application_notes_' + appId, notesTextarea.value);
                        
                        // Update last saved time
                        const lastSaved = document.querySelector('.last-saved');
                        const lastSavedTime = document.querySelector('.last-saved-time');
                        if (lastSaved && lastSavedTime) {
                            lastSaved.style.display = 'flex';
                            lastSavedTime.textContent = 'just now';
                        }
                    }
                }, 1000);
            });
        }
        
        // Timeline Panel Functions
        window.openTimelinePanel = function() {
            const timelinePanel = document.getElementById('timeline-panel');
            const jobDetails = document.getElementById('split-job-details');
            
            if (!timelinePanel) return;
            
            // Close notes if open
            const notesPanel = document.getElementById('notes-panel');
            if (notesPanel && notesPanel.classList.contains('open')) {
                closeNotesPanel();
            }
            
            timelinePanel.classList.add('open');
            timelinePanel.setAttribute('aria-hidden', 'false');
            
            if (jobDetails) {
                jobDetails.classList.add('timeline-open');
            }
            
            // Load timeline data
            const appId = selectedApplicationId || new URLSearchParams(window.location.search).get('applicationId');
            if (appId) {
                loadTimelineData(appId);
            }
        };
        
        window.closeTimelinePanel = function() {
            const timelinePanel = document.getElementById('timeline-panel');
            const jobDetails = document.getElementById('split-job-details');
            
            if (timelinePanel) {
                timelinePanel.classList.remove('open');
                timelinePanel.setAttribute('aria-hidden', 'true');
            }
            
            if (jobDetails) {
                jobDetails.classList.remove('timeline-open');
            }
        };
        
        function loadTimelineData(applicationId) {
            const timelineContent = document.getElementById('timeline-content');
            if (!timelineContent) return;
            
            timelineContent.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading timeline...</p>
                </div>
            `;
            
            // For now, show basic timeline info
            // In a real implementation, you'd fetch this from an API
            setTimeout(function() {
                timelineContent.innerHTML = `
                    <div class="timeline-events">
                        <div class="timeline-event">
                            <div class="timeline-event-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9 11L12 14L22 4" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div class="timeline-event-content">
                                <h6 class="timeline-event-title">Application Timeline</h6>
                                <p class="timeline-event-description">Timeline information will be displayed here.</p>
                            </div>
                        </div>
                    </div>
                `;
            }, 500);
        }
    });
    </script>

