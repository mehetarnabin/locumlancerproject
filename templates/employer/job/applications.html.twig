                                    <input class="form-check-input" type="checkbox" id="doc_other_toggle">
                                    <label class="form-check-label" for="doc_other_toggle">Other</label>
                                </div>
                            </div>
                            <div class="mt-3" id="other_document_container" style="display:none;">
                                <label for="other_document_name" class="form-label" style="font-size: 13px;">Document Name</label>
                                <input type="text" class="form-control" name="document_name" id="other_document_name" placeholder="Enter document name">
