{# Filter Panel Component #}
{# This is a reusable filter panel component that can be included anywhere #}

<div class="position-relative" style="flex-shrink: 0;">
    <button id="filter-btn" class="action-btn" title="Filter" onclick="toggleFilterPanel(event)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7H21M7 12H17M10 17H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Filter</span>
    </button>
    <!-- Filter Dropdown Panel -->
    <div id="filter-panel" class="filter-panel custom-dropdown hidden" style="position: absolute; top: 100%; left: 0; margin-top: 8px; min-width: 340px; max-width: 380px; z-index: 9999; background: #fff; border: 1px solid #e6eef6; box-shadow: 0 4px 12px rgba(11,22,40,0.08); border-radius: 12px; padding: 0; display: none; overflow: hidden;">
        <form id="filter-form" onsubmit="applyFilters(event)">
            <!-- Header -->
            <div style="padding: 14px 16px 10px 16px; border-bottom: 1px solid #e6eef6; background: #f8f9fa;">
                <h6 style="margin: 0; font-weight: 600; color: #121C0C; font-size: 14px;">Filter Applications</h6>
                <p style="margin: 4px 0 0 0; font-size: 11px; color: #6b7280;">Refine your search results</p>
            </div>
            
            <!-- Tabs -->
            <div style="display: flex; border-bottom: 1px solid #e6eef6; background: #fff;">
                <button type="button" class="filter-tab active" data-tab="direct-jobs" onclick="switchFilterTab('direct-jobs', event)" style="flex: 1; padding: 10px 12px; background: transparent; border: none; border-bottom: 2px solid #85BB65; color: #85BB65; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    Direct jobs
                </button>
                <button type="button" class="filter-tab" data-tab="recruiter-assigned" onclick="switchFilterTab('recruiter-assigned', event)" style="flex: 1; padding: 10px 12px; background: transparent; border: none; border-bottom: 2px solid transparent; color: #6b7280; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                    Recruiter assigned jobs
                </button>
                <button type="button" class="filter-tab" data-tab="recruiter-applied" onclick="switchFilterTab('recruiter-applied', event)" style="flex: 1; padding: 10px 12px; background: transparent; border: none; border-bottom: 2px solid transparent; color: #6b7280; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                    Recruiter applied jobs
                </button>
            </div>
            
            <!-- Filter Content - Direct Jobs Tab -->
            <div id="direct-jobs-content" class="filter-tab-content" style="padding: 14px; max-height: 500px; overflow-y: auto; display: block;">
                <!-- Job ID Search -->
                <div style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Job ID</label>
                    <input type="text" id="filter-job-id" name="jobId" class="form-control" 
                           placeholder="Enter Job ID" 
                           value="{{ app.request.get('jobId') }}"
                           style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; width: 100%; transition: border-color 0.2s;" 
                           onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                </div>
                
                <!-- Location Filter -->
                <div style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Location</label>
                    <input type="text" id="filter-location" name="location" class="form-control" 
                           placeholder="City or state" 
                           value="{{ app.request.get('location') }}"
                           style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; width: 100%; transition: border-color 0.2s;" 
                           onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                </div>
                
                <!-- Salary Range Filter -->
                <div style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Salary Range</label>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="number" id="filter-salary-min" name="salaryMin" class="form-control" 
                               placeholder="Min" 
                               value="{{ app.request.get('salaryMin') }}"
                               style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; flex: 1; transition: border-color 0.2s;" 
                               onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                        <span style="color: #6b7280; font-weight: 500; font-size: 12px;">-</span>
                        <input type="number" id="filter-salary-max" name="salaryMax" class="form-control" 
                               placeholder="Max" 
                               value="{{ app.request.get('salaryMax') }}"
                               style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; flex: 1; transition: border-color 0.2s;" 
                               onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                    </div>
                </div>
                
                <!-- Category/Work Type Filter -->
                <div style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Work Type</label>
                    <select id="filter-category" name="category" class="form-control" 
                            style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; width: 100%; transition: border-color 0.2s; cursor: pointer;" 
                            onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                        <option value="">All Types</option>
                        <option value="locums" {% if app.request.get('category') == 'locums' %}selected{% endif %}>Locums</option>
                        <option value="parttime" {% if app.request.get('category') == 'parttime' %}selected{% endif %}>Part Time</option>
                        <option value="fulltime" {% if app.request.get('category') == 'fulltime' %}selected{% endif %}>Full Time</option>
                    </select>
                </div>
                
                <!-- Date Applied Filter -->
                <div style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Applied Within</label>
                    <select id="filter-date-applied" name="days" class="form-control" 
                            style="font-size: 12px; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; width: 100%; transition: border-color 0.2s; cursor: pointer;" 
                            onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                        <option value="">Any time</option>
                        <option value="1" {% if app.request.get('days') == '1' %}selected{% endif %}>Last 24 hours</option>
                        <option value="7" {% if app.request.get('days') == '7' %}selected{% endif %}>Last 7 days</option>
                        <option value="30" {% if app.request.get('days') == '30' %}selected{% endif %}>Last 30 days</option>
                        <option value="90" {% if app.request.get('days') == '90' %}selected{% endif %}>Last 3 months</option>
                    </select>
                </div>
                
                <!-- Candidate Status Filter -->
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500; color: #121C0C;">Candidate Status</label>
                    <select name="status" class="form-control form-select" style="width: 100%; padding: 8px 12px; border: 1px solid #e6eef6; border-radius: 8px; font-size: 12px; color: #000000; transition: border-color 0.2s; cursor: pointer;" onfocus="this.style.borderColor='#85BB65'" onblur="this.style.borderColor='#e6eef6'">
                        <option value="">All Statuses</option>
                        <option value="applied" {% if app.request.get('status') == 'applied' %}selected{% endif %}>Applied</option>
                        <option value="in_review" {% if app.request.get('status') == 'in_review' %}selected{% endif %}>Shortlisted</option>
                        <option value="interview" {% if app.request.get('status') == 'interview' %}selected{% endif %}>Interview</option>
                        <option value="offered" {% if app.request.get('status') == 'offered' %}selected{% endif %}>Offered</option>
                        <option value="hired" {% if app.request.get('status') == 'hired' %}selected{% endif %}>Hired</option>
                        <option value="completed" {% if app.request.get('status') == 'completed' %}selected{% endif %}>Completed</option>
                    </select>
                </div>
            </div>
            
            <!-- Filter Content - Recruiter Assigned Jobs Tab -->
            <div id="recruiter-assigned-content" class="filter-tab-content" style="padding: 14px; max-height: 500px; overflow-y: auto; display: none;">
                <div style="text-align: center; padding: 40px 20px; color: #6b7280;">
                    <p style="margin: 0; font-size: 12px;">Content coming soon</p>
                </div>
            </div>
            
            <!-- Filter Content - Recruiter Applied Jobs Tab -->
            <div id="recruiter-applied-content" class="filter-tab-content" style="padding: 14px; max-height: 500px; overflow-y: auto; display: none;">
                <div style="text-align: center; padding: 40px 20px; color: #6b7280;">
                    <p style="margin: 0; font-size: 12px;">Content coming soon</p>
                </div>
            </div>
            
            <!-- Footer with Action Buttons -->
            <div style="padding: 10px 14px; border-top: 1px solid #e6eef6; background: #f8f9fa; display: flex; gap: 8px;">
                <button type="button" onclick="clearFilters()" class="btn btn-sm" 
                        style="flex: 1; background: #fff; color: #121C0C; border: 1px solid #e6eef6; padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;" 
                        onmouseover="this.style.background='#f5f5f5'; this.style.borderColor='#d1d5db'" 
                        onmouseout="this.style.background='#fff'; this.style.borderColor='#e6eef6'">
                    Clear
                </button>
                <button type="submit" class="btn btn-sm" 
                        style="flex: 1; background: #85BB65; color: #fff; border: none; padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;" 
                        onmouseover="this.style.background='#75a855'" 
                        onmouseout="this.style.background='#85BB65'">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

