{% extends 'employer/base.html.twig' %}

{% block title %}Jobs{% endblock %}

{% block employer_body %}
<style>
/* Override parent container padding */
.app-content {
    padding: 32px 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
}

/* Override any container padding */
.container-xl,
.container-fluid,
.container,
.app-wrapper {
    padding-left: 24px !important;
    padding-right: 24px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    max-width: 100% !important;
}

@media (max-width: 1199.98px) {
    .app-content {
        padding: 24px 0 !important;
    }
    
    .container-xl,
    .container-fluid,
    .container,
    .app-wrapper {
        padding-left: 20px !important;
        padding-right: 20px !important;
    }
}

.job-header, .job-row {
    display: flex;
    align-items: center;
}

.job-header {
    margin-bottom: 1px !important;
    position: relative !important;
    height: 40px;
}

.col-job,
.col-location,
.col-schedule,
.col-expiry,
.col-start,
.col-action {
    flex: 1;
    min-width: 130px;
}
.col-job {
    flex: 2;
}
.job-header {
    color: #121C0C;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    border-radius: 10px;
    border: 1px solid #e6eef6;
    min-height: 48px;
    height: 48px;
    margin-bottom: 2px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.5;
    background: #F8FAF9;
    border-bottom: 2px solid #e6eef6;
    padding: 2px 14px 2px 0 !important;
    box-sizing: border-box !important;
}

.job-header > div,
.job-row > div {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    padding-left: 8px !important;
    padding-right: 8px !important;
}

.job-row {
    border: none;
    padding: 2px 14px 2px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 2px 0;
    font-size: 12px;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.5;
    border-radius: 10px;
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    min-height: 40px;
    height: auto;
    transition: background-color 0.2s ease;
}

.job-row:hover {
    background-color: #F8FAF9;
}

.truncate-text {
    display: inline-block;
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: middle;
}

.job-section {
    background-color: #fff;
}

.job-list-container {
    margin-top: 0 !important;
}

.col-center {
    text-align: center;
}

.job-title {
    color: #121C0C;
}

.icon-image {
    width: 25px;
}

.icon-jobsearch path {
    fill: #121C0C;
}

.app-utility-item a:hover .icon-jobsearch path {
    fill: #85BB65;
}

.app-utility-item a {
    padding: 2px 3px;
    border-radius: 8px;
}

.app-utility-item a:hover {
    background: #f7fef4;
}

.badge.badge-pill {
    background: none;
    animation: colorChange 1s infinite alternate;
    font-weight: 400 !important;
}

@keyframes colorChange {
    0% {
        color: #0096B8;
    }
    100% {
        color: #33DAFF;
    }
}

.app-page-title {
    color: #000000;
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 32px 4px;
}
</style>

    {% set statusColors = {
        'draft': 'applied',
        'published': 'interview',
        'paused': 'review',
        'closed': 'rejected'
    } %}

    {% set transitionColors = {
        'publish': 'success',
        'resume': 'success',
        'pause': 'warning',
        'close': 'danger'
    } %}

    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="app-page-title">Jobs</h1>
            <a href="{{ path('app_employer_job_new') }}" title="Create new job" class="d-flex align-items-center">
                <img src="{{ asset('assets/icons/create-new.png') }}" class="icon-image">
            </a>
        </div>

        <div class="job-section">
            <div class="job-list-container bg-light rounded-3" style="padding: 0 1rem 1rem 1rem;">
                <div class="d-flex align-items-center job-lists">
                    <div class="d-flex align-items-center flex-grow-1">
                        <div class="job-header d-flex align-items-center gap-2 fw-semibold py-2 flex-grow-1">
                            <div class="col-job flex-grow-2">Job</div>
                            <div class="col-start col-center flex-grow-1">Profession</div>
                            <div class="col-start col-center flex-grow-1">Speciality</div>
                            <div class="col-start col-center flex-grow-1">Status</div>
                            <div class="col-start col-center flex-grow-1">Verified</div>
                            <div class="col-start col-center flex-grow-1">Created At</div>
                            <div class="col-action flex-grow-1 text-center">Actions</div>
                        </div>
                    </div>
                </div>

                {% for job in jobs %}
                    <div class="d-flex align-items-center job-lists">
                        <div class="job-row d-flex align-items-center flex-grow-1 gap-2">
                            <div class="col-job d-flex align-items-center gap-2 flex-grow-2">
                                <img src="{{ job.companyLogo|default(asset('assets/icons/job.png')) }}"
                                     alt="Logo"
                                     style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;"
                                     onerror="this.src='{{ asset('assets/icons/job.png') }}'" />
                                <div class="flex-grow-2">
                                    <a class="job-title truncate-text d-block fw-semibold text-decoration-none"
                                       href="{{ path('app_employer_job_applications', {'id': job.id}) }}">
                                        {{ job.title }}
                                    </a>
                                    <div class="job-meta text-muted small" style="font-size: 11px;">
                                        ID: {{ job.jobId }}
                                    </div>
                                </div>
                            </div>
                            <div class="col-start col-center flex-grow-1">{{ job.profession }}</div>
                            <div class="col-start col-center flex-grow-1">{{ job.speciality }}</div>
                            <div class="col-start col-center flex-grow-1">
                                <span class="badge badge-pill is-{{ statusColors[job.status] ?? 'dark' }}">
                                    {{ job.status|capitalize }}
                                </span>
                            </div>
                            <div class="col-start col-center flex-grow-1">{{ job.verified ? 'YES' : 'NO' }}</div>
                            <div class="col-start col-center flex-grow-1">{{ job.createdAt ? job.createdAt|date('m/d/Y') : '' }}</div>
                            <div class="col-action flex-grow-1 text-center">
                                <div class="d-flex justify-content-center gap-2 align-items-center">
                                    {% if job.status == 'draft' or job.status == 'published' or job.status == 'paused' %}
                                        <a href="{{ path('app_employer_job_edit', {'id': job.id}) }}"
                                           title="Edit">
                                            <img src="{{ asset('assets/icons/edit-file.png') }}" class="icon-image" />
                                        </a>
                                    {% endif %}
                                    <a href="{{ path('app_employer_job_applications', {'id': job.id}) }}"
                                        title="Applications">
                                        <img src="{{ asset('assets/icons/list-search.png') }}" class="icon-image" />
                                    </a>
                                    {% for transition in jobTransitions[job.id.toString()] %}
                                        <a href="{{ path('app_employer_job_transition', {id: job.id, transition: transition}) }}"
                                           title="{{ transition|capitalize }} Job">
                                            {% if transition == 'close' %}<img src="{{ asset('assets/icons/padlock.png') }}" class="icon-image" />{% endif %}
                                            {% if transition == 'publish' %}<img src="{{ asset('assets/icons/document.png') }}" class="icon-image" />{% endif %}
                                            {% if transition == 'pause' %}<img src="{{ asset('assets/icons/pause.png') }}" class="icon-image" />{% endif %}
                                            {% if transition == 'resume' %}<img src="{{ asset('assets/icons/refresh-arrow.png') }}" class="icon-image" />{% endif %}
                                        </a>
                                    {% endfor %}
                                    <a href="{{ path('app_employer_job_delete', {'id': job.id}) }}"
                                       title="Remove" 
                                       onclick="return confirm('Are you sure? Do you want to delete this job.')">
                                        <img src="{{ asset('assets/icons/delete.png') }}" class="icon-image" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="d-flex align-items-center job-lists">
                        <div class="job-row d-flex align-items-center flex-grow-1">
                            <div class="col-12 text-center py-4">
                                <p class="text-muted mb-0">No records found</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if jobs.nbPages > 1 %}
            <div class="col-12 mt-4">
                {{ pagerfanta(jobs, 'twitter_bootstrap5') }}
            </div>
        {% endif %}

    </div>
{% endblock %}
