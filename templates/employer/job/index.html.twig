                </div>
                {% else %}
                    <div class="d-flex align-items-center job-lists">
                        <div class="job-row d-flex align-items-center flex-grow-1">
                            <div class="col-12 text-center py-4">
                                <p class="text-muted mb-0">No records found</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if jobs.nbPages > 1 %}
            <div class="col-12 mt-4">
                {{ pagerfanta(jobs, 'twitter_bootstrap5') }}
            </div>
        {% endif %}

    </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.job-checkbox');
    const actionButtons = {
        edit: document.getElementById('edit-job-btn'),
        applications: document.getElementById('applications-btn'),
        pause: document.getElementById('pause-job-btn'),
        publish: document.getElementById('publish-job-btn'),
        close: document.getElementById('close-job-btn'),
        delete: document.getElementById('delete-job-btn')
    };

    function updateActionButtons() {
        const selectedJobs = Array.from(checkboxes).filter(cb => cb.checked);
        const hasSelection = selectedJobs.length > 0;
        const singleSelection = selectedJobs.length === 1;
        const selectedJob = singleSelection ? selectedJobs[0] : null;
        const selectedStatus = selectedJob ? selectedJob.dataset.jobStatus : null;

        // Show/hide button groups based on selection
        const leftGroup = document.querySelector('.job-actions-left');
        const middleGroup = document.querySelector('.job-actions-middle');
        const rightGroup = document.querySelector('.job-actions-right');

        if (hasSelection) {
            leftGroup.classList.add('has-selection');
            middleGroup.classList.add('has-selection');
            rightGroup.classList.add('has-selection');
        } else {
            leftGroup.classList.remove('has-selection');
            middleGroup.classList.remove('has-selection');
            rightGroup.classList.remove('has-selection');
        }

        // Enable/disable buttons based on selection
        // Disable edit if job is mediated
        const isMediated = selectedJob ? selectedJob.dataset.isMediated === 'true' : false;
        
        actionButtons.edit.disabled = !singleSelection || isMediated;
        actionButtons.applications.disabled = !singleSelection;
        actionButtons.delete.disabled = !hasSelection;

        // Status-specific buttons
        if (singleSelection && selectedStatus) {
            actionButtons.pause.disabled = selectedStatus !== 'published';
            actionButtons.publish.disabled = selectedStatus !== 'draft' && selectedStatus !== 'paused';
            actionButtons.close.disabled = selectedStatus === 'closed';
        } else {
            actionButtons.pause.disabled = true;
            actionButtons.publish.disabled = true;
            actionButtons.close.disabled = true;
        }
    }

    // Add event listeners to checkboxes
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateActionButtons);
    });

    // Select all checkbox functionality (if needed)
    const selectAllCheckbox = document.querySelector('.select-all-checkbox');
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateActionButtons();
        });
    }

    // Initialize button states
    updateActionButtons();
});

function getSelectedJobIds() {
    return Array.from(document.querySelectorAll('.job-checkbox:checked')).map(cb => cb.dataset.jobId);
}

function handleEditSelected() {
    const selected = document.querySelector('.job-checkbox:checked');
    if (selected && selected.dataset.editUrl) {
        window.location.href = selected.dataset.editUrl;
    }
}

function handleViewApplications() {
    const selected = document.querySelector('.job-checkbox:checked');
    if (selected && selected.dataset.applicationsUrl) {
        window.location.href = selected.dataset.applicationsUrl;
    }
}

function handlePauseSelected() {
    const selected = document.querySelectorAll('.job-checkbox:checked');
    if (selected.length > 0 && confirm('Are you sure you want to pause the selected job(s)?')) {
        const url = selected[0].dataset.pauseUrl;
        if (url) {
            window.location.href = url;
        }
    }
}

function handlePublishSelected() {
    const selected = document.querySelectorAll('.job-checkbox:checked');
    if (selected.length > 0 && confirm('Are you sure you want to publish the selected job(s)?')) {
        const url = selected[0].dataset.publishUrl;
        if (url) {
            window.location.href = url;
        }
    }
}

function handleCloseSelected() {
    const selected = document.querySelectorAll('.job-checkbox:checked');
    if (selected.length > 0 && confirm('Are you sure you want to close the selected job(s)?')) {
        const url = selected[0].dataset.closeUrl;
        if (url) {
            window.location.href = url;
        }
    }
}

function handleDeleteSelected() {
    const selected = document.querySelectorAll('.job-checkbox:checked');
    if (selected.length > 0 && confirm('Are you sure? Do you want to delete the selected job(s)?')) {
        const deleteUrl = selected[0].dataset.deleteUrl;
        if (deleteUrl) {
            if (confirm('This action cannot be undone. Are you absolutely sure?')) {
                window.location.href = deleteUrl;
            }
        }
    }
}
</script>
