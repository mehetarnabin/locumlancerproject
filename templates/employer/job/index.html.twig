                                            {{ job.title }}
                                        </a>
                                        <div class="job-meta small" style="font-size: 11px; color: #666666; margin-top: 2px; text-align: left;">
                                            ID: {{ job.jobId }}
                                            {% if job.jobRecruiters|length > 0 %}
                                                <span class="badge bg-info text-white ms-2" style="font-size: 9px; padding: 2px 5px;">Recruiter Mediated</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="col-start" style="flex: 1; min-width: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; font-size: 12px;">{{ job.profession }}</div>
