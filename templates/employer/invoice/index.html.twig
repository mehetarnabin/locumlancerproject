                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                        <div class="sortable col-center" data-sort="provider" data-column="provider" style="width: 150px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 4px;">
                            Provider
                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                        <div class="sortable" data-sort="particular" data-column="particular" style="width: 200px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; text-align: left; gap: 4px;">
                            Particular
                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                        <div class="sortable col-center" data-sort="amount" data-column="amount" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 4px;">
                            Amount($)
                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                        <div class="sortable col-center" data-sort="date" data-column="date" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 4px;">
                            Created At
                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                        <div class="sortable col-center" data-sort="status" data-column="status" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 4px;">
                            Status
                            <span class="sort-toggle">
                                <svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);">
                                    <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-list-container bg-light rounded-3">
            {% for invoice in invoices %}
                <div class="d-flex align-items-center invoice-lists">
                    <div class="invoice-row d-flex align-items-center flex-grow-1" style="width: 100%; min-width: 0; gap: 0; box-sizing: border-box !important;">
                        <div class="col-check" style="width: 30px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center;">
                            <input type="checkbox" class="invoice-checkbox" data-invoice-id="{{ invoice.id }}" />
                        </div>
                        <div data-column="number" style="width: 150px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; font-size: 12px;">
                            {% if invoice.status == 'paid' %}
                                <a href="{{ path('app_employer_invoice_show', {'id': invoice.id}) }}" style="color: #121C0C; text-decoration: none; font-weight: 500;">
                                    {{ invoice.invoiceNumber }}
                                </a>
                            {% elseif invoice.status == 'pending' %}
                                <a href="{{ path('app_employer_invoice_pay', {'id': invoice.id}) }}" style="color: #121C0C; text-decoration: none; font-weight: 500;">
                                    {{ invoice.invoiceNumber }}
                                </a>
                            {% else %}
                                {{ invoice.invoiceNumber }}
                            {% endif %}
                        </div>
                        <div data-column="job" style="width: 150px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; font-size: 12px;">{{ invoice.job }}</div>
                        <div data-column="provider" style="width: 150px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ invoice.provider }}</div>
                        <div data-column="particular" style="width: 200px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; font-size: 12px;">{{ invoice.particular }}</div>
                        <div data-column="amount" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">${{ invoice.amount|number_format(2, '.', ',') }}</div>
                        <div data-column="date" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ invoice.createdAt ? invoice.createdAt|date('m/d/Y') : '—' }}</div>
                        <div data-column="status" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                            <span class="badge badge-pill {% if invoice.status == 'pending' %}is-review{% elseif invoice.status == 'paid' %}is-hired{% endif %}">
                                {{ invoice.status|title }}
                            </span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% else %}
            <div class="invoice-list-container bg-light rounded-3" style="padding: 40px; text-align: center;">
                <p class="mb-0">No invoices found.</p>
            </div>
        {% endif %}
    </div>
</div>

<script>
// Filter button toggle
document.addEventListener('DOMContentLoaded', function() {
    const filterBtn = document.getElementById('filter-btn');
    const filterPanel = document.getElementById('filter-panel');
    
    if (filterBtn && filterPanel) {
        filterBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            filterPanel.classList.toggle('hidden');
        });
        
        // Close filter panel when clicking outside
        document.addEventListener('click', function(e) {
            if (!filterBtn.contains(e.target) && !filterPanel.contains(e.target)) {
                filterPanel.classList.add('hidden');
            }
        });
    }
    
    // Menu dropdown toggle
    const menuBtn = document.querySelector('.menu-dropdown-btn');
    const menuPanel = document.querySelector('.menu-panel');
    
    if (menuBtn && menuPanel) {
        menuBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            menuPanel.classList.toggle('hidden');
        });
        
        // Close menu panel when clicking outside
        document.addEventListener('click', function(e) {
            if (!menuBtn.contains(e.target) && !menuPanel.contains(e.target)) {
                menuPanel.classList.add('hidden');
            }
        });
    }
    
    // Clear filter button
    const clearFilterBtn = document.getElementById('clear-filter-btn');
    if (clearFilterBtn) {
        clearFilterBtn.addEventListener('click', function() {
            document.getElementById('filter-status').value = '';
            document.getElementById('filter-date-from').value = '';
            document.getElementById('filter-date-to').value = '';
            document.getElementById('filter-amount-min').value = '';
            document.getElementById('filter-amount-max').value = '';
        });
    }
    
    // Apply filter button (placeholder - implement actual filtering logic)
    const applyFilterBtn = document.getElementById('apply-filter-btn');
    if (applyFilterBtn) {
        applyFilterBtn.addEventListener('click', function() {
            // TODO: Implement actual filtering logic
            alert('Filter functionality will be implemented');
        });
    }
    
    // Handle checkbox selection to show/hide View and Analytics buttons
    const viewBtn = document.getElementById('view-btn');
    const analyticsBtn = document.getElementById('analytics-btn');
    const checkboxes = document.querySelectorAll('.invoice-checkbox');
    
    function updateActionButtons() {
        const selectedCheckboxes = Array.from(checkboxes).filter(cb => cb.checked);
        const hasSelection = selectedCheckboxes.length > 0;
        
        if (viewBtn) {
            if (hasSelection) {
                viewBtn.classList.remove('hidden-btn');
                viewBtn.classList.add('visible-btn');
            } else {
                viewBtn.classList.add('hidden-btn');
                viewBtn.classList.remove('visible-btn');
            }
        }
        
        if (analyticsBtn) {
            if (hasSelection) {
                analyticsBtn.classList.remove('hidden-btn');
                analyticsBtn.classList.add('visible-btn');
            } else {
                analyticsBtn.classList.add('hidden-btn');
                analyticsBtn.classList.remove('visible-btn');
            }
        }
    }
    
    // Add event listeners to all checkboxes
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateActionButtons);
    });
    
    // View button handler
    if (viewBtn) {
        viewBtn.addEventListener('click', function() {
            const selectedCheckboxes = Array.from(checkboxes).filter(cb => cb.checked);
            if (selectedCheckboxes.length === 0) {
                alert('Please select at least one invoice to view.');
                return;
            }
            
            // If only one is selected, go directly to that invoice
            if (selectedCheckboxes.length === 1) {
                const invoiceId = selectedCheckboxes[0].dataset.invoiceId;
                // Get the invoice row to find the link
                const invoiceRow = selectedCheckboxes[0].closest('.invoice-row');
                const invoiceLink = invoiceRow.querySelector('a[href*="invoice"]');
                if (invoiceLink) {
                    window.location.href = invoiceLink.href;
                } else {
                    // Fallback: construct URL
                    window.location.href = '/employer/invoice/' + invoiceId + '/show';
                }
            } else {
                // Multiple selected - open first one or show modal
                const firstInvoiceId = selectedCheckboxes[0].dataset.invoiceId;
                const firstRow = selectedCheckboxes[0].closest('.invoice-row');
                const firstLink = firstRow.querySelector('a[href*="invoice"]');
                if (firstLink) {
                    window.location.href = firstLink.href;
                } else {
                    window.location.href = '/employer/invoice/' + firstInvoiceId + '/show';
                }
            }
        });
    }
    
    // Analytics button handler
    if (analyticsBtn) {
        analyticsBtn.addEventListener('click', function() {
            const selectedCheckboxes = Array.from(checkboxes).filter(cb => cb.checked);
            if (selectedCheckboxes.length === 0) {
                alert('Please select at least one invoice for analytics.');
                return;
            }
            
            const selectedIds = Array.from(selectedCheckboxes).map(cb => cb.dataset.invoiceId);
            // TODO: Implement analytics functionality
            alert('Analytics functionality will be implemented for selected invoices: ' + selectedIds.join(', '));
        });
    }
    
    // Select all checkbox functionality (if you want to add a header checkbox)
    // This is optional but useful for UX
});
</script>
{% endblock %}
