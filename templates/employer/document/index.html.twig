<script>
    document.addEventListener('DOMContentLoaded', function() {
        // COMPLETE REMOVAL - Remove modal backdrop overlay entirely
        function removeModalBackdrop() {
            const backdrops = document.querySelectorAll('.modal-backdrop, [class*="modal-backdrop"]');
            backdrops.forEach(backdrop => {
                backdrop.remove();
                backdrop.style.display = 'none';
                backdrop.style.visibility = 'hidden';
                backdrop.style.opacity = '0';
            });
        }
        
        // Prevent Bootstrap from creating backdrop - override modal initialization
        if (window.bootstrap && window.bootstrap.Modal) {
            const OriginalModal = window.bootstrap.Modal;
            window.bootstrap.Modal = function(element, config) {
                // Force backdrop to false
                const newConfig = Object.assign({}, config || {}, {
                    backdrop: false,
                    keyboard: true
                });
                return new OriginalModal(element, newConfig);
            };
            // Copy static methods
            Object.setPrototypeOf(window.bootstrap.Modal, OriginalModal);
            Object.getOwnPropertyNames(OriginalModal).forEach(name => {
                if (name !== 'prototype' && name !== 'length' && name !== 'name') {
                    window.bootstrap.Modal[name] = OriginalModal[name];
                }
            });
        }
        
        // Remove backdrop when modals are shown
        document.querySelectorAll('[data-bs-toggle="modal"]').forEach(button => {
            button.addEventListener('click', function() {
                setTimeout(removeModalBackdrop, 1);
                setTimeout(removeModalBackdrop, 10);
                setTimeout(removeModalBackdrop, 50);
                setTimeout(removeModalBackdrop, 100);
            });
        });
        
        // Watch for dynamically added backdrops - AGGRESSIVE REMOVAL
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1) {
                        if (node.classList && (node.classList.contains('modal-backdrop') || node.className.includes('modal-backdrop'))) {
                            node.remove();
                        }
                        // Also check children
                        const childBackdrops = node.querySelectorAll ? node.querySelectorAll('.modal-backdrop, [class*="modal-backdrop"]') : [];
                        childBackdrops.forEach(bd => bd.remove());
                    }
                });
            });
            // Also check all existing backdrops
            removeModalBackdrop();
        });
        
        observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class']
        });
        
        // Remove any existing backdrops immediately and continuously
        removeModalBackdrop();
        setInterval(removeModalBackdrop, 100);
        
        // Also remove backdrop on modal show events
        document.addEventListener('shown.bs.modal', removeModalBackdrop);
        document.addEventListener('show.bs.modal', removeModalBackdrop);
        
        // Simple Split View Logic
        const container = document.getElementById('documents-split-view');
        const listPanel = document.getElementById('documents-list');
        const previewPanel = document.getElementById('documents-preview');
        const toggleBtn = document.getElementById('documents-toggle-btn');
        
        const placeholder = document.getElementById('preview-placeholder');
        const header = document.getElementById('preview-header');
        const title = document.getElementById('preview-title');
        const actions = document.getElementById('preview-actions');
        const frame = document.getElementById('preview-frame');

        // Toggle Button Click
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                container.classList.toggle('list-collapsed');
            });
        }

        // Toggle Bundle Expand/Collapse
        window.toggleBundle = function(bundleId) {
            const bundleContent = document.getElementById(bundleId);
            const bundleCard = bundleContent.closest('.document-bundle-card');
            
            if (bundleCard) {
                bundleCard.classList.toggle('expanded');
                if (bundleCard.classList.contains('expanded')) {
                    bundleContent.style.display = 'block';
                } else {
                    bundleContent.style.display = 'none';
                }
            }
        };

        // Handle Document Selection
        window.showDocumentPreview = function(element) {
            // Remove active class from all
            document.querySelectorAll('.document-item-card').forEach(el => el.classList.remove('active'));
            // Add active to clicked
            element.classList.add('active');

            const docName = element.getAttribute('data-doc-name');
            const downloadUrl = element.getAttribute('data-doc-download-url');
            const viewUrl = element.getAttribute('data-doc-view-url');
            const externalUrl = element.getAttribute('data-external-url');

            // Set Title
            title.textContent = docName;

            // Set Actions
            let actionHtml = '';
            if (downloadUrl) {
                actionHtml += `<a href="${downloadUrl}" class="btn btn-primary btn-sm me-2">Download</a>`;
            }
            if (viewUrl) {
                // Check if it's likely viewable (optional, but good for UX)
                 actionHtml += `<a href="${viewUrl}" target="_blank" class="btn btn-outline-primary btn-sm">Open in New Tab</a>`;
            }
            if (externalUrl) {
                actionHtml += `<a href="${externalUrl}" target="_blank" class="btn btn-outline-primary btn-sm">Visit Link</a>`;
            }
            actions.innerHTML = actionHtml;

            // Show Header and Frame, Hide Placeholder
            placeholder.style.display = 'none';
            header.style.display = 'flex';
            
            // Handle Content
            if (viewUrl) {
                frame.src = viewUrl;
                frame.style.display = 'block';
                // Reset styling to ensure full height underneath header
                frame.style.height = '100%';
                frame.style.width = '100%';
            } else if (externalUrl) {
                 // For external links, we might not be able to iframe them due to X-Frame-Options
                 // So we show a message
                 frame.style.display = 'none';
                 placeholder.style.display = 'flex';
                 placeholder.innerHTML = `
                    <div class="text-center">
                        <p class="mb-3">This is an external link.</p>
                        <a href="${externalUrl}" target="_blank" class="btn btn-primary">Open Link</a>
                    </div>
                 `;
            } else {
                 frame.style.display = 'none';
                 placeholder.style.display = 'flex';
                 placeholder.innerHTML = '<p>No preview available.</p>';
            }
        };
    });
</script>
<script>
    function toggleDocumentInput(select) {
        var customInputDiv = document.getElementById('customDocumentInput');
        var customInputField = document.getElementById('customDocNameField');
        if (select.value === 'Other') {
            customInputDiv.style.display = 'block';
            customInputField.required = true;
        } else {
            customInputDiv.style.display = 'none';
            customInputField.required = false;
        }
    }

    function prepareDocumentRequest() {
        var select = document.getElementById('documentTypeSelect');
        var customInput = document.getElementById('customDocNameField');
        var finalInput = document.getElementById('finalDocumentName');

        if (select.value === 'Other') {
            finalInput.value = customInput.value;
        } else {
            finalInput.value = select.value;
        }

        if (!finalInput.value) {
            alert('Please select or enter a document name.');
            return false;
        }
        return true;
    }
</script>
{% endblock %}
