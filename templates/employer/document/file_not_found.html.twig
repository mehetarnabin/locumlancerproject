{% extends 'base.html.twig' %}

{% block title %}File Not Found{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="text-center p-5 rounded-3 shadow-sm bg-white" style="max-width: 500px; width: 100%;">
        <div class="mb-4 text-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-file-earmark-x" viewBox="0 0 16 16">
                <path d="M6.854 7.146a.5.5 0 1 0-.708.708L7.293 9l-1.147 1.146a.5.5 0 0 0 .708.708L8 9.707l1.146 1.147a.5.5 0 0 0 .708-.708L8.707 9l1.147-1.146a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146z"/>
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
            </svg>
        </div>
        <h2 class="h4 mb-3 fw-bold text-dark">Document Not Found</h2>
        <p class="text-muted mb-4">
            We couldn't locate the file you are looking for. It may have been moved, deleted, or never fully uploaded.
        </p>
        
        {% if checked_path is defined and app.environment == 'dev' %}
            <div class="alert alert-light border text-start mb-4 bg-light py-2 px-3 small">
                <strong class="d-block text-secondary mb-1">Technical Details:</strong>
                <code class="text-break">{{ checked_path }}</code>
            </div>
        {% endif %}

        <a href="{{ path('app_employer_documents') }}" class="btn btn-primary px-4 py-2 rounded-pill fw-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            Back to Documents
        </a>
    </div>
</div>
{% endblock %}
