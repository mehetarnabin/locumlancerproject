    <div class="modal fade" id="sendOfferModal" tabindex="-1" aria-labelledby="sendOfferLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sendOfferLabel">Send Offer/Contract Letter</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="" method="POST" enctype="multipart/form-data" id="sendOfferForm">
                    <div class="modal-body">
                        <div class="mb-4">
                            <label class="form-label">Select Document Type *</label>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 50%; text-align: center;">Offer Letter</th>
                                        <th style="width: 50%; text-align: center;">Contract Letter</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td onclick="document.getElementById('document_type_offer').click();">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="document_type" id="document_type_offer" value="offer" required>
                                                <label class="form-check-label" for="document_type_offer">
                                                    <svg class="icon-image" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                        <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    </svg>
                                                    <span style="display: block; margin-top: 8px; font-weight: 500; font-size: 13px;">Offer Letter</span>
                                                </label>
                                            </div>
                                        </td>
                                        <td onclick="document.getElementById('document_type_contract').click();">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="document_type" id="document_type_contract" value="contract" required>
                                                <label class="form-check-label" for="document_type_contract">
                                                    <svg class="icon-image" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                        <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    </svg>
                                                    <span style="display: block; margin-top: 8px; font-weight: 500; font-size: 13px;">Contract Letter</span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Upload Document *</label>
                            <input type="file" class="form-control" name="document_file" accept=".pdf,.doc,.docx" required>
                        </div>
                        <input type="hidden" id="sendOfferApplicationId" name="application_id">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </form>
                <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const sendOfferForm = document.getElementById('sendOfferForm');
                    if (sendOfferForm) {
                        sendOfferForm.addEventListener('submit', function(e) {
                            e.preventDefault();
                            
                            const applicationId = document.getElementById('sendOfferApplicationId').value;
                            if (!applicationId) {
                                alert('Please select an application first.');
                                return;
                            }
                            
                            // Check if document type is selected
                            const documentType = this.querySelector('input[name="document_type"]:checked');
                            if (!documentType) {
                                alert('Please select a document type (Offer Letter or Contract Letter).');
                                return;
                            }
                            
                            // Check if file is selected
                            const fileInput = this.querySelector('input[type="file"][name="document_file"]');
                            if (!fileInput || !fileInput.files || !fileInput.files[0]) {
                                alert('Please select a file to upload.');
                                return;
                            }
                            
                            // Create FormData and ensure file is included
                            const formData = new FormData(this);
                            
                            // Verify file is in FormData
                            if (!formData.has('document_file') || !formData.get('document_file')) {
                                alert('File upload failed. Please try selecting the file again.');
                                return;
                            }
                            
                            const url = "{{ path('app_employer_application_sendoffer', {'id': 'APPLICATION_ID'}) }}".replace('APPLICATION_ID', applicationId);
                            
                            // Show loading state
                            const submitBtn = this.querySelector('button[type="submit"]');
                            const originalText = submitBtn ? submitBtn.textContent : 'Send';
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.textContent = 'Sending...';
                            }
                            
                            fetch(url, {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                // Don't set Content-Type header - let browser set it with boundary for multipart/form-data
                            })
                            .then(response => {
                                // Check if response is JSON
                                const contentType = response.headers.get('content-type');
                                if (contentType && contentType.includes('application/json')) {
                                    return response.json();
                                } else {
                                    // If not JSON, read as text to see the error
                                    return response.text().then(text => {
                                        console.error('Non-JSON response:', text);
                                        throw new Error('Server returned non-JSON response');
                                    });
                                }
                            })
                            .then(data => {
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = originalText;
                                }
                                
                                if (data.success) {
                                    alert(data.message || 'Offer letter sent successfully.');
                                    // Modal will close on reload
                                    location.reload();
                                } else {
                                    alert(data.message || 'Failed to send offer letter.');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = originalText;
                                }
                                alert('An error occurred while sending the offer letter. Please check the console for details.');
                            });
                        });
                    }
                });
                </script>
            </div>
        </div>
    </div>

