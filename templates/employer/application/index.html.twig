    {% set statusColors = {
        'applied': 'applied',
        'in_review': 'review',
        'interview': 'interview',
        'offered': 'offered',
        'accepted': 'accepted', 
        'rejected': 'rejected',
        'hired': 'hired',
        'completed': 'completed'
    } %}

    {% set allStatuses = ['applied', 'in_review', 'interview', 'offered', 'hired', 'completed'] %}

    <div class="container-xl">
        <div class="job-section shadow-lg p-3 rounded-3">

            <div class="application">
                <div class="row g-2 mb-3">
                    <div class="col">
                        <a href="{{ path('app_employer_applications') }}">
                            <div class="card is-card mb-3 is-applied {% if app.request.get('status') == '' %}active{% endif %}">
                                <div class="card-body">
                                    <h6 class="card-title">All</h6>
                                    <p class="card-text">{{ totalApplications|number_format }}</p>
                                </div>
                            </div>
                        </a>
                    </div>

                    {% for status in allStatuses %}
                        {% set count = 0 %}
                        {% for item in statusCounts %}
                            {% if item.status == status %}
                                {% set count = item.count %}
                            {% endif %}
                        {% endfor %}
                        <div class="col">
                            <a href="{{ path('app_employer_applications', {'status': status}) }}">
                                <div class="card is-card mb-3 is-{{ statusColors[status] }} {% if app.request.get('status') == status %}active{% endif %}">
                                    <div class="card-body">
                                        <h6 class="card-title">
                                            {% if status == 'in_review' %}
                                                Negotiating
                                            {% else %}
                                                {{ status | replace({'_': ' '}) | title }}
                                            {% endif %}
                                        </h6>
                                        <p class="card-text">{{ count }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="actions-container">
                <!-- Left Group: Filter + Status-based Action Buttons -->
