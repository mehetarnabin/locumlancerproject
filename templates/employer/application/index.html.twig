                            }
                            setTimeout(() => { 
                                modalEl.style.zIndex = '200000';
                                const bd = document.querySelector('.modal-backdrop');
                                if (bd) bd.style.zIndex = '199999';
                            }, 100);
                        } else if ((window.$ || window.jQuery) && ((window.$ && window.$.fn && window.$.fn.modal) || (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal))) {
                            var $ = window.$ || window.jQuery;
                            $(modalEl).modal('show');
                            setTimeout(() => { 
                                $(modalEl).css('z-index', '200000'); 
                                const bd = document.querySelector('.modal-backdrop');
                                if (bd) bd.style.zIndex = '199999';
                            }, 100);
                        } else {
                            modalEl.classList.add('show');
                            modalEl.style.display = 'block';
                            modalEl.setAttribute('aria-hidden', 'false');
                            modalEl.style.zIndex = '200000';
                        }
                    }
                }).catch(function(){
                    var modalEl = document.getElementById('assignedDocsModal');
                    if (modalEl) {
                        if (window.bootstrap && window.bootstrap.Modal) {
                            try {
                                var ModalCtor = window.bootstrap.Modal;
                                if (typeof ModalCtor.getOrCreateInstance === 'function') {
                                    ModalCtor.getOrCreateInstance(modalEl).show();
                                } else {
                                    new ModalCtor(modalEl).show();
                                }
                            } catch(_){
                                try {
                                    var M = window.bootstrap.Modal;
                                    new M(modalEl).show();
                                } catch(__){}
                            }
                        } else {
                            modalEl.classList.add('show');
                            modalEl.style.display = 'block';
                            modalEl.setAttribute('aria-hidden', 'false');
                        }
                    }
                    if (listEl) {
                        var li = document.createElement('li');
                        li.className = 'list-group-item';
                        li.textContent = 'Failed to load documents';
                        listEl.appendChild(li);
                    }
                });
            } catch(_) {}
        }
        
        try { window.handleEmployerTodoIconClick = handleEmployerTodoIconClick; } catch(_){}
        try { window.openEmployerDocsModal = openEmployerDocsModal; } catch(_){}
        
        document.addEventListener('click', function(ev){
            var el = ev.target.closest('.todo-icon-wrapper');
            if (!el) return;
            ev.preventDefault && ev.preventDefault();
            ev.stopPropagation && ev.stopPropagation();
            try {
                console.log('Global listener triggering handler');
                if (window.handleEmployerTodoIconClick) {
                    window.handleEmployerTodoIconClick(ev, el);
                } else {
                    alert('Error: Handler not found');
                }
            } catch(e){ console.error(e); alert('Error in global listener: ' + e.message); }
        }, true);
    </script>

    <script>
        // Sorting functionality for all sortable columns
        document.addEventListener('DOMContentLoaded', function() {
            // Mark as initialized to prevent base template script from running
            window.sortingInitialized = true;
            
            const headers = document.querySelectorAll('.sortable');
            let currentSort = { key: null, direction: 'asc' };

            const getText = (cell) => (cell?.textContent || '').trim();
            const getLowerText = (cell) => getText(cell).toLowerCase();
            const parseNumericText = (text) => {
                if (!text) return 0;
                const cleaned = text.replace(/[^0-9.]/g, '');
                const parsed = parseFloat(cleaned);
                return isNaN(parsed) ? 0 : parsed;
            };
            const parseDate = (text) => {
                if (!text || text === '—') return 0;
                // Parse MM/DD/YYYY format
                const parts = text.split('/');
                if (parts.length === 3) {
                    return new Date(parts[2], parts[0] - 1, parts[1]).getTime();
                }
                return 0;
            };

            function performSort(header, direction) {
                const key = header.dataset.sort || header.dataset.column;
                if (!key) return;
                
                currentSort = { key, direction };

                // Reset all arrows to inactive
                document.querySelectorAll('.sort-toggle .arrow').forEach(a => a.classList.remove('active'));
                
                // Activate the appropriate arrow on current header
                const up = header.querySelector('.sort-toggle .sort-up');
                const down = header.querySelector('.sort-toggle .sort-down');
                if (direction === 'asc' && up) up.classList.add('active');
                if (direction === 'desc' && down) down.classList.add('active');

                sortApplications(key, direction);
            }

            headers.forEach(header => {
                // Click on header (but not on arrows) - toggle sort direction
                header.addEventListener('click', function(e) {
                    // If clicking directly on an arrow, let the arrow handler deal with it
                    if (e.target.closest('.arrow')) {
                        return;
                    }
                    
                    const key = header.dataset.sort || header.dataset.column;
                    if (!key) return;
                    
                    // Toggle direction if same column, otherwise default to asc
                    const direction = (currentSort.key === key && currentSort.direction === 'asc') ? 'desc' : 'asc';
                    performSort(header, direction);
                });
                
                // Click on up arrow - sort ascending
                const upArrow = header.querySelector('.sort-toggle .sort-up');
                if (upArrow) {
                    upArrow.style.cursor = 'pointer';
                    upArrow.addEventListener('click', function(e) {
                        e.stopPropagation();
                        e.preventDefault();
                        performSort(header, 'asc');
                    });
                }
                
                // Click on down arrow - sort descending
                const downArrow = header.querySelector('.sort-toggle .sort-down');
                if (downArrow) {
                    downArrow.style.cursor = 'pointer';
                    downArrow.addEventListener('click', function(e) {
                        e.stopPropagation();
                        e.preventDefault();
                        performSort(header, 'desc');
                    });
                }
            });

            function sortApplications(key, direction) {
                const rows = Array.from(document.querySelectorAll('.job-row')).map(row => {
                    const jobCell = row.querySelector('.col-job');
                    const locationCell = row.querySelector('.col-location');
                    const salaryCell = row.querySelector('.col-salary');
                    const employerCell = row.querySelector('.col-employer');
                    const appliedCell = row.querySelector('.col-applied');
                    const categoryCell = row.querySelector('.col-category');
                    const statusCell = row.querySelector('.col-status');
                    const rankCell = row.querySelector('.col-rank');
                    
                    return {
                        element: row.parentElement, // Get the parent div.job-lists
                        data: {
                            job: getLowerText(jobCell?.querySelector('.job-title')) || getLowerText(jobCell),
                            location: getLowerText(locationCell),
                            salary: parseNumericText(getText(salaryCell)),
                            employer: getLowerText(employerCell),
                            applied: parseDate(getText(appliedCell)),
                            category: getLowerText(categoryCell),
                            status: getLowerText(statusCell),
                            rank: (() => {
                                const rankDisplay = rankCell?.querySelector('.rank-display');
                                const rankValue = rankDisplay?.getAttribute('data-rank-value');
                                if (rankValue) {
                                    return parseFloat(rankValue);
                                }
                                const rankText = getText(rankCell);
                                if (rankText === '—' || rankText === '') return 0;
                                const parsed = parseFloat(rankText);
                                return isNaN(parsed) ? 0 : parsed;
                            })()
                        }
                    };
                });

                rows.sort((a, b) => {
                    const valA = a.data[key];
                    const valB = b.data[key];
                    
                    if (valA === undefined || valB === undefined) {
                        return 0;
                    }
                    
                    if (typeof valA === 'string') {
                        return direction === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    } else {
                        return direction === 'asc' ? valA - valB : valB - valA;
                    }
                });

                const container = document.querySelector('.job-list-container .table-responsive-wrapper');
                if (container) {
                    rows.forEach(row => {
                        if (row.element) {
                            container.appendChild(row.element);
                        }
                    });
                }
            }
        });
    </script>

    <script>
        // Score/Rank display - editing removed, display only
        // No editing functionality needed - just display the score
        
        document.addEventListener('DOMContentLoaded', function() {
            // Split View Button Handler - Toggle split view on same page
            const gridViewBtn = document.getElementById('grid-view-btn');
            const listViewContainer = document.querySelector('.job-list-container');
            const splitViewContainer = document.getElementById('split-view-container');
            const splitJobList = document.getElementById('split-job-list');
            const splitJobDetails = document.getElementById('split-job-details');
            const applicationDetailContent = document.getElementById('application-detail-content');
            const noApplicationSelected = document.querySelector('.no-job-selected');
            
            let selectedApplicationId = null;
            
            // Function to load application details via AJAX
            function loadApplicationDetails(applicationId, jobId) {
                if (!applicationId || !jobId) return;
                
                const detailUrl = `/employer/jobs/${jobId}/applications/${applicationId}/detail`;
                
                if (applicationDetailContent) {
                    applicationDetailContent.innerHTML = `
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h5 class="text-muted">Loading Application Details</h5>
                        </div>
                    `;
                    applicationDetailContent.style.display = 'block';
                }
                if (noApplicationSelected) noApplicationSelected.style.display = 'none';
                
                fetch(detailUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'text/html'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.text();
                })
                .then(html => {
                    if (applicationDetailContent) {
                        applicationDetailContent.innerHTML = html;
                        applicationDetailContent.style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error loading application details:', error);
                    if (applicationDetailContent) {
                        applicationDetailContent.innerHTML = `
                            <div class="text-center py-5">
                                <p class="text-danger">Error loading application details. Please try again.</p>
                                <button onclick="loadApplicationDetails('${applicationId}', '${jobId}')" class="btn btn-primary mt-2">Retry</button>
                            </div>
                        `;
                    }
                });
            }
            
            // Function to select application card
            function selectApplicationCard(appCard) {
                document.querySelectorAll('.split-job-card').forEach(card => {
                    card.classList.remove('active');
                });
                
                appCard.classList.add('active');
                
                const checkbox = appCard.querySelector('.job-checkbox');
                if (checkbox) {
                    checkbox.checked = true;
                    document.querySelectorAll('.job-checkbox').forEach(cb => {
                        if (cb !== checkbox) {
                            cb.checked = false;
                        }
                    });
                }
                
                const applicationId = appCard.dataset.applicationId;
                const jobId = appCard.dataset.jobId;
                
                if (applicationId && jobId) {
                    selectedApplicationId = applicationId;
                    loadApplicationDetails(applicationId, jobId);
                }
            }
            
            if (gridViewBtn && listViewContainer && splitViewContainer) {
                gridViewBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    
                    const computedStyle = window.getComputedStyle(splitViewContainer);
                    const isSplitView = computedStyle.display === 'grid' || splitViewContainer.style.display === 'grid';
                    
                    // Get table headers
                    const tableHeaders = document.querySelectorAll('.job-header');
                    
                    if (isSplitView) {
                        // Switch to list view
                        splitViewContainer.style.display = 'none';
                        if (listViewContainer) listViewContainer.style.display = 'block';
                        gridViewBtn.classList.remove('active');
                        gridViewBtn.innerHTML = `
                            <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 3H10V10H3V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 3H21V10H14V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 14H10V21H3V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Split View
                        `;
                        // Show table headers in list view
                        tableHeaders.forEach(header => {
                            header.style.display = 'flex';
                        });
                    } else {
                        // Switch to split view
                        splitViewContainer.style.display = 'grid';
                        if (listViewContainer) listViewContainer.style.display = 'none';
                        gridViewBtn.classList.add('active');
                        gridViewBtn.innerHTML = `
                            <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 11H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M3 16H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            List View
                        `;
                        // Hide table headers in split view
                        tableHeaders.forEach(header => {
                            header.style.display = 'none';
                        });
                        
                        // Show placeholder or auto-select first application
                        if (noApplicationSelected) {
                            noApplicationSelected.style.display = 'flex';
                        }
                        if (applicationDetailContent) {
                            applicationDetailContent.style.display = 'none';
                        }
                        
                        // Auto-select first application or checked application
                        setTimeout(function() {
                            const checkedCheckbox = document.querySelector('.job-checkbox:checked');
                            let cardToSelect = null;
                            
                            if (checkedCheckbox && splitJobList) {
                                const appId = checkedCheckbox.getAttribute('data-application-id');
                                cardToSelect = splitJobList.querySelector(`.split-job-card[data-application-id="${appId}"]`);
                            }
                            
                            if (!cardToSelect && splitJobList) {
                                cardToSelect = splitJobList.querySelector('.split-job-card');
                            }
                            
                            if (cardToSelect) {
                                selectApplicationCard(cardToSelect);
                            }
                        }, 100);
                    }
                    
                    return false;
                }, true);
            }
            
            // Application card selection in split view
            if (splitJobList) {
                splitJobList.addEventListener('click', function(e) {
                    if (e.target.closest('a')) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    
                    const appCard = e.target.closest('.split-job-card');
                    if (appCard) {
                        if (e.target.classList.contains('job-checkbox') || e.target.closest('.job-checkbox')) {
                            return;
                        }
                        
                        e.preventDefault();
                        e.stopPropagation();
                        selectApplicationCard(appCard);
                    }
                });
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle clicking on candidate name in list view to open split view
            document.addEventListener('click', function(e) {
                const trigger = e.target.closest('.candidate-split-trigger');
                if (!trigger) return;
                
                e.preventDefault();
                e.stopPropagation();
                
                const appId = trigger.dataset.applicationId;
                if (!appId) return;
                
                const splitViewContainer = document.getElementById('split-view-container');
                const gridViewBtn = document.getElementById('grid-view-btn');
                
                // If not in split view, toggle it
                if (splitViewContainer && (splitViewContainer.style.display === 'none' || window.getComputedStyle(splitViewContainer).display === 'none')) {
                    if (gridViewBtn) gridViewBtn.click();
                }
                
                // Select the card
                setTimeout(() => {
                    const splitJobList = document.getElementById('split-job-list');
                    if (splitJobList) {
                        const card = splitJobList.querySelector(`.split-job-card[data-application-id="${appId}"]`);
                        if (card) {
                            card.click();
                            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                }, 100);
            });
        });
    </script>
