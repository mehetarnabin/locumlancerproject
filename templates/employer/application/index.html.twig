        function showModal(el) {
            if (!el) return;
            try {
                if (el.parentElement !== document.body) {
                    document.body.appendChild(el);
                }
            } catch(_){}
            if (window.bootstrap && window.bootstrap.Modal) {
                try {
                    var ModalCtor = window.bootstrap.Modal;
                    if (typeof ModalCtor.getOrCreateInstance === 'function') {
                        ModalCtor.getOrCreateInstance(el).show();
                    } else {
                        new ModalCtor(el).show();
                    }
                } catch(_){
                    try {
                        var M = window.bootstrap.Modal;
                        new M(el).show();
                    } catch(__){}
                }
                setTimeout(() => { 
                    el.style.zIndex = '200000'; 
                    const bd = document.querySelector('.modal-backdrop');
                    if (bd) bd.style.zIndex = '199999';
                }, 100);
                return;
            }
            if ((window.$ || window.jQuery) && ((window.$ && window.$.fn && window.$.fn.modal) || (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal))) {
                var $ = window.$ || window.jQuery;
                $(el).modal('show');
                setTimeout(() => { 
                    $(el).css('z-index', '200000'); 
                    const bd = document.querySelector('.modal-backdrop');
                    if (bd) bd.style.zIndex = '199999';
                }, 100);
                return;
            }
            el.classList.add('show');
            try {
                el.style.setProperty('display', 'flex', 'important');
                el.style.setProperty('position', 'fixed', 'important');
                el.style.setProperty('top', '0', 'important');
                el.style.setProperty('left', '0', 'important');
                el.style.setProperty('width', '100vw', 'important');
                el.style.setProperty('height', '100vh', 'important');
                el.style.setProperty('align-items', 'center', 'important');
                el.style.setProperty('justify-content', 'center', 'important');
                el.style.setProperty('background', 'rgba(0,0,0,0.5)', 'important');
                el.style.setProperty('z-index', '200000', 'important');
                el.style.setProperty('pointer-events', 'auto', 'important');
            } catch(_){
                el.style.display = 'flex';
                el.style.position = 'fixed';
                el.style.top = '0';
                el.style.left = '0';
                el.style.width = '100vw';
                el.style.height = '100vh';
                el.style.alignItems = 'center';
                el.style.justifyContent = 'center';
                el.style.background = 'rgba(0,0,0,0.5)';
                el.style.zIndex = '200000';
                el.style.pointerEvents = 'auto';
            }
            el.setAttribute('aria-hidden', 'false');
            try {
                document.body.classList.add('modal-open');
                var existing = document.querySelector('.modal-backdrop');
                if (!existing) {
                    var bd = document.createElement('div');
                    bd.className = 'modal-backdrop fade show';
                    bd.style.zIndex = '199999';
                    document.body.appendChild(bd);
                }
                var closeBtn = el.querySelector('[data-bs-dismiss="modal"], [data-dismiss="modal"]');
                if (closeBtn) {
                    closeBtn.addEventListener('click', function(){
                        el.classList.remove('show');
                        el.style.display = 'none';
                        document.body.classList.remove('modal-open');
                        var b = document.querySelector('.modal-backdrop');
                        if (b && b.parentElement) b.parentElement.removeChild(b);
                    });
                }
            } catch(_){}
        }


        // Force assignment to override any previous definitions
        window.handleEmployerTodoIconClick = function(event, element) {
            // alert('DEBUG: Todo Icon Clicked'); 
            console.log('Todo icon clicked', element);

            var e = event; 
            var el = element;

            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            var card = el.closest('.split-job-card'); 
            
            var appId = el.getAttribute('data-application-id') || (card ? card.getAttribute('data-application-id') : '');
             if (!appId) {
                const urlParams = new URLSearchParams(window.location.search);
                appId = urlParams.get('applicationId');
             }

            // Determine action type
            var icon = el.querySelector('.todo-icon');
            var iconType = icon ? icon.getAttribute('data-todo-icon-type') : '';
            
            var actionText = (el.getAttribute('data-todo-action') || '').toLowerCase();
            var status = (el.getAttribute('data-status') || '').toLowerCase().replace(/_/g,'');
            if (!iconType || iconType === '') {
                if (status === 'completed') iconType = 'review';
                else if (status === 'interview' || status === 'interviewing') iconType = 'interview';
                else if (status === 'negotiating' || status === 'offered') iconType = 'contract';
                else if (status === 'accepted' || status === 'hired') iconType = 'credentialing';
                else iconType = 'documents';
            }
            if (!actionText || actionText === '') {
                if (iconType === 'review') actionText = 'see your review';
                else if (iconType === 'interview') actionText = 'confirm interview from the list of interview dates';
                else if (iconType === 'contract') actionText = 'review signed offer/contract';
                else if (iconType === 'credentialing') actionText = 'request credentialing docs';
                else actionText = 'documents';
            }

            console.log('Detected Action:', actionText, 'Type:', iconType, 'AppId:', appId);

            // URLs
            var reviewUrl = '{{ path("app_employer_application_review_provider", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
            var contractUrl = '{{ path("app_employer_application_sendcontract", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
            var interviewUrl = '{{ path("app_employer_application_scheduleinterview", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
            var docReqUrl = '{{ path("app_employer_application_askfordocument", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
            var reviewDetailsUrl = '{{ path("app_employer_application_review_details", {"id": "00000000-0000-0000-0000-000000000000"}) }}'.replace('00000000-0000-0000-0000-000000000000', appId);
            
            function openSafeModal(modalId, actionUrl) {
                var m = document.getElementById(modalId);
                if (!m) {
                    console.error('Modal not found:', modalId);
                    // alert('Debug Error: Modal ' + modalId + ' not found.');
                    return;
                }
                
                if (actionUrl) {
                    var f = m.querySelector('form');
                    if(f) f.action = actionUrl;
                }
                
                // Try Bootstrap 5 (standard)
                var bs5Success = false;
                if (window.bootstrap && window.bootstrap.Modal) {
                    try {
                        // Check if getOrCreateInstance exists (BS 5.0.2+)
                        if (typeof window.bootstrap.Modal.getOrCreateInstance === 'function') {
                            window.bootstrap.Modal.getOrCreateInstance(m).show();
                            bs5Success = true;
                        } 
                        // Check if getInstance exists (BS 5+)
                        else if (typeof window.bootstrap.Modal.getInstance === 'function') {
                            var ins = window.bootstrap.Modal.getInstance(m);
                            if (!ins) ins = new window.bootstrap.Modal(m);
                            ins.show();
                            bs5Success = true;
                        }
                        // Fallback to constructor
                        else {
                             new window.bootstrap.Modal(m).show();
                             bs5Success = true;
                        }
                    } catch(e) {
                        console.warn('Bootstrap 5 modal failed:', e);
                        bs5Success = false;
                    }
                }
                
                if (bs5Success) return;

                // Try jQuery / Bootstrap 4
                if (window.jQuery && window.jQuery.fn.modal) {
                     try {
                        window.jQuery(m).modal('show');
                        return;
                     } catch(e) {
                        console.warn('jQuery modal failed:', e);
                     }
                } 
                
                // Manual Fallback (Robust)
                console.log('Using manual modal fallback');
                m.classList.add('show');
                m.style.setProperty('display', 'block', 'important');
                m.style.setProperty('opacity', '1', 'important');
                m.setAttribute('aria-modal', 'true');
                m.setAttribute('role', 'dialog');
                document.body.classList.add('modal-open');
                
                var bd = document.querySelector('.modal-backdrop');
                if (!bd) {
                     bd = document.createElement('div');
                     bd.className = 'modal-backdrop fade show';
                     document.body.appendChild(bd);
                }
                
                // Attach close handlers for manual mode
                var closes = m.querySelectorAll('[data-bs-dismiss="modal"], [data-dismiss="modal"], .btn-close');
                closes.forEach(btn => {
                    btn.onclick = function() {
                        m.classList.remove('show');
                        m.style.display = 'none';
                        document.body.classList.remove('modal-open');
                        var bd = document.querySelector('.modal-backdrop');
                        if (bd) bd.remove();
                    };
                });
            }

            if (iconType === 'review' || actionText.includes('review')) {
                // Pre-fetch details logic (kept from previous, assuming it works)
                var m = document.getElementById('reviewModal');
                 if (m) {
                    var f = m.querySelector('form');
                    if (f) f.reset();
                    var titleEl = m.querySelector('.modal-title');
                    if (titleEl) titleEl.textContent = 'Loading Review...';
                }
                
                openSafeModal('reviewModal', reviewUrl);
                
                fetch(reviewDetailsUrl)
                    .then(r => r.json())
                    .then(data => {
                        if (m) {
                            var titleEl = m.querySelector('.modal-title');
                            var dateEl = document.getElementById('reviewDate');
                            if (data.success && data.hasReview) {
                                if (titleEl) titleEl.textContent = 'Your Review';
                                if (dateEl) { dateEl.textContent = data.review.date || ''; dateEl.style.display = data.review.date ? 'block' : 'none'; }
                                var f = m.querySelector('form');
                                if (f) {
                                    var msg = f.querySelector('[name="message"], [name="review_text"]');
                                    if (msg) { msg.value = data.review.message || ''; }
                                    ['professionalism', 'quality', 'communication', 'emotional_intelligence'].forEach(function(k){
                                        var val = data.review[k];
                                        if (val) {
                                            var radio = f.querySelector('input[name="' + k + '"][value="' + val + '"]');
                                            if (radio) radio.checked = true;
                                        }
                                        f.querySelectorAll('input[name="' + k + '"]').forEach(function(r){ r.disabled = true; });
                                    });
                                    f.querySelectorAll('input, textarea, select').forEach(function(i){ try { i.disabled = true; } catch(_){} });
                                    var btn = m.querySelector('button[type="submit"]');
                                    if (btn) btn.style.display = 'none';
                                }
                            } else {
                                if (titleEl) titleEl.textContent = 'Write a Review';
                                if (dateEl) { dateEl.textContent = ''; dateEl.style.display = 'none'; }
                                var f = m.querySelector('form');
                                if (f) {
                                    f.querySelectorAll('input, textarea, select').forEach(function(i){ try { i.disabled = false; } catch(_){} });
                                    var btn = m.querySelector('button[type="submit"]');
                                    if (btn) btn.style.display = 'block';
                                }
                            }
                        }
                    })
                    .catch(function(){
                         if (m) {
                            var titleEl = m.querySelector('.modal-title');
                            if (titleEl) titleEl.textContent = 'Write a Review';
                            var f = m.querySelector('form');
                            if (f) {
                                 f.querySelectorAll('input, textarea, select').forEach(function(i){ try { i.disabled = false; } catch(_){} });
                                 var btn = m.querySelector('button[type="submit"]');
                                 if (btn) btn.style.display = 'block';
                            }
                        }
                    });
                return false;
            }
            
            if (iconType === 'contract' || actionText.includes('contract') || actionText.includes('offer')) {
                openSafeModal('sendOfferModal', contractUrl);
                return false;
            }
            
            if (iconType === 'interview' || actionText.includes('interview')) {
                 openSafeModal('interviewModal', interviewUrl);
                 return false;
            }
            
            if (iconType === 'credentialing' || iconType === 'documents' || actionText.includes('document')) {
                  openSafeModal('askDocumentModal', docReqUrl);
                  return false;
            }
            
            // Removed showTodoModalForApplication(card) as it is undefined here
            console.warn('Unhandled Todo Action:', actionText, iconType);
            
            return false;
        }
        
        function openEmployerDocsModal(appId) {
            try {
                var listEl = document.getElementById('assignedDocsList');
                var iframeEl = document.getElementById('assignedDocPreview');
                if (listEl) listEl.innerHTML = '';
                if (iframeEl) iframeEl.src = '';
                fetch(window.location.origin + '/employer/applications/' + appId + '/document-requests', {
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                }).then(function(r){ return r.json(); }).then(function(data){
                    var items = [];
                    if (data && data.contractUrl) {
                        items.push({ name: 'Contract', url: data.contractUrl });
                    }
                    var reqs = (data && data.documentRequests) ? data.documentRequests : [];
                    reqs.forEach(function(dr){
                        var name = dr && dr.name ? dr.name : ((dr && dr.document && dr.document.name) ? dr.document.name : 'Document');
                        var url = (dr && dr.document && dr.document.url) ? dr.document.url : null;
                        items.push({ name: name, url: url, pending: !url });
                    });
                    var sent = items.filter(function(it){ return !!it.url; });
                    if (sent.length === 0) {
                        if (listEl) {
                            var li = document.createElement('li');
                            li.className = 'list-group-item';
                            li.textContent = 'No documents provided by provider';
                            listEl.appendChild(li);
