    <script>
    // Functions for Calendly-style Modal
    let selectedDateStr = null;
    let selectedTimeStr = null;
    let selectedFullDateTime = null;

    function setMeetingDuration(btn, minutes) {
        document.getElementById('meeting_duration').value = minutes;
        
        document.querySelectorAll('.duration-chip-mini').forEach(chip => chip.classList.remove('active'));
        btn.classList.add('active');
        
        document.getElementById('duration-text').textContent = minutes + ' min';
        
        if (selectedDateStr) {
            generateTimeSlots(selectedDateStr);
        }
    }
    
    function generateTimeSlots(dateStr) {
        selectedDateStr = dateStr;
        const container = document.getElementById('time-slots-container');
        container.innerHTML = '';
        
        const dateObj = new Date(dateStr);
        const optionsDate = { weekday: 'long', month: 'long', day: 'numeric' };
        document.getElementById('selected-date-header').textContent = dateObj.toLocaleDateString('en-US', optionsDate);
        
        // Generate slots from 9 AM to 5 PM
        const startHour = 9;
        const endHour = 17;
        
        for (let h = startHour; h < endHour; h++) {
            ['00', '30'].forEach(min => {
                const timeLabel = formatTimeDisplay(h, min);
                const fullDateTime = `${dateStr} ${h.toString().padStart(2, '0')}:${min}`;
                
                // Row container
                const row = document.createElement('div');
                row.className = 'time-slot-row';
                
                // Time Button
                const slotBtn = document.createElement('button');
                slotBtn.type = 'button';
                slotBtn.className = 'time-slot-btn';
                slotBtn.textContent = timeLabel;
                
                // Next Button
                const nextBtn = document.createElement('button');
                nextBtn.type = 'button';
                nextBtn.className = 'next-btn';
                nextBtn.textContent = 'Next';
                nextBtn.onclick = () => confirmTimeSlot(fullDateTime, timeLabel);
                
                // Handle Click on Slot
                slotBtn.onclick = () => {
                   // Reset all
                   document.querySelectorAll('.time-slot-btn').forEach(b => {
                       b.classList.remove('active-slot');
                       b.style.width = '100%';
                       b.style.display = 'flex'; // Ensure visible
                   });
                   document.querySelectorAll('.next-btn').forEach(b => b.style.display = 'none');
                   
                   // Activate this one
                   slotBtn.classList.add('active-slot');
                   nextBtn.style.display = 'flex';
                };
                
                row.appendChild(slotBtn);
                row.appendChild(nextBtn);
                container.appendChild(row);
            });
        }
    }
    
    function formatTimeDisplay(hour, min) {
        const ampm = hour >= 12 ? 'pm' : 'am';
        const h12 = hour % 12 || 12;
        return `${h12}:${min}${ampm}`;
    }
    
    function confirmTimeSlot(fullDateTime, timeLabel) {
        selectedFullDateTime = fullDateTime;
        selectedTimeStr = timeLabel;
        
        // Set hidden input
        document.getElementById('meeting_date').value = fullDateTime;
        
        // Switch to details view
        document.getElementById('view-time-slots').style.display = 'none';
        document.getElementById('view-details').style.display = 'flex';
        
        // Update details header
        const dateObj = new Date(selectedDateStr);
        const optionsDate = { weekday: 'long', month: 'long', day: 'numeric' };
        const duration = document.getElementById('meeting_duration').value;
        const niceDate = dateObj.toLocaleDateString('en-US', optionsDate);
        
        document.getElementById('confirm-time-display').innerHTML = `
            <div style="font-weight: 600; color: #333; margin-bottom: 4px;">${selectedTimeStr} - ${addMinutes(selectedTimeStr, duration)}</div>
            <div>${niceDate}</div>
            <div style="font-size: 12px; color: #888; margin-top: 4px;">${document.getElementById('local-timezone')?.textContent || ''}</div>
        `;
    }
    
    function addMinutes(timeStr, minutes) {
        var match = timeStr.match(/(\d+):(\d+)(am|pm)/i);
        if (!match) return timeStr;
        
        var h = parseInt(match[1]);
        var m = parseInt(match[2]);
        var amp = match[3].toLowerCase();
        
        if (amp === 'pm' && h < 12) h += 12;
        if (amp === 'am' && h === 12) h = 0;
        
        var totalMinutes = h * 60 + m + parseInt(minutes);
        var newH = Math.floor(totalMinutes / 60) % 24;
        var newM = totalMinutes % 60;
        
        var newAmp = newH >= 12 ? 'pm' : 'am';
        var showH = newH % 12 || 12;
        var showM = newM.toString().padStart(2, '0');
        
        return showH + ':' + showM + newAmp;
    }
    
    function showTimeSlots() {
        document.getElementById('view-details').style.display = 'none';
        document.getElementById('view-time-slots').style.display = 'flex';
    }

    // Set timezone
    document.addEventListener('DOMContentLoaded', function() {
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const el = document.getElementById('local-timezone');
            if(el) el.textContent = tz;
        } catch(e){}
    });
    </script>

    <script>
    // Initialize Calendly Modal Logic for index.html.twig
    document.addEventListener('DOMContentLoaded', function() {
        var modalId = 'scheduleInterviewModal';
        var modalEl = document.getElementById(modalId);
        
        if (modalEl) {
            // Function to initialize Flatpickr when modal is shown
            var onShow = function(event) {
                // Initialize Flatpickr if not already initialized
                if (!modalEl.dataset.flatpickrInitialized) {
                    if (typeof flatpickr === 'function') {
                        flatpickr('#inline-flatpickr', {
                            enableTime: false,
                            dateFormat: "Y-m-d",
                            inline: true,
                            minDate: "today",
                            disableMobile: true,
                            onChange: function(selectedDates, dateStr, instance) {
                                if (typeof generateTimeSlots === 'function') {
                                    generateTimeSlots(dateStr);
                                }
                            }
                        });
                        modalEl.dataset.flatpickrInitialized = 'true';
                    }
                }
                
                // Get the button that triggered the modal
                var button = event.relatedTarget; 
                
                var appId = null;
                if (button) {
                    // Try standard attribute first, then variations
                    appId = button.getAttribute('data-application-id') || 
                            button.getAttribute('data-application_id') ||
                            (button.dataset ? button.dataset.applicationId : null);
                }
                
                // Fallback to global selectedApplicationId
                if (!appId && typeof selectedApplicationId !== 'undefined') {
                    appId = selectedApplicationId;
                }

                 // Fallback to finding it in the DOM if we are in the details view
                if (!appId) {
                     const scheduleBtn = document.getElementById('action-schedule-interview-btn');
                     if (scheduleBtn) appId = scheduleBtn.getAttribute('data-application_id');
                }

                // CRITICAL FIX: If triggered manually (e.g. from handleEmployerTodoIconClick), 
                // the input might already have the ID set. Use it if we haven't found one yet.
                if (!appId) {
                    var existingInput = document.getElementById('scheduleInterviewApplicationId');
                    if (existingInput && existingInput.value) {
                        appId = existingInput.value;
                    }
                }
                
                if (appId) {
                    // Set hidden input
                    document.getElementById('scheduleInterviewApplicationId').value = appId;
                    
                    // Set form action
                    var form = document.getElementById('scheduleInterviewForm');
                    // Route: /employer/applications/{id}/schedule-interview
                    var actionUrl = '/employer/applications/' + appId + '/schedule-interview';
                    form.action = actionUrl;
                    
                    console.log('Schedule Interview initialized for App ID:', appId, 'Action:', actionUrl);
                } else {
                    console.error('Could not determine Application ID for interview scheduling');
                }
            };

            // Attach event listener
            if (typeof $ !== 'undefined' && $(modalEl).on) {
                $(modalEl).on('shown.bs.modal', onShow);
            } else {
                modalEl.addEventListener('shown.bs.modal', onShow);
            }
        }
    });

    // Close button fix
    function closeModal(modalId) {
        if (typeof $ !== 'undefined' && $('#' + modalId).length) {
            $('#' + modalId).modal('hide');
        } else if (window.bootstrap && window.bootstrap.Modal) {
            const el = document.getElementById(modalId);
            const modal = bootstrap.Modal.getInstance(el);
            if (modal) modal.hide();
        }
    }
    </script>
{% endblock %}
