{% block footer_scripts %}
    <!-- Replace slim jQuery with full jQuery for AJAX support -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Fix Job Title header alignment - force left align
        function forceJobTitleLeftAlign() {
            // Target the specific div with class "col-job sortable" containing "Job Title"
            const jobTitleHeader = document.querySelector('.job-header .col-job.sortable[data-sort="job"]');
            if (jobTitleHeader) {
                // Force left alignment using setProperty with important
                jobTitleHeader.style.setProperty('justify-content', 'flex-start', 'important');
                jobTitleHeader.style.setProperty('text-align', 'left', 'important');
                jobTitleHeader.style.setProperty('display', 'flex', 'important');
                jobTitleHeader.style.setProperty('align-items', 'center', 'important');
                
                // Also ensure all children are left-aligned
                const children = jobTitleHeader.querySelectorAll('*');
                children.forEach(function(child) {
                    child.style.setProperty('text-align', 'left', 'important');
                });
            }
            
            // Also target any col-job.sortable in job-header
            const allJobHeaders = document.querySelectorAll('.job-header .col-job.sortable');
            allJobHeaders.forEach(function(header) {
                if (header.textContent.includes('Job Title')) {
                    header.style.setProperty('justify-content', 'flex-start', 'important');
                    header.style.setProperty('text-align', 'left', 'important');
                }
            });
        }
        
        // Filter Panel Toggle Functions - Define globally first and assign to window immediately
        window.toggleFilterPanel = function(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const filterPanel = document.getElementById('filter-panel');
            const recruiterPanel = document.getElementById('recruiter-jobs-panel');
            
            // Close recruiter panel if open
            if (recruiterPanel && !recruiterPanel.classList.contains('hidden')) {
                recruiterPanel.classList.add('hidden');
                recruiterPanel.style.display = 'none';
            }
            
            if (filterPanel) {
                const isHidden = filterPanel.classList.contains('hidden');
                if (isHidden) {
                    filterPanel.classList.remove('hidden');
                    filterPanel.style.display = 'block';
                } else {
                    filterPanel.classList.add('hidden');
                    filterPanel.style.display = 'none';
                }
            } else {
                console.error('Filter panel not found!');
            }
        };
        
        window.toggleRecruiterJobsDropdown = function(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const recruiterPanel = document.getElementById('recruiter-jobs-panel');
            const filterPanel = document.getElementById('filter-panel');
            
            // Close filter panel if open
            if (filterPanel && !filterPanel.classList.contains('hidden')) {
                filterPanel.classList.add('hidden');
                filterPanel.style.display = 'none';
            }
            
            if (recruiterPanel) {
                const isHidden = recruiterPanel.classList.contains('hidden');
                if (isHidden) {
                    recruiterPanel.classList.remove('hidden');
                    recruiterPanel.style.display = 'block';
                } else {
                    recruiterPanel.classList.add('hidden');
                    recruiterPanel.style.display = 'none';
                }
            }
        };
        
        window.applyFilters = function(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const form = document.getElementById('filter-form');
            if (!form) {
                console.error('Filter form not found!');
                return;
            }
            
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all filter values
            formData.forEach((value, key) => {
                if (value && value.trim() !== '') {
                    params.append(key, value.trim());
                }
            });
            
            // Preserve status filter if present
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status');
            if (status) {
                params.append('status', status);
            }
            
            // Build new URL
            const baseUrl = window.location.pathname;
            const newUrl = baseUrl + (params.toString() ? '?' + params.toString() : '');
            
            // Reload page with filters
            window.location.href = newUrl;
        };
        
        window.clearFilters = function() {
            // Clear all filter inputs
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                filterForm.reset();
            }
            
            // Get current URL without filter params
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status');
            
            // Build new URL with only status if present
            const baseUrl = window.location.pathname;
            const newUrl = baseUrl + (status ? '?status=' + status : '');
            
            // Reload page without filters
            window.location.href = newUrl;
        };

        // Initialize datepicker
        document.addEventListener('DOMContentLoaded', function() {
            // Filter panel is handled by the component in _applications_maindetail.html.twig
            // No need for duplicate filter button handling here
            
            // Fix Job Title alignment immediately
            forceJobTitleLeftAlign();
            
            // Run again after a delay to catch any dynamic content
            setTimeout(forceJobTitleLeftAlign, 100);
            setTimeout(forceJobTitleLeftAlign, 300);
            setTimeout(forceJobTitleLeftAlign, 500);
            
            // Watch for DOM changes
            const observer = new MutationObserver(function(mutations) {
                forceJobTitleLeftAlign();
            });
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class']
            });
            
            // Initialize date pickers for Schedule Interview Modal
            function initScheduleDatePickers() {
            if (typeof flatpickr !== "undefined") {
                    const datePickers = document.querySelectorAll('#scheduleInterviewModal .js-datepicker:not([data-flatpickr-initialized])');
                    datePickers.forEach(function(picker) {
                        if (!picker._flatpickr) {
                            const fp = flatpickr(picker, {
                    enableTime: true,
                                dateFormat: "m/d/Y H:i",
                                time_24hr: false,
                                allowInput: true,
                                minuteIncrement: 5,
                                disableMobile: true,
                                clickOpens: true
                            });
                            picker.setAttribute('data-flatpickr-initialized', 'true');
                            
                            // Make calendar icon clickable
                            const icon = picker.parentElement.querySelector('.fa-calendar-alt');
                            if (icon) {
                                icon.style.pointerEvents = 'auto';
                                icon.style.cursor = 'pointer';
                                icon.addEventListener('click', function(e) {
                                    e.preventDefault();
                                    fp.open();
                                });
                            }
                        }
                    });
                }
            }

            // Initialize on page load
            if (typeof flatpickr !== "undefined") {
                initScheduleDatePickers();
            }

            // Multiple Interview Dates Functionality
            const addInterviewDateBtn = document.getElementById('addInterviewDateBtn');
            const interviewDatesContainer = document.getElementById('interviewDatesContainer');
            
            if (addInterviewDateBtn && interviewDatesContainer) {
                // Add new date entry
                addInterviewDateBtn.addEventListener('click', function() {
                    const newEntry = document.createElement('div');
                    newEntry.className = 'interview-date-entry mb-3';
                    newEntry.innerHTML = `
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">From</label>
                                <div class="position-relative">
                                    <input type="text" class="form-control js-datepicker schedule-date-from" name="interview_date_from[]" placeholder="mm/dd/yyyy --:--" required style="border: 1px solid #85BB65;">
                                    <i class="fas fa-calendar-alt position-absolute" style="right: 12px; top: 50%; transform: translateY(-50%); color: #85BB65; cursor: pointer;"></i>
                        </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">To</label>
                                <div class="position-relative">
                                    <input type="text" class="form-control js-datepicker schedule-date-to" name="interview_date_to[]" placeholder="mm/dd/yyyy --:--" required style="border: 1px solid #85BB65;">
                                    <i class="fas fa-calendar-alt position-absolute" style="right: 12px; top: 50%; transform: translateY(-50%); color: #85BB65; cursor: pointer;"></i>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm remove-date-btn mt-2">
                            <i class="fas fa-times"></i> Remove
                        </button>
                    `;
