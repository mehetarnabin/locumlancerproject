                            li.innerHTML = '<span class="doc-name">' + it.name + '</span><a href="' + it.url + '" target="_blank" class="btn btn-sm btn-link text-primary ms-2" title="Open in new tab" style="padding: 0 4px;">' + eyeSvg + '</a>';
                            li.addEventListener('click', function(e){
                                if (e.target && e.target.closest('a')) return; 
                                if (iframeEl) iframeEl.src = it.url;
                            });
                            listEl && listEl.appendChild(li);
                            if (idx === 0 && iframeEl) iframeEl.src = it.url;
                        });
                    }
                    var modalEl = document.getElementById('assignedDocsModal');
                    if (modalEl) {
                        // Ensure modal is in body to avoid transform/z-index issues
                        if (modalEl.parentElement !== document.body) {
                            document.body.appendChild(modalEl);
                        }
                        modalEl.style.zIndex = '200000';
                        
                        if (window.bootstrap && window.bootstrap.Modal) {
                            try {
                                var ModalCtor = window.bootstrap.Modal;
                                if (typeof ModalCtor.getOrCreateInstance === 'function') {
                                    ModalCtor.getOrCreateInstance(modalEl).show();
                                } else {
                                    new ModalCtor(modalEl).show();
                                }
                            } catch(_){
                                try {
                                    var M = window.bootstrap.Modal;
