            // Helper function to initialize enhanced calendar picker
            window.initializeDeadlineCalendar = function initializeDeadlineCalendar(deadlineInput) {
                if (!deadlineInput) return;
                
                if (typeof flatpickr !== "undefined") {
                    // Destroy existing flatpickr instance if it exists
                    if (deadlineInput._flatpickr) {
                        deadlineInput._flatpickr.destroy();
                    }
                    
                    // Initialize flatpickr with enhanced options
                    flatpickr(deadlineInput, {
                        dateFormat: "Y-m-d", // Standard format for form submission
                        altInput: true,
                        altFormat: "m/d/Y", // User-friendly display format
                        minDate: "today",
                        allowInput: false,
                        clickOpens: true,
                        animate: true,
                        monthSelectorType: "static",
                        locale: {
                            firstDayOfWeek: 0
                        },
                        onReady: function(selectedDates, dateStr, instance) {
                            // Add custom footer with Clear and Today buttons
                            const footer = document.createElement('div');
                            footer.className = 'flatpickr-footer';
                            footer.style.cssText = 'display: flex; justify-content: space-between; padding: 12px; background-color: #f8f9fa; border-top: 1px solid #e6eef6; border-radius: 0 0 12px 12px;';
                            
                            const clearBtn = document.createElement('button');
                            clearBtn.type = 'button';
                            clearBtn.className = 'flatpickr-clear-btn';
                            clearBtn.textContent = 'Clear';
                            clearBtn.style.cssText = 'padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s ease; border: 1px solid #e6eef6; background-color: #fff; color: #495057;';
                            clearBtn.addEventListener('click', function() {
                                instance.clear();
                                instance.close();
                            });
                            
                            const todayBtn = document.createElement('button');
                            todayBtn.type = 'button';
                            todayBtn.className = 'flatpickr-today-btn';
                            todayBtn.textContent = 'Today';
                            todayBtn.style.cssText = 'padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s ease; border: 1px solid #e6eef6; background-color: #fff; color: #495057;';
                            todayBtn.addEventListener('click', function() {
                                instance.setDate(new Date(), true);
                                instance.close();
                            });
                            
                            // Add hover effects
                            clearBtn.addEventListener('mouseenter', function() {
                                this.style.backgroundColor = '#85BB65';
                                this.style.color = '#fff';
                                this.style.borderColor = '#85BB65';
                            });
                            clearBtn.addEventListener('mouseleave', function() {
                                this.style.backgroundColor = '#fff';
                                this.style.color = '#495057';
                                this.style.borderColor = '#e6eef6';
                            });
                            
                            todayBtn.addEventListener('mouseenter', function() {
                                this.style.backgroundColor = '#85BB65';
                                this.style.color = '#fff';
                                this.style.borderColor = '#85BB65';
                            });
                            todayBtn.addEventListener('mouseleave', function() {
                                this.style.backgroundColor = '#fff';
                                this.style.color = '#495057';
                                this.style.borderColor = '#e6eef6';
                            });
                            
                            footer.appendChild(clearBtn);
                            footer.appendChild(todayBtn);
                            
                            // Append footer to calendar
                            setTimeout(function() {
                                const calendar = instance.calendarContainer;
                                if (calendar && !calendar.querySelector('.flatpickr-footer')) {
                                    calendar.appendChild(footer);
                                }
                            }, 10);
                        }
                    });
                } else {
                    // Fallback for browsers without flatpickr
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    const minDate = today.toISOString().split('T')[0];
                    deadlineInput.setAttribute('min', minDate);
                    deadlineInput.value = '';
                }
            }

