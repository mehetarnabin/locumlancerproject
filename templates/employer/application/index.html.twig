.columns-panel input[type="checkbox"] {
  appearance: none;
  width: 16px;
  height: 16px;
  border: 1px solid #e6eef6;
  border-radius: 4px;
  background-color: #fff;
  cursor: pointer;
  position: relative;
  transition: all 0.2s ease;
}

.columns-panel input[type="checkbox"]:checked {
  background-color: #47ddff; /* Your custom fill color */
