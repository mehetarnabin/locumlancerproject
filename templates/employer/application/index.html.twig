            ev.stopPropagation && ev.stopPropagation();
            try {
                handleEmployerTodoIconClick(ev, el);
            } catch(_){}
        }, true);
    </script>

    <script>
        // Sorting functionality for all sortable columns
        document.addEventListener('DOMContentLoaded', function() {
            // Mark as initialized to prevent base template script from running
            window.sortingInitialized = true;
            
            const headers = document.querySelectorAll('.sortable');
            let currentSort = { key: null, direction: 'asc' };

            const getText = (cell) => (cell?.textContent || '').trim();
            const getLowerText = (cell) => getText(cell).toLowerCase();
            const parseNumericText = (text) => {
                if (!text) return 0;
                const cleaned = text.replace(/[^0-9.]/g, '');
                const parsed = parseFloat(cleaned);
                return isNaN(parsed) ? 0 : parsed;
            };
            const parseDate = (text) => {
                if (!text || text === '—') return 0;
                // Parse MM/DD/YYYY format
                const parts = text.split('/');
                if (parts.length === 3) {
                    return new Date(parts[2], parts[0] - 1, parts[1]).getTime();
                }
                return 0;
            };

            function performSort(header, direction) {
                const key = header.dataset.sort || header.dataset.column;
                if (!key) return;
                
                currentSort = { key, direction };

                // Reset all arrows to inactive
                document.querySelectorAll('.sort-toggle .arrow').forEach(a => a.classList.remove('active'));
                
                // Activate the appropriate arrow on current header
                const up = header.querySelector('.sort-toggle .sort-up');
                const down = header.querySelector('.sort-toggle .sort-down');
                if (direction === 'asc' && up) up.classList.add('active');
                if (direction === 'desc' && down) down.classList.add('active');

                sortApplications(key, direction);
            }

            headers.forEach(header => {
                // Click on header (but not on arrows) - toggle sort direction
                header.addEventListener('click', function(e) {
                    // If clicking directly on an arrow, let the arrow handler deal with it
                    if (e.target.closest('.arrow')) {
                        return;
                    }
                    
                    const key = header.dataset.sort || header.dataset.column;
                    if (!key) return;
                    
                    // Toggle direction if same column, otherwise default to asc
                    const direction = (currentSort.key === key && currentSort.direction === 'asc') ? 'desc' : 'asc';
                    performSort(header, direction);
                });
                
                // Click on up arrow - sort ascending
                const upArrow = header.querySelector('.sort-toggle .sort-up');
                if (upArrow) {
                    upArrow.style.cursor = 'pointer';
                    upArrow.addEventListener('click', function(e) {
                        e.stopPropagation();
                        e.preventDefault();
                        performSort(header, 'asc');
                    });
                }
                
                // Click on down arrow - sort descending
                const downArrow = header.querySelector('.sort-toggle .sort-down');
                if (downArrow) {
                    downArrow.style.cursor = 'pointer';
                    downArrow.addEventListener('click', function(e) {
                        e.stopPropagation();
                        e.preventDefault();
                        performSort(header, 'desc');
                    });
                }
            });

            function sortApplications(key, direction) {
                const rows = Array.from(document.querySelectorAll('.job-row')).map(row => {
                    const jobCell = row.querySelector('.col-job');
                    const locationCell = row.querySelector('.col-location');
                    const salaryCell = row.querySelector('.col-salary');
                    const employerCell = row.querySelector('.col-employer');
                    const appliedCell = row.querySelector('.col-applied');
                    const categoryCell = row.querySelector('.col-category');
                    const statusCell = row.querySelector('.col-status');
                    const rankCell = row.querySelector('.col-rank');
                    
                    return {
                        element: row.parentElement, // Get the parent div.job-lists
                        data: {
                            job: getLowerText(jobCell?.querySelector('.job-title')) || getLowerText(jobCell),
                            location: getLowerText(locationCell),
                            salary: parseNumericText(getText(salaryCell)),
                            employer: getLowerText(employerCell),
                            applied: parseDate(getText(appliedCell)),
                            category: getLowerText(categoryCell),
                            status: getLowerText(statusCell),
                            rank: (() => {
                                const rankDisplay = rankCell?.querySelector('.rank-display');
                                const rankValue = rankDisplay?.getAttribute('data-rank-value');
                                if (rankValue) {
                                    return parseFloat(rankValue);
                                }
                                const rankText = getText(rankCell);
                                if (rankText === '—' || rankText === '') return 0;
                                const parsed = parseFloat(rankText);
                                return isNaN(parsed) ? 0 : parsed;
                            })()
                        }
                    };
                });

                rows.sort((a, b) => {
                    const valA = a.data[key];
                    const valB = b.data[key];
                    
                    if (valA === undefined || valB === undefined) {
                        return 0;
                    }
                    
                    if (typeof valA === 'string') {
                        return direction === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    } else {
                        return direction === 'asc' ? valA - valB : valB - valA;
                    }
                });

                const container = document.querySelector('.job-list-container .table-responsive-wrapper');
                if (container) {
                    rows.forEach(row => {
                        if (row.element) {
                            container.appendChild(row.element);
                        }
                    });
                }
            }
        });
    </script>

    <script>
        // Score/Rank display - editing removed, display only
        // No editing functionality needed - just display the score
        
        document.addEventListener('DOMContentLoaded', function() {
            // Split View Button Handler - Toggle split view on same page
            const gridViewBtn = document.getElementById('grid-view-btn');
            const listViewContainer = document.querySelector('.job-list-container');
            const splitViewContainer = document.getElementById('split-view-container');
            const splitJobList = document.getElementById('split-job-list');
            const splitJobDetails = document.getElementById('split-job-details');
            const applicationDetailContent = document.getElementById('application-detail-content');
            const noApplicationSelected = document.querySelector('.no-job-selected');
            
            let selectedApplicationId = null;
            
            // Store current application and provider IDs for button handlers
            let currentApplicationId = null;
            let currentProviderId = null;
            
            // Function to load application details via AJAX
            function loadApplicationDetails(applicationId, jobId) {
                currentApplicationId = applicationId;
                if (!applicationId || !jobId) return;
                
                const detailUrl = `/employer/jobs/${jobId}/applications/${applicationId}/detail`;
                
                if (applicationDetailContent) {
                    applicationDetailContent.innerHTML = `
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h5 class="text-muted">Loading Application Details</h5>
                        </div>
                    `;
                    applicationDetailContent.style.display = 'block';
                }
                if (noApplicationSelected) noApplicationSelected.style.display = 'none';
                
                fetch(detailUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'text/html'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.text();
                })
                .then(html => {
                    if (applicationDetailContent) {
                        applicationDetailContent.innerHTML = html;
                        applicationDetailContent.style.display = 'block';
                        
                        // Ensure note button and action buttons are created and visible
                        ensureSplitViewButtons();
                        
                        // Re-attach event handlers for all buttons after content is loaded
                        setTimeout(function() {
                            // Re-attach hire/complete buttons
                            const hireBtn = applicationDetailContent.querySelector('#hire-btn');
                            const completeBtn = applicationDetailContent.querySelector('#complete-btn');
                            
                            if (hireBtn && window.updateApplicationStatus) {
                                hireBtn.onclick = function() {
                                    window.updateApplicationStatus('hire');
                                };
                            }
                            
                            if (completeBtn && window.updateApplicationStatus) {
                                completeBtn.onclick = function() {
                                    window.updateApplicationStatus('complete');
                                };
                            }
                            
                            // Update all action buttons with proper data attributes
                            // Schedule Interview button
                            const scheduleBtn = document.getElementById('action-schedule-interview-btn');
                            if (scheduleBtn) {
                                scheduleBtn.setAttribute('data-application_id', applicationId);
                            }
                            
                            // Send Contract/Offer button
                            const sendContractOfferBtn = document.getElementById('action-send-contract-offer-btn');
                            if (sendContractOfferBtn) {
                                sendContractOfferBtn.setAttribute('data-application_id', applicationId);
                            }
                            
                            // Send Credential button - get provider ID from loaded content or selected card
                            const sendCredentialBtn = document.getElementById('action-send-credential-btn');
                            if (sendCredentialBtn) {
                                sendCredentialBtn.setAttribute('data-application_id', applicationId);
                                // Try to get provider ID from loaded content
                                let providerId = '';
                                const detailContainer = applicationDetailContent.querySelector('.app-detail-content[data-provider-id], [data-provider-id]');
                                if (detailContainer) {
                                    providerId = detailContainer.getAttribute('data-provider-id') || '';
                                }
                                // Fallback to selected provider ID
                                if (!providerId && typeof selectedProviderId !== 'undefined') {
                                    providerId = selectedProviderId || '';
                                }
                                // Fallback to active card
                                if (!providerId) {
                                    const activeCard = document.querySelector('.split-job-card.active');
                                    if (activeCard) {
                                        const checkbox = activeCard.querySelector('.job-checkbox[data-provider-id]');
                                        if (checkbox) {
                                            providerId = checkbox.getAttribute('data-provider-id') || '';
                                        }
                                    }
                                }
                                sendCredentialBtn.setAttribute('data-provider-id', providerId);
                                currentProviderId = providerId;
                            }
                            
                            // Write Review button
                            const writeReviewBtn = document.getElementById('action-write-review-btn');
                            if (writeReviewBtn) {
                                writeReviewBtn.setAttribute('data-application_id', applicationId);
                            }
                            
                            // Request File button
                            const requestFileBtn = document.getElementById('action-request-file-btn');
                            if (requestFileBtn) {
                                requestFileBtn.setAttribute('data-application_id', applicationId);
                            }
                            
                            // Request Documents button
                            const requestDocsBtn = document.getElementById('action-request-documents-btn');
                            if (requestDocsBtn) {
                                requestDocsBtn.setAttribute('data-application_id', applicationId);
                            }
                            
                            // Update hidden input for write review modal
                            const writeReviewApplicationId = document.getElementById('writeReviewApplicationId');
                            if (writeReviewApplicationId) {
                                writeReviewApplicationId.value = applicationId;
                            }
                            
                            // Update selectedApplicationId globally for modal handlers
                            if (typeof selectedApplicationId !== 'undefined') {
                                selectedApplicationId = applicationId;
                            }
                            
                            // Get and set selectedApplicationStatus from loaded content or active card
                            let status = null;
                            const detailContainer = applicationDetailContent.querySelector('.app-detail-content[data-application-status], [data-application-status]');
                            if (detailContainer) {
                                status = detailContainer.getAttribute('data-application-status');
                            }
                            
                            // Fallback to active card
                            if (!status) {
                                const activeCard = document.querySelector('.split-job-card.active');
                                if (activeCard) {
                                    const checkbox = activeCard.querySelector('.job-checkbox[data-application-status]');
                                    if (checkbox) {
                                        status = checkbox.getAttribute('data-application-status');
                                    }
                                }
                            }
                            
                            // Set selectedApplicationStatus if available
                            if (status) {
                                if (typeof selectedApplicationStatus !== 'undefined') {
                                    selectedApplicationStatus = status;
                                }
                                if (typeof window.selectedApplicationStatus !== 'undefined') {
                                    window.selectedApplicationStatus = status;
                                }
                            }
                            
                            // Update status switch button if function exists
                            if (typeof updateStatusSwitchButton === 'function') {
                                updateStatusSwitchButton();
                            }
                            
                            // Trigger button visibility logic for detail page
                            updateDetailPageActionButtons(applicationDetailContent);
                        }, 100);
                    }
                })
                .catch(error => {
                    console.error('Error loading application details:', error);
                    if (applicationDetailContent) {
                        applicationDetailContent.innerHTML = `
                            <div class="text-center py-5">
                                <p class="text-danger">Error loading application details. Please try again.</p>
                                <button onclick="window.loadApplicationDetails && window.loadApplicationDetails('${applicationId}', '${jobId}')" class="btn btn-primary mt-2">Retry</button>
                            </div>
                        `;
                    }
                });
            }
            
            // Function to update action buttons in detail page based on status
            function updateDetailPageActionButtons(container) {
                if (!container) return;
                
                // Try to get status from the loaded content
                let status = null;
                
                // Try to get from data attribute first (most reliable)
                let dataStatus = container.getAttribute('data-application-status');
                if (dataStatus) {
                    status = dataStatus.toLowerCase();
                } else {
                    // Try to find .app-detail-content child with data attribute
                    const detailContainer = container.querySelector('.app-detail-content[data-application-status], [data-application-status]');
                    if (detailContainer) {
                        dataStatus = detailContainer.getAttribute('data-application-status');
                        if (dataStatus) {
                            status = dataStatus.toLowerCase();
                        }
                    }
                }
                
                // If not found, try to find status badge in the detail content
                if (!status) {
                    const statusBadge = container.querySelector('.badge, [class*="status"], .app-detail-meta-value .badge');
                    if (statusBadge) {
                        const statusText = statusBadge.textContent.trim().toLowerCase();
                        // Map status text to status value
                        if (statusText.includes('applied')) status = 'applied';
                        else if (statusText.includes('negotiating')) status = 'in_review';
                        else if (statusText.includes('review') || statusText.includes('shortlisted')) status = 'in_review';
                        else if (statusText.includes('interview')) status = 'interview';
                        else if (statusText.includes('offered')) status = 'offered';
                        else if (statusText.includes('hired') || statusText.includes('accepted')) status = 'hired';
                        else if (statusText.includes('completed')) status = 'completed';
                    }
                }
                
                // If still not found, try to get from selected checkbox in main list
                if (!status) {
                    const selectedCheckbox = document.querySelector('.job-checkbox:checked');
                    if (selectedCheckbox) {
                        status = selectedCheckbox.getAttribute('data-application-status');
                        if (status) status = status.toLowerCase();
                    }
                }
                
                // Try to get from active card
                if (!status) {
                    const activeCard = document.querySelector('.split-job-card.active');
                    if (activeCard) {
                        const checkbox = activeCard.querySelector('.job-checkbox[data-application-status]');
                        if (checkbox) {
                            status = checkbox.getAttribute('data-application-status');
                            if (status) status = status.toLowerCase();
                        }
                    }
                }
                
                if (!status) {
                    console.log('Status not found for detail page buttons');
                    return;
                }
                
                // Normalize status: remove underscores and convert to lowercase
                const normalizedStatus = status.toLowerCase().replace(/_/g, '');
                
                // Hide all conditional buttons first
                const conditionalButtonIds = [
                    'action-request-file-btn',
                    'action-schedule-interview-btn',
                    'action-request-documents-btn',
                    'action-send-contract-offer-btn',
                    'action-send-credential-btn',
                    'action-write-review-btn'
                ];
                
                conditionalButtonIds.forEach(function(btnId) {
                    const btn = document.getElementById(btnId);
                    if (btn) {
                        btn.classList.remove('show');
                        btn.style.display = 'none';
                        btn.style.visibility = 'hidden';
                        btn.style.opacity = '0';
                        btn.style.pointerEvents = 'none';
                    }
                });
                
                // Show appropriate button based on status
                let targetBtnId = null;
                
                if (normalizedStatus === 'applied') {
                    targetBtnId = 'action-request-file-btn';
                } else if (normalizedStatus === 'inreview' || normalizedStatus === 'shortlisted') {
                    targetBtnId = 'action-schedule-interview-btn';
                } else if (normalizedStatus === 'interview' || normalizedStatus === 'interviewing') {
                    targetBtnId = 'action-request-documents-btn';
                } else if (normalizedStatus === 'offered' || normalizedStatus === 'negotiating') {
                    // Show combined contract/offer button
                    targetBtnId = 'action-send-contract-offer-btn';
                } else if (normalizedStatus === 'accepted' || normalizedStatus === 'hired') {
                    targetBtnId = 'action-send-credential-btn';
                } else if (normalizedStatus === 'completed') {
                    targetBtnId = 'action-write-review-btn';
                }
                
                if (targetBtnId) {
                    const btn = document.getElementById(targetBtnId);
                    if (btn) {
                        btn.classList.add('show');
                        btn.style.display = 'flex';
                        btn.style.visibility = 'visible';
                        btn.style.opacity = '1';
                        btn.style.pointerEvents = 'auto';
                        btn.removeAttribute('disabled');
                        btn.style.cursor = 'pointer';
                        // Ensure Bootstrap can find the button
                        if (btn.hasAttribute('data-bs-toggle')) {
                            btn.setAttribute('type', 'button');
                        }
                    }
                }
            }
            
            // Make function available globally
            window.loadApplicationDetails = loadApplicationDetails;
            window.updateDetailPageActionButtons = updateDetailPageActionButtons;
            
            // Function to select application card
            function selectApplicationCard(appCard) {
                document.querySelectorAll('.split-job-card').forEach(card => {
                    card.classList.remove('active');
                });
                
                appCard.classList.add('active');
                
                const checkbox = appCard.querySelector('.job-checkbox');
                if (checkbox) {
                    checkbox.checked = true;
                    document.querySelectorAll('.job-checkbox').forEach(cb => {
                        if (cb !== checkbox) {
                            cb.checked = false;
                        }
                    });
                }
                
                const applicationId = appCard.dataset.applicationId;
                const jobId = appCard.dataset.jobId;
                
                // Get provider ID from checkbox if available
                const providerCheckbox = appCard.querySelector('.job-checkbox[data-provider-id]');
                if (providerCheckbox) {
                    selectedProviderId = providerCheckbox.getAttribute('data-provider-id');
                    currentProviderId = selectedProviderId;
                }
                
                if (applicationId && jobId) {
                    selectedApplicationId = applicationId;
                    currentApplicationId = applicationId;
                    selectedJobId = jobId; // Correctly set Global Job ID
                    loadApplicationDetails(applicationId, jobId);
                }
            }
            
            if (gridViewBtn && listViewContainer && splitViewContainer) {
                gridViewBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    
                    const computedStyle = window.getComputedStyle(splitViewContainer);
                    const isSplitView = computedStyle.display === 'grid' || splitViewContainer.style.display === 'grid';
                    
                    // Get table headers
                    const tableHeaders = document.querySelectorAll('.job-header');
                    
                    if (isSplitView) {
                        // Switch to list view
                        splitViewContainer.style.display = 'none';
                        if (listViewContainer) listViewContainer.style.display = 'block';
                        gridViewBtn.classList.remove('active');
                        gridViewBtn.innerHTML = `
                            <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 3H10V10H3V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 3H21V10H14V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 14H10V21H3V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Split View
                        `;
                        // Show table headers in list view
                        tableHeaders.forEach(header => {
                            header.style.display = 'flex';
                        });
                    } else {
                        // Switch to split view
                        splitViewContainer.style.display = 'grid';
                        splitViewContainer.classList.add('list-hidden'); // Hide list by default
                        if (listViewContainer) listViewContainer.style.display = 'none';
                        gridViewBtn.classList.add('active');
                        gridViewBtn.innerHTML = `
                            <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 11H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M3 16H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            List View
                        `;
                        // Hide table headers in split view
                        tableHeaders.forEach(header => {
                            header.style.display = 'none';
                        });
                        
                        // Hide the candidate list by default
                        const splitJobList = document.getElementById('split-job-list');
                        if (splitJobList) {
                            splitJobList.style.display = 'none';
                        }
                        
                        // Show toggle button
                        const listToggleBtn = document.getElementById('list-toggle-btn');
                        if (listToggleBtn) {
                            listToggleBtn.style.display = 'flex';
                            listToggleBtn.title = 'Show candidate list';
                        }
                        
                        // Show placeholder or auto-select first application
                        if (noApplicationSelected) {
                            noApplicationSelected.style.display = 'flex';
                        }
                        if (applicationDetailContent) {
                            applicationDetailContent.style.display = 'none';
                        }
                        
                        // Auto-select first application or checked application
                        setTimeout(function() {
                            const checkedCheckbox = document.querySelector('.job-checkbox:checked');
                            let cardToSelect = null;
                            
                            if (checkedCheckbox && splitJobList) {
                                const appId = checkedCheckbox.getAttribute('data-application-id');
                                cardToSelect = splitJobList.querySelector(`.split-job-card[data-application-id="${appId}"]`);
                            }
                            
                            if (!cardToSelect && splitJobList) {
                                cardToSelect = splitJobList.querySelector('.split-job-card');
                            }
                            
                            if (cardToSelect) {
                                selectApplicationCard(cardToSelect);
                            }
                        }, 100);
                    }
                    
                    return false;
                }, true);
            }
            
            // Application card selection in split view
            if (splitJobList) {
                splitJobList.addEventListener('click', function(e) {
                    if (e.target.closest('a')) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    
                    const appCard = e.target.closest('.split-job-card');
                    if (appCard) {
                        if (e.target.classList.contains('job-checkbox') || e.target.closest('.job-checkbox')) {
                            return;
                        }
                        
                        e.preventDefault();
                        e.stopPropagation();
                        selectApplicationCard(appCard);
                    }
                });
            }
            
            // Function to create and ensure note button exists in split view
            function ensureSplitViewButtons() {
                const splitJobDetails = document.getElementById('split-job-details');
                let detailActionButtons = document.getElementById('detail-action-buttons');
                
                if (!splitJobDetails) return;
                
                // Create detail-action-buttons container if it doesn't exist
                if (!detailActionButtons) {
                    detailActionButtons = document.createElement('div');
                    detailActionButtons.id = 'detail-action-buttons';
                    detailActionButtons.style.cssText = 'position: absolute; top: 10px; right: 10px; display: none; flex-direction: row; gap: 10px; align-items: center; justify-content: flex-end; z-index: 10;';
                    splitJobDetails.appendChild(detailActionButtons);
                }
                
                // Create Note button if it doesn't exist
                let noteBtn = document.getElementById('detail-note-btn');
                if (!noteBtn) {
                    noteBtn = document.createElement('button');
                    noteBtn.id = 'detail-note-btn';
                    noteBtn.className = 'action-btn';
                    noteBtn.type = 'button';
                    noteBtn.title = 'Notes';
                    noteBtn.style.cssText = 'display: flex !important; cursor: pointer !important; padding: 6px 12px; border-radius: 6px; border: 1px solid #e6eef6; background: #fff; align-items: center; gap: 6px; font-size: 13px; color: #000000 !important; transition: all 0.2s ease; white-space: nowrap; font-weight: 500; pointer-events: auto !important; z-index: 1001 !important; position: relative !important;';
                    noteBtn.innerHTML = `
                        <svg class="icon-image" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span style="color: #000000 !important;">Note</span>
                    `;
                    
                    // Add click event listener for note button
                    noteBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        
                        console.log('Note button clicked');
                        let applicationId = window.selectedApplicationId || currentApplicationId || null;
                        
                        if (!applicationId) {
                            const activeCard = document.querySelector('.split-job-card.active');
                            if (activeCard) {
                                applicationId = activeCard.getAttribute('data-application-id');
                            }
                        }
                        
                        if (applicationId && typeof window.openNotesPanel === 'function') {
                            window.openNotesPanel(applicationId);
                        } else if (applicationId) {
                            openNotesPanel(applicationId);
                        } else {
                            console.error('No application selected or openNotesPanel not found');
                            if (typeof showToast === 'function') {
                                showToast('Please select an application first', 'error');
                            } else {
                                alert('Please select an application first');
                            }
                        }
                        
                        return false;
                    }, true);
                    
                    // Append note button to detail action buttons
                    if (detailActionButtons) {
                        detailActionButtons.appendChild(noteBtn);
                    }
                    
                    console.log('Note button created and added to DOM', noteBtn);
                }
                
                // Ensure button is visible and clickable
                noteBtn.style.display = 'flex';
                noteBtn.style.visibility = 'visible';
                noteBtn.style.opacity = '1';
                noteBtn.style.pointerEvents = 'auto';
                
                // Show action buttons container
                if (detailActionButtons) {
                    detailActionButtons.style.display = 'flex';
                }
            }
            
            // Make function globally available
            window.ensureSplitViewButtons = ensureSplitViewButtons;
            
            // List Toggle Button Handler
            const listToggleBtn = document.getElementById('list-toggle-btn');
            if (listToggleBtn) {
                listToggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const splitViewContainer = document.getElementById('split-view-container');
                    const splitJobList = document.getElementById('split-job-list');
                    
                    if (!splitViewContainer || !splitJobList) return;
                    
                    const isHidden = splitViewContainer.classList.contains('list-hidden');
                    
                    if (isHidden) {
                        // Show the list
                        splitViewContainer.classList.remove('list-hidden');
                        splitJobList.style.display = 'block';
                        splitJobList.style.visibility = 'visible';
                        splitJobList.style.width = 'auto';
                        splitJobList.style.minWidth = '350px';
                        splitJobList.style.maxWidth = 'none';
                        listToggleBtn.title = 'Hide candidate list';
                        listToggleBtn.style.left = '330px'; // Adjust position when list is visible
                    } else {
                        // Hide ONLY the list, keep detail panel visible
                        splitViewContainer.classList.add('list-hidden');
                        splitJobList.style.display = 'none';
                        splitJobList.style.visibility = 'hidden';
                        splitJobList.style.width = '0';
                        splitJobList.style.minWidth = '0';
                        splitJobList.style.maxWidth = '0';
                        // Ensure detail panel stays visible
                        const splitJobDetails = document.getElementById('split-job-details');
                        if (splitJobDetails) {
                            splitJobDetails.style.display = 'block';
                            splitJobDetails.style.visibility = 'visible';
                            splitJobDetails.style.width = '100%';
                        }
                        listToggleBtn.title = 'Show candidate list';
                        listToggleBtn.style.left = '-20px'; // Position outside when list is hidden
                    }
                });
            }
        });
    </script>

