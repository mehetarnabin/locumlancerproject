                    if (appInput) appInput.value = appId;
                    show('sendCredentialLinkModal');
                    e.preventDefault && e.preventDefault();
                    e.stopPropagation && e.stopPropagation();
                    return false;
                }
                if (action.indexOf('contract') !== -1 || action.indexOf('offer') !== -1) {
                    resetModalForm('sendOfferModal');
                    var sInput = document.getElementById('sendOfferApplicationId');
                    if (sInput) sInput.value = appId;
                    
                    var form = document.querySelector('#sendOfferModal form');
