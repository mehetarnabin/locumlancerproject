    <!-- Send External Link Modal -->
    <div class="modal fade" id="sendLinkModal" tabindex="-1" aria-labelledby="sendLinkLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sendLinkLabel">Send External Link</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="sendLinkForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="linkUrl" class="form-label">Link URL *</label>
                            <input type="url" class="form-control" id="linkUrl" name="link_url" required placeholder="https://example.com">
                        </div>
                        <div class="mb-3">
                            <label for="linkDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="linkDescription" name="link_description" rows="3" placeholder="Optional description..."></textarea>
