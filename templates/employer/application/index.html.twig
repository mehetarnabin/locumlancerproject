                <form id="scheduleInterviewForm" action="#" method="POST" data-action-template="{{ path('app_employer_application_scheduleinterview', {'id': 'APPLICATION_ID'}) }}">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Meeting Date (From — To)</label>
                            <div id="interviewDatesContainer">
                            <div class="interview-date-entry mb-2 d-flex gap-2 align-items-end">
                                <div class="flex-grow-1">
                                    <label class="form-label small">From</label>
                                    <input type="datetime-local" class="form-control interview-date-start" name="interview_start[]" required min="{{ 'now'|date('Y-m-d\\TH:i') }}">
                                </div>
                                <div class="flex-grow-1">
                                    <label class="form-label small">To</label>
                                    <input type="datetime-local" class="form-control interview-date-end" name="interview_end[]" required min="{{ 'now'|date('Y-m-d\\TH:i') }}">
                                </div>
                                <button type="button" class="btn btn-danger btn-sm remove-date-btn">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="addInterviewDateBtn">Add another date</button>
                            <input type="hidden" id="meeting_date" name="meeting_date">
                        </div>
                        <div class="mb-3">
                            <label for="meeting_platform" class="form-label">Meeting Platform</label>
                            <select class="form-control" id="meeting_platform" name="meeting_platform" required>
                                <option value="">Choose Platform</option>
                                <option value="Zoom">Zoom</option>
                                <option value="Microsoft Teams">Microsoft Teams</option>
                                <option value="Google Meet">Google Meet</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="meeting_url" class="form-label">Meeting URL</label>
                        <input type="url" class="form-control" id="meeting_url" name="meeting_url" required>
                        </div>
                        <div class="mb-3">
                            <label for="meeting_comments" class="form-label">Comments / Rescheduling Notes</label>
                            <textarea class="form-control" id="meeting_comments" name="comment" rows="3" placeholder="Add any notes or comments about this schedule..."></textarea>
                        </div>
                        <input type="hidden" id="scheduleInterviewApplicationId" name="application_id">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send Schedule</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script>
        var SERVER_NOW = "{{ 'now'|date('Y-m-d\\TH:i') }}";
        window.scheduleInterviewAjax = function(ev){
            try {
                ev.preventDefault();
                var form = ev.target;
                var submitBtn = form.querySelector('button[type="submit"]');
                var originalBtnText = submitBtn ? submitBtn.textContent : '';
                if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }
                var formData = new FormData(form);
                // Set min attributes for current date-time
                (function(){
                    var nowVal = SERVER_NOW;
                    form.querySelectorAll('.interview-date-start,.interview-date-end').forEach(function(el){ try { el.min = nowVal; } catch(_){ } });
                })();
                var startInputs = form.querySelectorAll('.interview-date-start');
                var endInputs = form.querySelectorAll('.interview-date-end');
                for (var i=0; i<startInputs.length; i++){
                    var s = startInputs[i].value;
                    var e = endInputs[i] ? endInputs[i].value : '';
                    if (s && e && new Date(e) < new Date(s)) {
                        alert('End date/time must be after start date/time.');
                        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalBtnText || 'Send Schedule'; }
                        return false;
                    }
                }
                var hiddenMeeting = document.getElementById('meeting_date');
                if (hiddenMeeting && startInputs.length > 0 && startInputs[0].value) {
                    hiddenMeeting.value = startInputs[0].value;
                }
                var appIdVal = document.getElementById('scheduleInterviewApplicationId') ? document.getElementById('scheduleInterviewApplicationId').value : '';
                if (!formData.get('application_id') && appIdVal) {
                    formData.set('application_id', appIdVal);
                }
                var appIdForUrl = formData.get('application_id');
                var url = form.getAttribute('data-action-template');
                if (!appIdForUrl || !url) {
                    alert('Missing application ID.');
                    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalBtnText || 'Send Schedule'; }
                    return false;
                }
                url = url.replace('APPLICATION_ID', appIdForUrl);
                fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).then(function(response){
                    var ct = response.headers.get('content-type') || '';
                    if (ct.indexOf('application/json') !== -1) { return response.json(); }
                    if (response.ok) { return { success: true, message: 'Interview schedule sent successfully.' }; }
                    throw new Error('Unexpected response');
                }).then(function(data){
                    if (data && data.success) {
                        var interviewModal = document.getElementById('interviewModal');
                        var closeBtn = interviewModal ? interviewModal.querySelector('.close') : null;
                        if (closeBtn) { closeBtn.click(); } else if (interviewModal && window.bootstrap && window.bootstrap.Modal) { var mi = window.bootstrap.Modal.getInstance(interviewModal); if (mi) mi.hide(); }
                        var container = document.querySelector('.container-xl') || document.body;
                        var alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible show';
                        alertDiv.setAttribute('role', 'alert');
                        alertDiv.innerHTML = (data.message || 'Interview schedule sent successfully.') + '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
                        if (container.firstChild) { container.insertBefore(alertDiv, container.firstChild); } else { container.appendChild(alertDiv); }
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                        try { sessionStorage.setItem('interviewScheduledSuccess', '1'); } catch(_) {}
                        setTimeout(function(){ location.reload(); }, 600);
                    } else {
                        alert('Error: ' + (data && data.message ? data.message : 'Failed to process request'));
                    }
                }).catch(function(err){
                    console.error(err);
                    alert('An error occurred. Please try again.');
                }).finally(function(){
                    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalBtnText || 'Send Schedule'; }
                });
                return false;
            } catch(_) { return false; }
        };
    </script>

