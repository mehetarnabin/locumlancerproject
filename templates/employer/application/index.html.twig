{% extends 'employer/base.html.twig' %}

{% block title %}My Applications{% endblock %}

{% block employer_body %}

<style>
.flatpickr-calendar {
    z-index: 200005 !important;
}
/* Override parent container padding */
.app-content {
    padding: 32px 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
}

/* Override any container padding */
.container-xl,
.container-fluid,
.container,
.app-wrapper {
    padding-left: 24px !important;
    padding-right: 24px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    max-width: 100% !important;
}

@media (max-width: 1199.98px) {
    .app-content {
        padding: 24px 0 !important;
    }
    
    .container-xl,
    .container-fluid,
    .container,
    .app-wrapper {
        padding-left: 20px !important;
        padding-right: 20px !important;
    }
}
.job-header, .job-row {
    display: flex;
    align-items: center;
}

.col-job,
.col-location,
.col-schedule,
.col-expiry,
.col-start,
.col-action {
    flex: 1;
    min-width: 130px;
}
.col-job {
    flex: 2;
}
.job-header {
    padding-left: 20px !important;
    padding-right: 14px !important;
    color: #121C0C;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    border-radius: 10px;
    border: 1px solid #e6eef6;
    height: 40px;
    margin-bottom: 1px !important;
    margin-left: 0 !important;
    font-size: 13px;
    min-width: 0;
    position: relative !important;
    overflow: hidden;
    background: #F8FAF9;
    display: flex;
    align-items: center;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.5;
}

.job-header {
    margin-bottom: 2px !important;
    position: relative !important;
    z-index: 10 !important;
}

/* Split View Styles */
.split-view-container {
    display: none;
    grid-template-columns: minmax(350px, 1fr) 1.5fr;
    gap: 20px;
    margin-top: 20px;
    height: 70vh;
    max-height: 70vh;
    position: relative;
    transition: grid-template-columns 0.3s ease, gap 0.3s ease;
    overflow-x: visible;
    overflow-y: hidden;
    padding-left: 30px; /* Add padding to prevent clipping */
}

.split-view-container.list-hidden {
    grid-template-columns: 0fr 1fr;
    gap: 0; /* Remove gap when list is hidden */
}

.split-view-container.list-hidden .split-job-list {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    opacity: 0;
    pointer-events: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

/* Ensure detail panel always stays visible and stable */
.split-job-details {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.split-job-list {
    transition: opacity 0.3s ease, width 0.3s ease;
}

.split-job-details {
    transition: none !important; /* Keep detail panel stable - no transitions */
    width: 100% !important; /* Always take full available width */
    display: block !important; /* Always visible */
    visibility: visible !important; /* Always visible */
    opacity: 1 !important; /* Always visible */
    flex: 1 !important; /* Take remaining space */
}

/* Ensure detail panel is never hidden by list-hidden class */
.split-view-container.list-hidden .split-job-details {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    width: 100% !important;
}

.split-view-container::-webkit-scrollbar {
    display: none;
}

.split-job-list {
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
    scrollbar-width: thin;
    -ms-overflow-style: auto;
    max-height: 100%;
}

.split-job-list::-webkit-scrollbar {
    display: block;
    width: 8px;
}

.split-job-list::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.split-job-list::-webkit-scrollbar-thumb {
    background: #85BB65;
    border-radius: 4px;
}

.split-job-list::-webkit-scrollbar-thumb:hover {
    background: #6FA050;
}

/* List Toggle Button */
.list-toggle-btn {
    position: absolute;
    left: -20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1001;
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(11,22,40,0.1);
    transition: all 0.3s ease;
}

.list-toggle-btn:hover {
    background: #f8f9fa;
    border-color: #85BB65;
    box-shadow: 0 4px 12px rgba(11,22,40,0.15);
}

.list-toggle-btn svg {
    transition: transform 0.3s ease;
}

.split-view-container:not(.list-hidden) .list-toggle-btn svg {
    transform: rotate(180deg);
}

.split-view-container.list-hidden .list-toggle-btn {
    left: -20px;
}

.split-view-container:not(.list-hidden) .list-toggle-btn {
    left: 330px;
}

.split-job-details {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 20px;
    overflow-y: auto;
    overflow-x: visible;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
    height: 100%;
    max-height: 100%;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e0 #f7fafc;
    -ms-overflow-style: auto;
}

.split-job-details::-webkit-scrollbar {
    width: 8px;
    display: block;
}

.split-job-details::-webkit-scrollbar-track {
    background: #f7fafc;
    border-radius: 4px;
}

.split-job-details::-webkit-scrollbar-thumb {
    background: #cbd5e0;
    border-radius: 4px;
}

.split-job-details::-webkit-scrollbar-thumb:hover {
    background: #a0aec0;
}

.split-job-card {
    background: white;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    cursor: default;
    transition: all 0.2s ease;
}

.split-job-card:hover {
    border-color: #85BB65;
    transform: none !important;
    box-shadow: none !important;
}

.split-job-card.active {
    border-color: #85BB65;
    background-color: #F4F9F1;
}

.split-job-card-header {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
    position: relative;
}

.split-job-card-logo {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    flex-shrink: 0;
}

.split-job-card-title {
    font-weight: 600;
    color: #121C0C;
    font-size: 16px;
    margin-bottom: 2px;
    cursor: pointer;
}

.split-job-card-company {
    color: #666;
    font-size: 13px;
}

.split-job-summary {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 6px 0 4px 56px;
    font-size: 13px;
}

.split-job-summary-item {
    display: flex;
    gap: 6px;
}

.split-job-meta-label {
    color: #666;
}

.split-job-meta-value {
    color: #121C0C;
    font-weight: 500;
}

.no-job-selected {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #666;
    text-align: center;
}

.no-job-selected svg {
    margin-bottom: 16px;
    opacity: 0.5;
}

/* Notes Panel Styles */
.notes-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 400px;
    max-width: 90vw;
    background: #fff;
    border-left: 1px solid #e6eef6;
    box-shadow: -2px 0 8px rgba(11,22,40,0.06);
    transform: translateX(100%);
    transition: transform 0.2s ease;
    display: flex;
    flex-direction: column;
    z-index: 1000;
    visibility: hidden;
    overflow-y: auto;
    pointer-events: none;
}

.notes-panel.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
}

.notes-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid #e6eef6;
    font-weight: 600;
}

.notes-panel-close {
    background: transparent;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: #666;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.notes-panel-close:hover {
    background: #f5f5f5;
    color: #333;
}

.notes-panel-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.notes-title {
    margin-bottom: 16px;
}

.notes-title h6 {
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin-bottom: 4px;
}

.notes-title p {
    font-size: 12px;
    margin: 0;
}

.notes-textarea {
    width: 100%;
    flex: 1;
    resize: none;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 12px;
    outline: none;
    font-size: 14px;
    line-height: 1.5;
    min-height: 200px;
}

.notes-textarea:focus {
    border-color: #85BB65;
    box-shadow: 0 0 0 2px rgba(133, 187, 101, 0.1);
}

.notes-footer {
    margin-top: 12px;
    color: #666;
    font-size: 12px;
}

.notes-footer .last-saved {
    display: flex;
    align-items: center;
    gap: 6px;
}

.notes-footer .last-saved::before {
    content: "✓";
    color: #85BB65;
}

.split-job-details.notes-open {
    padding-right: 400px;
}

/* Detail Note Button Styling */
#detail-note-btn {
    color: #000000 !important;
}

#detail-note-btn span {
    color: #000000 !important;
}

#detail-note-btn:hover {
    background: #f8f9fa !important;
    border-color: #85BB65 !important;
}

#detail-note-btn:hover span {
    color: #000000 !important;
}

#detail-note-btn:active {
    background: #e8f5e9 !important;
    transform: scale(0.98);
}

#detail-note-btn:active span {
    color: #000000 !important;
}

/* Hide table headers when split view is active */
.split-view-container[style*="grid"] ~ .job-list-container .job-header,
.split-view-container[style*="grid"] ~ * .job-header,
#split-view-container[style*="grid"] ~ .job-list-container .job-header,
#split-view-container[style*="grid"] ~ * .job-header {
    display: none !important;
}

/* Alternative: Hide headers when split view container is visible */
body:has(#split-view-container[style*="grid"]) .job-list-container .job-header,
body:has(#split-view-container[style*="grid"]) .table-responsive-wrapper .job-header {
    display: none !important;
}

.job-row {
    border: none;
    padding: 2px 14px 2px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 2px 0;
    font-size: 12px;
    border-radius: 10px;
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    min-height: 40px;
    height: auto;
    min-width: 0;
    overflow: hidden;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.5;
    transition: background-color 0.2s ease;
}

.job-row:hover {
    background-color: #F8FAF9;
}
.truncate-text {
    display: inline-block;
    max-width: 180px; /* Adjust as needed */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: middle;
}
.job-section {
    background-color: #fff;
}
.job-list-container {
    background-color: #fff !important;
}

/* Match provider styling - no width increase needed */
.job-check {
    margin-right: 8px;
    transform: scale(1.2);
}
#toggleActions {
