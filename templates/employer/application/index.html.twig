                            <path d="M20.5 7V13C20.5 16.7712 20.5 18.6569 19.3284 19.8284C18.1569 21 16.2712 21 12.5 21H11.5C7.72876 21 5.84315 21 4.67157 19.8284C3.5 18.6569 3.5 16.7712 3.5 13V7" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M2 5C2 4.05719 2 3.58579 2.29289 3.29289C2.58579 3 3.05719 3 4 3H20C20.9428 3 21.4142 3 21.7071 3.29289C22 3.58579 22 4.05719 22 5C22 5.94281 22 6.41421 21.7071 6.70711C21.4142 7 20.9428 7 20 7H4C3.05719 7 2.58579 7 2.29289 6.70711C2 6.41421 2 5.94281 2 5Z" stroke="currentcolor" stroke-width="1.5"/>
                        </svg>
                        Archive
                    </button>
                    <button id="delete-btn" class="action-btn" title="Delete" type="button" style="pointer-events: auto; cursor: pointer; position: relative; z-index: 1000;">
                        <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.17065 4C9.58249 2.83481 10.6937 2 11.9999 2C13.3062 2 14.4174 2.83481 14.8292 4" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M20.5 6H3.49988" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M18.3735 15.3991C18.1965 18.054 18.108 19.3815 17.243 20.1907C16.378 21 15.0476 21 12.3868 21H11.6134C8.9526 21 7.6222 21 6.75719 20.1907C5.89218 19.3815 5.80368 18.054 5.62669 15.3991L5.16675 8.5M18.8334 8.5L18.6334 11.5" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M9.5 11L10 16" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M14.5 11L14 16" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        Delete
                    </button>
                </div>
                
                <!-- Right Group: Split View, Menu -->
                <div class="col-dropdowns">
                    <button type="button" id="grid-view-btn" class="action-btn" title="Split View">
                        <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3H10V10H3V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 3H21V10H14V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3 14H10V21H3V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Split View
                    </button>
                    <button id="float-view-btn" class="action-btn" title="Open in New Window">
                        <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13 3H21V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M13 21H3V3H21V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M13 11L21 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        New Window
                    </button>
                    <!-- Menu Dropdown -->
                    <div class="menu-dropdown position-relative">
                        <button type="button" class="menu-dropdown-btn dropdown-cstm"><span>Menu</span></button>
                        <div class="dropdown-panel menu-panel custom-dropdown hidden">
                            <!-- Print/Share Button -->
                            <button id="print-share-job-btn" class="menu-item">
                                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 9V2H18V9" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M6 18H4C2.89543 18 2 17.1046 2 16V11C2 9.89543 2.89543 9 4 9H20C21.1046 9 22 9.89543 22 11V16C22 17.1046 21.1046 18 20 18H18" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M6 14H18V22H6V14Z" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>Print/Share</span>
                            </button>
                            <div class="menu-divider" style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                            <!-- Regular Menu Items -->
                            <a href="#" id="export-report-btn" class="menu-item" style="text-decoration: none; color: inherit; cursor: pointer;">
                                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16.44 8.8999C20.04 9.2099 21.51 11.0599 21.51 15.1099V15.2399C21.51 19.7099 19.72 21.4999 15.25 21.4999H8.73998C4.26998 21.4999 2.47998 19.7099 2.47998 15.2399V15.1099C2.47998 11.0899 3.92998 9.2399 7.46998 8.9099" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M12 15.0001V3.62012" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M15.35 5.85L12 2.5L8.65002 5.85" stroke="#121C0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Export Report
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {% if applications|length > 0 %}
            <div class="table-responsive-wrapper" style="overflow-x: auto; width: 100%; margin-top: 16px; margin-bottom: 0; padding: 0 1rem 0 1rem !important;">
                <div class="d-flex align-items-center job-lists">
                    <div class="d-flex align-items-center flex-grow-1" style="width: 100%; min-width: 0;">
                        <div class="job-header d-flex align-items-center fw-semibold py-2 flex-grow-1" style="width: 100%; min-width: 0; gap: 0; padding-left: 20px !important; padding-right: 14px !important; padding-top: 2px !important; padding-bottom: 2px !important; box-sizing: border-box !important; font-size: 13px; font-weight: 600; letter-spacing: 0.01em; line-height: 1.5; height: 40px;">
                            <div class="col-check" style="width: 30px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center;">
                        </div>
                            <div class="col-job sortable" data-sort="employer" data-column="candidate" style="width: 150px; flex-shrink: 0; padding: 0 8px !important; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; text-align: left; cursor: pointer;">Candidate Name<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-job sortable" data-sort="job" data-column="job" style="width: 200px; flex-shrink: 0; padding: 0 8px !important; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-start; text-align: left; cursor: pointer; gap: 4px;">Job Title<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-location sortable" data-sort="location" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Location<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-salary sortable" data-sort="salary" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Salary<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-applied sortable" data-sort="applied" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Date Applied<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-category sortable" data-sort="category" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Category<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-todo sortable" data-sort="todo" style="width: 80px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">To Do<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-rank sortable" data-sort="rank" style="width: 100px; min-width: 100px; max-width: 100px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 0 8px; box-sizing: border-box; cursor: pointer; overflow: hidden; position: relative;">Score<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                            <div class="col-start col-center col-status sortable" data-sort="status" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Status<span class="sort-toggle"><svg class="arrow sort-up" width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="10" height="10" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                    </div>
                </div>
                </div>
            </div>
            <div class="job-list-container bg-light rounded-3" style="padding: 0 1rem 1rem 1rem; padding-right: 1rem !important; margin-top: 0;">
                <div class="table-responsive-wrapper" style="overflow-x: auto; width: 100%; padding-top: 0;">
                {% for application in applications %}
                    {% set job = application.job %}
                    <div class="d-flex align-items-center job-lists" style="width: 100%;">
                        <div class="job-row d-flex align-items-center flex-grow-1" style="gap: 0; min-width: 0; width: 100%; box-sizing: border-box !important; padding: 2px 14px 2px 0;">
                            <div class="col-check" style="width: 30px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center;">
                                <input type="checkbox" class="job-check job-checkbox" data-job-id="{{ job.id }}" data-application-id="{{ application.id }}" data-application-status="{{ application.status }}" data-provider-id="{{ application.provider.id }}" />
                            </div>
                            <div class="col-job d-flex align-items-center candidate-split-trigger" data-column="candidate" data-application-id="{{ application.id }}" style="width: 150px; flex-shrink: 0; padding: 0 8px !important; box-sizing: border-box; min-width: 0; overflow: hidden; display: flex; align-items: center; justify-content: flex-start; text-align: left; cursor: pointer;">
                                <div style="min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 500;">{{ application.provider.user.name|default(application.provider) }}</div>
                            </div>
                            <div class="col-job d-flex align-items-center" data-column="job" style="width: 200px; flex-shrink: 0; padding: 0 8px !important; box-sizing: border-box; min-width: 0; overflow: hidden; gap: 4px;">
                                <img src="{{ job.companyLogo|default(asset('assets/icons/job.png')) }}"
                                     alt="Logo"
                                    style="width: 24px; height: 24px; border-radius: 6px; flex-shrink: 0; object-fit: cover;"
                                    onerror="this.src='{{ asset('assets/icons/job.png') }}'" />
                                <div style="min-width: 0; overflow: hidden;">
                                    <a class="job-title truncate-text d-block fw-semibold text-decoration-none"
                                      href="{{ path('app_employer_job_applications', {'id': job.id}) }}"
                                      style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;">
                                        {{ job.title }}
                                    </a>
                                </div>
                            </div>
                            <div class="col-start col-center col-location" data-column="location" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ job.state }}</div>
                            <div class="col-start col-center col-salary" data-column="salary" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ job.formattedSalary }}</div>
                            <div class="col-start col-center col-applied" data-column="applied" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ application.createdAt|date('m/d/Y') }}</div>
                            <div class="col-start col-center col-category" data-column="category" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #121C0C;">
                                {% if job.workType == 'locums' %}
                                    Locums
                                {% elseif job.workType == 'parttime' or job.workType == 'part-time' %}
                                    Part Time
                                {% elseif job.workType == 'fulltime' or job.workType == 'full-time' %}
                                    Full Time
                                {% else %}
                                    {{ job.workType|default('—')|replace({'_': ' '})|title }}
                                {% endif %}
                            </div>
                            <div class="col-start col-center col-todo" data-column="todo" style="width: 80px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: visible; position: relative;">
                                {% set statusLower = application.status|lower|replace({'_': ''}) %}
                                {% set todoTask = null %}
                                {% if statusLower == 'applied' %}
                                    {% set todoTask = 'Revisit Alert' %}
                                {% elseif statusLower == 'shortlisted' %}
                                    {% set todoTask = 'Open Response' %}
                                {% elseif statusLower in ['interview','interviewing'] %}
                                    {% set todoTask = 'Confirm interview from the list of interview dates' %}
                                {% elseif statusLower in ['negotiating','offered'] %}
                                    {% set todoTask = 'Review signed offer/contract' %}
                                {% elseif statusLower in ['accepted','hired'] %}
                                    {% set todoTask = 'Request Credentialing Docs' %}
                                {% elseif statusLower == 'completed' %}
                                    {% set todoTask = 'See your review' %}
                                {% endif %}
                                {% set sentItems = [] %}
                                {% if application.documentProvidedAt %}{% set sentItems = sentItems|merge(['Document']) %}{% endif %}
                                {% if application.oneFileProvidedAt %}{% set sentItems = sentItems|merge(['OneFile']) %}{% endif %}
                                {% if application.contractSignedAt %}{% set sentItems = sentItems|merge(['Contract Signed']) %}{% elseif application.contractSentAt %}{% set sentItems = sentItems|merge(['Contract Sent']) %}{% endif %}
                                <span class="todo-icon-wrapper" title="{{ todoTask ?: 'Add To-Do' }}" data-application-id="{{ application.id }}" data-status="{{ application.status }}" data-todo-action="{{ todoTask }}" role="button" tabindex="0" onclick="return (window.handleEmployerTodoIconClick ? window.handleEmployerTodoIconClick(event, this) : false)">
                                    {% set todoIconType = 'documents' %}
                                    {% if todoTask %}
                                        {% if 'Revisit Alert' in todoTask %}
                                            {% set todoIconType = 'alert' %}
                                        {% elseif 'Open Response' in todoTask %}
                                            {% set todoIconType = 'response' %}
                                        {% elseif 'interview' in todoTask|lower %}
                                            {% set todoIconType = 'interview' %}
                                        {% elseif 'contract' in todoTask|lower or 'offer' in todoTask|lower %}
                                            {% set todoIconType = 'contract' %}
                                        {% elseif 'Credentialing' in todoTask %}
                                            {% set todoIconType = 'credentialing' %}
                                        {% elseif 'review' in todoTask|lower %}
                                            {% set todoIconType = 'review' %}
                                        {% endif %}
                                    {% endif %}
                                    <div class="todo-icon status-{{ application.status }}" data-todo-action="{{ todoTask }}" data-todo-type="application" data-todo-icon-type="{{ todoIconType }}" data-application-id="{{ application.id }}" data-status="{{ application.status }}">
                                        {% if todoIconType == 'alert' %}
                                            {# Bell icon for Revisit Alert #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        {% elseif todoIconType == 'response' %}
                                            {# Envelope icon for Open Response #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        {% elseif todoIconType == 'interview' %}
                                            {# Calendar icon for Confirm interview #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            </svg>
                                        {% elseif todoIconType == 'contract' %}
                                            {# Document/File icon for Review contract #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            </svg>
                                        {% elseif todoIconType == 'credentialing' %}
                                            {# Shield/Check icon for Credentialing Docs #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        {% elseif todoIconType == 'review' %}
                                            {# Star icon for See your review #}
                                            <svg viewBox="0 0 24 24" fill="#FFC107" xmlns="http://www.w3.org/2000/svg">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="#FFC107" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        {% else %}
                                            {# Default folder icon - simple folder outline #}
                                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
