{% endblock %}

{% block footer_scripts %}
    <!-- Replace slim jQuery with full jQuery for AJAX support -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Initialize datepicker
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof flatpickr !== "undefined") {
                flatpickr(".js-datepicker", {
                    enableTime: true,
                    dateFormat: "Y-m-d H:i",
                    time_24hr: true
                });
            }

            // Multiple Interview Dates Functionality
            const addInterviewDateBtn = document.getElementById('addInterviewDateBtn');
            const interviewDatesContainer = document.getElementById('interviewDatesContainer');
            
            if (addInterviewDateBtn && interviewDatesContainer) {
                // Add new date entry
                addInterviewDateBtn.addEventListener('click', function() {
                    const newEntry = document.createElement('div');
                    newEntry.className = 'interview-date-entry mb-2 d-flex gap-2 align-items-end';
                    newEntry.innerHTML = `
                        <div class="flex-grow-1">
                            <label class="form-label small">Date</label>
                            <input type="datetime-local" class="form-control interview-date" name="interview_dates[]" required>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm remove-date-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    interviewDatesContainer.appendChild(newEntry);
                    updateRemoveButtons();
                });

                // Remove date entry
                interviewDatesContainer.addEventListener('click', function(e) {
                    if (e.target.closest('.remove-date-btn')) {
                        e.target.closest('.interview-date-entry').remove();
                        updateRemoveButtons();
                    }
                });

                function updateRemoveButtons() {
                    const entries = interviewDatesContainer.querySelectorAll('.interview-date-entry');
                    entries.forEach((entry, index) => {
                        const removeBtn = entry.querySelector('.remove-date-btn');
                        if (removeBtn) {
                            removeBtn.style.display = entries.length > 1 ? 'block' : 'none';
                        }
                    });
                }
                updateRemoveButtons();
            }

            // Schedule Interview Modal Handler
            const scheduleInterviewModal = document.getElementById('scheduleInterviewModal');
            if (scheduleInterviewModal) {
                scheduleInterviewModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    const form = this.querySelector('#scheduleInterviewForm');
                    const actionUrl = "{{ path('app_employer_application_scheduleinterview', {'id': 'APPLICATION_ID'}) }}".replace('APPLICATION_ID', applicationId);
                form.setAttribute('action', actionUrl);
                    document.getElementById('scheduleInterviewApplicationId').value = applicationId;
                });
            }

            // Send Offer Modal Handler
            const sendOfferModal = document.getElementById('sendOfferModal');
            if (sendOfferModal) {
                sendOfferModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    document.getElementById('sendOfferApplicationId').value = applicationId;
                    // Set form action URL here if needed
                });
            }

            // Send Credential Link Modal Handler
            const sendCredentialLinkModal = document.getElementById('sendCredentialLinkModal');
            if (sendCredentialLinkModal) {
                sendCredentialLinkModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    const providerId = button.getAttribute('data-provider-id');
                    document.getElementById('credentialLinkApplicationId').value = applicationId;
                    document.getElementById('credentialLinkProviderId').value = providerId;
                });
            }

            // Write Review Modal Handler
            const writeReviewModal = document.getElementById('writeReviewModal');
            if (writeReviewModal) {
                writeReviewModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    document.getElementById('writeReviewApplicationId').value = applicationId;
                    // Set form action URL here if needed
                });
            }

            // Handle application selection and show/hide action buttons based on status
            let selectedApplicationId = null;
            let selectedApplicationStatus = null;
            let selectedProviderId = null;

            function updateActionButtons() {
                // Hide all action buttons first
                document.querySelectorAll('[id^="action-"]').forEach(function(btn) {
                    btn.style.display = 'none';
                });

                if (!selectedApplicationId || !selectedApplicationStatus) {
                    return;
                }

                // Show buttons based on status
                const status = selectedApplicationStatus.toLowerCase();
                
                if (status === 'applied') {
                    document.getElementById('action-request-file-btn').style.display = 'flex';
                } else if (status === 'in_review' || status === 'shortlisted') {
                    document.getElementById('action-schedule-interview-btn').style.display = 'flex';
                } else if (status === 'interview' || status === 'interviewing') {
                    document.getElementById('action-request-documents-btn').style.display = 'flex';
                } else if (status === 'offered' || status === 'negotiating') {
                    document.getElementById('action-send-offer-btn').style.display = 'flex';
                    document.getElementById('action-send-contract-btn').style.display = 'flex';
                } else if (status === 'accepted' || status === 'hired') {
                    document.getElementById('action-send-credential-btn').style.display = 'flex';
                } else if (status === 'completed') {
                    document.getElementById('action-write-review-btn').style.display = 'flex';
                }
            }

            // Handle checkbox selection
            document.querySelectorAll('.job-checkbox').forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    // Uncheck all other checkboxes
                    document.querySelectorAll('.job-checkbox').forEach(function(cb) {
                        if (cb !== this) {
                            cb.checked = false;
                        }
                    }.bind(this));

                    if (this.checked) {
                        selectedApplicationId = this.getAttribute('data-application-id');
                        selectedApplicationStatus = this.getAttribute('data-application-status');
                        selectedProviderId = this.getAttribute('data-provider-id');
                        updateActionButtons();
                    } else {
                        selectedApplicationId = null;
                        selectedApplicationStatus = null;
                        selectedProviderId = null;
                        updateActionButtons();
                    }
                });
            });

            // Handle action button clicks - set application ID for modals
            document.getElementById('action-request-file-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#askDocumentModal input[name="application_id"]');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
            });

            document.getElementById('action-request-documents-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#askDocumentModal input[name="application_id"]');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
            });

            document.getElementById('action-schedule-interview-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#scheduleInterviewApplicationId');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
            });

            document.getElementById('action-send-offer-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#sendOfferApplicationId');
                const select = document.querySelector('#sendOfferModal select[name="document_type"]');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
                if (select) {
                    select.value = 'offer';
                }
            });

            document.getElementById('action-send-contract-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#sendOfferApplicationId');
                const select = document.querySelector('#sendOfferModal select[name="document_type"]');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
                if (select) {
                    select.value = 'contract';
                }
            });

            document.getElementById('action-send-credential-btn')?.addEventListener('click', function() {
                const appIdInput = document.querySelector('#credentialLinkApplicationId');
                const providerIdInput = document.querySelector('#credentialLinkProviderId');
                if (appIdInput && selectedApplicationId) {
                    appIdInput.value = selectedApplicationId;
                }
                if (providerIdInput && selectedProviderId) {
                    providerIdInput.value = selectedProviderId;
                }
            });

            document.getElementById('action-write-review-btn')?.addEventListener('click', function() {
                const hiddenInput = document.querySelector('#writeReviewApplicationId');
                if (hiddenInput && selectedApplicationId) {
                    hiddenInput.value = selectedApplicationId;
                }
            });

            // Filter button toggle
            const filterBtn = document.getElementById('filter-btn');
            const filterPanel = document.getElementById('filter-panel');
            if (filterBtn && filterPanel) {
                filterBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isHidden = filterPanel.classList.contains('hidden');
                    
                    // Close all other dropdowns
                    document.querySelectorAll('.custom-dropdown').forEach(function(panel) {
                        if (panel !== filterPanel) {
                            panel.classList.add('hidden');
                        }
                    });
                    
                    // Toggle filter panel
                    if (isHidden) {
                        filterPanel.classList.remove('hidden');
                    } else {
                        filterPanel.classList.add('hidden');
                    }
                });
            }

            // Menu dropdown toggle
            const menuDropdownBtn = document.querySelector('.menu-dropdown-btn');
            const menuPanel = document.querySelector('.menu-panel');
            if (menuDropdownBtn && menuPanel) {
                menuDropdownBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isHidden = menuPanel.classList.contains('hidden');
                    
                    // Close all other dropdowns
                    document.querySelectorAll('.custom-dropdown').forEach(function(panel) {
                        if (panel !== menuPanel) {
                            panel.classList.add('hidden');
                        }
                    });
                    
                    // Toggle menu panel
                    if (isHidden) {
                        menuPanel.classList.remove('hidden');
                    } else {
                        menuPanel.classList.add('hidden');
                    }
                });
            }

            // Close dropdowns when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.position-relative') && !e.target.closest('.custom-dropdown')) {
                    document.querySelectorAll('.custom-dropdown').forEach(function(panel) {
                        panel.classList.add('hidden');
                    });
                }
            });

            // Ask Document Modal Handler
            const askDocumentModal = document.getElementById('askDocumentModal');
            if (askDocumentModal) {
                askDocumentModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button ? button.getAttribute('data-application_id') : 
                                          document.querySelector('#askDocumentModal input[name="application_id"]').value;
                const hiddenInput = document.querySelector('#askDocumentModal input[name="application_id"]');
                if (applicationId && hiddenInput) {
                    hiddenInput.value = applicationId;
                }
            });
            }
    });
</script>
{% endblock %}
