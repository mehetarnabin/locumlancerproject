                            <div class="split-job-summary-item">
                                <span class="split-job-meta-label">Applied:</span>
                                <span class="split-job-meta-value">{{ application.createdAt|date('m/d/Y') }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
