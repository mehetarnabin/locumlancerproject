    <script>
        // Fix Job Title header alignment - force left align
        function forceJobTitleLeftAlign() {
            // Target the specific div with class "col-job sortable" containing "Job Title"
            const jobTitleHeader = document.querySelector('.job-header .col-job.sortable[data-sort="job"]');
            if (jobTitleHeader) {
                // Force left alignment using setProperty with important
                jobTitleHeader.style.setProperty('justify-content', 'flex-start', 'important');
                jobTitleHeader.style.setProperty('text-align', 'left', 'important');
                jobTitleHeader.style.setProperty('display', 'flex', 'important');
                jobTitleHeader.style.setProperty('align-items', 'center', 'important');
                
                // Also ensure all children are left-aligned
                const children = jobTitleHeader.querySelectorAll('*');
                children.forEach(function(child) {
                    child.style.setProperty('text-align', 'left', 'important');
                });
            }
            
            // Also target any col-job.sortable in job-header
            const allJobHeaders = document.querySelectorAll('.job-header .col-job.sortable');
            allJobHeaders.forEach(function(header) {
                if (header.textContent.includes('Job Title')) {
                    header.style.setProperty('justify-content', 'flex-start', 'important');
                    header.style.setProperty('text-align', 'left', 'important');
                }
            });
        }
        
        // Initialize datepicker
        document.addEventListener('DOMContentLoaded', function() {
            // Fix Job Title alignment immediately
            forceJobTitleLeftAlign();
            
            // Run again after a delay to catch any dynamic content
            setTimeout(forceJobTitleLeftAlign, 100);
            setTimeout(forceJobTitleLeftAlign, 300);
            setTimeout(forceJobTitleLeftAlign, 500);
            
            // Watch for DOM changes
            const observer = new MutationObserver(function(mutations) {
                forceJobTitleLeftAlign();
            });
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class']
            });
            
            if (typeof flatpickr !== "undefined") {
                flatpickr(".js-datepicker", {
                    enableTime: true,
                    dateFormat: "Y-m-d H:i",
                    time_24hr: true
                });
            }

            // Multiple Interview Dates Functionality
            const addInterviewDateBtn = document.getElementById('addInterviewDateBtn');
            const interviewDatesContainer = document.getElementById('interviewDatesContainer');
            
                if (addInterviewDateBtn && interviewDatesContainer) {
                    // Add new date entry
                    addInterviewDateBtn.addEventListener('click', function() {
                        const newEntry = document.createElement('div');
                        newEntry.className = 'interview-date-entry mb-2 d-flex gap-2 align-items-end';
                        newEntry.innerHTML = `
                            <div class="flex-grow-1">
                                <label class="form-label small">From</label>
                                <input type="datetime-local" class="form-control interview-date-start" name="interview_start[]" required>
                            </div>
                            <div class="flex-grow-1">
                                <label class="form-label small">To</label>
                                <input type="datetime-local" class="form-control interview-date-end" name="interview_end[]" required>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm remove-date-btn">
                                <i class="fas fa-times"></i>
                            </button>
                        `;
                        interviewDatesContainer.appendChild(newEntry);
                        try {
                            const nowVal = SERVER_NOW;
                            const startEl = newEntry.querySelector('.interview-date-start');
                            const endEl = newEntry.querySelector('.interview-date-end');
                            if (startEl) startEl.min = nowVal;
                            if (endEl) endEl.min = nowVal;
                            if (startEl && endEl) {
                                startEl.addEventListener('change', function(){
                                    if (startEl.value) endEl.min = startEl.value;
                                });
                                startEl.addEventListener('input', function(){
                                    const nowStr = SERVER_NOW;
                                    try { startEl.min = nowStr; } catch(_){}
                                    if (startEl.value && new Date(startEl.value) < new Date(nowStr)) {
                                        startEl.value = nowStr;
                                    }
                                    try { endEl.min = startEl.value || nowStr; } catch(_){}
                                    if (endEl.value && startEl.value && new Date(endEl.value) < new Date(startEl.value)) {
                                        endEl.value = startEl.value;
                                    }
                                });
                                endEl.addEventListener('input', function(){
                                    const nowStr = SERVER_NOW;
                                    try { endEl.min = startEl.value || nowStr; } catch(_){}
                                    if (endEl.value) {
                                        const minStr = startEl.value || nowStr;
                                        if (new Date(endEl.value) < new Date(minStr)) {
                                            endEl.value = minStr;
                                        }
                                    }
                                });
                            }
                        } catch (_) {}
                        updateRemoveButtons();
                    });

                // Remove date entry
                interviewDatesContainer.addEventListener('click', function(e) {
                    if (e.target.closest('.remove-date-btn')) {
                        e.target.closest('.interview-date-entry').remove();
                        updateRemoveButtons();
                    }
                });

                function updateRemoveButtons() {
                    const entries = interviewDatesContainer.querySelectorAll('.interview-date-entry');
                    entries.forEach((entry, index) => {
                        const removeBtn = entry.querySelector('.remove-date-btn');
                        if (removeBtn) {
                            removeBtn.style.display = entries.length > 1 ? 'block' : 'none';
                        }
                    });
                }
                updateRemoveButtons();
            }

            (function(){
                function safeOpenModal(id){
                    var m = document.getElementById(id);
                    if (!m) return;
                    if (m.parentElement !== document.body) document.body.appendChild(m);
                    if (window.bootstrap && window.bootstrap.Modal) {
                        try {
                            var ModalCtor = window.bootstrap.Modal;
                            if (typeof ModalCtor.getOrCreateInstance === 'function') {
                                ModalCtor.getOrCreateInstance(m).show();
                            } else {
                                new ModalCtor(m).show();
                            }
                        } catch(_){
                            try { new window.bootstrap.Modal(m).show(); } catch(__){}
                        }
                    } else if ((window.$ || window.jQuery) && ((window.$ && window.$.fn && window.$.fn.modal) || (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal))) {
                        var $ = window.$ || window.jQuery;
                        $(m).modal('show');
                    } else {
                        m.classList.add('show');
                        m.style.display = 'block';
                        m.setAttribute('aria-hidden', 'false');
                    }
                    setTimeout(function(){
                        m.style.zIndex = '200000';
                        var dlg = m.querySelector('.modal-dialog');
                        if (dlg) { try { dlg.style.setProperty('z-index','200001','important'); } catch(_){ dlg.style.zIndex='200001'; } dlg.style.display = 'block'; }
                        var content = m.querySelector('.modal-content');
                        if (content) content.style.display = 'block';
                        var bd = document.querySelector('.modal-backdrop');
                        if (bd) bd.style.zIndex = '199999';
                        try {
                            if (id === 'interviewModal' && typeof window.updateInterviewInputsMin === 'function') {
                                window.updateInterviewInputsMin();
                            }
                        } catch(_){}
                    }, 50);
                }
                
            })();
            // Schedule Interview Modal Handler
            const interviewModal = document.getElementById('interviewModal');
            if (interviewModal) {
                if (!window.updateInterviewInputsMin) {
                    window.updateInterviewInputsMin = function(){
                        var modal = document.getElementById('interviewModal');
                        if (!modal) return;
                        function pad(n){ return String(n).padStart(2,'0'); }
                        var d = new Date();
                        var nowStr = d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                        modal.querySelectorAll('.interview-date-start,.interview-date-end').forEach(function(el){
                            try { el.min = nowStr; } catch(_){}
                            el.addEventListener('focus', function(){
                                var nd = new Date();
                                var ns = nd.getFullYear() + '-' + pad(nd.getMonth()+1) + '-' + pad(nd.getDate()) + 'T' + pad(nd.getHours()) + ':' + pad(nd.getMinutes());
                                try { el.min = ns; } catch(_){}
                            });
                            el.addEventListener('input', function(){
                                var nd = new Date();
                                var ns = nd.getFullYear() + '-' + pad(nd.getMonth()+1) + '-' + pad(nd.getDate()) + 'T' + pad(nd.getHours()) + ':' + pad(nd.getMinutes());
                                try { el.min = ns; } catch(_){}
                                if (el.value && new Date(el.value) < new Date(ns)) { el.value = ns; }
                                var entry = el.closest('.interview-date-entry');
                                if (entry) {
                                    var sEl = entry.querySelector('.interview-date-start');
                                    var eEl = entry.querySelector('.interview-date-end');
                                    if (sEl && eEl) {
                                        var minStr = sEl.value || ns;
                                        try { eEl.min = minStr; } catch(_){}
                                        if (eEl.value && new Date(eEl.value) < new Date(minStr)) {
                                            eEl.value = minStr;
                                        }
                                    }
                                }
                            });
                        });
                    };
                }
                interviewModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    if (button && button.hasAttribute('data-application-id')) {
                        const applicationId = button.getAttribute('data-application-id');
                        const hiddenInput = document.getElementById('scheduleInterviewApplicationId');
                        if (hiddenInput) hiddenInput.value = applicationId;
                    }
                    try {
                        var nowVal = SERVER_NOW;
                        interviewModal.querySelectorAll('.interview-date-start,.interview-date-end').forEach(function(el){ el.min = nowVal; });
                        interviewModal.querySelectorAll('.interview-date-start').forEach(function(startEl){
                            startEl.addEventListener('change', function(){
                                var entry = startEl.closest('.interview-date-entry');
                                var endEl = entry ? entry.querySelector('.interview-date-end') : null;
                                if (endEl && startEl.value) { endEl.min = startEl.value; }
                            });
                        });
                        interviewModal.querySelectorAll('.interview-date-start,.interview-date-end').forEach(function(el){
                            el.addEventListener('input', function(){
                                var nowStr = SERVER_NOW;
                                try { el.min = nowStr; } catch(_){}
                                if (el.value) {
                                    var v = new Date(el.value);
                                    var n = new Date(nowStr);
                                    if (v < n) { el.value = nowStr; }
                                }
                                var entry = el.closest('.interview-date-entry');
                                if (entry) {
                                    var sEl = entry.querySelector('.interview-date-start');
                                    var eEl = entry.querySelector('.interview-date-end');
                                    if (sEl && eEl && sEl.value) {
                                        try { eEl.min = sEl.value; } catch(_){}
                                        if (eEl.value && new Date(eEl.value) < new Date(sEl.value)) {
                                            eEl.value = sEl.value;
                                        }
                                    }
                                }
                            });
                        });
                        try { window.updateInterviewInputsMin(); } catch(_){}
                    } catch(_){}
                });

                // AJAX Form Submission
                const form = document.getElementById('scheduleInterviewForm');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        const submitBtn = form.querySelector('button[type="submit"]');
                        const originalBtnText = submitBtn ? submitBtn.textContent : 'Send Schedule';
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.textContent = 'Sending...';
                        }
                        
                        const formData = new FormData(form);
                        try {
                            const startInputs = form.querySelectorAll('.interview-date-start');
                            const endInputs = form.querySelectorAll('.interview-date-end');
                            // Basic validation: ensure each start has matching end and start <= end
                            startInputs.forEach((startEl, idx) => {
                                const endEl = endInputs[idx];
                                if (startEl && endEl && startEl.value && endEl.value) {
                                    const s = new Date(startEl.value);
                                    const e = new Date(endEl.value);
                                    if (e < s) {
                                        throw new Error('End date/time must be after start date/time.');
                                    }
                                }
                            });
                            // Keep backward compatibility: set hidden meeting_date to first start
                            const hiddenMeeting = document.getElementById('meeting_date');
                            if (hiddenMeeting && startInputs.length > 0 && startInputs[0].value) {
                                hiddenMeeting.value = startInputs[0].value;
                            }
                        } catch (validationErr) {
                            alert(validationErr.message || 'Invalid date range.');
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.textContent = originalBtnText;
                            }
                            return;
                        }
                        // Ensure application_id is set
                        if (!formData.get('application_id')) {
                            // try to get from hidden input directly
                            const appIdVal = document.getElementById('scheduleInterviewApplicationId').value;
                            if (appIdVal) formData.set('application_id', appIdVal);
                            else if (typeof selectedApplicationId !== 'undefined' && selectedApplicationId) formData.set('application_id', selectedApplicationId);
                        }
                        
                        // Construct URL robustly from application_id
                        const appIdForUrl = formData.get('application_id') || document.getElementById('scheduleInterviewApplicationId')?.value;
                        let url = form.action;
                        const invalidAction = (!url || url === '#' || url.endsWith('#') || url === window.location.href);
                        if (invalidAction || !url) {
                            if (appIdForUrl) {
                                url = "{{ path('app_employer_application_scheduleinterview', {'id': 'APPLICATION_ID'}) }}".replace('APPLICATION_ID', appIdForUrl);
                            } else {
                                alert('Missing application ID. Please select an application and try again.');
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = originalBtnText;
                                }
                                return;
                            }
                        }
                        
                        fetch(url, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => {
                            const ct = response.headers.get('content-type') || '';
                            if (ct.indexOf('application/json') !== -1) {
                                return response.json();
                            }
                            // Non-JSON fallback: treat 200 OK as success
                            if (response.ok) {
                                return { success: true, message: 'Interview schedule sent successfully.' };
                            }
                            throw new Error('Unexpected response (' + response.status + ')');
                        })
                        .then(data => {
                            if (data && data.success) {
                                // Close modal
                                const closeBtn = interviewModal.querySelector('.close');
                                if (closeBtn) closeBtn.click();
                                else {
                                    const modalInstance = bootstrap.Modal.getInstance(interviewModal);
                                    if (modalInstance) modalInstance.hide();
                                }
                                // Immediate success alert
                                (function(){
                                    var container = document.querySelector('.container-xl') || document.body;
                                    var alertDiv = document.createElement('div');
                                    alertDiv.className = 'alert alert-success alert-dismissible show';
                                    alertDiv.setAttribute('role', 'alert');
                                    alertDiv.innerHTML = (data.message || 'Interview schedule sent successfully.') + '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
                                    if (container.firstChild) {
                                        container.insertBefore(alertDiv, container.firstChild);
                                    } else {
                                        container.appendChild(alertDiv);
                                    }
                                    window.scrollTo({ top: 0, behavior: 'smooth' });
                                })();
                                // Also set flag to show after reload and refresh page to update lists
                                try { sessionStorage.setItem('interviewScheduledSuccess', '1'); } catch (_) {}
                                setTimeout(function(){ location.reload(); }, 600);
                            } else {
                                alert('Error: ' + (data.message || 'Failed to process request'));
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('An error occurred. Please try again.');
                        })
                        .finally(() => {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.textContent = originalBtnText;
                            }
                        });
                    });
                }
            }

            (function(){
                try {
                    var flag = sessionStorage.getItem('interviewScheduledSuccess');
                    if (flag) {
                        sessionStorage.removeItem('interviewScheduledSuccess');
                        var container = document.querySelector('.container-xl') || document.body;
                        var alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible show';
                        alertDiv.setAttribute('role', 'alert');
                        alertDiv.innerHTML = 'Interview schedule sent successfully.<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
                        if (container.firstChild) {
                            container.insertBefore(alertDiv, container.firstChild);
                        } else {
                            container.appendChild(alertDiv);
                        }
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                } catch (_) {}
            })();

            // Send Offer Modal Handler
            const sendOfferModal = document.getElementById('sendOfferModal');
            if (sendOfferModal) {
                sendOfferModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    document.getElementById('sendOfferApplicationId').value = applicationId;
                    // Set form action URL here if needed
                });
            }

            // Send Credential Link Modal Handler
            const sendCredentialLinkModal = document.getElementById('sendCredentialLinkModal');
            if (sendCredentialLinkModal) {
                sendCredentialLinkModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const applicationId = button.getAttribute('data-application_id');
                    const providerId = button.getAttribute('data-provider-id');
                    document.getElementById('credentialLinkApplicationId').value = applicationId;
                    document.getElementById('credentialLinkProviderId').value = providerId;
                });
            }

            // Write Review Modal Handler
            const writeReviewModal = document.getElementById('writeReviewModal');
            if (writeReviewModal) {
                writeReviewModal.addEventListener('show.bs.modal', function(event) {
                    const form = document.getElementById('writeReviewForm');
                    const hiddenInput = document.getElementById('writeReviewApplicationId');
                    const applicationId = hiddenInput && hiddenInput.value ? hiddenInput.value : (typeof selectedApplicationId !== 'undefined' ? selectedApplicationId : '');
                    if (hiddenInput && applicationId) {
                        hiddenInput.value = applicationId;
                    }
                    if (form && applicationId) {
