            function updateStatusSwitchButton() {
                // Use window version if local version is not available (for split view)
                const statusValue = selectedApplicationStatus || window.selectedApplicationStatus;
                if (!statusValue) return;

                const status = statusValue.toLowerCase();
                let currentStatusLabel = status.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
                
                // Map legacy statuses
                if (status === 'in_review') currentStatusLabel = 'Shortlisted';
                if (status === 'interview') currentStatusLabel = 'Interviewing';
                if (status === 'offered') currentStatusLabel = 'Negotiating';
                if (status === 'hired') currentStatusLabel = 'Accepted';
                
                // Show the button
                const statusSwitchContainer = document.getElementById('status-switch-container');
                if (statusSwitchContainer) {
                    statusSwitchContainer.style.display = 'flex';
                }

                // Update button text
                const statusSwitchText = document.getElementById('status-switch-text');
                if (statusSwitchText) {
                    statusSwitchText.textContent = currentStatusLabel;
                }

                // Update dropdown content
                const statusCurrentLabel = document.getElementById('status-current-label');
                if (statusCurrentLabel) {
                    statusCurrentLabel.textContent = currentStatusLabel;
                }

                const optionsContainer = document.getElementById('status-options-container');
                if (optionsContainer) {
                    optionsContainer.innerHTML = ''; // Clear existing options
                    
                    const allStatuses = [
                        { key: 'applied', label: 'Applied', transition: 'move_to_applied' },
                        { key: 'shortlisted', label: 'Shortlisted', transition: 'shortlist' },
                        { key: 'interviewing', label: 'Interviewing', transition: 'interview' },
                        { key: 'negotiating', label: 'Negotiating', transition: 'negotiate' },
                        { key: 'accepted', label: 'Accepted', transition: 'accept' },
                        { key: 'completed', label: 'Completed', transition: 'complete' }
                    ];

                    // Determine next status key
                    let nextStatusKey = null;
                    if (status === 'applied') nextStatusKey = 'shortlisted';
                    else if (status === 'in_review' || status === 'shortlisted') nextStatusKey = 'interviewing';
                    else if (status === 'interview' || status === 'interviewing') nextStatusKey = 'negotiating';
                    else if (status === 'offered' || status === 'negotiating') nextStatusKey = 'accepted';
                    else if (status === 'hired' || status === 'accepted') nextStatusKey = 'completed';

                    // Helper to create button
                    const createButton = (option, isPrimary = false) => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'status-change-btn';
                        btn.style.cssText = `width: 100%; padding: 8px 12px; background: #85BB65; color: #fff; border: 1px solid #85BB65; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-align: left; display: flex; align-items: center; justify-content: space-between; transition: all 0.2s; margin-bottom: 4px;`;
                        
                        btn.innerHTML = `
                            <span>${option.label}</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: #fff;">
                                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        `;
                        
                        btn.onclick = function() {
                            // Use window version if local version is not available (for split view)
                            const appId = selectedApplicationId || window.selectedApplicationId;
                            const jobId = selectedJobId || window.selectedJobId;
                            if (appId) {
                                changeApplicationStatus(option.transition, appId, jobId);
                            } else {
                                console.error('Application ID not found for status change');
                            }
                        };
                        return btn;
                    };

                    // Only add Next Status Option
                    if (nextStatusKey) {
                        const nextOption = allStatuses.find(opt => opt.key === nextStatusKey);
                        if (nextOption) {
                            optionsContainer.appendChild(createButton(nextOption, true));
                        }
                    } else {
                        // If no next status (e.g. completed), show message
                         optionsContainer.innerHTML = '<div style="font-size: 13px; color: #666; padding: 4px 0;">No next phase</div>';
                    }
                }
            }

