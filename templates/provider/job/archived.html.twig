<script>
// Rank editing functionality for archived applications - using event delegation
(function() {
    if (window.archivedRankEditingInitialized) {
        return; // Already initialized
    }
    window.archivedRankEditingInitialized = true;

    function saveRank(input) {
        let value = parseFloat(input.value);
        const applicationId = input.dataset.applicationId;
        const wrapper = input.closest('.rank-input-wrapper');
        const display = wrapper ? wrapper.previousElementSibling : input.previousElementSibling;

        if (isNaN(value)) {
            showErrorAlert('Invalid Score', 'Score must be a number between 1 and 10.');
            input.value = input.dataset.originalValue || '';
            return;
        }

        // Clamp and round to nearest 0.5
        if (value < 1) value = 1;
        if (value > 10) value = 10;
        value = Math.round(value * 2) / 2;

        if (value === parseFloat(input.dataset.originalValue)) {
            if (wrapper) {
                wrapper.classList.add('hidden');
            } else {
                input.classList.add('hidden');
            }
            if (display) display.classList.remove('hidden');
            return;
        }

        // AJAX request
        fetch('{{ path("app_update_application_rank") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ applicationId, rank: value })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (display) {
                    display.textContent = value;
                    display.classList.remove('hidden');
                }
                input.dataset.originalValue = value;
                if (wrapper) {
                    wrapper.classList.add('hidden');
                } else {
                    input.classList.add('hidden');
                }
                // Show toast
                let msg = document.getElementById('rank-success-msg');
                if (!msg) {
                    msg = document.createElement('div');
                    msg.id = 'rank-success-msg';
                    msg.style.position = 'fixed';
                    msg.style.top = '20px';
                    msg.style.right = '20px';
                    msg.style.backgroundColor = '#4CAF50';
                    msg.style.color = 'white';
                    msg.style.padding = '10px 15px';
                    msg.style.borderRadius = '5px';
                    msg.style.zIndex = '9999';
                    document.body.appendChild(msg);
                }
                msg.textContent = 'Score updated successfully!';
                msg.style.display = 'block';
                if (msg.timeoutId) clearTimeout(msg.timeoutId);
                msg.timeoutId = setTimeout(() => { msg.style.display = 'none'; }, 2000);
            } else {
                showErrorAlert('Update Failed', 'Failed to update score: ' + (data.message || 'Unknown error'));
                input.value = input.dataset.originalValue || '';
            }
        })
        .catch(err => {
            console.error('Fetch error:', err);
            showErrorAlert('Server Error', 'Server error while updating score.');
            input.value = input.dataset.originalValue || '';
        });
    }

    // Use event delegation for all rank editing interactions
    document.addEventListener('click', function(e) {
        // Handle rank display click
        const rankDisplay = e.target.closest('.rank-display');
        if (rankDisplay && !rankDisplay.classList.contains('hidden')) {
            e.preventDefault();
            e.stopPropagation();
            const wrapper = rankDisplay.nextElementSibling;
            if (wrapper && wrapper.classList.contains('rank-input-wrapper')) {
                const input = wrapper.querySelector('.rank-input');
                if (input) {
                    wrapper.classList.remove('hidden');
                    rankDisplay.classList.add('hidden');
                    // Initialize original value if not set
                    if (!input.dataset.originalValue) {
                        input.dataset.originalValue = input.value || '';
                    }
                    setTimeout(() => {
                        input.focus();
                        input.select();
                    }, 10);
                }
            }
            return false;
        }
    }, true); // Use capture phase to ensure we catch the event early

    // Handle keyboard events on rank inputs
    document.addEventListener('keydown', function(e) {
        const rankInput = e.target.closest('.rank-input');
        if (!rankInput) return;

        if (e.key === 'Enter') {
            e.preventDefault();
            rankInput.blur(); // Trigger blur which will save
        } else if (e.key === 'Escape') {
            const wrapper = rankInput.closest('.rank-input-wrapper');
            const display = wrapper ? wrapper.previousElementSibling : rankInput.previousElementSibling;
            rankInput.value = rankInput.dataset.originalValue || '';
            if (wrapper) {
                wrapper.classList.add('hidden');
            } else {
                rankInput.classList.add('hidden');
            }
            if (display) display.classList.remove('hidden');
        }
    });

    // Initialize original values for existing inputs and set up auto-save on blur
    function initializeRankValues() {
        document.querySelectorAll('.rank-input').forEach(input => {
            if (!input.dataset.originalValue) {
                input.dataset.originalValue = input.value || '';
            }
            // Add blur event listener for auto-save
            input.addEventListener('blur', function() {
                // Small delay to allow click events to process first
                setTimeout(() => {
                    saveRank(input);
                }, 200);
            });
        });
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeRankValues);
    } else {
        initializeRankValues();
    }
})();
</script>

<script>
  // Single-selection feature: automatically uncheck previous selection when new one is selected
  document.addEventListener('DOMContentLoaded', function() {
    // Delegated change listener to catch any checkbox state changes reliably
    document.addEventListener('change', (e) => {
      const target = e.target;
      if (!target) return;
      if (target.classList && (target.classList.contains('job-checkbox') || target.classList.contains('job-check'))) {
        // Enforce single selection - automatically uncheck others
        if (target.checked) {
          const jobId = target.dataset.jobId || target.dataset.bookmarkId;
          // Get all checkboxes (including split view ones)
          const allCheckboxes = document.querySelectorAll('.job-checkbox, .job-check');
          // Uncheck all other checkboxes and check all instances of this job (sync views)
          allCheckboxes.forEach(cb => {
            const cbJobId = cb.dataset.jobId || cb.dataset.bookmarkId;
            if (cbJobId === jobId) {
              cb.checked = true;
            } else {
              cb.checked = false;
            }
          });
          window.selectedJobId = jobId;
        } else {
          // If unchecking, clear selection
          const jobId = target.dataset.jobId || target.dataset.bookmarkId;
          if (window.selectedJobId === jobId) {
            window.selectedJobId = null;
          }
        }
        // Update UI states if functions exist
        if (typeof toggleActionsVisibility === 'function') toggleActionsVisibility();
        if (typeof updateButtonStates === 'function') updateButtonStates();
      }
    });
  });
</script>

<script>
// Menu dropdown functionality
document.addEventListener('DOMContentLoaded', function() {
    const menuBtn = document.querySelector('.menu-dropdown-btn');
    const menuPanel = document.querySelector('.menu-panel');

    function toggleDropdown(panel, btn) {
        const isOpen = !panel.classList.contains('hidden');
        closeAllDropdowns();
        if (!isOpen) panel.classList.remove('hidden');
    }

    function closeAllDropdowns() {
        if (menuPanel) menuPanel.classList.add('hidden');
    }

    if (menuBtn && menuPanel) {
        menuBtn.addEventListener('click', e => {
            e.stopPropagation();
            toggleDropdown(menuPanel, menuBtn);
        });

        document.addEventListener('click', e => {
            if (!menuPanel.contains(e.target) && !menuBtn.contains(e.target)) {
                closeAllDropdowns();
            }
        });
    }

    // Generate PDF from job details and open print window
    function generateJobPDF(jobId) {
        if (!jobId) {
            if (typeof showWarningAlert === 'function') {
                showWarningAlert('No Job Selected', 'Please select a job first');
            } else {
                alert('Please select a job first');
            }
            return;
        }
        
        // Fetch job details
        const url = '/provider/jobs/' + jobId + '/detail-content';
        fetch(url)
            .then(response => response.text())
            .then(html => {
                // Parse the HTML to extract job details
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                
                // Extract job information
                const jobTitle = doc.querySelector('.job-detail-title, h1, h2, h3, h4')?.textContent?.trim() || 'Job Details';
                const jobCompany = doc.querySelector('.job-detail-company, .company-name')?.textContent?.trim() || '';
                const jobLocation = doc.querySelector('.job-detail-meta-item')?.textContent?.trim() || '';
                
                // Get all job detail sections
                const sections = doc.querySelectorAll('.job-detail-section, .job-detail-meta-item');
                let jobDetailsHTML = '';
                
                sections.forEach(section => {
                    // Clone and clean the section
                    const clone = section.cloneNode(true);
                    // Remove buttons and action elements
                    clone.querySelectorAll('button, .btn, .action-btn, .no-print').forEach(el => el.remove());
                    jobDetailsHTML += clone.outerHTML;
                });
                
                // If no sections found, use the full HTML
                if (!jobDetailsHTML) {
                    const fullContent = doc.body.cloneNode(true);
                    fullContent.querySelectorAll('button, .btn, .action-btn, .no-print, script, style').forEach(el => el.remove());
                    jobDetailsHTML = fullContent.innerHTML;
                }
                
                // Create a clean HTML document for PDF
                const pdfHTML = `
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>${jobTitle} - Job Details</title>
    <style>
        @page { margin: 1.5cm; }
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.6;
            color: #000;
            padding: 20px;
            max-width: 800px;
            margin: 0 auto;
        }
        h1 {
            font-size: 24pt;
            color: #121C0C;
            border-bottom: 3px solid #85BB65;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        h2 {
            font-size: 18pt;
            color: #121C0C;
            margin-top: 25px;
            margin-bottom: 10px;
            border-bottom: 1px solid #e6eef6;
            padding-bottom: 5px;
        }
        .job-header {
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #e6eef6;
        }
        .job-company {
            font-size: 16pt;
            color: #666;
            margin-bottom: 10px;
        }
        .job-detail-section {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }
        .job-detail-label {
            font-weight: bold;
            color: #121C0C;
            margin-right: 8px;
        }
        .job-detail-meta-item {
            background: #f8f9fa;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="job-header">
        <h1>${jobTitle}</h1>
        ${jobCompany ? `<div class="job-company">${jobCompany}</div>` : ''}
        ${jobLocation ? `<div>${jobLocation}</div>` : ''}
    </div>
    ${jobDetailsHTML}
</body>
</html>`;
                
                // Open print window
                const printWindow = window.open('', '_blank');
                printWindow.document.write(pdfHTML);
                printWindow.document.close();
                
                // Wait for content to load, then print
                printWindow.onload = function() {
                    setTimeout(() => {
                        printWindow.print();
                    }, 250);
                };
            })
            .catch(error => {
                console.error('Error generating PDF:', error);
                if (typeof showErrorAlert === 'function') {
                    showErrorAlert('Error', 'Failed to generate PDF. Please try again.');
                } else {
                    alert('Failed to generate PDF. Please try again.');
                }
            });
    }

    // Handle Print/Share button click
    const printShareBtn = document.getElementById('print-share-job-btn');
    if (printShareBtn) {
        printShareBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            // Get the selected job ID
            const selectedJobId = window.selectedJobId;
            if (selectedJobId) {
                // Generate PDF and open print window
                generateJobPDF(selectedJobId);
            } else {
                if (typeof showWarningAlert === 'function') {
                    showWarningAlert('No Job Selected', 'Please select a job first');
                } else {
                    alert('Please select a job first');
                }
            }
            closeAllDropdowns();
        });
    }
});

// Action buttons functionality
document.addEventListener('DOMContentLoaded', function() {
    // Filter button functionality
    const filterBtn = document.getElementById('filter-btn');
    const filterPanel = document.getElementById('filter-panel');
    const applyFilterBtn = document.getElementById('apply-filter-btn');
    const clearFilterBtn = document.getElementById('clear-filter-btn');
    
    if (filterBtn && filterPanel) {
        filterBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            filterPanel.classList.toggle('hidden');
        });
        
        document.addEventListener('click', function(e) {
            if (!filterPanel.contains(e.target) && !filterBtn.contains(e.target)) {
                filterPanel.classList.add('hidden');
            }
        });
    }
    
    if (applyFilterBtn) {
        applyFilterBtn.addEventListener('click', function() {
            // Implement filter logic here
            const location = document.getElementById('filter-location')?.value || '';
            const salaryMin = document.getElementById('filter-salary-min')?.value || '';
            const salaryMax = document.getElementById('filter-salary-max')?.value || '';
            const category = document.getElementById('filter-category')?.value || '';
            const datePosted = document.getElementById('filter-date-posted')?.value || '';
            
            // Build filter URL and reload
            const params = new URLSearchParams();
            if (location) params.append('location', location);
            if (salaryMin) params.append('salary_min', salaryMin);
            if (salaryMax) params.append('salary_max', salaryMax);
            if (category) params.append('category', category);
            if (datePosted) params.append('date_posted', datePosted);
            
            const queryString = params.toString();
            window.location.href = window.location.pathname + (queryString ? '?' + queryString : '');
        });
    }
    
    if (clearFilterBtn) {
        clearFilterBtn.addEventListener('click', function() {
            document.getElementById('filter-location').value = '';
            document.getElementById('filter-salary-min').value = '';
            document.getElementById('filter-salary-max').value = '';
            document.getElementById('filter-category').value = '';
            document.getElementById('filter-date-posted').value = '';
            window.location.href = window.location.pathname;
        });
    }
    
    // Email button functionality
    const emailBtn = document.getElementById('email-btn');
    if (emailBtn) {
        emailBtn.addEventListener('click', function() {
            const selectedJobId = window.selectedJobId;
            if (selectedJobId) {
                // Open email modal or redirect to email page
                if (typeof openEmailModal === 'function') {
                    openEmailModal(1);
                } else {
                    window.location.href = '/provider/messages/new?jobId=' + selectedJobId;
                }
            } else {
                if (typeof showWarningAlert === 'function') {
                    showWarningAlert('No Job Selected', 'Please select a job first');
                } else {
                    alert('Please select a job first');
                }
            }
        });
    }
    
    // Apply button functionality
    const applyBtn = document.getElementById('apply-btn');
    if (applyBtn) {
        applyBtn.addEventListener('click', function() {
            const selectedJobId = window.selectedJobId;
            if (selectedJobId) {
                window.location.href = '/provider/jobs/apply/' + selectedJobId + '?redirect_route=app_provider_jobs_archived';
            } else {
                if (typeof showWarningAlert === 'function') {
                    showWarningAlert('No Job Selected', 'Please select a job first');
                } else {
                    alert('Please select a job first');
                }
            }
        });
    }
    
    // Delete button functionality - Using event delegation for reliability
    document.addEventListener('click', function(e) {
        const deleteBtn = e.target.closest('#delete-btn');
        if (!deleteBtn) return;
        
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        // Get the selected checkbox to retrieve the application ID
        const selectedCheckbox = document.querySelector('.job-checkbox:checked, .job-check:checked');
        if (selectedCheckbox) {
            const applicationId = selectedCheckbox.dataset.applicationId;
            if (applicationId) {
                if (confirm('Are you sure you want to delete this application? This action cannot be undone.')) {
                    // Create form data with application_ids as expected by the controller
                    const formData = new FormData();
                    formData.append('application_ids', JSON.stringify([applicationId]));
                    
                    fetch('{{ path("app_provider_applications_delete") }}', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            if (typeof showSuccessAlert === 'function') {
                                showSuccessAlert('Success!', data.message || 'Application deleted successfully');
                            }
                            // Reload the page to reflect changes
                            setTimeout(() => location.reload(), 500);
                        } else {
                            if (typeof showErrorAlert === 'function') {
                                showErrorAlert('Error!', data.message || 'Failed to delete application');
                            } else {
                                alert(data.message || 'Failed to delete application');
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        if (typeof showErrorAlert === 'function') {
                            showErrorAlert('Error!', 'An error occurred while deleting the application');
                        } else {
                            alert('An error occurred while deleting the application');
                        }
                    });
                }
            }
        } else {
            if (typeof showWarningAlert === 'function') {
                showWarningAlert('No Application Selected', 'Please select an application first');
            } else {
                alert('Please select an application first');
            }
        }
    });
    
    // New Window button functionality
    const floatViewBtn = document.getElementById('float-view-btn');
    if (floatViewBtn) {
        floatViewBtn.addEventListener('click', function() {
            const selectedJobId = window.selectedJobId;
            if (selectedJobId) {
                window.open('/provider/jobs/' + selectedJobId + '/detail', '_blank');
            } else {
                if (typeof showWarningAlert === 'function') {
                    showWarningAlert('No Job Selected', 'Please select a job first');
                } else {
                    alert('Please select a job first');
                }
            }
        });
    }
    
    // Toggle actions visibility function
    function toggleActionsVisibility() {
        const checkboxes = document.querySelectorAll('.job-checkbox, .job-check');
        const checked = Array.from(checkboxes).filter(cb => cb.checked);
        const anyChecked = checked.length > 0;
        
        // Update apply button state
        if (applyBtn) {
            applyBtn.disabled = !anyChecked;
            if (anyChecked) {
                applyBtn.classList.remove('hidden-btn');
                applyBtn.style.visibility = 'visible';
                applyBtn.style.opacity = '1';
            } else {
                applyBtn.classList.add('hidden-btn');
                applyBtn.style.visibility = 'hidden';
                applyBtn.style.opacity = '0';
            }
        }
    }
    
    // Update button states when checkboxes change
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('job-checkbox') || e.target.classList.contains('job-check')) {
            toggleActionsVisibility();
        }
    });
    
    // Initial check
    toggleActionsVisibility();
});

// Todo popup functionality
(function() {
    // Create popup element if it doesn't exist
    function createTodoPopup() {
        if (!window.todoPopup) {
            window.todoPopup = document.getElementById('todo-popup');
        }
        if (!window.todoPopup) {
            window.todoPopup = document.createElement('div');
            window.todoPopup.id = 'todo-popup';
            window.todoPopup.className = 'todo-popup';
            window.todoPopup.innerHTML = `
                <div class="todo-popup-header">
                    <div class="todo-popup-title">To Do Action</div>
                    <button class="todo-popup-close" type="button">&times;</button>
                </div>
                <div class="todo-popup-content"></div>
            `;
            if (document.body) {
                document.body.appendChild(window.todoPopup);
            } else {
                document.addEventListener('DOMContentLoaded', function() {
                    document.body.appendChild(window.todoPopup);
                });
            }
            
            // Close button handler
            const closeBtn = window.todoPopup.querySelector('.todo-popup-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    window.todoPopup.classList.remove('show');
                });
            }
        }
    }
    
    // Initialize popup click handler using event delegation
    function initTodoPopupHandler() {
        if (window.todoPopupHandlerInitialized) {
            return;
        }
        
        // Use event delegation on document to catch all clicks
        document.addEventListener('click', function(e) {
            // Check if click is on todo icon or its children
            const todoIcon = e.target.closest('.todo-icon');
            if (todoIcon) {
                e.stopPropagation();
                e.preventDefault();
                
                // Ensure popup exists
                if (!window.todoPopup) {
                    createTodoPopup();
                }
                
                const action = todoIcon.dataset.todoAction;
                if (action && window.todoPopup) {
                    const content = window.todoPopup.querySelector('.todo-popup-content');
                    if (content) {
                        content.textContent = action;
                        
                        // Position popup near the icon
                        const rect = todoIcon.getBoundingClientRect();
                        const popupWidth = 250;
                        const popupHeight = 100;
                        let left = rect.left + (rect.width / 2) - (popupWidth / 2);
                        let top = rect.top - popupHeight - 10;
                        
                        // Adjust if popup goes off screen
                        if (left < 10) left = 10;
                        if (left + popupWidth > window.innerWidth - 10) {
                            left = window.innerWidth - popupWidth - 10;
                        }
                        if (top < 10) {
                            top = rect.bottom + 10;
                        }
                        
                        window.todoPopup.style.left = left + 'px';
                        window.todoPopup.style.top = top + 'px';
                        window.todoPopup.classList.add('show');
                    }
                }
                return;
            }
            
            // Close popup if clicking outside
            if (window.todoPopup && window.todoPopup.classList.contains('show') && 
                !window.todoPopup.contains(e.target) && 
                !e.target.closest('.todo-icon')) {
                window.todoPopup.classList.remove('show');
            }
        });
        
        window.todoPopupHandlerInitialized = true;
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            createTodoPopup();
            initTodoPopupHandler();
        });
    } else {
        createTodoPopup();
        initTodoPopupHandler();
    }
})();
</script>

<!-- Timeline Panel -->
<aside id="timeline-panel" class="timeline-panel" aria-hidden="true" style="position: fixed; top: 0; right: 0; height: 100vh; width: 400px; max-width: 90vw; background: #fff; border-left: 1px solid #e6eef6; box-shadow: -2px 0 8px rgba(11,22,40,0.06); transform: translateX(100%); transition: transform 0.2s ease; display: flex; flex-direction: column; z-index: 9999; visibility: hidden; overflow-y: auto; pointer-events: none;">
    <div class="timeline-header" style="padding: 12px 14px; border-bottom: 1px solid #e6eef6; display: flex; justify-content: space-between; align-items: center;">
        <h6 class="timeline-title" style="margin: 0; font-size: 14px; font-weight: 600;">Job Timeline</h6>
        <button type="button" class="timeline-close" onclick="closeTimelinePanel()" style="background: none; border: none; font-size: 22px; cursor: pointer; color: #666; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>
    <div class="timeline-body" id="timeline-content" style="flex: 1; padding: 16px; overflow-y: auto;">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading timeline...</p>
        </div>
    </div>
</aside>

<!-- Timeline Panel Overlay -->
<div id="timeline-overlay" class="timeline-panel-overlay" onclick="closeTimelinePanel()" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9998; display: none;"></div>

<style>
.timeline-panel.open {
    transform: translateX(0) !important;
    visibility: visible !important;
    pointer-events: auto !important;
}
.timeline-panel-overlay.active {
    display: block !important;
}
.timeline-event-content {
    border: none !important;
    border-left: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
}
</style>

<script>
window.openTimelinePanel = function(jobId) {
    const timelinePanel = document.getElementById('timeline-panel');
    const timelineContent = document.getElementById('timeline-content');
    const timelineOverlay = document.getElementById('timeline-overlay');
    
    if (!timelinePanel || !timelineContent) return;
    
    // Show loading state
    timelineContent.innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading timeline...</p>
        </div>
    `;
    
    // Open the panel
    timelinePanel.classList.add('open');
    timelinePanel.setAttribute('aria-hidden', 'false');
    if (timelineOverlay) {
        timelineOverlay.classList.add('active');
    }
    
    // Fetch job timeline data from API
    fetch(`/provider/jobs/${jobId}/timeline-data`)
        .then(response => response.json())
        .then(data => {
            // Build interview section HTML
            let interviewsHTML = '';
            if (data.interviews && data.interviews.length > 0) {
                interviewsHTML = data.interviews.map(interview => `
                    <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px;">
                        <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">${interview.type}:</span>
                        <span class="timeline-detail-value" style="color: #121C0C;">${interview.date} at ${interview.time}</span>
                    </div>
                    ${interview.platform ? `
                    <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px;">
                        <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">Platform:</span>
                        <span class="timeline-detail-value" style="color: #121C0C;">${interview.platform}</span>
                    </div>
                    ` : ''}
                    ${interview.meetingUrl ? `
                    <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px;">
                        <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">Meeting Link:</span>
                        <span class="timeline-detail-value" style="color: #121C0C;">
                            <a href="${interview.meetingUrl}" target="_blank" class="text-primary">Join Meeting</a>
                        </span>
                    </div>
                    ` : ''}
                `).join('');
            } else {
                interviewsHTML = '<p class="timeline-event-description text-muted" style="font-size: 12px; color: #6c757d; margin-bottom: 0;">No interviews scheduled yet.</p>';
            }
            
            // Build timeline content with real data
            timelineContent.innerHTML = `
                <div class="timeline-events" style="padding: 0;">
                    <div class="timeline-event" style="display: flex; gap: 12px; padding: 12px 0;">
                        <div class="timeline-event-icon" style="flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #e8f5e9; border-radius: 50%;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 11L12 14L22 4" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M21 12V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3.89543 5 5 3.89543 5 3H16" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="timeline-event-content" style="flex: 1; border: none !important; border-left: none !important; background: transparent !important; box-shadow: none !important; padding: 0 !important;">
                            <h6 class="timeline-event-title" style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #333;">Application Overview</h6>
                            <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px; align-items: center;">
                                <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">Status:</span>
                                <span class="timeline-detail-value status-${data.applicationStatus.toLowerCase().replace(/\s+/g, '-')}" style="background: #85BB65; color: white; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">${data.applicationStatus}</span>
                            </div>
                            ${data.applicationDate ? `
                            <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px;">
                                <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">Applied On:</span>
                                <span class="timeline-detail-value" style="color: #121C0C;">${data.applicationDate}</span>
                            </div>
                            ` : ''}
                            <div class="timeline-detail-item" style="display: flex; gap: 8px; margin-bottom: 6px; font-size: 12px;">
                                <span class="timeline-detail-label" style="color: #6c757d; font-weight: 500;">Job Saved:</span>
                                <span class="timeline-detail-value" style="color: #121C0C;">${data.bookmarkDate}</span>
                            </div>
                        </div>
                    </div>
                    <div class="timeline-event-divider" style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                    <div class="timeline-event" style="display: flex; gap: 12px; padding: 12px 0;">
                        <div class="timeline-event-icon" style="flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border-radius: 50%;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="4" width="18" height="18" rx="2" stroke="#6c757d" stroke-width="2"/>
                                <path d="M16 2V6M8 2V6M3 10H21" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="timeline-event-content" style="flex: 1; border: none !important; border-left: none !important; background: transparent !important; box-shadow: none !important; padding: 0 !important;">
                            <h6 class="timeline-event-title" style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #333;">Interview Schedule</h6>
                            ${interviewsHTML}
                        </div>
                    </div>
                    <div class="timeline-event-divider" style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                    
                    <!-- Quick Actions -->
                    <div class="timeline-event" style="display: flex; gap: 12px; padding: 12px 0;">
                        <div class="timeline-event-icon" style="flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #e8f5e9; border-radius: 50%;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#85BB65" stroke-width="2"/>
                                <path d="M12 8V12L15 15" stroke="#85BB65" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="timeline-event-content" style="flex: 1; border: none !important; border-left: none !important; background: transparent !important; box-shadow: none !important; padding: 0 !important;">
                            <h6 class="timeline-event-title" style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #333;">Quick Actions</h6>
                            <a href="/provider/jobs/${data.jobId}/detail" style="display: inline-block; background: #85BB65; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 500; margin-top: 4px;">View Full Details</a>
                        </div>
                    </div>
                </div>
            `;
        })
        .catch(error => {
            console.error('Error loading timeline:', error);
            timelineContent.innerHTML = `
                <div class="alert alert-warning">
                    <p class="mb-0">Unable to load detailed timeline information.</p>
                </div>
            `;
        });
};

window.closeTimelinePanel = function() {
    const timelinePanel = document.getElementById('timeline-panel');
    const timelineOverlay = document.getElementById('timeline-overlay');
    if (timelinePanel) {
        timelinePanel.classList.remove('open');
        timelinePanel.setAttribute('aria-hidden', 'true');
    }
    if (timelineOverlay) {
        timelineOverlay.classList.remove('active');
    }
};

// Intercept clicks on job links in list view to open split view instead
document.addEventListener('click', function(e) {
    const jobLink = e.target.closest('a.job-title');
    if (jobLink && jobLink.href && jobLink.href.includes('/detail')) {
        e.preventDefault();
        e.stopPropagation();
        
        // Extract job ID from href
        const href = jobLink.href;
        const jobIdMatch = href.match(/\/jobs\/(\d+)\/detail/);
        if (jobIdMatch && jobIdMatch[1]) {
            const jobId = jobIdMatch[1];
            
            // Open split view and select the job
            if (typeof window.openSplitViewAndSelectJob === 'function') {
                window.openSplitViewAndSelectJob(jobId);
            }
        }
    }
});

// Function to open split view and select a job
window.openSplitViewAndSelectJob = function(jobId) {
    const splitViewContainer = document.getElementById('split-view-container');
    const listViewContainer = document.getElementById('list-view-container');
    const gridViewBtn = document.getElementById('grid-view-btn');
    const splitJobList = document.getElementById('split-job-list');
    
    if (!splitViewContainer || !listViewContainer) return;
    
    const isSplitViewOpen = splitViewContainer.style.display === 'grid';
    
    // If split view is already open, just select the job
    if (isSplitViewOpen && splitJobList) {
        const cardToSelect = splitJobList.querySelector(`.split-job-card[data-job-id="${jobId}"]`);
        if (cardToSelect && typeof window.selectJobCard === 'function') {
            window.selectJobCard(cardToSelect);
        }
        return;
    }
    
    // Check if filters are active - if so, reload page without filters to show unfiltered split view
    const urlParams = new URLSearchParams(window.location.search);
    const hasFilters = urlParams.has('location') || urlParams.has('salaryMin') || urlParams.has('salaryMax') || urlParams.has('category') || urlParams.has('days');
    const filtersActive = sessionStorage.getItem('filtersActive') === 'true' || hasFilters;
    
    if (filtersActive) {
        // Reload page without filter parameters to show unfiltered split view
        const currentUrl = window.location.pathname;
        const newParams = new URLSearchParams();
        newParams.append('selectJob', jobId);
        window.location.href = `${currentUrl}?${newParams.toString()}`;
        return;
    }
    
    // Open split view
    if (gridViewBtn) {
        gridViewBtn.click();
        
        // Wait for split view to open, then select the job
        setTimeout(() => {
            if (splitJobList) {
                const cardToSelect = splitJobList.querySelector(`.split-job-card[data-job-id="${jobId}"]`);
                if (cardToSelect && typeof window.selectJobCard === 'function') {
                    window.selectJobCard(cardToSelect);
                }
            }
        }, 300);
    }
};
</script>
