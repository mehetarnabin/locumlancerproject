                                <span class="timeline-detail-value" style="color: #121C0C;">${data.contractSignedDate}</span>
                            </div>
                            ` : ''}
                        </div>
                    </div>
                    
                    <div class="timeline-event-divider" style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                    
                    <!-- Interview Schedule -->
                    <div class="timeline-event" style="display: flex; gap: 12px; padding: 12px 0;">
                        <div class="timeline-event-icon" style="flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border-radius: 50%;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="4" width="18" height="18" rx="2" stroke="#6c757d" stroke-width="2"/>
                                <path d="M16 2V6M8 2V6M3 10H21" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="timeline-event-content" style="flex: 1; border: none !important; border-left: none !important; background: transparent !important; box-shadow: none !important; padding: 0 !important;">
                            <h6 class="timeline-event-title" style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #333;">Interview Schedule</h6>
                            ${interviewsHTML}
                        </div>
                    </div>
                    
                    <div class="timeline-event-divider" style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                    
                    <!-- Quick Actions -->
                    <div class="timeline-event" style="display: flex; gap: 12px; padding: 12px 0;">
                        <div class="timeline-event-icon" style="flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #e8f5e9; border-radius: 50%;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#85BB65" stroke-width="2"/>
                                <path d="M12 8V12L15 15" stroke="#85BB65" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="timeline-event-content" style="flex: 1; border: none !important; border-left: none !important; background: transparent !important; box-shadow: none !important; padding: 0 !important;">
                            <h6 class="timeline-event-title" style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #333;">Quick Actions</h6>
                            <a href="/provider/jobs/${data.jobId}/detail" style="display: inline-block; background: #85BB65; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 500; margin-top: 4px;">View Full Details</a>
                        </div>
                    </div>
                </div>
                
                <style>
                    .timeline-events {
                        padding: 10px 0;
                    }
                    .timeline-info-box {
                        background: #f8f9fa;
                        border-left: 3px solid #85BB65;
                        padding: 12px 15px;
                        border-radius: 6px;
                        margin-bottom: 10px;
                    }
                    .timeline-info-label {
                        font-size: 11px;
                        text-transform: uppercase;
                        color: #6c757d;
                        font-weight: 600;
                        margin-bottom: 4px;
                        letter-spacing: 0.5px;
                    }
                    .timeline-info-value {
                        font-size: 13px;
                        color: #121C0C;
                        font-weight: 500;
                        font-family: monospace;
                    }
                    .timeline-event {
                        display: flex;
                        gap: 15px;
                        padding: 15px 0;
                    }
                    .timeline-event-icon {
                        flex-shrink: 0;
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        background: #f8f9fa;
                        border-radius: 50%;
                    }
                    .timeline-event-icon.has-interview {
                        background: #e8f5e9;
                    }
                    .timeline-event-content {
                        flex: 1;
                    }
                    .timeline-event-title {
                        font-size: 14px;
                        font-weight: 600;
                        margin-bottom: 8px;
                        color: #121C0C;
                    }
                    .timeline-detail-item {
                        display: flex;
                        gap: 8px;
                        margin-bottom: 6px;
                        font-size: 13px;
                        align-items: center;
                    }
                    .timeline-detail-label {
                        color: #6c757d;
                        font-weight: 500;
                    }
                    .timeline-detail-value {
                        color: #121C0C;
                    }
                    .timeline-detail-value.status-interview,
                    .timeline-detail-value.status-offered,
                    .timeline-detail-value.status-accepted,
                    .timeline-detail-value.status-hired {
                        color: #85BB65;
                        font-weight: 600;
                    }
                    .timeline-detail-value.status-rejected {
                        color: #dc3545;
                        font-weight: 600;
                    }
                    .timeline-event-date {
                        font-size: 12px;
                        margin-bottom: 6px;
                    }
                    .timeline-event-description {
                        font-size: 13px;
                        color: #6c757d;
                        margin-bottom: 0;
                    }
                    .timeline-event-divider {
                        height: 1px;
                        background: #e6eef6;
                        margin: 10px 0;
                    }
                    .timeline-actions {
                        display: flex;
                        gap: 8px;
                        flex-wrap: wrap;
                        margin-top: 8px;
                    }
                    .timeline-actions .btn {
                        font-size: 12px;
                        padding: 6px 12px;
                    }
                </style>
            `;
        })
        .catch(error => {
            console.error('Error loading timeline:', error);
            timelineContent.innerHTML = `
                <div class="timeline-events">
                    <!-- Job ID Section -->
                    <div class="timeline-info-box">
                        <div class="timeline-info-label">Job ID</div>
                        <div class="timeline-info-value">${jobId}</div>
                    </div>
                    
                    <div class="timeline-event-divider"></div>
                    
                    <div class="alert alert-warning">
                        <p class="mb-0">Unable to load detailed timeline information.</p>
                        <a href="/provider/jobs/${jobId}/detail" class="btn btn-sm btn-outline-primary mt-2">
                            View Job Details
                        </a>
                    </div>
                </div>
            `;
        });
}

window.closeTimelinePanel = function() {
    const timelinePanel = document.getElementById('timeline-panel');
    if (timelinePanel) {
        timelinePanel.classList.remove('open');
        timelinePanel.setAttribute('aria-hidden', 'true');
    }
}

// Note Panel Functions
window.openNotesPanel = function(jobId) {
    const panel = document.getElementById('notes-panel');
    const textarea = document.getElementById('notes-textarea');
    if (!panel || !textarea) return;
    
    // Close timeline panel if open
    const timelinePanel = document.getElementById('timeline-panel');
    if (timelinePanel && timelinePanel.classList.contains('open')) {
        timelinePanel.classList.remove('open');
        timelinePanel.setAttribute('aria-hidden', 'true');
    }
    
    panel.dataset.jobId = jobId;
    const saved = localStorage.getItem('provider_job_notes_' + jobId) || '';
    textarea.value = saved;
    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    textarea.focus();
    
    // Auto-save on input
    textarea.oninput = function() {
        localStorage.setItem('provider_job_notes_' + jobId, textarea.value);
        const lastSaved = panel.querySelector('.last-saved');
        const lastSavedTime = panel.querySelector('.last-saved-time');
        if (lastSaved && lastSavedTime) {
            lastSaved.style.display = 'block';
            lastSavedTime.textContent = new Date().toLocaleTimeString();
        }
    };
}

window.closeNotesPanel = function() {
    const panel = document.getElementById('notes-panel');
    if (!panel) return;
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
    panel.dataset.jobId = '';
}
</script>
{% endblock %}
