    <script>
    function openTimelinePanel(jobId) {
        const panel = document.getElementById('timeline-panel');
        const overlay = document.getElementById('timeline-overlay');
        const timelineContent = document.getElementById('timeline-content');
        
        // Show panel and overlay
        panel.classList.add('open');
        overlay.classList.add('show');
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
        
        // Show loading state
        timelineContent.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading timeline...</p>
            </div>
        `;
        
        // Fetch timeline data
        fetch(`/provider/jobs/${jobId}/timeline-data`)
            .then(response => response.json())
            .then(data => {
                let interviewsHTML = '';
                if (data.interviews && data.interviews.length > 0) {
                    interviewsHTML = data.interviews.map(interview => `
                        <div class="timeline-detail-item">
                            <span class="timeline-detail-label">${interview.type}:</span>
                            <span class="timeline-detail-value">
                                <strong>${interview.date}</strong>
                                <span class="badge rounded-pill" style="background:#eef2ff;color:#111827;border:1px solid #c7d2fe;padding:2px 8px;font-size:11px;font-weight:600;display:inline-block;margin-left:8px;">
                                    From ${interview.time || 'Not Set'} — To ${interview.endTime || 'Not Set'}
                                </span>
                                ${interview.platform ? `<small class="text-muted" style="margin-left:8px;">${interview.platform}</small>` : ''}
                            </span>
                        </div>
                        ${interview.meetingUrl ? `
                        <div class="timeline-detail-item">
                            <span class="timeline-detail-label">Meeting Link:</span>
                            <span class="timeline-detail-value">
                                <a href="${interview.meetingUrl}" target="_blank" class="text-primary">Join Meeting</a>
                            </span>
                        </div>
                        ` : ''}
                    `).join('');
                } else {
                    interviewsHTML = '<p class="text-muted small mb-0">No interviews scheduled yet.</p>';
                }
                
                // Build timeline content
                timelineContent.innerHTML = `
                    <div class="timeline-events">
                        <!-- Job ID Section -->
                        <div class="timeline-info-box">
                            <div class="timeline-info-label">Job ID</div>
                            <div class="timeline-info-value">${data.jobId}</div>
                        </div>
                        
                        <!-- Application Overview -->
                        <div class="timeline-event">
                            <div class="timeline-event-icon" style="background: #e8f5e9;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9 11L12 14L22 4" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M21 12V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3.89543 5 5 3.89543 5 3H16" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div class="timeline-event-content">
                                <h6 class="timeline-event-title">Application Overview</h6>
                                <div class="timeline-detail-item" style="display: flex; gap: 8px; align-items: center;">
                                    <span class="timeline-detail-label">Status:</span>
                                    <span class="timeline-detail-value status-${data.applicationStatus.toLowerCase().replace(/\s+/g, '-')}" style="background: #85BB65; color: white; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">${data.applicationStatus}</span>
                                </div>
                                ${data.applicationDate ? `
                                <div class="timeline-detail-item">
                                    <span class="timeline-detail-label">Applied On:</span>
                                    <span class="timeline-detail-value">${data.applicationDate}</span>
                                </div>
                                ` : ''}
                                <div class="timeline-detail-item">
                                    <span class="timeline-detail-label">Job Saved:</span>
                                    <span class="timeline-detail-value">${data.bookmarkDate}</span>
                                </div>
                                ${data.hiredDate ? `
                                <div class="timeline-detail-item">
                                    <span class="timeline-detail-label">Hired Date:</span>
                                    <span class="timeline-detail-value">${data.hiredDate}</span>
                                </div>
                                ` : ''}
                                ${data.contractSentDate ? `
                                <div class="timeline-detail-item">
                                    <span class="timeline-detail-label">Contract Sent:</span>
                                    <span class="timeline-detail-value">${data.contractSentDate}</span>
                                </div>
                                ` : ''}
                                ${data.contractSignedDate ? `
                                <div class="timeline-detail-item">
                                    <span class="timeline-detail-label">Contract Signed:</span>
                                    <span class="timeline-detail-value">${data.contractSignedDate}</span>
                                </div>
                                ` : ''}
                            </div>
                        </div>
                        
                        <!-- Interview Schedule -->
                        <div class="timeline-event">
                            <div class="timeline-event-icon" style="background: #f8f9fa;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="4" width="18" height="18" rx="2" stroke="#6c757d" stroke-width="2"/>
                                    <path d="M16 2V6M8 2V6M3 10H21" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="timeline-event-content">
                                <h6 class="timeline-event-title">Interview Schedule</h6>
                                ${interviewsHTML}
                            </div>
                        </div>
                        
                        <div class="timeline-event-divider"></div>
                        
                        <!-- Quick Actions -->
                        <div class="timeline-event">
                            <div class="timeline-event-icon" style="background: #e8f5e9;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="12" cy="12" r="10" stroke="#85BB65" stroke-width="2"/>
                                    <path d="M12 8V12L15 15" stroke="#85BB65" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="timeline-event-content">
                                <h6 class="timeline-event-title">Quick Actions</h6>
                                <a href="/provider/jobs/${data.jobId}/detail" style="display: inline-block; background: #85BB65; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 500; margin-top: 4px;">View Full Details</a>
                            </div>
                        </div>
                    </div>
                `;
            })
            .catch(error => {
                console.error('Error fetching timeline data:', error);
                timelineContent.innerHTML = `
                    <div class="text-center py-5">
                        <div class="text-danger mb-3">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                                <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h5>Unable to load timeline</h5>
                        <p class="text-muted">Please try again later.</p>
                    </div>
                `;
            });
    }

    function closeTimelinePanel() {
        const panel = document.getElementById('timeline-panel');
        const overlay = document.getElementById('timeline-overlay');
        
        panel.classList.remove('open');
        overlay.classList.remove('show');
        document.body.style.overflow = ''; // Restore scrolling
    }
    </script>

