    <script>
        // New script for sorting and dynamic content loading
        $(document).ready(function() {
            // --- Sort By functionality ---
            const sortButton = $('.sort-button');
            const sortDropdown = $('.sort-dropdown');
            const sortLinks = $('.sort-link');

            sortButton.on('click', function() {
                sortDropdown.toggleClass('show');
            });

            sortLinks.on('click', function(event) {
                event.preventDefault();
                const sortValue = $(this).data('sort-value');
                const url = new URL(window.location.href);
                url.searchParams.set('sort', sortValue);

                $.ajax({
                    url: url.href,
                    type: 'GET',
                    success: function(response) {
                        let newHtml = $(response);
                        let $newJobList = newHtml.find('.job-sidebar').html();
                        $('.job-sidebar').html($newJobList);
                        let $newCount = newHtml.find('#results-count').text();
                        $('#results-count').text($newCount);
                        attachJobCardClickHandler();
                        sortDropdown.removeClass('show');
                    },
                    error: function(error) {
                        console.error("Error fetching sorted jobs:", error);
                    }
                });
            });

            // Close dropdown if clicked outside
            $(document).on('click', function(event) {
                if (!$(event.target).closest('.sort-options').length) {
                    sortDropdown.removeClass('show');
                }
            });

            // --- Job Card Click Handler - Navigate to Detail Page or Open Split View ---
            function attachJobCardClickHandler() {
                $('.job-info-card').off('click').on('click', function(event) {
                    // Don't prevent default if clicking on save button or other interactive elements
                    if ($(event.target).closest('.btn-save, button, a').length) {
                        return; // Let those elements handle their own clicks
                    }
                    
                    // Check if user is logged in
                    const isLoggedIn = {{ app.user ? 'true' : 'false' }};
                    const jobId = $(this).data('job-id');
                    
                    if (isLoggedIn) {
                        // If logged in, navigate to provider detail page
                        window.location.href = '/provider/jobs/' + jobId + '/detail';
                    } else {
                        // If NOT logged in, open split view and show job details
                        event.preventDefault();
                        
                        // Remove 'active' class from all job cards and add to the clicked one
                        $('.job-info-card.active').removeClass('active');
                        $(this).addClass('active');
                        
                        // Open split view
                        openSplitViewForJob(jobId);
                    }
                });
            }
            
            // Function to open split view and load job details
            function openSplitViewForJob(jobId) {
                const splitViewContainer = $('#split-view-container');
                
                // Create split view container if it doesn't exist
                if (!splitViewContainer.length) {
                    $('body').append(`
                        <div class="split-view-container" id="split-view-container" style="display: grid; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; background: white; grid-template-columns: 400px 1fr; gap: 0;">
                            <div class="split-job-list" id="split-job-list" style="overflow-y: auto; border-right: 1px solid #e6eef6; padding: 20px; background: #f8f9fa; height: 100%;"></div>
                            <div class="split-job-details" id="split-job-details" style="overflow-y: auto; overflow-x: hidden; padding: 20px; height: 100%; max-height: 100%; scrollbar-width: thin; scrollbar-color: #cbd5e0 #f7fafc;"></div>
                            <button class="close-split-view" style="position: absolute; top: 10px; right: 10px; z-index: 10000; background: white; border: 1px solid #e6eef6; border-radius: 6px; padding: 8px 12px; cursor: pointer; font-size: 14px;">Close</button>
                        </div>
                        <style>
                        #split-view-container .split-job-details::-webkit-scrollbar {
                            width: 8px;
                            display: block;
                        }
                        #split-view-container .split-job-details::-webkit-scrollbar-track {
                            background: #f7fafc;
                            border-radius: 4px;
                        }
                        #split-view-container .split-job-details::-webkit-scrollbar-thumb {
                            background: #cbd5e0;
                            border-radius: 4px;
                        }
                        #split-view-container .split-job-details::-webkit-scrollbar-thumb:hover {
                            background: #a0aec0;
                        }
                        /* Ensure job details in split view match original design */
                        #split-view-container .split-job-details .job-title-wrap,
                        #split-view-container .split-job-details .job-header,
                        #split-view-container .split-job-details .job-detail {
                            max-width: 100%;
                            width: 100%;
                        }
                        #split-view-container .split-job-details .job-header h1 {
                            font-size: 24px;
                            font-weight: 600;
                            margin-bottom: 10px;
                            color: #121C0C;
                        }
                        #split-view-container .split-job-details .job-header h3 {
                            font-size: 16px;
                            color: #6b7280;
                            margin-bottom: 20px;
                        }
                        #split-view-container .split-job-details .block-buttons {
                            display: flex;
                            gap: 10px;
                            margin-top: 20px;
                            flex-wrap: wrap;
                        }
                        #split-view-container .split-job-details .details.content-area {
                            margin-top: 30px;
                        }
                        #split-view-container .split-job-details .details.content-area h4 {
                            font-size: 18px;
                            font-weight: 600;
                            margin-bottom: 15px;
                            color: #121C0C;
                        }
                        </style>
                    `);
                    
                    // Add close button handler
                    $('.close-split-view').on('click', function() {
                        $('#split-view-container').hide();
                    });
                    
                    // Copy job list to split view
                    const jobListHtml = $('.job-sidebar').html();
                    $('#split-job-list').html(`
                        <div class="job-sidebar">${jobListHtml}</div>
                    `);
                    
                    // Re-attach click handlers to the new job cards in split view
                    attachJobCardClickHandler();
                } else {
                    splitViewContainer.show();
                }
                
                // Show loading indicator in split view
                $('#split-job-details').html('<div class="text-center py-5"><div class="spinner-border text-primary mb-3" role="status"></div><p>Loading job details...</p></div>');
                
                // Fetch job details via AJAX - use the dedicated endpoint that returns just the job detail HTML
                const detailUrl = '/jobs/detail/' + encodeURIComponent(jobId);
                $.ajax({
                    url: detailUrl,
                    type: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        // Response is HTML from the endpoint - directly use it
                        if (response && typeof response === 'string' && response.trim()) {
                            $('#split-job-details').html(response);
                            
                            // Also update the regular detail container for consistency
                            $('#job-detail-container').html(response);
                            
                            // Re-initialize any scripts that might be needed (like save button handlers)
                            if (typeof attachSaveButtonHandlers === 'function') {
                                attachSaveButtonHandlers();
                            }
                        } else {
                            console.error('Empty or invalid response:', response);
                            $('#split-job-details').html('<div class="text-center p-5"><p>No job details found in response.</p></div>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading job details:', {
                            status: status,
                            error: error,
                            xhrStatus: xhr.status,
                            responseText: xhr.responseText,
                            url: detailUrl
                        });
                        let errorMsg = 'Error loading job details. Please try again.';
                        if (xhr.status === 404) {
                            errorMsg = 'Job not found.';
                        } else if (xhr.status === 403) {
                            errorMsg = 'Access denied.';
                        } else if (xhr.status === 500) {
                            errorMsg = 'Server error. Please try again later.';
                        }
                        $('#split-job-details').html('<div class="text-center p-5"><p class="text-danger">' + errorMsg + '</p><p class="text-muted small">Status: ' + xhr.status + '</p></div>');
                    }
                });
            }
            // Initial call to attach handlers when the page first loads
            attachJobCardClickHandler();
        });
    </script>
