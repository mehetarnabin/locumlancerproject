    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 20px;
    overflow-y: auto; /* Enable vertical scrolling */
    overflow-x: hidden; /* Disable horizontal scrolling */
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
    height: 100%; /* Take full height of container */
    max-height: 100%; /* Don't exceed container height */
    /* Show vertical scrollbar */
    scrollbar-width: thin; /* Firefox - thin scrollbar */
    scrollbar-color: #cbd5e0 #f7fafc; /* Firefox - thumb and track colors */
    -ms-overflow-style: auto; /* IE and Edge - show scrollbar */
}

/* Custom vertical scrollbar for Chrome, Safari and Opera */
.split-job-details::-webkit-scrollbar {
    width: 8px; /* Width of the vertical scrollbar */
    display: block; /* Show scrollbar */
}

.split-job-details::-webkit-scrollbar-track {
    background: #f7fafc; /* Track color */
    border-radius: 4px;
}

.split-job-details::-webkit-scrollbar-thumb {
    background: #cbd5e0; /* Thumb color */
    border-radius: 4px;
}

.split-job-details::-webkit-scrollbar-thumb:hover {
    background: #a0aec0; /* Thumb color on hover */
}

/* Ensure panels are positioned at the absolute right edge */
.split-job-details .timeline-panel,
.split-job-details .notes-panel {
    right: 0 !important;
}

/* When panels are open, ensure proper layout - no scrolling */
.split-job-details.notes-open,
.split-job-details.timeline-open {
    overflow-x: hidden !important; /* Prevent horizontal scrolling */
    overflow-y: hidden !important; /* Prevent vertical scrolling */
    scrollbar-width: none !important; /* Firefox */
    -ms-overflow-style: none !important; /* IE and Edge */
}

/* Hide scrollbar when panels are open */
.split-job-details.notes-open::-webkit-scrollbar,
.split-job-details.timeline-open::-webkit-scrollbar {
    display: none !important;
}

/* Ensure job details content remains visible when notes or timeline panel is open */
.split-job-details {
    position: relative;
}

/* Ensure content inside job details is visible */
.split-job-details #job-detail-content,
.split-job-details .no-job-selected {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
}

/* When notes are open, content should be visible on the left side */
.split-job-details.notes-open #job-detail-content,
.split-job-details.notes-open .no-job-selected {
    overflow: visible;
}

/* Job Details Styles */
.job-detail-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
