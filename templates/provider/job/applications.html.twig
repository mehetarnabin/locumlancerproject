    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  (function(){
    function showModalById(id){
      var el = document.getElementById(id);
      if (!el) {
          console.error('Modal element not found:', id);
          return;
      }
      
      // Try jQuery/Bootstrap 4 first since it is loaded
      if (typeof $ !== 'undefined' && $(el).modal) {
          try {
            $(el).modal('show');
            return;
          } catch(e) {
            console.warn('jQuery modal failed:', e);
          }
      }

      // Try Bootstrap 5
      if (window.bootstrap && window.bootstrap.Modal) {
        try {
            window.bootstrap.Modal.getOrCreateInstance(el).show();
            return;
        } catch(e) {
             console.warn('Bootstrap 5 modal failed:', e);
        }
      }
      
      // Fallback
      el.classList.add('show');
      el.style.display = 'block';
      el.setAttribute('aria-hidden', 'false');
      
      // Ensure pointer events
      el.style.setProperty('pointer-events', 'auto', 'important');
      
      // Force close handlers on all close buttons
      var closeBtns = el.querySelectorAll('.btn-close, .close, [data-dismiss="modal"], [data-bs-dismiss="modal"]');
      closeBtns.forEach(function(btn){
          btn.onclick = function() {
              el.style.display = 'none';
              el.classList.remove('show');
              var bd = document.querySelector('.modal-backdrop');
              if(bd) bd.remove();
          };
          btn.style.cursor = 'pointer';
          btn.style.setProperty('pointer-events', 'auto', 'important');
      });

      // Add a simple backdrop if needed or just let it float
      if (!document.querySelector('.modal-backdrop')) {
          var backdrop = document.createElement('div');
          backdrop.className = 'modal-backdrop fade show';
          document.body.appendChild(backdrop);
          backdrop.onclick = function() {
              el.style.display = 'none';
              el.classList.remove('show');
              backdrop.remove();
          };
      }
    }

    window.handleTodoIconClick = function(e, el){
      try {
        e.preventDefault();
        e.stopPropagation();

        var appId = el.getAttribute('data-application-id') || '';
        var docStatus = el.getAttribute('data-doc-status') || '';
        var pending = el.getAttribute('data-doc-pending') || '';
        var action = el.getAttribute('data-todo-action') || 'Task Details';
        var type = el.getAttribute('data-todo-type') || 'status';
        var iconType = el.getAttribute('data-todo-icon-type') || '';
        
        // Interview data
        var intDate = el.getAttribute('data-interview-date');
        var intUrl = el.getAttribute('data-interview-url');
        var intPlatform = el.getAttribute('data-interview-platform');
        
        // Check for response/Open Response FIRST before documents - MUST be checked before any other handlers
        var actionLower = (action || '').toLowerCase();
        var iconTypeLower = (iconType || '').toLowerCase();
        var isResponseTask = iconTypeLower === 'response' || 
                            actionLower.includes('open response') || 
                            actionLower.includes('response from employer') ||
                            actionLower === 'open response' ||
                            (type === 'status' && (actionLower.includes('response') || iconTypeLower === 'response'));
        
        if (isResponseTask) {
            e.stopImmediatePropagation(); // Stop all other handlers
            // Open message modal for provider to view and reply to employer messages
            if (typeof window.openProviderMessageModal === 'function') {
                window.openProviderMessageModal(appId);
            } else {
                console.error('openProviderMessageModal function not found');
                // Try again after a short delay in case function is defined later
                setTimeout(function() {
                    if (typeof window.openProviderMessageModal === 'function') {
                        window.openProviderMessageModal(appId);
                    } else {
                        alert('Message feature is loading. Please refresh the page and try again.');
                    }
                }, 200);
            }
            return false;
        }

        var hiddenInput = document.getElementById('providerDocsAppId');
        if(hiddenInput) hiddenInput.value = appId;
        
        document.getElementById('providerDocsType').value = type;
        
        // Update Title
        var titleEl = document.getElementById('assignedDocsModalLabel');
        if(titleEl) titleEl.textContent = action;

        // Elements
        var listEl = document.getElementById('providerDocsList');
        var msgEl = document.getElementById('providerDocsMessage');
        var customEl = document.getElementById('todoCustomContent');
        var headerEl = document.getElementById('todoHeader');
        
        var provideBtn = document.getElementById('provideDocsBtn');
        var actionBtn = document.getElementById('todoActionBtn');
        var viewDocsBtn = document.getElementById('viewDocumentsBtn');
        
        // Reset
        listEl.innerHTML = '';
        listEl.classList.add('d-none');
        msgEl.classList.add('d-none');
        customEl.classList.add('d-none');
        customEl.innerHTML = '';
        provideBtn.classList.add('d-none');
        actionBtn.classList.add('d-none');
        if(viewDocsBtn) viewDocsBtn.classList.remove('d-none');
        headerEl.textContent = 'Details:';

        if (type === 'documents' || type === 'credentialing') {
            headerEl.textContent = type === 'credentialing' ? 'Credentialing Requirements:' : 'Pending Documents:';
            listEl.innerHTML = '<li class="list-group-item text-center"><div class="spinner-border spinner-border-sm" role="status"></div> Loading...</li>';
            listEl.classList.remove('d-none');
            // Hide the generic button as we use per-item upload
            provideBtn.classList.add('d-none');
            actionBtn.classList.add('d-none');
            // ViewDocsBtn is already visible

            // Fetch details
            var reqUrl = "{{ path('app_provider_application_document_requests_details', {'id': '00000000-0000-0000-0000-000000000000'}) }}".replace('00000000-0000-0000-0000-000000000000', appId);
            
            fetch(reqUrl)
                .then(function(r){ return r.json(); })
               .then(function(data){
                   listEl.innerHTML = '';
                   var hasContent = false;
                   
                   if (data.success) {
                       // 1. Show Credentialing Links
                       if (data.credentialLinks && data.credentialLinks.length > 0) {
                            data.credentialLinks.forEach(function(link){
                               hasContent = true;
                               var li = document.createElement('li');
                               li.className = 'list-group-item';
                               li.innerHTML = '<div><strong>' + link.title + '</strong>' + 
                                   (link.description ? '<br><small class="text-muted">' + link.description + '</small>' : '') + 
                                   '</div><a href="' + link.url + '" target="_blank" class="btn btn-sm btn-outline-primary mt-2">Open Link</a>';
                               listEl.appendChild(li);
                            });
                       }

                       // 2. Show Document Requests
                       if (data.documentRequests && data.documentRequests.length > 0) {
                           var hasPending = false;
                           data.documentRequests.forEach(function(req){
                               hasContent = true;
                               var li = document.createElement('li');
                               li.className = 'list-group-item d-flex justify-content-between align-items-center';
                               
                               var content = '<div><strong>' + req.name + '</strong>';
                               if (req.providedAt) {
                                   content += '<br><small class="text-success">Provided on ' + new Date(req.providedAt).toLocaleDateString() + '</small>';
                                   var actionHtml = '<span class="badge bg-success">Completed</span>';
                                   if (req.documentUrl) {
                                       actionHtml += '<a href="' + req.documentUrl + '" target="_blank" class="btn btn-sm btn-link text-primary ms-2" title="View Document" style="padding: 0 4px;"><svg class="icon-image" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 12C2 12 5 5 12 5C19 5 22 12 22 12C22 12 19 19 12 19C5 19 2 12 2 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>';
                                   }
                                   li.innerHTML = content + '</div><div class="d-flex align-items-center">' + actionHtml + '</div>';
                               } else {
                                   hasPending = true;
                                   content += '</div>';
                                   var actionDiv = document.createElement('div');
                                   actionDiv.innerHTML = 
                                       '<button class="btn btn-sm btn-outline-primary upload-trigger" data-req-id="' + req.id + '" data-req-name="' + (req.name || '').replace(/"/g, '&quot;') + '">Upload</button>' +
                                       '<input type="file" class="d-none doc-upload-input" data-req-id="' + req.id + '" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png">';
                                   li.innerHTML = content;
                                   li.appendChild(actionDiv);
                               }
                               listEl.appendChild(li);
                           });
                       }
                       
                       // Bind events
                       var triggers = listEl.querySelectorAll('.upload-trigger');
                       for(var i=0; i<triggers.length; i++) {
                           triggers[i].onclick = function() {
                               var reqId = this.getAttribute('data-req-id');
                               var reqName = this.getAttribute('data-req-name') || '';
                               var btn = this;
                               
                               // Generate PDF from quick links and upload
                               btn.disabled = true;
                               btn.textContent = 'Generating PDF...';
                               
                               // Load jsPDF if not already loaded
                               if (typeof window.jspdf === 'undefined') {
                                   var script = document.createElement('script');
                                   script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
                                   script.onload = function() {
                                       generateQuickLinksPDFAndUpload(reqId, reqName, btn, appId, listEl);
                                   };
                                   script.onerror = function() {
                                       // If jsPDF fails to load, fall back to file picker
                                       console.error('Failed to load jsPDF library');
                                       btn.disabled = false;
                                       btn.textContent = 'Upload';
                                       var input = listEl.querySelector('input[data-req-id="' + reqId + '"]');
                                       if(input) {
                                           input.value = '';
                                           input.click();
                                       }
                                   };
                                   document.head.appendChild(script);
                               } else {
                                   generateQuickLinksPDFAndUpload(reqId, reqName, btn, appId, listEl);
                               }
                           };
                       }
                       
                       // Function to generate PDF from quick links and upload it
                       async function generateQuickLinksPDFAndUpload(reqId, reqName, btn, appId, listEl) {
                           try {
                               btn.textContent = 'Loading quick links...';
                               
                               // Get all quick links - we'll use all available quick links
                               var quickLinks = [
                                   { id: 'education', name: 'Education' },
                                   { id: 'license', name: 'License' },
                                   { id: 'insurance', name: 'Insurance' },
                                   { id: 'health', name: 'Health Assessment' },
                                   { id: 'risk', name: 'Risk Assessment' },
                                   { id: 'application-certification', name: 'Application Certification' }
                               ];
                               
                               // Load jsPDF
                               const { jsPDF } = window.jspdf;
                               const doc = new jsPDF();
                               const pageWidth = doc.internal.pageSize.getWidth();
                               const pageHeight = doc.internal.pageSize.getHeight();
                               const margin = 14;
                               const maxWidth = pageWidth - (margin * 2);
                               
                               // Set font
                               doc.setFontSize(18);
                               doc.setFont(undefined, 'bold');
                               doc.text(reqName || 'Quick Links Summary', margin, 20);
                               
                               // Add date
                               doc.setFontSize(10);
                               doc.setFont(undefined, 'normal');
                               const dateStr = new Date().toLocaleString();
                               doc.text('Generated: ' + dateStr, margin, 30);
                               
                               // Add line separator
                               doc.setDrawColor(200, 200, 200);
                               doc.line(margin, 36, pageWidth - margin, 36);
                               var yPos = 44;
                               
                               // Helper function to add wrapped text
                               function addWrappedText(doc, text, x, y, maxWidth, fontSize) {
                                   doc.setFontSize(fontSize);
                                   const lines = doc.splitTextToSize(text, maxWidth);
                                   doc.text(lines, x, y);
                                   return lines.length * (fontSize * 0.4);
                               }
                               
                               // Helper function to fetch quick link data
                               async function fetchQuickLinkData(linkId) {
                                   try {
                                       switch(linkId) {
                                           case 'education':
                                               // First try to get data from popup if available
                                               const educationPopup = document.getElementById('popup-education');
                                               if (educationPopup) {
                                                   const popupCards = educationPopup.querySelectorAll('.ed-card, .card');
                                                   if (popupCards.length > 0) {
                                                       return Array.from(popupCards).map(card => {
                                                           const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
                                                           const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
                                                           return { title, details };
                                                       });
                                                   }
                                               }
                                               
                                               // Fallback: try to fetch from endpoint (with error handling)
                                               try {
                                                   const eduResponse = await fetch("{{ path('app_provider_education_list') }}", {
                                                       headers: { 'X-Requested-With': 'XMLHttpRequest' }
                                                   });
                                                   
                                                   if (!eduResponse.ok) {
                                                       console.warn('Education list fetch failed:', eduResponse.status, eduResponse.statusText);
                                                       return [];
                                                   }
                                                   
                                                   const eduHtml = await eduResponse.text();
                                                   if (!eduHtml || eduHtml.trim() === '' || eduHtml.includes('<!DOCTYPE') === false && !eduHtml.includes('<html')) {
                                                       // Check if it's JSON error response
                                                       try {
                                                           const jsonData = JSON.parse(eduHtml);
                                                           if (jsonData.error || jsonData.message) {
                                                               console.warn('Education endpoint returned error:', jsonData);
                                                               return [];
                                                           }
                                                       } catch (e) {
                                                           // Not JSON, continue with HTML parsing
                                                       }
                                                   }
                                                   
                                                   const eduParser = new DOMParser();
                                                   const eduDoc = eduParser.parseFromString(eduHtml, 'text/html');
                                                   const eduCards = eduDoc.querySelectorAll('.ed-card, .card');
                                                   
                                                   if (eduCards.length > 0) {
                                                       return Array.from(eduCards).map(card => {
                                                           const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
                                                           const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
                                                           return { title, details };
                                                       });
                                                   }
                                               } catch (fetchError) {
                                                   console.warn('Error fetching education list:', fetchError);
                                                   // Return empty array - PDF will show "No data available"
                                               }
                                               return [];
                                           case 'license':
                                               const licensePopup = document.getElementById('popup-license');
                                               if (licensePopup) {
                                                   const licenseCards = licensePopup.querySelectorAll('.ed-card, .card');
                                                   return Array.from(licenseCards).map(card => {
                                                       const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
                                                       const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
                                                       return { title, details };
                                                   });
                                               }
                                               return [];
                                           case 'insurance':
                                               const insurancePopup = document.getElementById('popup-insurance');
                                               if (insurancePopup) {
                                                   const insuranceCards = insurancePopup.querySelectorAll('.ed-card, .card');
                                                   return Array.from(insuranceCards).map(card => {
                                                       const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
                                                       const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
                                                       return { title, details };
                                                   });
                                               }
                                               return [];
                                           case 'health':
                                               const healthPopup = document.getElementById('popup-health');
                                               if (healthPopup) {
                                                   const form = healthPopup.querySelector('form');
                                                   if (form) {
                                                       const healthData = [];
                                                       form.querySelectorAll('.form-group').forEach(group => {
                                                           const label = group.querySelector('label')?.textContent?.trim() || '';
                                                           const inputs = group.querySelectorAll('input[type="radio"]:checked, textarea, select');
                                                           const values = Array.from(inputs).map(input => {
                                                               if (input.type === 'radio') return input.value;
                                                               if (input.tagName === 'TEXTAREA') return input.value;
                                                               if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                                                               return '';
                                                           }).filter(v => v);
                                                           if (label && values.length > 0) {
                                                               healthData.push({ title: label, details: values });
                                                           }
                                                       });
                                                       return healthData;
                                                   }
                                               }
                                               return [];
                                           case 'risk':
                                               const riskPopup = document.getElementById('popup-risk');
                                               if (riskPopup) {
                                                   const form = riskPopup.querySelector('form');
                                                   if (form) {
                                                       const riskData = [];
                                                       form.querySelectorAll('.form-group').forEach(group => {
                                                           const label = group.querySelector('label')?.textContent?.trim() || '';
                                                           const inputs = group.querySelectorAll('input[type="radio"]:checked, textarea, select');
                                                           const values = Array.from(inputs).map(input => {
                                                               if (input.type === 'radio') return input.value;
                                                               if (input.tagName === 'TEXTAREA') return input.value;
                                                               if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                                                               return '';
                                                           }).filter(v => v);
                                                           if (label && values.length > 0) {
                                                               riskData.push({ title: label, details: values });
                                                           }
                                                       });
                                                       return riskData;
                                                   }
                                               }
                                               return [];
                                           case 'application-certification':
                                               const certPopup = document.getElementById('popup-application-certification');
                                               if (certPopup) {
                                                   const form = certPopup.querySelector('form');
                                                   if (form) {
                                                       const certData = [];
                                                       form.querySelectorAll('.form-group, .form-check').forEach(group => {
                                                           const label = group.querySelector('label')?.textContent?.trim() || '';
                                                           const inputs = group.querySelectorAll('input[type="checkbox"]:checked, input[type="radio"]:checked, textarea, select');
                                                           const values = Array.from(inputs).map(input => {
                                                               if (input.type === 'checkbox' || input.type === 'radio') return input.value || 'Yes';
                                                               if (input.tagName === 'TEXTAREA') return input.value;
                                                               if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                                                               return '';
                                                           }).filter(v => v);
                                                           if (label && values.length > 0) {
                                                               certData.push({ title: label, details: values });
                                                           }
                                                       });
                                                       return certData;
                                                   }
                                               }
                                               return [];
                                           default:
                                               return [];
                                       }
                                   } catch (error) {
                                       console.error('Error fetching quick link data:', error);
                                       return [];
                                   }
                               }
                               
                               // Fetch and add data for each quick link
                               btn.textContent = 'Generating PDF...';
                               for (var index = 0; index < quickLinks.length; index++) {
                                   var link = quickLinks[index];
                                   
                                   // Check if we need a new page
                                   if (yPos > pageHeight - 40) {
                                       doc.addPage();
                                       yPos = 20;
                                   }
                                   
                                   // Section header
                                   doc.setFontSize(14);
                                   doc.setFont(undefined, 'bold');
                                   doc.text((index + 1) + '. ' + link.name, margin, yPos);
                                   yPos += 8;
                                   
                                   // Fetch data for this link
                                   doc.setFontSize(10);
                                   doc.setFont(undefined, 'normal');
                                   
                                   try {
                                       var linkData = await fetchQuickLinkData(link.id);
                                       
                                       if (linkData && linkData.length > 0) {
                                           linkData.forEach(function(item) {
                                               // Check if we need a new page
                                               if (yPos > pageHeight - 30) {
                                                   doc.addPage();
                                                   yPos = 20;
                                               }
                                               
                                               // Item title
                                               if (item.title) {
                                                   doc.setFont(undefined, 'bold');
                                                   doc.setFontSize(11);
                                                   var titleHeight = addWrappedText(doc, item.title, margin + 5, yPos, maxWidth - 5, 11);
                                                   yPos += titleHeight + 2;
                                               }
                                               
                                               // Item details
                                               if (item.details && item.details.length > 0) {
                                                   doc.setFont(undefined, 'normal');
                                                   doc.setFontSize(10);
                                                   item.details.forEach(function(detail) {
                                                       if (yPos > pageHeight - 20) {
                                                           doc.addPage();
                                                           yPos = 20;
                                                       }
                                                       var detailHeight = addWrappedText(doc, '  • ' + detail, margin + 10, yPos, maxWidth - 10, 10);
                                                       yPos += detailHeight + 3;
                                                   });
                                               }
                                               
                                               yPos += 3; // Space between items
                                           });
                                       } else {
                                           doc.setFont(undefined, 'italic');
                                           doc.setFontSize(10);
                                           doc.text('  No data available', margin + 5, yPos);
                                           yPos += 6;
                                       }
                                   } catch (error) {
                                       doc.setFont(undefined, 'normal');
                                       doc.setFontSize(10);
                                       doc.text('  Error loading data: ' + error.message, margin + 5, yPos);
                                       yPos += 6;
                                   }
                                   
                                   yPos += 8; // Space between sections
                               }
                               
                               // Generate PDF blob
                               btn.textContent = 'Uploading PDF...';
                               try {
                                   var pdfBlob = doc.output('blob');
                                   if (!pdfBlob || pdfBlob.size === 0) {
                                       throw new Error('Generated PDF is empty');
                                   }
                                   var pdfFile = new File([pdfBlob], (reqName || 'QuickLinks').replace(/[^a-zA-Z0-9]/g, '_') + '.pdf', { type: 'application/pdf' });
                               } catch (pdfError) {
                                   throw new Error('Failed to generate PDF: ' + (pdfError.message || 'Unknown error'));
                               }
                               
                               // Upload the PDF
                               var formData = new FormData();
                               formData.append('file', pdfFile);
                               formData.append('category', reqName);
                               
                               fetch('/provider/documents/upload-ajax', {
                                   method: 'POST',
                                   headers: {
                                       'X-Requested-With': 'XMLHttpRequest'
                                   },
                                   credentials: 'same-origin',
                                   body: formData
                               })
                               .then(function(r) {
                                   if (!r.ok) {
                                       // Try to get error message from response
                                       return r.text().then(function(text) {
                                           try {
                                               const json = JSON.parse(text);
                                               throw new Error(json.message || 'HTTP ' + r.status + ': ' + (json.error || 'Upload failed'));
                                           } catch (e) {
                                               if (e.message && e.message.includes('HTTP')) {
                                                   throw e;
                                               }
                                               throw new Error('HTTP ' + r.status + ': ' + (text.substring(0, 100) || 'Upload failed'));
                                           }
                                       });
                                   }
                                   return r.json();
                               })
                               .then(function(uploadResult) {
                                   if (uploadResult.success && uploadResult.document && uploadResult.document.id) {
                                       // Assign the uploaded document to the request
                                       btn.textContent = 'Assigning...';
                                       return fetch('/provider/document-request/' + reqId + '/assign-document', {
                                           method: 'POST',
                                           headers: {
                                               'Content-Type': 'application/json',
                                               'X-Requested-With': 'XMLHttpRequest'
                                           },
                                           credentials: 'same-origin',
                                           body: JSON.stringify({ documentId: uploadResult.document.id })
                                       });
                                   } else {
                                       throw new Error('Upload failed: ' + (uploadResult.message || 'Unknown error'));
                                   }
                               })
                               .then(function(r) {
                                   if (!r.ok) throw new Error('HTTP ' + r.status);
                                   return r.json();
                               })
                               .then(function(result) {
                                   if (result.success) {
                                       // Show success message and refresh
                                       btn.textContent = 'Done!';
                                       btn.classList.remove('btn-outline-primary');
                                       btn.classList.add('btn-success');
                                       
                                       // Refresh the document requests list
                                       setTimeout(function() {
                                           var reqUrl = "{{ path('app_provider_application_document_requests_details', {'id': '00000000-0000-0000-0000-000000000000'}) }}".replace('00000000-0000-0000-0000-000000000000', appId);
                                           fetch(reqUrl)
                                               .then(function(r){ return r.json(); })
                                               .then(function(data){
                                                   var todoEl = document.querySelector('[data-todo-type="documents"][data-application-id="' + appId + '"]');
                                                   if (todoEl && typeof window.showTodoDetails === 'function') {
                                                       window.showTodoDetails(appId, 'documents', todoEl);
                                                   } else {
                                                       location.reload();
                                                   }
                                               })
                                               .catch(function(err){
                                                   console.error('Refresh error:', err);
                                                   location.reload();
                                               });
                                       }, 1000);
                                   } else {
                                       throw new Error('Assignment failed: ' + (result.message || 'Unknown error'));
                                   }
                               })
                               .catch(function(err) {
                                   console.error('Error in PDF upload/assign process:', err);
                                   var errorMsg = 'Error: ' + (err.message || 'Unknown error occurred');
                                   if (err.message && err.message.includes('HTTP 500')) {
                                       errorMsg = 'Server error occurred. Please try again or upload the document manually.';
                                   } else if (err.message && err.message.includes('HTTP')) {
                                       errorMsg = 'Upload failed: ' + err.message;
                                   }
                                   alert(errorMsg);
                                   btn.disabled = false;
                                   btn.textContent = 'Upload';
                                   btn.classList.remove('btn-success');
                               });
                               
                           } catch (error) {
                               console.error('Error generating PDF:', error);
                               // Fall back to file picker if PDF generation fails
                               btn.disabled = false;
                               btn.textContent = 'Upload';
                               btn.classList.remove('btn-success');
                               
                               // Show error but allow manual upload
                               var errorMsg = 'Failed to generate PDF automatically. ';
                               if (error.message && !error.message.includes('HTTP')) {
                                   errorMsg += error.message + ' ';
                               }
                               errorMsg += 'Opening file picker for manual upload...';
                               alert(errorMsg);
                               
                               // Open file picker as fallback
                               var input = listEl.querySelector('input[data-req-id="' + reqId + '"]');
                               if(input) {
                                   setTimeout(function() {
                                       input.value = '';
                                       input.click();
                                   }, 500);
                               }
                           }
                       }

                       var inputs = listEl.querySelectorAll('.doc-upload-input');
                       for(var j=0; j<inputs.length; j++) {
                           inputs[j].onchange = function() {
                               if (this.files && this.files[0]) {
                                   uploadDocument(appId, this.getAttribute('data-req-id'), this.files[0], this);
                               }
                           };
                       }
                       
                       if (!hasContent) {
                            msgEl.textContent = 'No credentialing documents or links required at this time.';
                            msgEl.classList.remove('d-none');
                       } else if (!hasPending && type === 'documents') {
                            // Only show generic "All provided" if it's the document task and no pending docs
                            // For credentialing, links are always "open", so we don't necessarily show "All done"
                            msgEl.textContent = 'All documents provided.';
                            msgEl.classList.remove('d-none');
                       }
                   } else {
                       msgEl.textContent = 'No details available.';
                       msgEl.classList.remove('d-none');
                   }
               })
               .catch(function(err){
                   console.error(err);
                   listEl.innerHTML = '<li class="list-group-item text-danger">Error loading details.</li>';
               });
        } 
        else if (type === 'interview') {
            headerEl.textContent = 'Interview Information:';
            customEl.classList.remove('d-none');
            
            var interviewsJson = el.getAttribute('data-interviews') || '[]';
            var interviews = [];
