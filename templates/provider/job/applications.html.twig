}

.todo-popup {
    position: fixed;
    background: white;
    color: #121C0C;
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 14px;
    box-shadow: 0 4px 20px rgba(133, 187, 101, 0.15), 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 99999;
    min-width: 300px;
    max-width: 420px;
    display: none;
    pointer-events: none;
    border: 2px solid #85BB65;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.todo-popup.show {
    display: block;
    pointer-events: auto;
    animation: todoPopupFadeIn 0.2s ease-out;
}

@keyframes todoPopupFadeIn {
    from {
        opacity: 0;
        transform: translateY(-5px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.todo-popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 2px solid #85BB65;
}

.todo-popup-title {
    font-weight: 600;
    font-size: 16px;
    color: #121C0C;
    letter-spacing: -0.01em;
}

.todo-popup-close {
    background: none;
