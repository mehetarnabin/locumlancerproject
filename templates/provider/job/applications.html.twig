        const isInSplitView = archiveBtn.closest('#job-detail-content') || archiveBtn.closest('.split-job-details');
        
        let selectedIds = [];
        
        if (isInSplitView) {
            // In split view, use the selected job
            const selectedJobId = window.selectedJobId;
            if (selectedJobId) {
                // Find the application ID for this job
                const activeCard = document.querySelector('.split-job-card.active');
                if (activeCard) {
                    const checkbox = activeCard.querySelector('.job-checkbox');
                    if (checkbox) {
                        const applicationId = checkbox.dataset.applicationId || checkbox.dataset.jobId;
                        if (applicationId) {
                            selectedIds = [applicationId];
                        }
                    }
                }
                // Fallback to job ID if application ID not found
                if (selectedIds.length === 0) {
                    selectedIds = [selectedJobId];
                }
            }
        } else {
            // In list view, use checked checkboxes
            selectedIds = Array.from(document.querySelectorAll('.job-check.job-checkbox:checked, .job-checkbox:checked, .job-check:checked, #split-job-list .job-checkbox:checked'))
                .map(cb => {
                    // Prioritize application ID - this is what we need for archiving
                    const appId = cb.dataset.applicationId || cb.getAttribute('data-application-id');
                    if (appId) {
                        return appId;
                    }
                    // If no application ID, try to get it from the job ID (fallback)
                    const jobId = cb.dataset.jobId || cb.getAttribute('data-job-id');
                    return jobId;
                })
                .filter(Boolean);
        }
        
        // Log for debugging
        console.log('Selected IDs for archiving:', selectedIds);

        if (selectedIds.length === 0) {
            if (typeof showWarningAlert === 'function') {
                showWarningAlert('No Selection', 'Please select at least one application to archive.');
            } else {
                alert('Please select at least one application to archive.');
            }
            return;
        }

        const confirmTitle = 'Archive Applications';
        const confirmMessage = `Are you sure you want to archive ${selectedIds.length} application(s)? They will be moved to your archived jobs section.`;

        const confirmed = await new Promise((resolve) => {
            if (typeof showConfirmAlert === 'function') {
                showConfirmAlert(
                    confirmTitle,
                    confirmMessage,
                    'Archive',
                    'Cancel',
                    (result) => resolve(result)
                );
            } else {
                resolve(window.confirm(`${confirmTitle}\n${confirmMessage}`));
            }
        });

        if (!confirmed) {
            return;
        }

        try {
            const response = await fetch("{{ path('app_provider_application_archive_bulk') }}", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'`
                },
                body: JSON.stringify({ ids: selectedIds })
            });

            const result = await response.json();

            if (result.success) {
                if (typeof showSuccessAlert === 'function') {
                    showSuccessAlert('Success', result.message);
                } else {
                    alert(result.message || 'Archived successfully.');
                }
                
                // Remove archived rows from DOM
                selectedIds.forEach(id => {
                    let checkbox = document.querySelector(`.job-checkbox[data-application-id="${id}"]`);
                    if (!checkbox) {
                        checkbox = document.querySelector(`.job-check.job-checkbox[data-application-id="${id}"]`);
                    }
                    if (!checkbox) {
                        checkbox = document.querySelector(`.job-checkbox[data-job-id="${id}"]`);
                    }
                    
                    if (checkbox) {
                        const jobList = checkbox.closest('.job-lists');
                        if (jobList) {
                            jobList.remove();
                        } else {
                            const jobRow = checkbox.closest('.job-row');
                            if (jobRow) {
                                const parentList = jobRow.closest('.job-lists');
                                if (parentList) {
                                    parentList.remove();
                                } else {
                                    jobRow.remove();
                                }
                            }
                        }
                    }
                });
                
                // Check if there are any remaining jobs
                const container = document.querySelector('.job-list-container');
                const remainingJobs = document.querySelectorAll('.job-lists:not(:first-child)');
                
                if (remainingJobs.length === 0 && container) {
                    const tableWrapper = container.querySelector('.table-responsive-wrapper');
                    if (tableWrapper) {
                        tableWrapper.innerHTML = '<div style="display: flex; justify-content: center; align-items: center; min-height: 400px; padding: 40px;"><p class="mb-0" style="font-size: 18px; color: #666; text-align: center;">No applications found.</p></div>';
                    } else {
                        container.innerHTML = '<div style="display: flex; justify-content: center; align-items: center; min-height: 400px; padding: 40px;"><p class="mb-0" style="font-size: 18px; color: #666; text-align: center;">No applications found.</p></div>';
                    }
                }
                
                // Uncheck all checkboxes and update button states
                document.querySelectorAll('.job-checkbox').forEach(cb => cb.checked = false);
                // Clear selected job ID
                window.selectedJobId = null;
                if (typeof toggleActionsVisibility === 'function') {
                    toggleActionsVisibility();
                }
                if (typeof updateButtonStates === 'function') {
                    updateButtonStates();
                }
            } else {
                if (typeof showErrorAlert === 'function') {
                    showErrorAlert('Error', result.message || 'Something went wrong.');
                } else {
                    alert(result.message || 'Something went wrong.');
                }
            }
        } catch (error) {
            console.error('Error archiving applications:', error);
            if (typeof showErrorAlert === 'function') {
                showErrorAlert('Error', 'An error occurred while archiving applications.');
            } else {
                alert('An error occurred while archiving applications.');
            }
        }
    }); // Close document.addEventListener for archive button
});

// End of utilities script block
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const headers = document.querySelectorAll('.sortable');
  let currentSort = { key: null, direction: 'asc' };

  const getText = (cell) => (cell?.textContent || '').trim();
  const getLowerText = (cell) => getText(cell).toLowerCase();
  const parseNumericText = (text) => {
    if (!text) return 0;
    const cleaned = text.replace(/[^0-9.]/g, '');
    const parsed = parseFloat(cleaned);
    return isNaN(parsed) ? 0 : parsed;
  };

  headers.forEach(header => {
    header.addEventListener('click', () => {
      const key = header.dataset.sort;
      const direction = (currentSort.key === key && currentSort.direction === 'asc') ? 'desc' : 'asc';
      currentSort = { key, direction };

      // Reset all arrows to inactive
      document.querySelectorAll('.sort-toggle .arrow').forEach(a => a.classList.remove('active'));
      // Activate the appropriate arrow on current header
      const up = header.querySelector('.sort-toggle .sort-up');
      const down = header.querySelector('.sort-toggle .sort-down');
      if (direction === 'asc' && up) up.classList.add('active');
      if (direction === 'desc' && down) down.classList.add('active');

      sortApplications(key, direction);
    });
  });

  function sortApplications(key, direction) {
    const rows = Array.from(document.querySelectorAll('.job-row')).map(row => {
      const locationCell = row.querySelector('.col-location');
      const salaryCell = row.querySelector('.col-salary');
      const employerCell = row.querySelector('.col-employer');
      const appliedCell = row.querySelector('.col-applied');
      const categoryCell = row.querySelector('.col-category');
      const todoCell = row.querySelector('.col-todo');
      const rankCell = row.querySelector('.col-rank');
      const statusCell = row.querySelector('.col-status');
      const interviewCell = row.querySelector('.col-interview');
      
      return {
        element: row,
        job: {
          job: row.querySelector('.job-title')?.textContent.trim().toLowerCase() || '',
          location: getLowerText(locationCell),
          salary: parseNumericText(getText(salaryCell)),
          employer: getLowerText(employerCell),
          applied: getText(appliedCell),
          category: getLowerText(categoryCell),
          rank: (() => {
            const rankText = rankCell?.querySelector('.rank-display')?.textContent.trim() || rankCell?.textContent.trim() || '';
            if (rankText === '—' || rankText === '') return 0;
            const parsed = parseFloat(rankText);
            return isNaN(parsed) ? 0 : parsed;
          })(),
          todo: ((todoCell?.dataset.todoText || getText(todoCell)) || '').trim().toLowerCase(),
          interview: getLowerText(interviewCell),
          status: getLowerText(statusCell)
        }
      };
    });

    rows.sort((a, b) => {
      const valA = a.job[key];
      const valB = b.job[key];
      if (typeof valA === 'string') {
        return direction === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
      } else {
        return direction === 'asc' ? valA - valB : valB - valA;
      }
    });

    const container = document.querySelector('.job-list-container');
    if (container) {
      rows.forEach(row => {
        if (row.element && row.element.parentElement) {
          container.appendChild(row.element.parentElement);
        }
      });
    }
  }
});
</script>

<script>
// No results popup function
function showNoResultsPopup(message, callback) {
  // Create popup element
  const popup = document.createElement('div');
  popup.id = 'no-results-popup';
  popup.style.cssText = `
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    padding: 24px 32px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    z-index: 100000;
    text-align: center;
    font-size: 16px;
    color: #121C0C;
    font-weight: 500;
    min-width: 280px;
    animation: fadeIn 0.3s ease-in;
  `;
  popup.innerHTML = message;
  
  // Add fade-in animation
  const style = document.createElement('style');
  style.textContent = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    @keyframes fadeOut {
      from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
      to { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
    }
  `;
  document.head.appendChild(style);
  
  // No overlay - just show the popup
  document.body.appendChild(popup);
  
  // Auto-close after 3 seconds
  setTimeout(() => {
    popup.style.animation = 'fadeOut 0.3s ease-out';
    setTimeout(() => {
      if (popup.parentNode) popup.parentNode.removeChild(popup);
      if (style.parentNode) style.parentNode.removeChild(style);
      if (callback) callback();
    }, 300);
  }, 3000);
}

// Filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const filterBtn = document.getElementById('filter-btn');
  const filterPanel = document.getElementById('filter-panel');
  const applyFilterBtn = document.getElementById('apply-filter-btn');
  const clearFilterBtn = document.getElementById('clear-filter-btn');
  
  if (!filterBtn || !filterPanel) return;
  
  // Toggle filter panel - ONLY toggle, don't apply filters
  filterBtn.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    // Toggle the hidden class to show/hide the overlay
    const isHidden = filterPanel.classList.contains('hidden');
    if (isHidden) {
      filterPanel.classList.remove('hidden');
      filterPanel.style.display = 'block';
      
      // Position the filter panel correctly to prevent clipping
      const filterBtnRect = filterBtn.getBoundingClientRect();
      const splitViewContainer = document.getElementById('split-view-container');
      // Always use fixed positioning to prevent clipping issues
      filterPanel.style.position = 'fixed';
      filterPanel.style.left = filterBtnRect.left + 'px';
      filterPanel.style.top = (filterBtnRect.bottom + 8) + 'px';
      filterPanel.style.zIndex = '99999';
    } else {
      filterPanel.classList.add('hidden');
      filterPanel.style.display = 'none';
    }
  });
  
  // Close filter panel when clicking outside
  document.addEventListener('click', function(e) {
    if (filterPanel && filterBtn && !filterPanel.contains(e.target) && !filterBtn.contains(e.target)) {
      filterPanel.classList.add('hidden');
      filterPanel.style.display = 'none';
    }
  });
  
  // Apply filters - only when Apply button is clicked
  if (applyFilterBtn) {
    applyFilterBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      try {
        // Hide filter panel immediately
        if (filterPanel) {
          filterPanel.classList.add('hidden');
          filterPanel.style.display = 'none';
        }
        // If currently in split view, switch to list view first
        const splitViewContainer = document.getElementById('split-view-container');
        const listViewContainer = document.querySelector('.job-list-container');
        const gridViewBtn = document.getElementById('grid-view-btn');
        if (splitViewContainer && splitViewContainer.style.display === 'grid') {
          // Switch to list view before applying filters
          splitViewContainer.style.display = 'none';
          if (listViewContainer) {
            listViewContainer.style.display = 'block';
          }
          if (gridViewBtn) {
            gridViewBtn.classList.remove('active');
          }
        }
        applyFilters();
      } catch (error) {
        console.error('Error applying filters:', error);
        // Show all rows if there's an error
        showAllRows();
      }
    });
  }
  
  // Clear filters
  if (clearFilterBtn) {
    clearFilterBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const locationInput = document.getElementById('filter-location');
      const salaryMinInput = document.getElementById('filter-salary-min');
      const salaryMaxInput = document.getElementById('filter-salary-max');
    const dateApplied = document.getElementById('filter-date-applied');
      
      if (locationInput) locationInput.value = '';
      if (salaryMinInput) salaryMinInput.value = '';
      if (salaryMaxInput) salaryMaxInput.value = '';
    if (dateApplied) dateApplied.value = '';
      
      // Reload page to show all applications
      window.location.href = "{{ path('app_provider_jobs_applications') }}";
    });
  }
  
  function showAllRows() {
    // Only target .job-lists wrapper, not .job-row
    const rowWrappers = document.querySelectorAll('.job-lists');
    console.log('Showing all rows, found:', rowWrappers.length, 'wrappers');
    rowWrappers.forEach(wrapper => {
      // Force show the element by removing any inline styles
      wrapper.style.display = '';
      wrapper.style.removeProperty('display');
      // Also remove hidden class if present
      wrapper.classList.remove('hidden');
      wrapper.classList.remove('d-none');
    });
  }
  
  // Ensure all rows are visible on page load - run after a short delay to ensure DOM is ready
  setTimeout(function() {
    showAllRows();
  }, 100);
  
  // Also run on window load to be sure
  window.addEventListener('load', function() {
    setTimeout(showAllRows, 200);
  });
  
  function applyFilters() {
    const locationInput = document.getElementById('filter-location');
    const salaryMinInput = document.getElementById('filter-salary-min');
    const salaryMaxInput = document.getElementById('filter-salary-max');
    const dateAppliedInput = document.getElementById('filter-date-applied');
    
    if (!locationInput || !salaryMinInput || !salaryMaxInput) {
      console.warn('Filter inputs not found');
      return;
    }
    
    // Build filter parameters
    const params = new URLSearchParams();
    if (locationInput.value) params.append('location', locationInput.value);
    if (salaryMinInput.value) params.append('salaryMin', salaryMinInput.value);
    if (salaryMaxInput.value) params.append('salaryMax', salaryMaxInput.value);
    if (dateAppliedInput?.value) params.append('days', dateAppliedInput.value);
    
    // Get current status from URL if present
    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get('status');
    if (status) params.append('status', status);
    
    // Get the base URL
    const applicationsUrl = "{{ path('app_provider_jobs_applications') }}";
    
    // First check if there are results using AJAX
    fetch(`${applicationsUrl}?${params.toString()}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(res => res.json())
      .then(data => {
        // Check if no applications found
        if (data.html && (
          data.html.includes('No applications found') || 
          data.html.includes('Applications not found') || 
          data.html.includes('applications not found') ||
          data.html.includes('No applications match') ||
          data.html.includes('match the selected filters')
        )) {
          // Show custom popup for 3 seconds, then redirect to original page (without filters)
          showNoResultsPopup('No applications found', function() {
            const currentUrl = window.location.pathname;
            const newParams = new URLSearchParams();
            // Keep only the status parameter if it exists, remove filter parameters
            if (status) {
              newParams.append('status', status);
            }
            const redirectUrl = newParams.toString() ? `${currentUrl}?${newParams.toString()}` : currentUrl;
            window.location.href = redirectUrl;
          });
          // Close the filter panel
          if (filterPanel) {
            filterPanel.classList.add('hidden');
            filterPanel.style.display = 'none';
          }
          return;
        }
        
        // If results exist, reload the page with filter parameters - this will reset everything cleanly
        const newUrl = params.toString() ? `${applicationsUrl}?${params.toString()}` : applicationsUrl;
        window.location.href = newUrl;
      })
      .catch(err => {
        console.error('Filter check error:', err);
        // On error, just reload with filters anyway
        const newUrl = params.toString() ? `${applicationsUrl}?${params.toString()}` : applicationsUrl;
        window.location.href = newUrl;
      });
  }
});

// Split View Functionality
document.addEventListener('DOMContentLoaded', function () {
  const gridViewBtn = document.getElementById('grid-view-btn');
