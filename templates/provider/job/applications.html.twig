                                msg.style.position = 'fixed';
                                msg.style.top = '20px';
                                msg.style.right = '20px';
                                msg.style.backgroundColor = '#85BB65';
                                msg.style.color = 'white';
                                msg.style.padding = '10px 15px';
                                msg.style.borderRadius = '5px';
                                msg.style.zIndex = '99999';
                                msg.textContent = 'Marked as completed!';
                                document.body.appendChild(msg);
                                setTimeout(() => {
                                    msg.style.display = 'none';
                                    document.body.removeChild(msg);
                                }, 2000);
                            }
                        });
                    }
                    
                    // Position popup relative to icon
                    const iconWrapper = todoIcon.closest('.todo-icon-wrapper');
                    const iconContainer = iconWrapper || todoIcon;
                    const containerRect = iconContainer.getBoundingClientRect();
                    
                    // Show popup first (positioned initially, will be adjusted in requestAnimationFrame)
                    window.todoPopup.style.left = (containerRect.right + 10) + 'px';
                    window.todoPopup.style.top = containerRect.top + 'px';
                    window.todoPopup.classList.add('show');
                    
                    // Use requestAnimationFrame to ensure popup is rendered before getting dimensions
                    requestAnimationFrame(() => {
                        // Get actual popup dimensions after it's rendered
                        const popupRect = window.todoPopup.getBoundingClientRect();
                        const popupWidth = popupRect.width || 300;
                        const popupHeight = popupRect.height || 200;
                        
                        // Position to the right of the icon
                        let left = containerRect.right + 10;
                        let top = containerRect.top;
                    
                    // Adjust if popup goes off screen
                    if (left + popupWidth > window.innerWidth - 10) {
                            // If not enough space on right, show to the left
                            left = containerRect.left - popupWidth - 10;
                        }
                        if (left < 10) {
                            left = 10;
                    }
                    if (top < 10) {
                        top = 10;
                    }
                    if (top + popupHeight > window.innerHeight - 10) {
                        top = window.innerHeight - popupHeight - 10;
                    }
                    
                    window.todoPopup.style.left = left + 'px';
                    window.todoPopup.style.top = top + 'px';
                    });
                }
            }
            
            // Close popup if clicking outside (for click-based closing)
            if (window.todoPopup && window.todoPopup.classList.contains('show') && 
                !window.todoPopup.contains(e.target) && 
                !findTodoIcon(e.target)) {
                // Only close on click, not on hover
                // window.todoPopup.classList.remove('show');
            }
        });
        
        window.todoPopupHandlerInitialized = true;
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            createTodoPopup();
            initTodoPopupHandler();
        });
    } else {
        createTodoPopup();
        initTodoPopupHandler();
    }
})();

