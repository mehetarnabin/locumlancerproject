                          <p class="mb-0">Unable to load detailed timeline information.</p>
                          <a href="/provider/jobs/${jobId}/detail" class="btn btn-sm btn-outline-primary mt-2">
                              View Job Details
                          </a>
                      </div>
                  </div>
              `;
          });
  }

  window.closeTimelinePanel = function() {
      const timelinePanel = document.getElementById('timeline-panel');
      const jobDetails = document.getElementById('split-job-details');
      if (timelinePanel) {
          timelinePanel.classList.remove('open');
          timelinePanel.setAttribute('aria-hidden', 'true');
      }
      if (jobDetails) {
          jobDetails.classList.remove('timeline-open');
      }
  }

  // Timeline button click handler
  document.addEventListener('click', function(e) {
      if (e.target.closest('#detail-timeline-btn')) {
          e.preventDefault();
          e.stopPropagation();
          
          // Get the selected job ID
          let jobId = window.selectedJobId || null;
          
          // If not found, try to find from active split job card
          if (!jobId) {
              const activeCard = document.querySelector('.split-job-card.active');
              if (activeCard) {
                  jobId = activeCard.getAttribute('data-job-id');
              }
          }
          
          // If still not found, try to find from checked checkbox
          if (!jobId) {
              const checkedCheckbox = document.querySelector('.job-checkbox:checked');
              if (checkedCheckbox) {
                  jobId = checkedCheckbox.getAttribute('data-job-id');
              }
          }
          
          if (jobId) {
              // Open timeline panel (it will handle collapsing the list)
              openTimelinePanel(jobId);
          } else {
              if (typeof showToast === 'function') {
                  showToast('Please select a job first', 'warning');
              }
          }
      }
      
      // View Details button click handler
      if (e.target.closest('#detail-view-details-btn')) {
          e.preventDefault();
          e.stopPropagation();
          
          // Get the selected job ID and application ID
          let jobId = window.selectedJobId || null;
          let applicationId = window.selectedApplicationId || null;
          
          // If not found, try to find from active split job card
          if (!jobId || !applicationId) {
              const activeCard = document.querySelector('.split-job-card.active');
              if (activeCard) {
                  if (!jobId) jobId = activeCard.getAttribute('data-job-id');
                  if (!applicationId) applicationId = activeCard.getAttribute('data-application-id');
              }
          }
          
          // If still not found, try to find from checked checkbox
          if (!jobId || !applicationId) {
              const checkedCheckbox = document.querySelector('.job-checkbox:checked');
              if (checkedCheckbox) {
                  if (!jobId) jobId = checkedCheckbox.getAttribute('data-job-id');
                  if (!applicationId) applicationId = checkedCheckbox.getAttribute('data-application-id');
              }
          }
          
          if (applicationId) {
              // For applications page, use application detail URL
              window.location.href = `/provider/applications/${applicationId}`;
          } else if (jobId) {
              // For other pages, use job detail URL
              window.location.href = `/provider/jobs/${jobId}/detail`;
          } else {
              if (typeof showToast === 'function') {
                  showToast('Please select a job first', 'warning');
              }
          }
      }
      
  });
  
  // Note Panel Functions
  window.openNotesPanel = function(jobId) {
      const panel = document.getElementById('notes-panel');
      const textarea = document.getElementById('notes-textarea');
      const jobDetails = document.getElementById('split-job-details');
      const container = document.getElementById('split-view-container');
      
      if (!panel || !textarea) return;
      
      // Close timeline panel if open
      const timelinePanel = document.getElementById('timeline-panel');
      if (timelinePanel && timelinePanel.classList.contains('open')) {
          timelinePanel.classList.remove('open');
          timelinePanel.setAttribute('aria-hidden', 'true');
          if (jobDetails) {
              jobDetails.classList.remove('timeline-open');
          }
      }
      
      // Step 1: Collapse the left list first
      if (typeof window.collapseList === 'function') {
          window.collapseList();
      }
      
      // Step 2: Set job ID and load from localStorage
      panel.dataset.jobId = jobId;
      const saved = localStorage.getItem('provider_job_notes_' + jobId) || '';
      textarea.value = saved;
      
      // Step 3: Wait for collapse animation, then open panel
      setTimeout(() => {
          // Ensure container and job details don't scroll
          if (container) {
              container.style.overflowX = 'hidden';
              container.style.overflowY = 'hidden';
              container.scrollLeft = 0;
              container.scrollTop = 0;
          }
          
          if (jobDetails) {
              jobDetails.classList.add('notes-open');
              jobDetails.style.overflowY = 'hidden';
              jobDetails.style.overflowX = 'hidden';
              jobDetails.scrollLeft = 0;
              jobDetails.scrollTop = 0;
          }
          
          // Removed - allow scrolling in split-job-list
          // const jobList = document.getElementById('split-job-list');
          // if (jobList) {
          //     jobList.style.overflowY = 'hidden';
          //     jobList.style.overflowX = 'hidden';
          // }
          
          // Open the panel
          panel.classList.add('open');
          panel.setAttribute('aria-hidden', 'false');
          
          // Focus textarea
          setTimeout(() => {
              textarea.focus();
          }, 50);
      }, 150);
      
      // Auto-save on input
      textarea.oninput = function() {
          localStorage.setItem('provider_job_notes_' + jobId, textarea.value);
          const lastSaved = panel.querySelector('.last-saved');
          const lastSavedTime = panel.querySelector('.last-saved-time');
          if (lastSaved && lastSavedTime) {
              lastSaved.style.display = 'block';
              lastSavedTime.textContent = new Date().toLocaleTimeString();
          }
      };
  }
  
  window.closeNotesPanel = function() {
      const panel = document.getElementById('notes-panel');
      const jobDetails = document.getElementById('split-job-details');
      if (!panel) return;
      panel.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      panel.dataset.jobId = '';
      
      // Remove notes-open class from job details container to restore layout
      if (jobDetails) {
          jobDetails.classList.remove('notes-open');
      }
  }
  
  // Note button click handlers - Single consolidated handlers to avoid conflicts
  document.addEventListener('click', function(e) {
      // Handle detail-note-btn (button in job details panel)
      const detailNoteBtn = e.target.closest('#detail-note-btn');
      if (detailNoteBtn) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          
          // Get the selected job ID
          let jobId = window.selectedJobId || null;
          
          // If not found, try to find from active split job card
          if (!jobId) {
              const activeCard = document.querySelector('.split-job-card.active');
              if (activeCard) {
                  jobId = activeCard.getAttribute('data-job-id');
              }
          }
          
          // If still not found, try to find from checked checkbox
          if (!jobId) {
              const checkedCheckbox = document.querySelector('.job-checkbox:checked');
              if (checkedCheckbox) {
                  jobId = checkedCheckbox.getAttribute('data-job-id') || checkedCheckbox.getAttribute('data-application-id');
              }
          }
          
          if (jobId) {
              // Open notes panel (it will handle collapsing the list)
              if (typeof window.openNotesPanel === 'function') {
                  window.openNotesPanel(jobId);
              }
          } else {
              if (typeof showToast === 'function') {
                  showToast('Please select a job first', 'warning');
              }
          }
          return;
      }
      
      // Handle note-btn (button in action bar) - if it exists
      const noteBtn = e.target.closest('#note-btn');
      if (noteBtn) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          
          let jobId = null;
          const single = Array.from(document.querySelectorAll('.job-checkbox')).filter(cb => cb.checked);
          if (single.length === 1) {
              jobId = single[0].dataset.jobId || single[0].dataset.applicationId;
          }
          if (!jobId) {
              jobId = window.selectedJobId || null;
              if (!jobId) {
                  const activeCard = document.querySelector('.split-job-card.active');
                  if (activeCard) {
                      jobId = activeCard.getAttribute('data-job-id');
                  }
              }
          }
          if (jobId) { 
              if (typeof window.openNotesPanel === 'function') {
                  window.openNotesPanel(jobId);
              }
          } else {
              if (typeof showToast === 'function') {
                  showToast('Please select a job to add notes', 'warning');
              }
          }
      }
  });
});

// Handle list collapse functionality - same as saved section
function setupListCollapse() {
    const container = document.getElementById('split-view-container');
    const toggleBtn = document.getElementById('list-toggle-btn');
    const noteBtn = document.getElementById('note-btn');
    const detailNoteBtn = document.getElementById('detail-note-btn');
    
    if (!container || !toggleBtn) {
        console.log('setupListCollapse: Missing container or toggleBtn', { container, toggleBtn });
        return;
    }

    // Function to update toggle button position and visibility
    window.updateToggleButtonPosition = function() {
        if (!container || !toggleBtn) return;
        
        if (container.style.display !== 'grid') {
            toggleBtn.style.display = 'none';
            return;
        }
        
        const isCollapsed = container.classList.contains('list-collapsed');
        const splitJobDetails = document.getElementById('split-job-details');
        
        // Only show toggle button when list is collapsed
        if (isCollapsed) {
            // Ensure button is visible and properly styled
            toggleBtn.style.display = 'flex';
            toggleBtn.style.alignItems = 'center';
            toggleBtn.style.justifyContent = 'center';
            toggleBtn.style.position = 'fixed';
            toggleBtn.style.zIndex = '1001';
            toggleBtn.style.transform = 'none';
            toggleBtn.style.opacity = '1';
            toggleBtn.style.visibility = 'visible';
            
            // Position at the left edge of the details container (just on the edge)
            if (splitJobDetails) {
                const detailsRect = splitJobDetails.getBoundingClientRect();
                const buttonWidth = 30; // Match the button width from CSS
                toggleBtn.style.left = (detailsRect.left - buttonWidth / 2) + 'px';
                toggleBtn.style.top = (detailsRect.top + 35) + 'px';
            } else {
                // Fallback positioning if details not found
                toggleBtn.style.left = '20px';
                toggleBtn.style.top = '100px';
            }
        } else {
            // Hide toggle button when list is visible (default state)
            toggleBtn.style.display = 'none';
        }
    };
    
    // Observe container changes to update toggle button visibility
    const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && (mutation.attributeName === 'style' || mutation.attributeName === 'class')) {
                updateToggleButtonPosition();
            }
        });
    });
    
    observer.observe(container, { attributes: true, attributeFilter: ['style', 'class'] });
    
    // Update position on resize and scroll
    window.addEventListener('resize', updateToggleButtonPosition);
    window.addEventListener('scroll', updateToggleButtonPosition, true);
    
    // Initialize: Hide toggle button by default
    updateToggleButtonPosition();

    // Helper function to collapse the list - make it globally accessible
    window.collapseList = function() {
        if (!container || !toggleBtn) return;
        
        if (!container.classList.contains('list-collapsed')) {
            container.classList.add('list-collapsed');
            const splitJobList = document.getElementById('split-job-list');
            const splitJobDetails = document.getElementById('split-job-details');
            if (splitJobList) {
                splitJobList.style.display = 'none';
                splitJobList.style.width = '0';
                splitJobList.style.minWidth = '0';
                splitJobList.style.maxWidth = '0';
                splitJobList.style.padding = '0';
                splitJobList.style.margin = '0';
                splitJobList.style.visibility = 'hidden';
            }
            if (splitJobDetails) {
                splitJobDetails.style.gridColumn = '1 / -1';
                splitJobDetails.style.width = '100%';
                splitJobDetails.style.maxWidth = '100%';
            }
            
            // Force show and position the toggle button immediately
            toggleBtn.style.display = 'flex';
            toggleBtn.style.alignItems = 'center';
            toggleBtn.style.justifyContent = 'center';
            toggleBtn.style.position = 'fixed';
            toggleBtn.style.zIndex = '1001';
            toggleBtn.style.opacity = '1';
            toggleBtn.style.visibility = 'visible';
            
            // Update position with multiple timeouts to ensure it appears
            setTimeout(() => {
                updateToggleButtonPosition();
            }, 50);
            setTimeout(() => {
                updateToggleButtonPosition();
            }, 150);
            setTimeout(() => {
                updateToggleButtonPosition();
            }, 300);
        }
    };
    
    // Keep local reference for internal use
    const collapseList = window.collapseList;

    // Helper function to expand the list
    function expandList() {
        if (container.classList.contains('list-collapsed')) {
            container.classList.remove('list-collapsed');
            const splitJobList = document.getElementById('split-job-list');
            const splitJobDetails = document.getElementById('split-job-details');
            if (splitJobList) {
                splitJobList.style.display = 'block';
                splitJobList.style.width = '';
                splitJobList.style.minWidth = '';
                splitJobList.style.maxWidth = '';
                splitJobList.style.padding = '';
                splitJobList.style.margin = '';
                splitJobList.style.visibility = '';
            }
            if (splitJobDetails) {
                splitJobDetails.style.gridColumn = '';
                splitJobDetails.style.width = '';
                splitJobDetails.style.maxWidth = '';
            }
            
            // Close any open panels (notes or timeline) when expanding
            const notesPanel = document.getElementById('notes-panel');
            if (notesPanel && notesPanel.classList.contains('open')) {
                notesPanel.classList.remove('open');
                notesPanel.setAttribute('aria-hidden', 'true');
                if (splitJobDetails) {
                    splitJobDetails.classList.remove('notes-open');
                }
            }
            
            const timelinePanel = document.getElementById('timeline-panel');
            if (timelinePanel && timelinePanel.classList.contains('open')) {
                timelinePanel.classList.remove('open');
                timelinePanel.setAttribute('aria-hidden', 'true');
                if (splitJobDetails) {
                    splitJobDetails.classList.remove('timeline-open');
                }
            }
            
            const timelineOverlay = document.getElementById('timeline-overlay');
            if (timelineOverlay && timelineOverlay.classList.contains('active')) {
                timelineOverlay.classList.remove('active');
            }
            
            // Hide toggle button when list is expanded
            toggleBtn.style.display = 'none';
            updateToggleButtonPosition();
        }
    }

    // Toggle list collapse - completely hide/show the left sidebar
    toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCollapsed = container.classList.contains('list-collapsed');
        
        if (isCollapsed) {
            expandList();
        } else {
            collapseList();
        }
        
        // Update button position after toggle
        setTimeout(updateToggleButtonPosition, 100);
    });

    // Collapse list when note button is clicked (only if noteBtn exists)
    if (noteBtn) {
        noteBtn.addEventListener('click', () => {
            collapseList();
        });
    }
    
    // Collapse list when detail note button is clicked
    // Note: This is handled in the main click handler above, but we keep this as backup
    if (detailNoteBtn) {
        detailNoteBtn.addEventListener('click', (e) => {
            // Don't prevent default here, let the main handler do it
            // Just ensure collapse happens
            if (typeof window.collapseList === 'function') {
                window.collapseList();
            }
        });
    }
}

// Initialize list collapse functionality - run early to ensure it's available
document.addEventListener('DOMContentLoaded', function() {
    // Small delay to ensure all elements are ready
    setTimeout(() => {
        setupListCollapse();
    }, 100);
});

// Global apply button handler for AJAX-loaded content
// Use the unified handler if available, otherwise use local implementation
function setupApplyButtonHandler() {
    // If unified handler exists, use it
    if (typeof window.handleApplyButtonClick === 'function') {
        document.addEventListener('click', function(e) {
            const applyBtn = e.target.closest('#apply-button-ajax');
            if (applyBtn && !applyBtn.disabled) {
                window.handleApplyButtonClick(e, applyBtn);
            }
        });
        return;
    }
    
    // Fallback: local implementation
    const applyBtn = document.getElementById('apply-button-ajax');
    if (applyBtn && !applyBtn.hasAttribute('data-handler-attached')) {
        applyBtn.setAttribute('data-handler-attached', 'true');
        applyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const jobId = applyBtn.getAttribute('data-job-id');
            if (!jobId) {
                if (typeof showToast === 'function') {
                    showToast('error', 'Job ID is missing');
                } else {
                    alert('Job ID is missing');
                }
                return;
            }
            
            if (confirm('Are you sure you want to apply for this job?')) {
                applyBtn.disabled = true;
                const originalText = applyBtn.textContent || applyBtn.innerHTML;
                applyBtn.textContent = 'Applying...';
                
                // Use the provider jobs apply route with AJAX flag
                const applyUrl = `/provider/jobs/apply/${jobId}?redirect_route=app_provider_jobs_applications&ajax=1`;
                
                fetch(applyUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    redirect: 'follow'
                })
                .then(response => {
                    // Check if response is JSON
                    const contentType = response.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        return response.json();
                    }
                    // If redirected or HTML response, treat as success
                    if (response.redirected || response.ok) {
                        return { status: 'success', message: 'Job applied successfully' };
                    }
                    throw new Error('Failed to apply for job');
                })
                .then(data => {
                    if (data.status === 'success') {
                        // Success - show message
                        if (typeof showToast === 'function') {
                            showToast('success', data.message || 'Applied for job successfully!');
                        } else {
                            alert(data.message || 'Applied for job successfully!');
                        }
                        
                        // Update button state
                        applyBtn.disabled = true;
                        applyBtn.textContent = 'Already Applied';
                        applyBtn.style.background = '#6b7280';
                        applyBtn.style.cursor = 'not-allowed';
                        
                        // Redirect to applications page with applied filter
                        setTimeout(() => {
                            window.location.href = '/provider/applications?status=applied';
                        }, 1000);
                    } else {
                        throw new Error(data.message || 'Failed to apply for job');
                    }
                })
                .catch(error => {
                    console.error('Apply error:', error);
                    applyBtn.disabled = false;
                    applyBtn.textContent = originalText || 'Apply';
                    if (typeof showToast === 'function') {
                        showToast('error', error.message || 'Failed to apply for job. Please try again.');
                    } else {
                        alert(error.message || 'Failed to apply for job. Please try again.');
                    }
                });
            }
        });
    }
}

// Also setup handler using event delegation for dynamically loaded content
document.addEventListener('click', function(e) {
    const applyBtn = e.target.closest('#apply-button-ajax');
    if (applyBtn && !applyBtn.hasAttribute('data-handler-attached')) {
        setupApplyButtonHandler();
        // Trigger click again after handler is attached
        if (applyBtn === e.target || applyBtn.contains(e.target)) {
            applyBtn.click();
        }
    }
}, true);
</script>
