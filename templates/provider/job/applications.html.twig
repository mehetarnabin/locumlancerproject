                    <path d="M3 6H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M3 11H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M3 16H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                List View
            `;
            if (actionsContainer) {
                actionsContainer.classList.add('scrollable');
            }
            // Auto-select the checked job or first job card
            setTimeout(function() {
                const checkedInList = listViewContainer.querySelector('.job-checkbox:checked');
                let cardToSelect = null;
                
                if (checkedInList) {
                    const jobId = checkedInList.dataset.jobId || checkedInList.dataset.applicationId;
                    if (jobId && splitJobList) {
                        cardToSelect = splitJobList.querySelector(`.split-job-card[data-job-id="${jobId}"]`);
                    }
                }
                
                if (!cardToSelect && splitJobList) {
                    cardToSelect = splitJobList.querySelector('.split-job-card');
                }

                if (cardToSelect && typeof window.selectJobCard === 'function') {
                    window.selectJobCard(cardToSelect);
                } else {
                    selectedJobId = null;
                    window.selectedJobId = null;
                }
            }, 200);
        }
    });
  }
  
  // Job card selection
  if (splitJobList) {
      splitJobList.addEventListener('click', function (e) {
          // Only trigger if clicking on the job title specifically
          const jobTitle = e.target.closest('.split-job-card-title');
          if (!jobTitle) {
              return; // Not clicking on title, ignore
          }
          
          const jobCard = e.target.closest('.split-job-card');
          if (jobCard && !e.target.classList.contains('job-checkbox')) {
              if (typeof window.selectJobCard === 'function') {
                  window.selectJobCard(jobCard);
              }
          }
      });
  }
  
  // Function to open split view and select a job
  window.openSplitViewAndSelectJob = function(jobId, applicationId = null) {
      const splitViewContainer = document.getElementById('split-view-container');
      const listViewContainer = document.querySelector('.job-list-container');
      const gridViewBtn = document.getElementById('grid-view-btn');
      const splitJobList = document.getElementById('split-job-list');
      
      if (!splitViewContainer || !listViewContainer) {
          console.error('Split view or list view container not found', { splitViewContainer, listViewContainer });
          return;
      }
      
      const isSplitViewOpen = splitViewContainer.style.display === 'grid';
      
      // If split view is already open, just select the job
      if (isSplitViewOpen && splitJobList) {
          // Try to find the card with retry logic
          const findAndSelectCard = (retries = 3) => {
          let cardToSelect = null;
          if (applicationId) {
              cardToSelect = splitJobList.querySelector(`.split-job-card[data-application-id="${applicationId}"]`);
          }
          if (!cardToSelect) {
              cardToSelect = splitJobList.querySelector(`.split-job-card[data-job-id="${jobId}"]`);
          }
              
              // If not found, try finding by string comparison (in case of UUID formatting issues)
              if (!cardToSelect) {
                  const allCards = splitJobList.querySelectorAll('.split-job-card');
                  for (let card of allCards) {
                      const cardJobId = card.getAttribute('data-job-id');
                      const cardApplicationId = card.getAttribute('data-application-id');
                      if (applicationId && cardApplicationId && (cardApplicationId === applicationId || cardApplicationId.toString() === applicationId.toString())) {
                          cardToSelect = card;
                          break;
                      }
                      if (cardJobId && (cardJobId === jobId || cardJobId.toString() === jobId.toString())) {
                          cardToSelect = card;
                          break;
                      }
                  }
              }
              
          if (cardToSelect && typeof window.selectJobCard === 'function') {
                  // Scroll card into view
                  cardToSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
              window.selectJobCard(cardToSelect);
                  return true;
              } else if (retries > 0) {
                  // Retry after a short delay
                  setTimeout(() => findAndSelectCard(retries - 1), 100);
                  return false;
          }
              return false;
          };
          
          findAndSelectCard();
          return;
      }
      
      // Check if filters are active - if so, reload page without filters to show unfiltered split view
      const urlParams = new URLSearchParams(window.location.search);
      const hasFilters = urlParams.has('location') || urlParams.has('salaryMin') || urlParams.has('salaryMax') || urlParams.has('days');
      const filtersActive = sessionStorage.getItem('filtersActive') === 'true' || hasFilters;
      
      if (filtersActive) {
          // Reload page without filter parameters to show unfiltered split view
          const currentUrl = window.location.pathname;
          const newParams = new URLSearchParams();
          const status = urlParams.get('status');
          if (status) {
              newParams.append('status', status);
          }
          const newUrl = newParams.toString() ? `${currentUrl}?${newParams.toString()}` : currentUrl;
          // Add jobId to URL so we can select it after reload
          const finalUrl = newUrl + (newUrl.includes('?') ? '&' : '?') + 'selectJob=' + jobId;
          window.location.href = finalUrl;
          return;
      }
      
      // Switch to split view
      splitViewContainer.style.display = 'grid';
      listViewContainer.style.display = 'none';
      
      if (gridViewBtn) {
          gridViewBtn.classList.add('active');
          gridViewBtn.innerHTML = `
              <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M3 11H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M3 16H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              List View
          `;
      }
      
      // Disable sticky in split view
      const stickyContainer = document.querySelector('.sticky-header-container');
      if (stickyContainer) {
          stickyContainer.style.position = 'relative';
          stickyContainer.style.top = 'auto';
      }
      
      // Hide table header in split view
      const tableHeaderWrappers = document.querySelectorAll('.table-responsive-wrapper');
      tableHeaderWrappers.forEach(wrapper => {
          const hasJobHeader = wrapper.querySelector('.job-header');
          if (hasJobHeader) {
              wrapper.style.display = 'none';
          }
      });
      const allJobHeaders = document.querySelectorAll('.job-header');
      allJobHeaders.forEach(header => {
          header.style.display = 'none';
      });
      
      const actionsContainer = document.querySelector('.actions-container');
      if (actionsContainer) {
          actionsContainer.classList.add('scrollable');
      }
      
      // Select the job with retry logic to ensure DOM is ready
      const findAndSelectCard = (retries = 5) => {
          if (!splitJobList) {
              if (retries > 0) {
                  setTimeout(() => findAndSelectCard(retries - 1), 100);
              }
              return;
          }
          
          let cardToSelect = null;
          if (applicationId) {
              cardToSelect = splitJobList.querySelector(`.split-job-card[data-application-id="${applicationId}"]`);
          }
          if (!cardToSelect) {
              cardToSelect = splitJobList.querySelector(`.split-job-card[data-job-id="${jobId}"]`);
          }
          
          // If not found, try finding by string comparison (in case of UUID formatting issues)
          if (!cardToSelect) {
              const allCards = splitJobList.querySelectorAll('.split-job-card');
              for (let card of allCards) {
                  const cardJobId = card.getAttribute('data-job-id');
                  const cardApplicationId = card.getAttribute('data-application-id');
                  if (applicationId && cardApplicationId && (cardApplicationId === applicationId || cardApplicationId.toString() === applicationId.toString())) {
                      cardToSelect = card;
                      break;
                  }
                  if (cardJobId && (cardJobId === jobId || cardJobId.toString() === jobId.toString())) {
                      cardToSelect = card;
                      break;
                  }
              }
          }
          
          if (cardToSelect && typeof window.selectJobCard === 'function') {
              // Scroll card into view
              setTimeout(() => {
                  cardToSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }, 50);
              window.selectJobCard(cardToSelect);
          } else if (retries > 0) {
              // Retry after a short delay
              setTimeout(() => findAndSelectCard(retries - 1), 150);
          }
      };
      
      // Start trying to find and select the card
      setTimeout(() => findAndSelectCard(), 100);
  };
  
  // Allow normal navigation for job links - removed split view interception
  // Job links will now navigate normally to the detail page
  // If split view is needed in the future, it can be added as an optional feature
  
  window.selectJobCard = function(jobCard) {
      const jobId = jobCard.dataset.jobId;
      const applicationId = jobCard.dataset.applicationId;
      
      // Check if this job is already selected - if so, just keep it selected (no redirect)
      if (jobCard.classList.contains('active') && window.selectedJobId === jobId) {
          // Job is already selected - do nothing, keep it in split view
          return;
      }
      
      // Remove active class from all cards
      document.querySelectorAll('.split-job-card').forEach(card => {
          card.classList.remove('active');
      });
      
      // Add active class to selected card
      jobCard.classList.add('active');
      
      // Check the checkbox for the selected job - change event will handle unchecking others
      const checkbox = jobCard.querySelector('.job-checkbox');
      if (checkbox) {
          checkbox.checked = true;
          // Trigger change event to update button states and uncheck others
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }
      
      // Get job ID and load details
      selectedJobId = jobId;
      window.selectedJobId = selectedJobId;
      if (applicationId) {
          window.selectedApplicationId = applicationId;
      }
      if (typeof window.renderJobDetails === 'function') {
          window.renderJobDetails(selectedJobId, applicationId);
      } else if (typeof loadJobDetails === 'function') {
          loadJobDetails(selectedJobId);
      }
  }

  window.renderJobDetails = function(jobId, applicationId = null) {
    console.log('Loading job details for ID:', jobId, 'Application ID:', applicationId);
    
    // Use the jobDetailContent and noJobSelected from outer scope
    
    // Show detail action buttons container
    const detailActionButtons = document.getElementById('detail-action-buttons');
    if (detailActionButtons) {
        detailActionButtons.style.display = 'flex';
    }
    
    // Show timeline, view details, and note buttons in split view
    const detailTimelineBtn = document.getElementById('detail-timeline-btn');
    if (detailTimelineBtn) {
        detailTimelineBtn.style.display = 'flex';
        detailTimelineBtn.style.alignItems = 'center';
    }
    const detailViewDetailsBtn = document.getElementById('detail-view-details-btn');
    if (detailViewDetailsBtn) {
        detailViewDetailsBtn.style.display = 'flex';
        detailViewDetailsBtn.style.alignItems = 'center';
    }
    if (detailNoteBtn) {
        detailNoteBtn.style.display = 'flex';
        detailNoteBtn.style.alignItems = 'center';
    }
    
    // Show loading state
    jobDetailContent.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h5 class="text-muted">Loading Job Details</h5>
        </div>
    `;
    
    // For applications, use the application detail content endpoint
    const url = applicationId 
        ? `/provider/jobs/application/${applicationId}/detail-content`
        : `/provider/jobs/${jobId}/detail-content`;
    
    fetch(url, {
        headers: {
            'Accept': 'text/html',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    // If response contains HTML error, extract it
                    if (text.includes('alert alert-danger')) {
                        throw new Error(text);
                    }
                    throw new Error(`HTTP error! status: ${response.status}. ${text.substring(0, 200)}`);
                });
            }
            return response.text();
        })
        .then(html => {
            // Check if the response is an error message
            if (html.includes('alert alert-danger') || html.includes('Error')) {
                jobDetailContent.innerHTML = html;
            } else {
                jobDetailContent.innerHTML = html;
            }
            jobDetailContent.style.display = 'block';
            if (noJobSelected) noJobSelected.style.display = 'none';
            if (detailNoteBtn) { 
                detailNoteBtn.style.display = 'flex';
                detailNoteBtn.style.alignItems = 'center';
            }
            // Show detail action buttons container
            const detailActionButtons = document.getElementById('detail-action-buttons');
            if (detailActionButtons) {
                detailActionButtons.style.display = 'flex';
            }
            
            const detailTimelineBtn = document.getElementById('detail-timeline-btn');
            if (detailTimelineBtn) { 
                detailTimelineBtn.style.display = 'flex';
                detailTimelineBtn.style.alignItems = 'center';
            }
            const detailViewDetailsBtn = document.getElementById('detail-view-details-btn');
            if (detailViewDetailsBtn) { 
                detailViewDetailsBtn.style.display = 'flex';
                detailViewDetailsBtn.style.alignItems = 'center';
            }
            // Update toggle button position after content loads
            setTimeout(() => {
                if (typeof updateToggleButtonPosition === 'function') {
                    updateToggleButtonPosition();
                }
            }, 100);
            
            // Setup apply button handler for AJAX-loaded content
            setupApplyButtonHandler();
        })
        .catch(error => {
            console.error('Full error:', error);
            jobDetailContent.innerHTML = `
                <div class="alert alert-danger">
                    <h4>Error Loading Job Details</h4>
                    <div>${error.message || 'HTTP error! status: 500'}</div>
                    <div class="mt-3">
                        <button class="action-btn" onclick="window.renderJobDetails('${jobId}', ${applicationId ? "'" + applicationId + "'" : 'null'})">Try Again</button>
                        <a href="/provider/jobs/${jobId}" class="action-btn">View Full Page</a>
                    </div>
                </div>
            `;
            jobDetailContent.style.display = 'block';
            if (noJobSelected) noJobSelected.style.display = 'none';
        });
  }

  window.loadJobDetails = function(jobId) {
      renderJobDetails(jobId);
  };

  // Timeline Panel Functions
  window.openTimelinePanel = function(jobId) {
      const timelinePanel = document.getElementById('timeline-panel');
      const timelineContent = document.getElementById('timeline-content');
      const jobDetails = document.getElementById('split-job-details');
      
      if (!timelinePanel || !timelineContent) return;
      
      // Close notes panel if open
      const notesPanel = document.getElementById('notes-panel');
      if (notesPanel && notesPanel.classList.contains('open')) {
          notesPanel.classList.remove('open');
          notesPanel.setAttribute('aria-hidden', 'true');
          if (jobDetails) {
              jobDetails.classList.remove('notes-open');
          }
      }
      
      // Collapse the left list first (default behavior for timeline panel)
      if (typeof window.collapseList === 'function') {
          window.collapseList();
      }
      
      // Show loading state
      timelineContent.innerHTML = `
          <div class="text-center py-4">
              <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2 text-muted">Loading timeline...</p>
          </div>
      `;
      
      // Wait a bit for collapse animation, then open panel
      setTimeout(() => {
          // Open the panel
          timelinePanel.classList.add('open');
          timelinePanel.setAttribute('aria-hidden', 'false');
          
          // Add timeline-open class to job details to shrink it
          if (jobDetails) {
              jobDetails.classList.add('timeline-open');
              // Prevent any scrolling - panel is positioned absolutely so no scroll needed
              jobDetails.scrollLeft = 0;
              jobDetails.scrollTop = 0;
              
              // Force hide scrollbars
              jobDetails.style.overflowY = 'hidden';
              jobDetails.style.overflowX = 'visible';
              
              // Hide scrollbars on job list as well
              const jobList = document.getElementById('split-job-list');
              if (jobList) {
                  jobList.style.overflowY = 'hidden';
                  jobList.style.overflowX = 'hidden';
              }
              
              // Ensure panel is visible by checking container overflow
              const container = jobDetails.closest('.split-view-container');
              if (container) {
                  container.style.overflowX = 'visible';
                  container.style.overflowY = 'hidden';
              }
          }
      }, 100);
      
      // Fetch job timeline data from API
      fetch(`/provider/jobs/${jobId}/timeline-data`)
          .then(response => response.json())
          .then(data => {
              // Build interview section HTML
              let interviewsHTML = '';
              if (data.interviews && data.interviews.length > 0) {
                  interviewsHTML = data.interviews.map(interview => `
                      <div class="timeline-detail-item">
                          <span class="timeline-detail-label">${interview.type}:</span>
                          <span class="timeline-detail-value">${interview.date} at ${interview.time}</span>
                      </div>
                      ${interview.platform ? `
                      <div class="timeline-detail-item">
                          <span class="timeline-detail-label">Platform:</span>
                          <span class="timeline-detail-value">${interview.platform}</span>
                      </div>
                      ` : ''}
                      ${interview.meetingUrl ? `
                      <div class="timeline-detail-item">
                          <span class="timeline-detail-label">Meeting Link:</span>
                          <span class="timeline-detail-value">
                              <a href="${interview.meetingUrl}" target="_blank" class="text-primary">Join Meeting</a>
                          </span>
                      </div>
                      ` : ''}
                  `).join('');
              } else {
                  interviewsHTML = '<p class="timeline-event-description text-muted">No interviews scheduled yet.</p>';
              }
              
              // Determine current status and progress stages
              const statusLower = (data.applicationStatus || '').toLowerCase().replace(/\s+/g, '').replace(/_/g, '');
              const stages = [
                  { name: 'Applied', key: 'applied' },
                  { name: 'Interview', key: 'interview' },
                  { name: 'Negotiating', key: 'negotiating' },
                  { name: 'Accepted', key: 'accepted' },
                  { name: 'Completed', key: 'completed' }
              ];
              
              // Determine which stage we're at
              let currentStageIndex = -1;
              if (statusLower === 'notapplied' || !data.applicationStatus) {
                  currentStageIndex = -1;
              } else if (statusLower.includes('applied')) {
                  currentStageIndex = 0;
              } else if (statusLower.includes('interview') || statusLower.includes('shortlisted') || statusLower.includes('inreview')) {
                  currentStageIndex = 1;
              } else if (statusLower.includes('negotiating') || statusLower.includes('offered')) {
                  currentStageIndex = 2;
              } else if (statusLower.includes('accepted') || statusLower.includes('hired')) {
                  currentStageIndex = 3;
              } else if (statusLower.includes('completed')) {
                  currentStageIndex = 4;
              }
              
              // Build progress stages HTML
              const progressHTML = stages.map((stage, index) => {
                  const isActive = index === currentStageIndex;
                  const isCompleted = index < currentStageIndex;
                  return `
                      <div class="progress-stage-item" style="
                          background: ${isCompleted ? '#e8f5e9' : '#fff'};
                          border: 1px dashed ${isCompleted ? '#85BB65' : '#e6eef6'};
