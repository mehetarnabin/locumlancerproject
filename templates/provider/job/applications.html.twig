             // Hide default buttons
             provideBtn.classList.add('d-none');
             actionBtn.classList.add('d-none');
             if(viewDocsBtn) viewDocsBtn.classList.remove('d-none');

             // Fetch details
             var reqUrl = "{{ path('app_provider_application_interview_details', {'id': '00000000-0000-0000-0000-000000000000'}) }}".replace('00000000-0000-0000-0000-000000000000', appId);
             
             fetch(reqUrl)
                .then(function(r){ return r.json(); })
                .then(function(data){
                    listEl.innerHTML = '';
                     if(data.success && data.interviews && data.interviews.length > 0) {
