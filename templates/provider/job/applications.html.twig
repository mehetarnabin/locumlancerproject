                        <div class="col-start col-center col-todo sortable" data-sort="todo" style="width: 80px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">To Do<span class="sort-toggle"><svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                        <div class="col-start col-center col-rank sortable" data-sort="rank" style="width: 100px; min-width: 100px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 0 8px; box-sizing: border-box; cursor: pointer; overflow: visible; position: relative;">Score<span class="sort-toggle"><svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                        <div class="col-start col-center col-status sortable" data-sort="status" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; cursor: pointer;">Status<span class="sort-toggle"><svg class="arrow sort-up" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="arrow sort-down" width="12" height="12" viewBox="0 0 24 24" fill="none" style="transform: rotate(180deg);"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        </div>
        {% if applications|length > 0 %}
        <div class="job-list-container bg-light rounded-3" style="padding: 0 1rem 1rem 1rem; padding-right: 1rem !important; margin-top: 0;">
        <div class="table-responsive-wrapper" style="overflow-x: auto; width: 100%; padding-top: 0;">
        {% for application in applications %}
            {% set job = application.job %}
              <div class="d-flex align-items-center job-lists">
                <div class="job-row d-flex align-items-center flex-grow-1" style="gap: 0; min-width: 0; width: 100%; box-sizing: border-box !important;">
                  <div class="col-check" style="width: 30px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center;">
                      <input type="checkbox" class="job-check job-checkbox" data-job-id="{{ job.id }}" data-application-id="{{ application.id }}" data-status="{{ application.status }}" />
                  </div>
                  <div class="col-job d-flex align-items-center gap-2" data-column="job" style="width: 200px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; min-width: 0; overflow: hidden;">
                      <img src="{{ job.companyLogo|default(asset('assets/icons/job.png')) }}"
                          alt="Logo"
                          style="width: 24px; height: 24px; border-radius: 6px; flex-shrink: 0; object-fit: cover;"
                          onerror="this.src='{{ asset('assets/icons/job.png') }}'" />
                      <div style="min-width: 0; overflow: hidden;">
                          <a class="job-title truncate-text d-block fw-semibold text-decoration-none"
                            href="{{ path('app_provider_jobs_application_detail', {'id': application.id}) }}"
                            style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;">
                              {{ job.title }}
                          </a>
                      </div>
                  </div>
                  <div class="col-start col-center col-location" data-column="location" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ job.state }}</div>
                  <div class="col-start col-center col-salary" data-column="salary" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ job.formattedSalary }}</div>
                  <div class="col-start col-center col-employer" data-column="employer" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ job.employer|default(job.companyName|default('—')) }}</div>
                  <div class="col-start col-center col-applied" data-column="applied" style="width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px;">{{ application.createdAt|date('m/d/Y') }}</div>
                  <div class="col-start col-center col-category" data-column="category" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #121C0C;">
                    {% if job.workType == 'locums' %}
                        Locums
                    {% elseif job.workType == 'parttime' or job.workType == 'part-time' %}
                        Parttime
                    {% elseif job.workType == 'fulltime' or job.workType == 'full-time' %}
                        Full time
                    {% else %}
                        {{ job.workType|default('—')|replace({'_': ' '})|title }}
                    {% endif %}
                  </div>
                  <div class="col-start col-center col-todo" data-column="todo" style="width: 80px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: visible; position: relative;">
                      {% set todoTasks = [] %}
                      {% set pendingDocs = false %}
                      {% set pendingDocNames = [] %}
                      {% for dr in application.documentRequests %}
                          {% if not dr.providedAt %}
                              {% set pendingDocs = true %}
                              {% set pendingDocNames = pendingDocNames|merge([dr.name]) %}
                          {% endif %}
                      {% endfor %}

                      {# Check for pending documents - always show if there are pending docs #}
                      {% set hasNewRequests = application.documentRequests|length > 0 %}
                      {% if hasNewRequests and pendingDocs %}
                          {% set todoTasks = todoTasks|merge([{
                              'action': 'Provide requested documents',
                              'display': 'Provide: ' ~ pendingDocNames|join(', '),
                              'type': 'documents',
                              'icon': 'documents'
                          }]) %}
                      {% elseif not hasNewRequests and application.documentRequestedAt and not application.documentProvidedAt %}
                          {% set todoTasks = todoTasks|merge([{
                              'action': 'Provide requested documents',
                              'display': 'Provide requested documents',
                              'type': 'documents',
                              'icon': 'documents'
                          }]) %}
                      {% endif %}

                      {# Status-based TODOs - Only showing if no blocking tasks (like docs) #}
                      {% if todoTasks|length == 0 %}
                      {% if application.status == 'applied' %}
                          {% set todoTasks = todoTasks|merge([{
                              'action': 'Open Response from Employer',
                              'display': 'Open Response from Employer',
                              'type': 'status',
                              'icon': 'response'
                          }]) %}
                      {% elseif application.status == 'saved' %}
                           {% set todoTasks = todoTasks|merge([{
                              'action': 'Revisit Alert/Review Job Details',
                              'display': 'Revisit Alert/Review Job Details',
                              'type': 'status',
                              'icon': 'alert'
                          }]) %}
                      {% elseif application.status == 'in_review' or application.status == 'shortlisted' %}
                          {% set todoTasks = todoTasks|merge([{
                              'action': 'Open Response',
                              'display': 'Open Response',
                              'type': 'status',
                              'icon': 'response'
                          }]) %}
                      {% if application.interviews|length > 0 %}
                          {% set interviewData = [] %}
                          {% for iv in application.interviews %}
                              {% set interviewData = interviewData|merge([{
                                  'date': iv.date ? iv.date|date('M d, Y h:i A') : 'TBD',
                                  'end_date': iv.endDate ? iv.endDate|date('M d, Y h:i A') : null,
                                  'url': iv.meetingUrl,
                                  'platform': iv.meetingPlatform
                              }]) %}
                          {% endfor %}
                          {% set todoTasks = todoTasks|merge([{
                              'action': 'Interview Details',
                              'display': 'Interview Details',
                              'type': 'interview',
                              'icon': 'interview',
                              'interviews': interviewData
                          }]) %}
                      {% endif %}
                      {% elseif application.status in ['interview','interviewing'] %}
                          {% if application.interview %}
                              {# Confirmed Interview #}
                              {% set iv = application.interview %}
                              {% set interviewData = [{
                                  'date': iv.date ? iv.date|date('M d, Y h:i A') : 'TBD',
                                  'url': iv.meetingUrl,
                                  'platform': iv.meetingPlatform
                              }] %}
                              {% set todoTasks = todoTasks|merge([{
                                  'action': 'Interview Details',
                                  'display': 'Interview Details',
                                  'type': 'interview',
                                  'icon': 'interview',
                                  'interviews': interviewData,
                                  'date': iv.date ? iv.date|date('M d, Y h:i A') : 'TBD',
                                  'url': iv.meetingUrl,
                                  'platform': iv.meetingPlatform
                              }]) %}
                          {% else %}
                              {# Interview Request #}
                              {% set interviewData = [] %}
                              {% for iv in application.interviews %}
                                  {% set interviewData = interviewData|merge([{
                                      'date': iv.date ? iv.date|date('M d, Y h:i A') : 'TBD',
                                      'url': iv.meetingUrl,
                                      'platform': iv.meetingPlatform
                                  }]) %}
                              {% endfor %}
                              {% set todoTasks = todoTasks|merge([{
                                  'action': 'Confirm interview',
                                  'display': 'Confirm interview from the list of interview dates',
                                  'type': 'interview_request',
                                  'icon': 'interview',
                                  'interviews': interviewData
                              }]) %}
                          {% endif %}
                      {% elseif application.status == 'negotiating' %}
                          {% if application.contractSentAt and not application.contractSignedAt %}
                              {% set todoTasks = todoTasks|merge([{
                                  'action': 'Sign offer',
                                  'display': 'Sign offer',
                                  'type': 'contract',
                                  'icon': 'contract'
                              }]) %}
                          {% else %}
                              {% set todoTasks = todoTasks|merge([{
                                  'action': 'Sign offer',
                                  'display': 'Sign offer',
                                  'type': 'contract',
                                  'icon': 'contract'
                              }]) %}
                          {% endif %}
                      {% elseif application.status == 'accepted' or application.status == 'hired' %}
                          {% if pendingDocs %}
                              {% set todoTasks = todoTasks|merge([{
                                      'action': 'Open Credentialing Docs',
                                      'display': 'Open Credentialing Docs',
                                      'type': 'credentialing',
                                      'icon': 'credentialing'
                                  }]) %}
                          {% endif %}
                      {% endif %}
                      
                      {# Legacy contract check (if not already added) #}
                      {% if application.contractSentAt and not application.contractSignedAt %}
                          {% set hasContractTodo = false %}
                          {% for task in todoTasks %}
                              {% if task.action == 'Sign offer' %}
                                  {% set hasContractTodo = true %}
                              {% endif %}
                          {% endfor %}
                          {% if not hasContractTodo %}
                              {% set todoTasks = todoTasks|merge([{
                                  'action': 'Sign and return contract',
                                  'display': 'Sign and return contract',
                                  'type': 'contract',
                                  'icon': 'contract'
                              }]) %}
                          {% endif %}
                      {% endif %}
                      {% endif %}
                      
                      {% if todoTasks|length > 0 %}
                          <div class="todo-icons-container">
                              {% for task in todoTasks %}
                                  <div class="todo-icon-wrapper" data-bs-toggle="tooltip" title="{{ task.display }}">
                                      <div class="todo-icon" 
                                           onclick="return handleTodoIconClick(event, this);"
                                           style="cursor: pointer;"
                                           data-doc-pending="{{ pendingDocNames|join(', ') }}"
                                           data-doc-status="{{ task.display }}"
                                           data-todo-action="{{ task.action }}" 
                                           data-todo-type="{{ task.type }}" 
                                           data-todo-icon-type="{{ task.icon }}"
                                           data-application-id="{{ application.id }}" 
                                           data-status="{{ application.status }}"
                                           data-interviews="{{ task.interviews|default([])|json_encode|e('html_attr') }}"
                                           data-interview-date="{{ task.date|default('') }}"
                                           data-interview-url="{{ task.url|default('') }}"
                                           data-interview-platform="{{ task.platform|default('') }}">
                                          {% if task.icon == 'alert' %}
                                              {# Bell icon for Revisit Alert #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                              </svg>
                                          {% elseif task.icon == 'response' %}
                                              {# Envelope icon for Open Response #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                              </svg>
                                          {% elseif task.icon == 'interview' %}
                                              {# Calendar icon for Confirm interview #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                              </svg>
                                          {% elseif task.icon == 'contract' %}
                                              {# Document/File icon for Review contract #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                  <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                              </svg>
                                          {% elseif task.icon == 'credentialing' %}
                                              {# Shield/Check icon for Credentialing Docs #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                  <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                              </svg>
                                          {% elseif task.icon == 'review' %}
                                              {# Star icon for See your review #}
                                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                              </svg>
                                          {% else %}
                                              {# Default document icon - match _application_list.html.twig #}
                                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M4 6C4 5.44772 4.44772 5 5 5H9.58579C9.851 5 10.1054 5.10536 10.2929 5.29289L12 7H19C19.5523 7 20 7.44772 20 8V18C20 18.5523 19.5523 19 19 19H5C4.44772 19 4 18.5523 4 18V6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                      <path d="M4 8H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                      <path d="M16 12L18 14L21 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                          {% endif %}
                              </div>
                                  </div>
                              {% endfor %}
                          </div>
                      {% else %}
                          -
                      {% endif %}
                  </div>
                  <div class="col-start col-center col-rank" data-column="rank" style="width: 100px; min-width: 100px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: visible; position: relative;">
                      <span class="rank-display" data-application-id="{{ application.id }}" style="font-size: 12px;">
                        {{ application.rank is not null ? application.rank : '—' }}
                      </span>
                      <div class="rank-input-wrapper hidden">
                      <input type="number"
                              class="rank-input"
                            value="{{ application.rank is not null ? application.rank : '' }}"
                            min="1"
                            max="10"
                            step="0.5"
                            data-application-id="{{ application.id }}"
                            data-original-value="{{ application.rank is not null ? application.rank : '' }}"
                            oninput="if(this.value>10) this.value=10; if(this.value<1)this.value=1;" />
                      </div>
                    </div>
                  <div class="col-start col-center col-status" data-column="status" style="width: 120px; flex-shrink: 0; padding: 0 8px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; color: #000; font-size: 12px;">
                      {{ application.status | replace({'_': ' '}) | title }}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
            </div>
        </div>
        {% else %}
            <div style="display: flex; justify-content: center; align-items: center; min-height: 400px; padding: 40px;">
                <p style="font-size: 18px; color: #666; text-align: center;">Applications not found.</p>
            </div>
        {% endif %}

        <!-- Split View Container -->
        <div class="split-view-container" id="split-view-container">
            <button class="list-toggle-btn" id="list-toggle-btn" style="display: none;" title="Toggle job list">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <!-- Left Side: Job List -->
            <div class="split-job-list" id="split-job-list">
                {% if applications|length > 0 %}
                    {% for application in applications %}
                        {% set job = application.job %}
                        <div class="split-job-card" data-job-id="{{ job.id }}" data-application-id="{{ application.id }}">
                            <div class="split-job-card-header">
                                <input type="checkbox" class="job-checkbox" data-job-id="{{ job.id }}" data-application-id="{{ application.id }}" data-status="{{ application.status }}" style="margin-top: 2px;">
                                <img src="{{ job.companyLogo|default(asset('assets/icons/job.png')) }}" 
                                    alt="Logo" class="split-job-card-logo"
                                    onerror="this.src='{{ asset('assets/icons/job.png') }}'">
                                <div class="flex-grow-1">
                                    <div class="split-job-card-title">{{ job.title }}</div>
                                    <div class="split-job-card-company">{{ job.companyName|default('Company') }}</div>
                                </div>
                            </div>
                            <div class="split-job-summary">
                                <div class="split-job-summary-item">
                                    <span class="split-job-meta-label">Status:</span>
                                    <span class="split-job-meta-value">{{ application.status | replace({'_': ' '}) | title }}</span>
                                </div>
                                <div class="split-job-summary-item">
                                    <span class="split-job-meta-label">Score:</span>
                                    <span class="split-job-meta-value">{{ application.rank is not null ? application.rank : '—' }}</span>
                                </div>
                                {% if application.status == 'completed' %}
                                    {% set reviewExists = false %}
                                    {% for review in application.reviews %}
                                        {% if review.reviewedBy == 'PROVIDER' %}
                                            {% set reviewExists = true %}
                                        {% endif %}
                                    {% endfor %}

                                    {% if not reviewExists %}
                                        <div class="split-job-summary-item" style="color: #d32f2f;">
                                            <span class="split-job-meta-label">Action:</span>
                                            <span class="split-job-meta-value">Write a review</span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                                {% if application.interviews|length > 0 %}
                                <div class="split-job-summary-item" style="display: block; margin-top: 8px; border-top: 1px solid #f3f4f6; padding-top: 8px;">
                                    <div class="split-job-meta-label" style="width: 100%; margin-bottom: 4px;">Scheduled Interview(s):</div>
                                    {% for interview in application.interviews %}
                                        <div style="margin-bottom: 8px; font-size: 13px; background: #f9fafb; padding: 6px; border-radius: 6px;">
                                            <div style="display: flex; justify-content: space-between; font-weight: 500;">
                                                <span>{{ interview.date|date('M d, Y') }}</span>
                                                <span>{{ interview.date|date('h:i A') }}</span>
                                            </div>
                                            {% if interview.meetingPlatform %}
                                                <div style="color: #4b5563; font-size: 12px;">Via {{ interview.meetingPlatform }}</div>
                                            {% endif %}
                                            {% if interview.meetingUrl %}
                                                <div style="margin-top: 2px;"><a href="{{ interview.meetingUrl }}" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: 500;">Join Meeting</a></div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
            
            <!-- Right Side: Job Details -->
            <div class="split-job-details" id="split-job-details">
                <div style="position: absolute; top: 10px; right: 10px; display: none; flex-direction: row; gap: 10px; align-items: center; justify-content: flex-end;" id="detail-action-buttons" class="detail-action-buttons">
                <button id="detail-timeline-btn" class="action-btn" title="Timeline" style="display: flex; cursor: pointer; padding: 6px 12px; border-radius: 6px; border: 1px solid #e6eef6; background: #fff; align-items: center; gap: 6px; font-size: 13px; color: #000000 !important; transition: all 0.2s ease; white-space: nowrap; font-weight: 500;">
                  <svg class="icon-image" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M16 2V6M8 2V6M3 10H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8 14H8.01M12 14H12.01M16 14H16.01M8 18H8.01M12 18H12.01M16 18H16.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span style="color: #000000 !important;">Timeline</span>
                </button>
                <button id="detail-view-details-btn" class="action-btn" title="View Details" style="display: flex; cursor: pointer; padding: 6px 12px; border-radius: 6px; border: 1px solid #e6eef6; background: #fff; align-items: center; gap: 6px; font-size: 13px; color: #000000 !important; transition: all 0.2s ease; white-space: nowrap; font-weight: 500;">
                  <svg class="icon-image" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
