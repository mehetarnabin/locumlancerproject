    }

    // Handle Print/Share button click
    const printShareBtn = document.getElementById('print-share-job-btn');
    if (printShareBtn) {
        printShareBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            // Get the selected job ID from multiple sources
            let selectedJobId = window.selectedJobId || null;
            
            // If not found, try to find from active split job card
            if (!selectedJobId) {
                const activeCard = document.querySelector('.split-job-card.active');
                if (activeCard) {
                    selectedJobId = activeCard.getAttribute('data-job-id');
