                            const appId = window.todoPopup.dataset.applicationId;
                            const appStatus = window.todoPopup.dataset.status;
                            
                            if (appId) {
                                // For now, just close the popup
                                // In the future, this could mark the TODO as completed in the database
                                window.todoPopup.classList.remove('show');
                                
                                // Show a success message
