{% if cvDocuments is not empty %}
<div class="d-flex flex-column gap-2" style="margin-top: 12px; overflow: hidden;">
    {% for cv in cvDocuments %}
    <div class="p-2 rounded-2 border d-flex align-items-center justify-content-between bg-white hover-shadow transition-all" style="border-color: #e5e7eb !important; min-width: 0; overflow: hidden;">
        <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 0; overflow: hidden;">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background-color: #F4F9F1; color: #000000;">
                <i class="fa fa-file-pdf" style="color: #000000; font-size: 14px;"></i>
            </div>
            <div class="flex-grow-1" style="min-width: 0; overflow: hidden;">
                <div class="fw-medium" style="font-size: 0.875rem; color: #000000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3;">{{ cv.name }}</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0" style="gap: 6px; flex-shrink: 0;">
            <button type="button" 
                    class="btn btn-light btn-sm d-flex align-items-center justify-content-center delete-cv-btn" 
                    data-cv-id="{{ cv.id }}"
                    data-cv-name="{{ cv.name }}"
                    data-csrf-token="{{ csrf_token('delete_cv_' ~ cv.id) }}"
                    title="Delete CV"
                    style="width: 32px; height: 32px; padding: 0; border: 1px solid #dc3545; background: transparent; color: #dc3545; border-radius: 6px; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </button>
            <button type="button" 
                    class="btn btn-light btn-sm d-flex align-items-center justify-content-center view-cv-btn" 
                    data-bs-toggle="modal" 
                    data-bs-target="#viewCvModal" 
                    data-cv-url="{{ path('app_provider_document_view', {'id': cv.id}) }}"
                    data-cv-name="{{ cv.name }}"
                    title="View CV"
                    style="width: 32px; height: 32px; padding: 0; border: 1px solid #85BB65; background: transparent; color: #000000; border-radius: 6px; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<style>
    .hover-shadow:hover {
        box-shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.06);
        border-color: #85BB65 !important;
        transform: translateY(-1px);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .delete-cv-btn:hover,
    .view-cv-btn:hover {
        transform: scale(1.05);
    }
</style>