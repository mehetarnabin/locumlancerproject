{# templates/provider/profile/_education_form.html.twig #}

{{ form_start(form, {
    'attr': {'class': 'education-form needs-validation', 'novalidate': 'novalidate'}
}) }}

<div class="row">
    <div class="col-12">{{ form_row(form.school, {'attr': {'class': 'form-control mb-2', 'placeholder': 'School/Institution'}}) }}</div>

    <div class="col-md-4">
        {{ form_row(form.country, {'attr': {'class': 'form-control mb-2', 'placeholder': 'Country'}}) }}
        {{ form_row(form.state, {'attr': {'class': 'form-control mb-2', 'placeholder': 'State/Province'}}) }}
        {{ form_row(form.city, {'attr': {'class': 'form-control mb-2', 'placeholder': 'City'}}) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.degree, {'attr': {'class': 'form-control mb-2', 'placeholder': 'Degree'}}) }}
        {{ form_row(form.startDate, {'attr': {'class': 'form-control mb-2 js-datepicker', 'placeholder': 'Start Date'}}) }}
        {{ form_row(form.endDate, {'attr': {'class': 'form-control mb-2 js-datepicker', 'placeholder': 'End Date'}}) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.fieldOfStudy, {'attr': {'class': 'form-control mb-2', 'placeholder': 'Field of Study'}}) }}
        {{ form_row(form.grade, {'attr': {'class': 'form-control mb-2', 'placeholder': 'Grade'}}) }}
    </div>
</div>

{{ form_row(form.description, {'attr': {'class': 'form-control mb-2', 'rows': 4, 'placeholder': 'Description'}}) }}

<div class="mt-3">
    <button type="submit" class="btn btn-primary">Save</button>
    <button type="submit" name="save_continue" data-redirect-url="{{ path('app_provider_license_index') }}" class="btn btn-success">Save & Continue</button>
</div>

{{ form_end(form) }}
