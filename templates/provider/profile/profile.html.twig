        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
      return;
    }
    
    // Handle Health Assessment form submission to redirect to Risk Assessment
    if (form.closest('#popup-health')) {
      const clickedButton = e.submitter || document.activeElement;
      const saveContinueBtn = form.querySelector('.save-continue-btn[name="save_continue"]');
      
      // Only handle if "Save and Continue" was clicked
      if (clickedButton && clickedButton.name === 'save_continue' && clickedButton.value === '1' && saveContinueBtn) {
        e.preventDefault();
        e.stopPropagation();
        
        const currentPopupId = saveContinueBtn.dataset.currentPopup || 'health';
        const nextPopupId = saveContinueBtn.dataset.nextPopup || 'risk';
        
        // Create FormData and submit via AJAX
        const formData = new FormData(form);
        formData.append('save_continue', '1');
        
        // Show loading state
        const submitBtn = clickedButton;
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
        
        fetch(form.action || window.location.href, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
        .then(response => {
          if (response.ok) {
            // Form submitted successfully, transition to next popup
            window.transitionToNextPopup(currentPopupId, nextPopupId);
          } else {
            throw new Error('Form submission failed');
          }
        })
        .catch(error => {
          console.error('Error submitting form:', error);
          alert('Error saving form. Please try again.');
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        });
      }
    }
  });
  
  // Handle popup transition after form submission (if form doesn't redirect)
  // This can be called from the form submission success handler
  window.transitionToNextPopup = function(currentPopupId, nextPopupId) {
    // Close current popup
    if (currentPopupId) {
      const currentPopup = document.getElementById(`popup-${currentPopupId}`);
      if (currentPopup) {
        currentPopup.classList.add('d-none');
      }
    }
    
    // Open next popup
    if (nextPopupId && nextPopupId.trim() !== '') {
      const nextPopup = document.getElementById(`popup-${nextPopupId}`);
      if (nextPopup) {
        nextPopup.classList.remove('d-none');
        // Load content if needed
        if (nextPopupId === 'education') {
          if (typeof loadEducationList === 'function') {
            loadEducationList();
          }
        }
      }
    }
  };

// License Modal
  const openLicenseModal = document.getElementById('openLicenseModal');
  if (openLicenseModal) {
    openLicenseModal.addEventListener('click', function (e) {
  e.preventDefault();
