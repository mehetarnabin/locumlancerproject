// CV Upload Functionality - Direct file picker with auto-submit
document.addEventListener('DOMContentLoaded', function () {
  const cvUploadBtn = document.getElementById('cvUploadBtn');
  const cvButtonText = document.getElementById('cvButtonText');
  const cvFileInputDirect = document.getElementById('cvFileInputDirect');
  const cvUploadSpinner = document.getElementById('cvUploadSpinner');
  const cvDisplayArea = document.getElementById('cvDisplayArea');
  const cvFileNameDisplay = document.getElementById('cvFileNameDisplay');
  const cvDocumentsList = document.getElementById('cvDocumentsList');
  const cvDragDropContent = document.getElementById('cvDragDropContent');
  
  // Keep references to old modal elements for backward compatibility
  const cvUploadModal = document.getElementById('cvUploadModal');
  const cvUploadForm = document.getElementById('cvUploadForm');
  const cvFileInput = document.getElementById('cvFileInput');
  const cvUploadSubmitBtn = document.getElementById('cvUploadSubmitBtn');
  const cvUploadError = document.getElementById('cvUploadError');

  // Check if CV is already uploaded on page load
  {% if cvDocuments is not empty %}
    const firstCv = {{ cvDocuments|first|json_encode|raw }};
    if (firstCv) {
      updateCvDisplay(firstCv.name);
    }
  {% else %}
    // Show drag drop content if no CV is uploaded
    if (cvDragDropContent) {
      cvDragDropContent.style.display = 'flex';
    }
  {% endif %}

  function updateCvDisplay(fileName) {
    if (cvButtonText) {
      cvButtonText.textContent = 'Update CV';
    }
    if (cvFileNameDisplay) {
      cvFileNameDisplay.textContent = fileName;
    }
    if (cvDisplayArea) {
      cvDisplayArea.classList.remove('d-none');
      cvDisplayArea.style.display = 'block';
    }
    // Hide drag drop content when file is uploaded
    if (cvDragDropContent) {
      cvDragDropContent.style.display = 'none';
    }
    // Keep the button visible - don't hide it
  }

  function fetchUpdatedCvList() {
    // Fetch updated CV list from the server
    fetch('{{ path("app_provider_profile") }}', {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.text())
    .then(html => {
      // Parse the HTML and extract the CV list
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const updatedList = doc.getElementById('cvDocumentsList');
      if (updatedList && cvDocumentsList) {
        cvDocumentsList.innerHTML = updatedList.innerHTML;
      }
    })
    .catch(error => {
      console.error('Error fetching CV list:', error);
    });
  }

  // Direct file upload functionality
  if (cvUploadBtn && cvFileInputDirect) {
    // When button is clicked, trigger file input
    cvUploadBtn.addEventListener('click', function(e) {
      e.preventDefault();
      cvFileInputDirect.click();
    });

    // When file is selected, automatically submit via AJAX
    cvFileInputDirect.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) {
        return;
      }

      // Validate file type
      const allowedExtensions = ['.pdf', '.doc', '.docx'];
      const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
      
      if (!allowedExtensions.includes(fileExtension)) {
        if (typeof showWarningAlert === 'function') {
          showWarningAlert('Invalid File Type', 'Please select a valid CV file (PDF, DOC, or DOCX)');
        } else {
          alert('Please select a valid CV file (PDF, DOC, or DOCX)');
        }
        cvFileInputDirect.value = '';
        return;
      }

      // Validate file size (25MB max)
      const maxSize = 25 * 1024 * 1024; // 25MB in bytes
      if (file.size > maxSize) {
        if (typeof showWarningAlert === 'function') {
          showWarningAlert('File Too Large', 'File size exceeds 25MB limit. Please select a smaller file.');
        } else {
          alert('File size exceeds 25MB limit. Please select a smaller file.');
        }
        cvFileInputDirect.value = '';
        return;
      }

      // Show loading state
      if (cvUploadBtn) {
        cvUploadBtn.disabled = true;
        if (cvUploadSpinner) {
          cvUploadSpinner.style.display = 'inline-block';
        }
        if (cvButtonText) {
          cvButtonText.textContent = 'Uploading...';
        }
      }

      // Create FormData - use same structure as the modal form
      const formData = new FormData();
      formData.append('fileName', file);
      formData.append('category', 'CV');
      formData.append('name', 'CV');
      formData.append('documentType', 'CV');
      
      // Try to get CSRF token from the modal form if it exists
      const modalForm = document.querySelector('#uploadModal form');
      if (modalForm) {
        const csrfInput = modalForm.querySelector('input[name*="_token"]');
        if (csrfInput) {
          formData.append(csrfInput.name, csrfInput.value);
        }
      }

      // Submit via AJAX
      fetch('{{ path("app_provider_documents") }}', {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        if (!response.ok) {
          return response.text().then(text => {
            try {
              const data = JSON.parse(text);
              throw new Error(data.message || 'Upload failed');
            } catch (e) {
              if (e instanceof Error && e.message) {
                throw e;
              }
              throw new Error('Upload failed. Please try again.');
            }
          });
        }
        return response.text().then(text => {
          try {
            return JSON.parse(text);
          } catch (e) {
            // If response is HTML (redirect), consider it success
            return { success: true, fileName: file.name };
          }
        });
      })
      .then(data => {
        // Update button text
        if (cvButtonText) {
          cvButtonText.textContent = 'Update CV';
        }
        
        // Update display with uploaded file name - store it to persist
        const displayFileName = data.fileName || file.name;
        updateCvDisplay(displayFileName);
        
        // Update CV list if HTML is provided (this won't affect the display area above)
        if (cvDocumentsList && data.cvListHtml) {
          cvDocumentsList.innerHTML = data.cvListHtml;
        } else if (cvDocumentsList && data.success) {
          // If no HTML provided but upload was successful, fetch updated list
          fetchUpdatedCvList();
        }
        
        // Ensure display area stays visible after list update
        setTimeout(() => {
          if (cvDisplayArea && displayFileName) {
            cvDisplayArea.style.display = 'block';
            if (cvFileNameDisplay) {
              cvFileNameDisplay.textContent = displayFileName;
            }
          }
        }, 100);
        
        // Show success message
        if (typeof showSuccessAlert === 'function') {
          showSuccessAlert('CV Uploaded', 'CV uploaded successfully!');
        } else {
          alert('CV uploaded successfully!');
        }
        
        // Reset file input only (this doesn't affect the display area)
        // The display area shows the uploaded file name, not the input value
        cvFileInputDirect.value = '';
        
        // Don't reload page - keep the file name visible in the display area
      })
      .catch(error => {
        console.error('Upload error:', error);
        if (typeof showErrorAlert === 'function') {
          showErrorAlert('Upload Failed', 'Upload failed: ' + error.message);
        } else {
          alert('Upload failed: ' + error.message);
        }
        cvFileInputDirect.value = '';
      })
      .finally(() => {
        // Reset button state
        if (cvUploadBtn) {
          cvUploadBtn.disabled = false;
          if (cvUploadSpinner) {
            cvUploadSpinner.style.display = 'none';
          }
        }
      });
    });
  }

  // Drag and Drop functionality for CV upload
  const cvDragDropArea = document.getElementById('cvDragDropArea');
  
  if (cvDragDropArea && cvFileInputDirect) {
    // Prevent default drag behaviors
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      cvDragDropArea.addEventListener(eventName, preventDefaults, false);
      document.body.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
      e.preventDefault();
      e.stopPropagation();
    }

    // Highlight drop area when item is dragged over it
    ['dragenter', 'dragover'].forEach(eventName => {
      cvDragDropArea.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      cvDragDropArea.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
      cvDragDropArea.classList.add('drag-over');
    }

    function unhighlight(e) {
      cvDragDropArea.classList.remove('drag-over');
    }

    // Handle dropped files
    cvDragDropArea.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
      const dt = e.dataTransfer;
      const files = dt.files;
      
      if (files.length > 0) {
        const file = files[0];
        
        // Validate file type
        const allowedExtensions = ['.pdf', '.doc', '.docx'];
        const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
        
        if (!allowedExtensions.includes(fileExtension)) {
          if (typeof showWarningAlert === 'function') {
            showWarningAlert('Invalid File Type', 'Please select a valid CV file (PDF, DOC, or DOCX)');
          } else {
            alert('Please select a valid CV file (PDF, DOC, or DOCX)');
          }
          return;
        }

        // Validate file size (25MB max)
        const maxSize = 25 * 1024 * 1024; // 25MB in bytes
        if (file.size > maxSize) {
          if (typeof showWarningAlert === 'function') {
            showWarningAlert('File Too Large', 'File size exceeds 25MB limit. Please select a smaller file.');
          } else {
            alert('File size exceeds 25MB limit. Please select a smaller file.');
          }
          return;
        }

        // Set the file to the input and trigger change event
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        cvFileInputDirect.files = dataTransfer.files;
        
        // Trigger the change event to use existing upload logic
        const changeEvent = new Event('change', { bubbles: true });
        cvFileInputDirect.dispatchEvent(changeEvent);
      }
    }

    // Also allow clicking the drag drop area to open file picker
    cvDragDropArea.addEventListener('click', function(e) {
      // Don't trigger if clicking on the button
      if (!e.target.closest('#cvUploadBtn')) {
        cvFileInputDirect.click();
      }
    });
  }

  // Form submit handler
  if (cvUploadForm) {
    cvUploadForm.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      if (!cvFileInput || !cvFileInput.files || cvFileInput.files.length === 0) {
        showError('Please select a CV file to upload.');
        return false;
      }

      const file = cvFileInput.files[0];
      
      // Validate file type
      const allowedExtensions = ['.pdf', '.doc', '.docx'];
      const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
      
      if (!allowedExtensions.includes(fileExtension)) {
        showError('Please select a valid CV file (PDF, DOC, or DOCX)');
        return false;
      }

      // Validate file size (25MB max)
      const maxSize = 25 * 1024 * 1024; // 25MB in bytes
      if (file.size > maxSize) {
        showError('File size exceeds 25MB limit. Please select a smaller file.');
        return false;
      }

      // Hide error
      hideError();

      // Show loading state - change button to "Uploading..."
      if (cvUploadSubmitBtn) {
        cvUploadSubmitBtn.disabled = true;
        const originalBtnText = cvUploadSubmitBtn.innerHTML;
        cvUploadSubmitBtn.dataset.originalText = originalBtnText;
        cvUploadSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Uploading...';
      }

      // Create FormData
      const formData = new FormData(cvUploadForm);
      
      // Submit via AJAX
      fetch(cvUploadForm.action || window.location.href, {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        if (!response.ok) {
          return response.json().then(data => {
            throw new Error(data.message || 'Upload failed');
          });
        }
        return response.json();
      })
      .then(data => {
        if (data.success) {
          // Reset button state first
          if (cvUploadSubmitBtn && cvUploadSubmitBtn.dataset.originalText) {
            cvUploadSubmitBtn.disabled = false;
            cvUploadSubmitBtn.innerHTML = cvUploadSubmitBtn.dataset.originalText;
            delete cvUploadSubmitBtn.dataset.originalText;
          }
          
          // Update button text
          if (cvButtonText) {
            cvButtonText.textContent = 'Update CV';
          }
          
          // Update display with uploaded file name
          updateCvDisplay(data.fileName || file.name);
          
          // Update CV list if HTML is provided
          if (cvDocumentsList && data.cvListHtml) {
            cvDocumentsList.innerHTML = data.cvListHtml;
          }
          
          // Reset form
          cvUploadForm.reset();
          
          // Close modal
          const modal = bootstrap.Modal.getInstance(cvUploadModal);
          if (modal) {
            modal.hide();
          }
          
          // Show success message
          if (typeof showSuccessAlert === 'function') {
            showSuccessAlert('CV Uploaded', 'CV uploaded successfully!');
          } else {
            alert('CV uploaded successfully!');
          }
        } else {
          throw new Error(data.message || 'Upload failed');
        }
      })
      .catch(error => {
        console.error('Upload error:', error);
        if (typeof showErrorAlert === 'function') {
          showErrorAlert('Upload Failed', 'Upload failed: ' + error.message);
        } else {
          showError('Upload failed: ' + error.message);
        }
      })
      .finally(() => {
        // Reset button state only if upload failed (success case already handled)
        if (cvUploadSubmitBtn && cvUploadSubmitBtn.dataset.originalText) {
          cvUploadSubmitBtn.disabled = false;
          cvUploadSubmitBtn.innerHTML = cvUploadSubmitBtn.dataset.originalText;
          delete cvUploadSubmitBtn.dataset.originalText;
        }
      });
      
      return false;
    });
  }

  // Also handle button click directly as a fallback
  if (cvUploadSubmitBtn) {
    cvUploadSubmitBtn.addEventListener('click', function(e) {
      // Let the form submit handler take care of it
      // This ensures the button click triggers form submission
      if (cvUploadForm && cvFileInput && cvFileInput.files && cvFileInput.files.length > 0) {
        // Form will handle the submission
        return true;
      } else {
        e.preventDefault();
        showError('Please select a CV file to upload.');
        return false;
      }
    });
  }

  function showError(message) {
    if (cvUploadError) {
      cvUploadError.textContent = message;
      cvUploadError.classList.remove('d-none');
    }
  }

  function hideError() {
    if (cvUploadError) {
      cvUploadError.classList.add('d-none');
    }
  }

  // Clear error when file input changes
  if (cvFileInput) {
    cvFileInput.addEventListener('change', function() {
      hideError();
    });
  }

  // Reset form when modal is closed
  if (cvUploadModal) {
    cvUploadModal.addEventListener('hidden.bs.modal', function() {
      if (cvUploadForm) {
        cvUploadForm.reset();
      }
      hideError();
    });
  }
});

