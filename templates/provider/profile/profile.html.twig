      <h5>Work Preferences</h5>
      <button class="popup-close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M6 18L18 6M6 6l12 12" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="popup-body">
      <section class="content">
        <div class="row">
          <div class="col-12">
            <div id="work-preferences-error" class="alert alert-danger d-none mb-3"></div>
            
            {# Summary View - Shown by default #}
            <div id="work-preferences-summary-view">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">My Work Preferences</h6>
                <button type="button" class="btn btn-primary btn-sm" id="work-preferences-add-new-btn">
                  {% set hasPreferences = providerEntity.profession or providerEntity.desiredPayRate or providerEntity.desiredHour or (providerEntity.desiredStates is not empty) %}
                  {{ hasPreferences ? 'Edit' : 'Add New' }}
                </button>
              </div>
              <div id="work-preferences-summary-content">
                {% include 'provider/profile/_work_preferences_summary.html.twig' with { provider: providerEntity } %}
              </div>
            </div>

            {# Form View - Hidden by default #}
            <div id="work-preferences-form-view" style="display: none;">
            {% if workPreferenceForm is defined %}
                {{ form_start(workPreferenceForm, {'attr': {'id': 'work-preferences-form', 'class': 'needs-validation'}}) }}
                <div class="row g-3">
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.profession, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.profession, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(workPreferenceForm.profession) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.specialities, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.specialities, {'attr': {'class': 'form-control select2'}}) }}
                        {{ form_errors(workPreferenceForm.specialities) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.desiredPayRate, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="radio-group">
                          {{ form_widget(workPreferenceForm.desiredPayRate, {'attr':{'class': 'checkbox'}}) }}
                        </div>
                        {{ form_errors(workPreferenceForm.desiredPayRate) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.desiredHour, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="radio-group">
                          {{ form_widget(workPreferenceForm.desiredHour, {'attr':{'class': 'checkbox'}}) }}
                        </div>
                        {{ form_errors(workPreferenceForm.desiredHour) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.payRateHourly, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.payRateHourly, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(workPreferenceForm.payRateHourly) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.payRateDaily, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.payRateDaily, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(workPreferenceForm.payRateDaily) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.availabilityToStart, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.availabilityToStart, {'attr': {'class': 'form-control js-datepicker'}}) }}
                        {{ form_errors(workPreferenceForm.availabilityToStart) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.preferredPatientVolume, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.preferredPatientVolume, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(workPreferenceForm.preferredPatientVolume) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.desiredStates, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(workPreferenceForm.desiredStates, {'attr': {'class': 'form-control select2'}}) }}
                        {{ form_errors(workPreferenceForm.desiredStates) }}
                      </div>
                  </div>
                  <div class="col-md-6">
                      <div class="mb-3">
                        {{ form_label(workPreferenceForm.willingToTravel, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="mt-2">
                          {{ form_widget(workPreferenceForm.willingToTravel, {'attr':{'class': 'checkbox'}}) }}
                        </div>
                        {{ form_errors(workPreferenceForm.willingToTravel) }}
                      </div>
                  </div>
                </div>
                {{ form_rest(workPreferenceForm) }}
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-secondary" id="work-preferences-cancel-form-btn">Cancel</button>
                  <button type="submit" class="btn btn-primary" id="work-preferences-submit">Save Preferences</button>
                </div>
                {{ form_end(workPreferenceForm) }}
            {% else %}
              <p class="text-muted mb-0">Form unavailable.</p>
            {% endif %}
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

