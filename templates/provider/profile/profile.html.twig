<script>
// Store original document type options
let originalDocumentTypeOptions = null;

function setCategory(label) {
    const map = {
        'CV Upload': 'CV',
        'Work Preference': 'Work Preference',
        'Insurance': 'Insurance',
        'Health Assessment': 'Health Assessment',
        'Risk Assessment': 'Risk Assessment',
        'References': 'References',
        'Documents': 'Documents'
    };
    const categoryValue = map[label] || 'Documents';
    
    // Hide category field and use hidden input for CV
    const categoryField = document.getElementById('categoryField');
    const categoryHidden = document.getElementById('documentCategoryHidden');
    const categorySelect = document.getElementById('documentCategory');
    const documentTypeSelect = document.getElementById('documentTypeSelect');
    
    if (categoryValue === 'CV') {
        // Hide the visible category field and use hidden input
        if (categoryField) categoryField.style.display = 'none';
        if (categoryHidden) categoryHidden.value = 'CV';
        
        // Filter document type dropdown to show only CV
        if (documentTypeSelect) {
            // Store original options if not already stored
            if (!originalDocumentTypeOptions) {
                originalDocumentTypeOptions = Array.from(documentTypeSelect.options).map(opt => ({
                    value: opt.value,
                    text: opt.text
                }));
            }
            
            // Clear all options
            documentTypeSelect.innerHTML = '';
            
            // Add only CV option
            const cvOption = document.createElement('option');
            cvOption.value = 'CV';
            cvOption.text = 'CV';
            documentTypeSelect.appendChild(cvOption);
            
            // Select CV by default
            documentTypeSelect.value = 'CV';
            
            // Trigger change event to apply document type config
            documentTypeSelect.dispatchEvent(new Event('change'));
        }
    } else {
        // Show the visible category field for other document types
        if (categoryField) categoryField.style.display = 'block';
        if (categorySelect) categorySelect.value = categoryValue;
        if (categoryHidden) categoryHidden.value = '';
        
        // Restore all document type options
        if (documentTypeSelect && originalDocumentTypeOptions) {
            documentTypeSelect.innerHTML = '';
            originalDocumentTypeOptions.forEach(opt => {
                const option = document.createElement('option');
                option.value = opt.value;
                option.text = opt.text;
                documentTypeSelect.appendChild(option);
            });
            documentTypeSelect.value = '';
        }
    }
    
    // Set document name to "CV" when CV category is selected
    const documentNameInput = document.getElementById('name');
    if (documentNameInput && categoryValue === 'CV') {
        documentNameInput.value = 'CV';
    }
}

/* Upload handler preserved */
document.addEventListener('DOMContentLoaded', function () {
  const form = document.querySelector('#uploadModal form');
  const documentTypeSelect = document.getElementById('documentTypeSelect');
  const documentNameInput = document.getElementById('name');
  const issueDateField = document.getElementById('issueDateField');
  const expirationDateField = document.getElementById('expirationDateField');
  const issueDateInput = document.getElementById('issueDate');
  const expirationDateInput = document.getElementById('expirationDate');
  const documentNote = document.getElementById('documentNote');
  const handleAutoExpiry = () => {
    if (!issueDateInput) return;
    const days = parseInt(issueDateInput.dataset.autoExpiryDays || '0', 10);
    if (days > 0 && issueDateInput.value && expirationDateInput) {
      const baseDate = new Date(issueDateInput.value);
      if (!isNaN(baseDate.getTime())) {
        const expiryDate = new Date(baseDate);
        expiryDate.setDate(expiryDate.getDate() + days);
        expirationDateInput.value = expiryDate.toISOString().split('T')[0];
      }
    } else if (days > 0 && expirationDateInput) {
      expirationDateInput.value = '';
    }
  };
  if (issueDateInput) {
    issueDateInput.addEventListener('change', handleAutoExpiry);
  }
  const defaultDocumentConfig = {
    showIssue: true,
    showExpiry: true,
    autoExpiryDays: 0,
    note: ''
  };
  const documentConfigs = {
    "CV": { showIssue: false, showExpiry: false, note: 'Upload your CV document.' },
    "Driver's License": { showIssue: true, showExpiry: true, note: 'Upload front and back if available.' },
    "Copy of Passport": { showIssue: true, showExpiry: true, note: 'Ensure passport details are clearly visible.' },
    "Passport Photo 2x2": { showIssue: false, showExpiry: false, note: 'Standard 2&quot;x2&quot; photo. No expiry required.' },
    "USMLE / COMLEX Scores": { showIssue: true, showExpiry: true, note: 'Include all score reports.' },
    "Specialty & Subspecialty Certification": { showIssue: false, showExpiry: false, note: 'Certification does not expire.' },
    "Medical School Diploma": { showIssue: false, showExpiry: false, note: 'Upload your diploma copy.' },
    "Postgraduate Certificates": { showIssue: false, showExpiry: false, note: 'Residency/Fellowship completion certificates.' },
    "Life Support Certifications": { showIssue: false, showExpiry: false, note: 'Include ACLS/BLS/PALS certificates.' },
    "Medical Licenses": { showIssue: true, showExpiry: true, note: 'Include both active and inactive licenses.' },
    "DEA Certificates": { showIssue: true, showExpiry: true, note: 'Upload all DEA certificates.' },
    "CSR": { showIssue: true, showExpiry: true, note: 'Controlled Substance Registration for applicable states.' },
    "Undergraduate Transcript": { showIssue: false, showExpiry: false, note: 'Unofficial copy is acceptable if official unavailable.' },
    "Vaccine Titers": { showIssue: false, showExpiry: false, note: 'Include Hepatitis B, Varicella, and MMR titers.' },
    "Negative TB Test": { showIssue: true, showExpiry: true, autoExpiryDays: 365, note: 'Automatically expires 1 year from test date.' },
    "Influenza Vaccine Proof": { showIssue: true, showExpiry: true, autoExpiryDays: 365, note: 'Auto-expires 1 year from administration date.' },
    "COVID-19 Vaccine Proof": { showIssue: true, showExpiry: true, autoExpiryDays: 365, note: 'Auto-expires 1 year from last dose.' },
    "Mask Fit Testing": { showIssue: true, showExpiry: true, autoExpiryDays: 365, note: 'Auto-expires 1 year from fit test date.' },
    "Malpractice COI": { showIssue: true, showExpiry: true, note: 'Upload certificates covering the last 10 years (multiple files allowed).' },
    "Procedure Logs": { showIssue: true, showExpiry: true, note: 'Provide procedure logs for the last 2 years.' },
    "Case Logs": { showIssue: true, showExpiry: true, note: 'Provide case logs for the last 2 years.' },
    "Residency History": { showIssue: false, showExpiry: false, note: 'Attach a list of addresses lived at for the last 10 years.' },
    "Hospital Affiliations & Training": { showIssue: false, showExpiry: false, note: 'Document must include start/end dates, address, phone, and contact email.' },
    "Custom": { showIssue: true, showExpiry: true, note: '' }
  };
  function applyDocumentTypeConfig(type) {
    if (!issueDateField || !expirationDateField || !issueDateInput || !expirationDateInput) {
      return;
    }
    const config = documentConfigs[type] || defaultDocumentConfig;
    const showIssue = !!config.showIssue;
    const showExpiry = !!config.showExpiry;
    issueDateField.classList.toggle('d-none', !showIssue);
    issueDateInput.required = showIssue;
    if (!showIssue) {
      issueDateInput.value = '';
    }
    expirationDateField.classList.toggle('d-none', !showExpiry);
    if (showExpiry) {
      expirationDateInput.readOnly = !!config.autoExpiryDays;
      expirationDateInput.classList.toggle('bg-light', !!config.autoExpiryDays);
      expirationDateInput.required = !config.autoExpiryDays;
    } else {
      expirationDateInput.readOnly = false;
      expirationDateInput.classList.remove('bg-light');
      expirationDateInput.required = false;
      expirationDateInput.value = '';
    }
    issueDateInput.dataset.autoExpiryDays = config.autoExpiryDays || '';
    if (!config.autoExpiryDays) {
      expirationDateInput.value = showExpiry ? expirationDateInput.value : '';
    } else {
      handleAutoExpiry();
    }
    if (documentNote) {
      if (config.note) {
        documentNote.innerHTML = config.note;
        documentNote.classList.remove('d-none');
        documentNote.classList.add('text-muted');
      } else {
        documentNote.textContent = '';
        documentNote.classList.add('d-none');
      }
    }
    if (documentNameInput && type && type !== 'Custom') {
      documentNameInput.value = type;
    }
  }
  if (documentTypeSelect) {
    // Store original options on page load
    if (!originalDocumentTypeOptions) {
      originalDocumentTypeOptions = Array.from(documentTypeSelect.options).map(opt => ({
        value: opt.value,
        text: opt.text
      }));
    }
    
    documentTypeSelect.addEventListener('change', function () {
      applyDocumentTypeConfig(this.value);
    });
    applyDocumentTypeConfig(documentTypeSelect.value);
  }
  
  // Restore document type options when modal is closed
  const uploadModal = document.getElementById('uploadModal');
  if (uploadModal) {
    uploadModal.addEventListener('hidden.bs.modal', function () {
      const documentTypeSelect = document.getElementById('documentTypeSelect');
      if (documentTypeSelect && originalDocumentTypeOptions) {
        // Restore all original options
        documentTypeSelect.innerHTML = '';
        originalDocumentTypeOptions.forEach(opt => {
          const option = document.createElement('option');
          option.value = opt.value;
          option.text = opt.text;
          documentTypeSelect.appendChild(option);
        });
        documentTypeSelect.value = '';
        
        // Reset form fields
        const documentNameInput = document.getElementById('name');
        if (documentNameInput) documentNameInput.value = '';
        
        // Show category field again
        const categoryField = document.getElementById('categoryField');
        if (categoryField) categoryField.style.display = 'block';
        
        // Reset hidden category
        const categoryHidden = document.getElementById('documentCategoryHidden');
        if (categoryHidden) categoryHidden.value = '';
      }
    });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    const uploadBtn = document.getElementById('uploadDocumentBtn');
    const uploadBtnText = uploadBtn ? uploadBtn.querySelector('.upload-btn-text') : null;
    const uploadBtnSpinner = uploadBtn ? uploadBtn.querySelector('.upload-btn-spinner') : null;
    const fileNameInput = document.getElementById('fileName');
    const documentNameInput = document.getElementById('name');
    
    // Get file name for display
    const fileName = fileNameInput && fileNameInput.files.length > 0 ? fileNameInput.files[0].name : '';
    const documentName = documentNameInput ? documentNameInput.value : '';

    // Use SweetAlert for confirmation
    showConfirmAlert(
      'Confirm Upload',
      'Are you sure you want to upload this document?',
      'Yes, Upload',
      'Cancel',
      function(confirmed) {
        if (!confirmed) return;

        // Update button state to uploading
        if (uploadBtn) {
          uploadBtn.disabled = true;
          if (uploadBtnText) uploadBtnText.style.display = 'none';
          if (uploadBtnSpinner) uploadBtnSpinner.style.display = 'inline-block';
        }

        const formData = new FormData(form);
        
        // Ensure only one category field is submitted
        const categoryHidden = document.getElementById('documentCategoryHidden');
        const categorySelect = document.getElementById('documentCategory');
        if (categoryHidden && categoryHidden.value) {
          // Remove the select field value if hidden field has a value
          formData.delete('category');
          formData.append('category', categoryHidden.value);
        }

        fetch(form.action, {
          method: 'POST',
          body: formData,
        })
        .then(response => {
          if (!response.ok) {
            return response.text().then(text => {
              throw new Error(text || 'Upload failed');
            });
          }
          return response.text();
        })
        .then(() => {
          // Show success alert with document name
          const displayName = documentName || fileName || 'Document';
          showSuccessAlert('Upload Success', `${displayName} has been successfully uploaded.`, function() {
            // Close modal
            const modalEl = document.getElementById('uploadModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.hide();
            form.reset();
            
            // Reset button state
            if (uploadBtn) {
              uploadBtn.disabled = false;
              if (uploadBtnText) uploadBtnText.style.display = 'inline-block';
              if (uploadBtnSpinner) uploadBtnSpinner.style.display = 'none';
            }
            
            // Reload page to show updated document list
            setTimeout(() => {
              window.location.reload();
            }, 500);
          });
        })
        .catch(error => {
          // Reset button state on error
          if (uploadBtn) {
            uploadBtn.disabled = false;
            if (uploadBtnText) uploadBtnText.style.display = 'inline-block';
            if (uploadBtnSpinner) uploadBtnSpinner.style.display = 'none';
          }
          
          // Show error alert
          const errorMessage = error.message.includes('<') ? 'Upload failed. Please try again.' : error.message;
          showErrorAlert('Upload Error', errorMessage);
        });
      }
    );
  });
});
</script>
