          </div>

          {# Center: assignment column #}
          <div class="col-12 col-lg-6 d-flex flex-column">
            <div class="profile-right-card h-fix-auto">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0" style="font-weight: 500;">Your History</h5>
              </div>
              <div class="card-body" style="padding: 0;">
                <div class="mb-2" style="text-align: left;">
                  <h6 class="card-title mb-1" style="font-size: 0.875rem; font-weight: 500; color: #252930; margin-bottom: 2px;">Your Average Rating</h6>
                  <div style="margin-top: 2px;">
                      {% set rating = 3.72 %}
                    <div style="font-size: 16px; font-weight: normal; color: #252930; line-height: 1.2;">{{ rating|number_format(1) }}</div>
                  </div>
                </div>
                <div class="mb-2" style="text-align: left;">
                  <h6 class="card-title mb-1" style="font-size: 0.875rem; font-weight: 500; color: #252930; margin-bottom: 2px;">Locum Assignments : </h6>
                  <div class="mb-0" style="font-size: 16px; font-weight: normal; color: #252930; line-height: 1.2;">10</div>
                </div>
                <div style="text-align: left;">
                  <h6 class="card-title mb-1" style="font-size: 0.875rem; font-weight: 500; color: #252930; margin-bottom: 2px;">Years Active : </h6>
                  <div class="mb-0" style="font-size: 16px; font-weight: normal; color: #252930; line-height: 1.2;">15 years</div>
                </div>
                </div>
            </div>

            <!-- Square Cards Section: Work Preferences and Documents - Placed below Your History -->
            <div class="row g-3 mt-3">
              <!-- Work Preferences Card -->
              <div class="col-6">
                <div class="card app-card-settings profile-square-card h-100">
                  <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height: 140px; padding: 1rem 0.75rem;">
                    <div class="mb-2">
                      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8;">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
                      </svg>
                    </div>
                    <h5 class="card-title mb-2 text-center" style="font-size: 0.95rem; font-weight: 500; line-height: 1.2;">Work Preferences</h5>
                    <button type="button" class="btn btn-primary documents-view-btn" data-popup="work-preferences" style="padding: 6px 16px; font-size: 0.85rem; font-weight: 500; border-radius: 6px; white-space: nowrap;">
                      <span>View</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; margin-left: 4px;">
                        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Documents Card -->
              <div class="col-6">
                <div class="card app-card-settings profile-square-card h-100">
                  <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height: 140px; padding: 1rem 0.75rem;">
                    <div class="mb-2">
                      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8;">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                      </svg>
                    </div>
                    <h5 class="card-title mb-2 text-center" style="font-size: 0.95rem; font-weight: 500; line-height: 1.2;">Documents</h5>
                    <a href="{{ path('app_provider_documents') }}" class="btn btn-primary documents-view-btn" style="padding: 6px 16px; font-size: 0.85rem; font-weight: 500; border-radius: 6px; text-decoration: none; white-space: nowrap;">
                      <span>View</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0; margin-left: 4px;">
                        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CV Upload Card - Full Width with Drag and Drop -->
          <div class="col-12 mt-4">
            <div class="card app-card-settings">
              <div class="card-header-row d-flex justify-content-between align-items-center mb-0">
                <div class="card-title-wrapper">
                  <h5 class="card-title mb-0">CV Upload</h5>
                </div>
              </div>
              <div class="card-body" style="padding: 24px !important;">
                <!-- Drag and Drop Area -->
                <div id="cvDragDropArea" class="cv-drag-drop-area" style="border: 2px dashed #85BB65; border-radius: 12px; padding: 1rem 1.25rem !important; text-align: center; background: #F4F9F1; transition: all 0.3s ease; cursor: pointer; height: 140px !important; max-height: 140px !important; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box;">
                  <div id="cvDragDropContent" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 0; margin: 0; box-sizing: border-box; gap: 0.35rem;">
                    <div style="margin: 0 !important; padding: 0 !important; display: flex; align-items: center; justify-content: center; line-height: 1;">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7; display: block; margin: 0; padding: 0;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                      </svg>
                    </div>
                    <h6 class="mb-0" style="font-size: 0.8rem !important; font-weight: 600; color: #252930; line-height: 1.2; margin: 0 !important; padding: 0 !important; text-align: center; white-space: nowrap;">Drag & Drop your CV here</h6>
                    <p class="text-muted mb-0" style="font-size: 0.7rem !important; line-height: 1.1; margin: 0 !important; padding: 0 !important; text-align: center;">or</p>
                    <button type="button" id="cvUploadBtn" class="btn btn-primary" style="padding: 5px 16px !important; font-size: 0.75rem !important; font-weight: 600; border-radius: 6px; margin: 0 !important; white-space: nowrap; display: inline-block; line-height: 1.2;">
                      <span id="cvButtonText">Browse Files</span>
                      <span id="cvUploadSpinner" style="display: none;">
                        <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                      </span>
                    </button>
                    <p class="text-muted mb-0" style="font-size: 0.65rem !important; line-height: 1.1; margin: 0 !important; padding: 0 !important; text-align: center; white-space: nowrap;">Supported formats: PDF, DOC, DOCX (Max 10MB)</p>
                  </div>
                  
                  <!-- Uploaded CV Display (shown after upload) -->
                  <div id="cvDisplayArea" class="d-none" style="width: 100%;">
                    <div class="d-flex align-items-center justify-content-between p-3" style="background: white; border: 1px solid #85BB65; border-radius: 8px;">
                      <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 0;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                          <polyline points="14 2 14 8 20 8"/>
                          <line x1="16" y1="13" x2="8" y2="13"/>
                          <line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                        <span id="cvFileNameDisplay" class="text-dark fw-medium" style="font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;"></span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Hidden file input -->
                <input type="file" id="cvFileInputDirect" accept=".pdf,.doc,.docx" style="display: none;">
                
                <!-- Uploaded CVs List -->
                <div id="cvDocumentsList" class="mt-4">
                  {% if cvDocuments is not empty %}
                    <div>
                      <h6 class="fw-semibold mb-3" style="font-size: 1rem;">Uploaded CVs</h6>
                      <ul class="list-group list-group-flush">
                        {% for cv in cvDocuments %}
                          <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #e5e7eb;">
                            <div class="d-flex align-items-center gap-3">
                              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                              </svg>
                              <div>
                                <div class="fw-semibold text-dark">{{ cv.name }}</div>
                                <small class="text-muted">Uploaded {{ cv.createdAt ? cv.createdAt|date('M d, Y h:i A') : '' }}</small>
                              </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                              <a href="{{ asset('uploads/' ~ app.user.id ~ '/' ~ cv.fileName) }}" target="_blank" class="btn btn-link btn-sm text-decoration-none" style="color: #85BB65;">Download</a>
                              <form action="{{ path('app_provider_profile_cv_delete', {id: cv.id}) }}" method="post" onsubmit="return confirm('Remove this CV?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_cv_' ~ cv.id) }}">
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                              </form>
                            </div>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    {# Right: narrow column for share and quick links - col-lg-4 #}
    <div class="col-12 col-lg-4 d-flex flex-column" style="align-self: flex-start;">
      <div class="profile-right-card h-fix-auto" style="margin-top: -24px;">
          <div class="card-header-row d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Share & Quick Links</h5>
            <button id="toggle-checkmarks" class="cstm-toggle-btn" title="Toggle Checkmarks">
              <svg icon-image width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
