    const cancelBtn = e.target.closest('#work-preferences-cancel-form-btn') || (e.target.id === 'work-preferences-cancel-form-btn' ? e.target : null);
    
    if (cancelBtn) {
      e.preventDefault();
      e.stopPropagation();
      
      const summaryView = document.getElementById('work-preferences-summary-view');
      const formView = document.getElementById('work-preferences-form-view');
      
      if (summaryView && formView) {
        // Hide form, show summary
        formView.style.display = 'none';
        summaryView.style.display = 'block';
      }
    }
  });
  
  // Also attach direct event listener as fallback
  document.addEventListener('DOMContentLoaded', function() {
    // Use setInterval to check for button existence (in case popup loads dynamically)
    const checkAndAttach = setInterval(function() {
      const addNewBtn = document.getElementById('work-preferences-add-new-btn');
      const cancelBtn = document.getElementById('work-preferences-cancel-form-btn');
      
      if (addNewBtn && !addNewBtn.dataset.listenerAttached) {
        addNewBtn.dataset.listenerAttached = 'true';
        addNewBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const summaryView = document.getElementById('work-preferences-summary-view');
          const formView = document.getElementById('work-preferences-form-view');
          
          if (summaryView && formView) {
            summaryView.style.display = 'none';
            formView.style.display = 'block';
            
            setTimeout(function() {
              if (typeof $ !== 'undefined' && $.fn.select2) {
                $('#work-preferences-form-view .select2').each(function() {
                  if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                      dropdownParent: $('#popup-work-preferences')
                    });
                  }
                });
              }
              
              if (typeof flatpickr !== 'undefined') {
                $('#work-preferences-form-view .js-datepicker').each(function() {
                  if (!this._flatpickr) {
                    flatpickr(this, {
                      dateFormat: "Y-m-d"
                    });
                  }
                });
              }
            }, 100);
          }
        });
      }
      
      if (cancelBtn && !cancelBtn.dataset.listenerAttached) {
        cancelBtn.dataset.listenerAttached = 'true';
        cancelBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const summaryView = document.getElementById('work-preferences-summary-view');
          const formView = document.getElementById('work-preferences-form-view');
          
          if (summaryView && formView) {
            formView.style.display = 'none';
            summaryView.style.display = 'block';
          }
        });
      }
      
      // Clear interval once both buttons are found and attached
      if (addNewBtn && cancelBtn && addNewBtn.dataset.listenerAttached && cancelBtn.dataset.listenerAttached) {
        clearInterval(checkAndAttach);
      }
    }, 500);
    
    // Clear interval after 10 seconds to prevent infinite checking
    setTimeout(function() {
      clearInterval(checkAndAttach);
    }, 10000);
  });

  // Handle Share button - generate PDF and save to localStorage
  const shareBtn = document.getElementById('share-quick-links-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async function(e) {
      e.preventDefault();
      const selectedLinks = [];
      document.querySelectorAll('.quick-link-checkbox:checked').forEach(checkbox => {
        const linkName = checkbox.closest('.quick-link-card').querySelector('.cstm-btn-text').textContent.trim();
        const linkId = checkbox.dataset.link;
        selectedLinks.push({
          id: linkId,
          name: linkName
        });
      });

      if (selectedLinks.length === 0) {
        if (typeof showWarningAlert === 'function') {
          showWarningAlert('No Selection', 'Please select at least one quick link to share.');
        } else {
          alert('Please select at least one quick link to share.');
        }
        return;
      }

      // Load jsPDF library dynamically if not already loaded
      if (typeof window.jspdf === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        script.onload = () => generateAndSavePDF(selectedLinks);
        document.head.appendChild(script);
      } else {
        generateAndSavePDF(selectedLinks);
      }
    });
  }

  // Helper function to fetch data for each quick link type
  async function fetchQuickLinkData(linkId) {
    try {
      switch(linkId) {
        case 'education':
          const eduResponse = await fetch('{{ path('app_provider_education_list') }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });
          const eduHtml = await eduResponse.text();
          const eduParser = new DOMParser();
          const eduDoc = eduParser.parseFromString(eduHtml, 'text/html');
          const eduCards = eduDoc.querySelectorAll('.ed-card, .card');
          const eduData = Array.from(eduCards).map(card => {
            const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
            const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
            return { title, details };
          });
          return eduData.length > 0 ? eduData : [{ title: 'No education entries found', details: [] }];
          
        case 'license':
          // Extract license data from popup if available
          const licensePopup = document.getElementById('popup-license');
          if (licensePopup && !licensePopup.classList.contains('d-none')) {
            const licenseCards = licensePopup.querySelectorAll('.ed-card, .card');
            const licenseData = Array.from(licenseCards).map(card => {
              const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
              const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
              return { title, details };
            });
            if (licenseData.length > 0) return licenseData;
          }
          return [{ title: 'No license entries found', details: [] }];
          
        case 'insurance':
          const insurancePopup = document.getElementById('popup-insurance');
          if (insurancePopup && !insurancePopup.classList.contains('d-none')) {
            const insuranceCards = insurancePopup.querySelectorAll('.ed-card, .card');
            const insuranceData = Array.from(insuranceCards).map(card => {
              const title = card.querySelector('h5, .card-title')?.textContent?.trim() || '';
              const details = Array.from(card.querySelectorAll('p, .card-text')).map(p => p.textContent.trim()).filter(t => t);
              return { title, details };
            });
            if (insuranceData.length > 0) return insuranceData;
          }
          return [{ title: 'No insurance entries found', details: [] }];
          
        case 'health':
          const healthPopup = document.getElementById('popup-health');
          if (healthPopup && !healthPopup.classList.contains('d-none')) {
            const form = healthPopup.querySelector('form');
            if (form) {
              const formData = new FormData(form);
              const healthData = [];
              form.querySelectorAll('.form-group').forEach(group => {
                const label = group.querySelector('label')?.textContent?.trim() || '';
                const inputs = group.querySelectorAll('input[type="radio"]:checked, textarea, select');
                const values = Array.from(inputs).map(input => {
                  if (input.type === 'radio') return input.value;
                  if (input.tagName === 'TEXTAREA') return input.value;
                  if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                  return '';
                }).filter(v => v);
                if (label && values.length > 0) {
                  healthData.push({ title: label, details: values });
                }
              });
              if (healthData.length > 0) return healthData;
            }
          }
          return [{ title: 'No health assessment data found', details: [] }];
          
        case 'risk':
          const riskPopup = document.getElementById('popup-risk');
          if (riskPopup && !riskPopup.classList.contains('d-none')) {
            const form = riskPopup.querySelector('form');
            if (form) {
              const riskData = [];
              form.querySelectorAll('.form-group').forEach(group => {
                const label = group.querySelector('label')?.textContent?.trim() || '';
                const inputs = group.querySelectorAll('input[type="radio"]:checked, textarea, select');
                const values = Array.from(inputs).map(input => {
                  if (input.type === 'radio') return input.value;
                  if (input.tagName === 'TEXTAREA') return input.value;
                  if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                  return '';
                }).filter(v => v);
                if (label && values.length > 0) {
                  riskData.push({ title: label, details: values });
                }
              });
              if (riskData.length > 0) return riskData;
            }
          }
          return [{ title: 'No risk assessment data found', details: [] }];
          
        case 'application-certification':
          const certPopup = document.getElementById('popup-application-certification');
          if (certPopup && !certPopup.classList.contains('d-none')) {
            const form = certPopup.querySelector('form');
            if (form) {
              const certData = [];
              form.querySelectorAll('.form-group, .form-check').forEach(group => {
                const label = group.querySelector('label')?.textContent?.trim() || '';
                const inputs = group.querySelectorAll('input[type="checkbox"]:checked, input[type="radio"]:checked, textarea, select');
                const values = Array.from(inputs).map(input => {
                  if (input.type === 'checkbox' || input.type === 'radio') return input.value || 'Yes';
                  if (input.tagName === 'TEXTAREA') return input.value;
                  if (input.tagName === 'SELECT') return input.options[input.selectedIndex]?.text;
                  return '';
                }).filter(v => v);
                if (label && values.length > 0) {
                  certData.push({ title: label, details: values });
                }
              });
              if (certData.length > 0) return certData;
            }
          }
          return [{ title: 'No application certification data found', details: [] }];
          
        default:
          return [{ title: 'Data not available', details: [] }];
      }
    } catch (error) {
      console.error(`Error fetching data for ${linkId}:`, error);
      return [{ title: 'Error loading data', details: [`Error: ${error.message}`] }];
    }
  }

  // Helper function to add text with word wrapping
  function addWrappedText(doc, text, x, y, maxWidth, fontSize = 10) {
    doc.setFontSize(fontSize);
    const lines = doc.splitTextToSize(text, maxWidth);
    doc.text(lines, x, y);
    return lines.length * (fontSize * 0.4); // Return height used
  }

  // Function to generate PDF and save to localStorage
  async function generateAndSavePDF(selectedLinks) {
    try {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();
      const margin = 14;
      const maxWidth = pageWidth - (margin * 2);
      
      // Set font
      doc.setFontSize(18);
      doc.setFont(undefined, 'bold');
      doc.text('Quick Links Summary', margin, 20);
      
      // Add date
      doc.setFontSize(10);
      doc.setFont(undefined, 'normal');
      const dateStr = new Date().toLocaleString();
      doc.text(`Generated: ${dateStr}`, margin, 30);
      
      // Add email if provided
      const email = document.getElementById('share-url')?.value || '';
      let yPos = 36;
      if (email) {
        doc.text(`Email: ${email}`, margin, yPos);
        yPos += 6;
      }
      
      // Add line separator
      doc.setDrawColor(200, 200, 200);
      doc.line(margin, yPos + 2, pageWidth - margin, yPos + 2);
      yPos += 10;
      
      // Fetch and add data for each selected link
      for (let index = 0; index < selectedLinks.length; index++) {
        const link = selectedLinks[index];
        
        // Check if we need a new page
        if (yPos > pageHeight - 40) {
          doc.addPage();
          yPos = 20;
        }
        
        // Section header
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text(`${index + 1}. ${link.name}`, margin, yPos);
        yPos += 8;
        
        // Fetch data for this link
        doc.setFontSize(10);
        doc.setFont(undefined, 'normal');
        doc.text('Loading data...', margin + 5, yPos);
        
        try {
          const linkData = await fetchQuickLinkData(link.id);
          
          // Remove "Loading data..." by drawing white rectangle
          doc.setFillColor(255, 255, 255);
          doc.rect(margin + 5, yPos - 5, maxWidth - 5, 5, 'F');
          
          if (linkData && linkData.length > 0) {
            linkData.forEach((item, itemIndex) => {
              // Check if we need a new page
              if (yPos > pageHeight - 30) {
                doc.addPage();
                yPos = 20;
              }
              
              // Item title
              if (item.title) {
                doc.setFont(undefined, 'bold');
                doc.setFontSize(11);
                const titleHeight = addWrappedText(doc, item.title, margin + 5, yPos, maxWidth - 5, 11);
                yPos += titleHeight + 2;
              }
              
              // Item details
              if (item.details && item.details.length > 0) {
                doc.setFont(undefined, 'normal');
                doc.setFontSize(10);
                item.details.forEach(detail => {
                  if (yPos > pageHeight - 20) {
                    doc.addPage();
                    yPos = 20;
                  }
                  const detailHeight = addWrappedText(doc, `  • ${detail}`, margin + 10, yPos, maxWidth - 10, 10);
                  yPos += detailHeight + 3;
                });
              }
              
              yPos += 3; // Space between items
            });
          } else {
            doc.setFont(undefined, 'italic');
            doc.setFontSize(10);
            doc.text('  No data available', margin + 5, yPos);
            yPos += 6;
          }
        } catch (error) {
          doc.setFillColor(255, 255, 255);
          doc.rect(margin + 5, yPos - 5, maxWidth - 5, 5, 'F');
          doc.setFont(undefined, 'normal');
          doc.setFontSize(10);
          doc.text(`  Error loading data: ${error.message}`, margin + 5, yPos);
          yPos += 6;
        }
        
        yPos += 8; // Space between sections
      }
      
      // Generate PDF as base64
      const pdfBase64 = doc.output('datauristring');
      const pdfBlob = doc.output('blob');
      
      // Convert blob to base64 for localStorage
      const reader = new FileReader();
      reader.onloadend = function() {
        const base64data = reader.result.split(',')[1]; // Remove data:application/pdf;base64, prefix
        
        // Save to localStorage
        const shareData = {
          selectedLinks: selectedLinks,
          timestamp: new Date().toISOString(),
          email: email,
          pdfBase64: base64data,
          filename: `quick_links_${new Date().toISOString().split('T')[0]}.pdf`
        };
        
        localStorage.setItem('sharedQuickLinksPDF', JSON.stringify(shareData));
        
        // Also trigger download
        doc.save(shareData.filename);
        
        if (typeof showSuccessAlert === 'function') {
          showSuccessAlert('PDF Saved', `Generated and saved PDF with ${selectedLinks.length} quick link(s) to local storage and downloaded.`);
        } else {
          alert(`Generated and saved PDF with ${selectedLinks.length} quick link(s) to local storage and downloaded.`);
        }

        // Clear email input
        const emailInput = document.getElementById('share-url');
        if (emailInput) emailInput.value = '';
      };
      reader.readAsDataURL(pdfBlob);
      
    } catch (error) {
      console.error('Error generating PDF:', error);
      if (typeof showErrorAlert === 'function') {
        showErrorAlert('Error', 'Failed to generate PDF. Please try again.');
      } else {
        alert('Failed to generate PDF. Please try again.');
      }
    }
  }

  // Close popup for any .popup-close button
  document.querySelectorAll('.popup-close').forEach(closeBtn => {
    closeBtn.addEventListener('click', function () {
        const overlay = this.closest('.popup-overlay');
        if (overlay) {
          overlay.classList.add('d-none');
        }
      });
    });
  });
</script>
