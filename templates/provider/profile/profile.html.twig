<script>
document.addEventListener('DOMContentLoaded', function () {
  const workPrefForm = document.getElementById('work-preferences-form');
  const workPrefError = document.getElementById('work-preferences-error');
  const summaryContainer = document.getElementById('work-preferences-summary');

  if (workPrefForm) {
    workPrefForm.addEventListener('submit', function (event) {
      event.preventDefault();

      if (workPrefError) {
        workPrefError.classList.add('d-none');
        workPrefError.textContent = '';
      }

      const submitBtn = document.getElementById('work-preferences-submit');
      const originalLabel = submitBtn ? submitBtn.innerHTML : null;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
      }

      fetch(workPrefForm.action, {
        method: 'POST',
        body: new FormData(workPrefForm),
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).then(response => response.json())
        .then(data => {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalLabel || 'Save Preferences';
          }

          if (data.success) {
            // Update summary content
            const summaryContent = document.getElementById('work-preferences-summary-content');
            if (summaryContent && data.summaryHtml) {
              summaryContent.innerHTML = data.summaryHtml;
            }

            // Switch back to summary view
            const summaryView = document.getElementById('work-preferences-summary-view');
            const formView = document.getElementById('work-preferences-form-view');
            if (summaryView) summaryView.style.display = 'block';
            if (formView) formView.style.display = 'none';

            if (typeof showSuccessAlert === 'function') {
              showSuccessAlert('Preferences Saved', 'Your work preferences were updated successfully.');
            }
          } else {
            const message = data.message || 'Unable to save work preferences.';
            if (workPrefError) {
              workPrefError.textContent = message;
              workPrefError.classList.remove('d-none');
            } else if (typeof showErrorAlert === 'function') {
              showErrorAlert('Error', message);
            }
          }
        })
        .catch(() => {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalLabel || 'Save Preferences';
          }

          if (workPrefError) {
            workPrefError.textContent = 'Something went wrong. Please try again.';
            workPrefError.classList.remove('d-none');
          } else if (typeof showErrorAlert === 'function') {
            showErrorAlert('Error', 'Something went wrong. Please try again.');
