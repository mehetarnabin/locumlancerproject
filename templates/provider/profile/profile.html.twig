                        <path d="M19 10H18" stroke="#1C274C" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </label>
                      {{ form_widget(profileForm.profilePictureFilename, {'attr': {'id': 'profileImageInput', 'accept': 'image/*', 'class': 'd-none'}}) }}
                    </div>

                    <div style="flex:1;">
                      {{ form_widget(profileForm.name, {'attr': {'class': 'form-control fw-semibold', 'placeholder': 'Name'}}) }}
                      {{ form_errors(profileForm.name) }}
                    </div>
                  </div>

                  <div style="margin-top: 16px; padding: 0; width: 100%; box-sizing: border-box; overflow: hidden;">
                    <!-- Nickname -->
                    <div class="info-item" style="margin-bottom: 6px; width: 100%; box-sizing: border-box;">
                      <div class="d-flex gap-2 align-items-center">
                        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#121C0C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="12" cy="7" r="4" stroke="#121C0C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {% if profileForm.nickname is defined %}
                          {{ form_widget(profileForm.nickname, {'attr': {'class': 'form-control', 'placeholder': 'Enter your preferred nickname or display name here'}}) }}
                          {{ form_errors(profileForm.nickname) }}
                        {% else %}
                          <input type="text" class="form-control" placeholder="Enter your preferred nickname or display name here" disabled style="background: #f9fafb;">
                        {% endif %}
                      </div>
                    </div>

