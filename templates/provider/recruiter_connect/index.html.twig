{% extends 'provider/base.html.twig' %}

{% block title %}Recruiter Connect{% endblock %}

{% block provider_body %}
<style>
.recruiter-connect-page {
    padding: 72px 24px;
}

.recruiter-connect-hero {
    background: linear-gradient(135deg, #101828 0%, #1D2939 60%, #344054 100%);
    border-radius: 24px;
    padding: 48px;
    color: #fff;
    box-shadow: 0 24px 50px rgba(15, 23, 42, 0.25);
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.recruiter-connect-hero h1 {
    font-size: 2rem;
    margin: 0;
}

.recruiter-connect-hero p {
    font-size: 1rem;
    margin: 0;
    opacity: 0.9;
}

.recruiter-connect-cta {
    align-self: flex-start;
    border: none;
    border-radius: 999px;
    padding: 14px 28px;
    font-weight: 600;
    font-size: 1rem;
    color: #101828;
    background: #F2F4F7;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.recruiter-connect-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(242, 244, 247, 0.35);
}

.recruiter-connect-placeholder {
    margin-top: 32px;
    border: 1px dashed #D0D5DD;
    border-radius: 20px;
    padding: 36px;
    background: #fff;
    text-align: center;
}

.recruiter-connect-placeholder h2 {
    font-size: 1.25rem;
    margin-bottom: 12px;
    color: #101828;
}

.recruiter-connect-placeholder p {
    margin: 0;
    color: #475467;
}

@media (max-width: 767.98px) {
    .recruiter-connect-page {
        padding: 48px 16px;
    }

    .recruiter-connect-hero {
        padding: 32px;
    }
}
</style>

<div class="recruiter-connect-page">
    <div class="recruiter-connect-hero">
        <span class="badge bg-light text-dark px-3 py-2" style="border-radius: 999px; width: fit-content;">Coming soon</span>
        <h1>Recruiter Connect</h1>
        <p>Browse curated recruiter support packages built by the LocumLancer team. Choose the level of help you need and fast-track your next assignment.</p>
        <a class="recruiter-connect-cta" href="#packages">See recruiter packages</a>
    </div>

    <div class="recruiter-connect-placeholder" id="packages">
        <h2>Packages will appear here</h2>
        <p>Once the admin team publishes recruiter packages, they will automatically surface on this page.</p>
    </div>
</div>
{% endblock %}


