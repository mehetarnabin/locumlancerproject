<script>
document.addEventListener('DOMContentLoaded', () => {
    const matchedTab = document.getElementById('tab-matched-jobs');
    const savedTab = document.getElementById('tab-saved-jobs');
    const matchedPane = document.getElementById('pane-matched-jobs');
    const savedPane = document.getElementById('pane-saved-jobs');
    const viewAllLink = document.getElementById('view-all-link');

    function activateTab(tab) {
        if (tab === 'matched') {
            if (matchedTab) matchedTab.classList.add('active');
            if (savedTab) savedTab.classList.remove('active');
            if (matchedPane) matchedPane.classList.add('show', 'active');
            if (savedPane) savedPane.classList.remove('show', 'active');
            if (viewAllLink) viewAllLink.href = "{{ path('app_provider_jobs_matching')|e('js') }}";
        } else {
            if (savedTab) savedTab.classList.add('active');
            if (matchedTab) matchedTab.classList.remove('active');
            if (savedPane) savedPane.classList.add('show', 'active');
            if (matchedPane) matchedPane.classList.remove('show', 'active');
            if (viewAllLink) viewAllLink.href = "{{ path('app_provider_jobs_saved')|e('js') }}";
        }
    }

    if (matchedTab) {
        matchedTab.addEventListener('click', () => activateTab('matched'));
    }
    if (savedTab) {
        savedTab.addEventListener('click', () => activateTab('saved'));
    }
});
</script>
<script>
(function() {
    function initProfileAnalytics() {
        const select = document.getElementById('profileAnalyticsSelect');
        
        if (!select) {
            return;
        }

        function showChart(chartType) {
            if (!chartType) {
                return;
            }
            
            // Get all charts dynamically each time to ensure we have the latest
            const charts = document.querySelectorAll('.analytics-chart .chart-content');
            
            // Hide all charts first - use both class and inline style to ensure it works
            charts.forEach(function(chart) {
                chart.classList.add('d-none');
                chart.style.display = 'none';
            });
            
            // Show the selected chart
            const chartId = 'chart-' + chartType;
            const activeChart = document.getElementById(chartId);
            if (activeChart) {
                activeChart.classList.remove('d-none');
                activeChart.style.display = '';
            }
        }

        // Set up change event listener
        select.addEventListener('change', function(event) {
            showChart(event.target.value);
        });

        // Initialize with the selected value
        const initialValue = select.value || 'ratio';
        showChart(initialValue);
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProfileAnalytics);
    } else {
        // DOM is already ready
        initProfileAnalytics();
    }
})();
</script>

