                <!-- Scrollable list -->
                <div class="todo-list flex-grow-1" id="todoListContainer">
                    <ul class="list-unstyled m-0 p-0" id="todoList">
                        {% if todos is defined and todos|length > 0 %}
                            {% for todo in todos %}
                            <li class="todo-item d-flex align-items-start gap-3 mb-3 todo-id-{{ todo.id }}">
                                <div class="todo-icon text-white d-flex align-items-center justify-content-center cursor-pointer todo-toggle-btn" 
                                     data-id="{{ todo.id }}" 
                                     data-completed="{{ todo.isDone ? 'true' : 'false' }}">
                                     <!-- Checkbox SVG logic based on state -->
                                    {% if todo.isDone %}
                                    <svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" fill="#85BB65"/>
                                    </svg>
                                    {% else %}
                                    
                                    {% endif %}
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="{{ path('app_provider_documents') }}" class="flex-grow-1 text-decoration-none text-dark schedule-left">
                                            <div class="fw-semibold {{ todo.isDone ? 'text-decoration-line-through text-muted' : '' }}" id="todo-title-{{ todo.id }}">
                                                {{ todo.title }}
                                                {% if todo.documentRequest %}
                                                    - <span class="text-primary">{{ todo.documentRequest.name|default('Document') }}</span>
                                                {% endif %}
                                                {% if todo.employer %}
                                                    <span class="text-muted small"> (via {{ todo.employer.companyName|default(todo.employer.name) }})</span>
                                                {% endif %}
                                            </div>
                                            {% if todo.description %}
                                            <div class="small text-muted">{{ todo.description }}</div>
                                            {% endif %}
                                        </a>
                                        <div class="schedule-right text-end">
                                            <div class="small fw-semibold" style="font-size:12px;">{{ todo.createdAt|date('M d, Y') }}</div>
                                            <div class="small text-muted" style="font-size:12px;">{{ todo.createdAt|date('h:i A') }}</div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            {% endfor %}
                        {% else %}
                            <li class="text-center text-muted" id="no-todos-msg">No pending tasks.</li>
                        {% endif %}
                    </ul>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const todoList = document.getElementById('todoList');
                        
                        // Event Delegation for Toggle
                        todoList?.addEventListener('click', function(e) {
                            // Toggle
                            const toggleBtn = e.target.closest('.todo-toggle-btn');
                            if(toggleBtn) {
                                const id = toggleBtn.dataset.id;
                                const isCompleted = toggleBtn.dataset.completed === 'true';
                                
                                fetch(`/provider/todos/${id}/toggle`, { method: 'POST' })
                                .then(res => res.json())
                                .then(data => {
                                    if(data.success) {
                                        const newStatus = data.isDone;
                                        toggleBtn.dataset.completed = newStatus;
                                        const titleEl = document.getElementById(`todo-title-${id}`);
                                        
                                        if(newStatus) {
                                            toggleBtn.innerHTML = `<svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" fill="#85BB65"/></svg>`;
                                            if(titleEl) titleEl.classList.add('text-decoration-line-through', 'text-muted');
                                            
                                            // Optional: Remove completed task from list after delay
                                            // setTimeout(() => {
                                            //     const li = document.querySelector(`.todo-id-${id}`);
                                            //     if(li) li.remove();
                                            //     if(todoList.children.length === 0) {
                                            //         todoList.innerHTML = '<li class="text-center text-muted">No pending tasks.</li>';
                                            //     }
                                            // }, 1000);

                                        } else {
                                            toggleBtn.innerHTML = ``;
                                            if(titleEl) titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                                        }
                                    }
                                });
                            }
                        });
                    });
                </script>

            </div>
