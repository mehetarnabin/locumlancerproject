{% block footer_scripts %}
<script>
// Toggle message collapse (Gmail-style)
function toggleMessageCollapse(headerElement) {
    const messageItem = headerElement.closest('.gmail-message-item');
    if (messageItem) {
        messageItem.classList.toggle('collapsed');
        const content = messageItem.querySelector('.gmail-message-content.collapsible-content');
        if (content) {
            if (messageItem.classList.contains('collapsed')) {
                content.style.display = 'none';
            } else {
                content.style.display = 'block';
            }
        }
    }
}

// Initialize - expand all messages by default
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.gmail-message-item').forEach(function(item) {
        const content = item.querySelector('.gmail-message-content.collapsible-content');
        if (content) {
            content.style.display = 'block';
        }
    });
});
// ============================================================================
// MESSAGES SYSTEM
// ============================================================================

// Draft functionality
let currentDraftId = null;

// File attachment management
let selectedFiles = [];

// Email Templates Configuration
const emailTemplates = {
    request: {
        subject: () => 'Quick check-in on this opportunity',
        message: () => `Hi there,\n\nI hope you're doing well. I'm reaching out to check in on this opportunity. I'm still very interested and would be happy to provide any additional information you might need from me.\n\nThanks so much for your time!\n\nBest,\n[YOUR NAME]`
    },
    thank: {
        subject: () => 'Thank you for the conversation',
        message: () => `Hi there,\n\nThank you again for the time you spent discussing this position. I appreciated the conversation and learning more about the team.\n\nIf there's anything else you need from me, please let me know—I'm excited about the opportunity.\n\nWarm regards,\n[YOUR NAME]`
    },
    follow: {
        subject: () => 'Following up on this opportunity',
        message: () => `Hi there,\n\nI wanted to follow up regarding this role. I'm still very enthusiastic about the opportunity and happy to share any additional information that would be helpful.\n\nThanks again for your time and consideration.\n\nBest,\n[YOUR NAME]`
    },
    details: {
        subject: () => 'Request for additional details',
        message: () => `Hi there,\n\nThanks for the update on this role. Could you share any additional details or next steps so I can prepare accordingly?\n\nI appreciate the guidance and look forward to hearing from you.\n\nBest regards,\n[YOUR NAME]`
    },
    review: {
        subject: () => 'Feedback on the process',
        message: () => `Hi there,\n\nI wanted to share feedback on the recent process. Below are a few notes that might be helpful. Please feel free to edit or add your own comments.\n\n[Add your review or feedback here]\n\nThank you for the experience!\n\nBest,\n[YOUR NAME]`
    }
};

// Toast notification function
function showToast(type, message) {
    const toast = document.createElement('div');
    toast.className = `toast-notification toast-${type}`;
    toast.innerHTML = `
        <div class="toast-content">
            <span class="toast-message">${message}</span>
            <button class="toast-close" onclick="this.parentElement.parentElement.remove()">&times;</button>
        </div>
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

// Compose Modal Functions
function openComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.remove('minimized');
    }
}

function closeComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.add('hidden');
        clearAttachments();
    }
}

function minimizeComposeModal() {
    const modal = document.getElementById('compose-modal');
    if (modal) {
        modal.classList.add('minimized');
    }
}

// File attachment functions
function initializeFileAttachments() {
    const fileInput = document.getElementById('compose-attachment');
    if (fileInput) {
        fileInput.addEventListener('change', function(e) {
            handleFileSelection(e.target.files);
        });
    }
}

function handleFileSelection(files) {
    if (!files || files.length === 0) return;
    const newFiles = Array.from(files);
    selectedFiles = [...selectedFiles, ...newFiles];
    updateFileDisplay();
    updateAttachmentButton();
}

function updateFileDisplay() {
    const attachmentDisplay = document.getElementById('file-attachment-display');
    const attachmentList = document.getElementById('file-attachment-list');
    if (!attachmentDisplay || !attachmentList) return;
    attachmentList.innerHTML = '';
    if (selectedFiles.length === 0) {
        attachmentDisplay.classList.remove('visible');
        return;
    }
    selectedFiles.forEach((file, index) => {
        const fileSize = file.size > 0 ? formatFileSize(file.size) : 'Unknown size';
        const listItem = document.createElement('li');
        listItem.className = 'file-attachment-item';
        listItem.innerHTML = `
            <div class="file-attachment-info">
                <svg class="file-attachment-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="file-attachment-name" title="${file.name}">${file.name}</span>
                <span class="file-attachment-size">${fileSize}</span>
            </div>
            <button type="button" class="file-attachment-remove" onclick="removeSelectedFile(${index})" title="Remove file">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        `;
        attachmentList.appendChild(listItem);
    });
    attachmentDisplay.classList.add('visible');
}

function updateAttachmentButton() {
    const attachmentBtn = document.getElementById('attachment-btn');
    if (attachmentBtn) {
        if (selectedFiles.length > 0) {
            attachmentBtn.classList.add('has-attachment');
            attachmentBtn.title = `${selectedFiles.length} file(s) attached`;
        } else {
            attachmentBtn.classList.remove('has-attachment');
            attachmentBtn.title = 'Attach files';
        }
    }
}

function removeSelectedFile(index) {
    if (index >= 0 && index < selectedFiles.length) {
        selectedFiles.splice(index, 1);
        updateFileDisplay();
        updateAttachmentButton();
    }
}

function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function clearAttachments() {
    selectedFiles = [];
    updateFileDisplay();
    updateAttachmentButton();
    const fileInput = document.getElementById('compose-attachment');
    if (fileInput) {
        fileInput.value = '';
    }
}

// Template dropdown functionality
document.addEventListener('DOMContentLoaded', function() {
    const dropdownBtn = document.getElementById('templatesDropdownBtn');
    const dropdownMenu = document.getElementById('templatesDropdownMenu');
    
    if (dropdownBtn && dropdownMenu) {
        dropdownBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const isOpen = dropdownMenu.style.display === 'block';
            dropdownMenu.style.display = isOpen ? 'none' : 'block';
            dropdownBtn.classList.toggle('active', !isOpen);
            
            if (!isOpen) {
                const rect = dropdownBtn.getBoundingClientRect();
                dropdownMenu.style.top = rect.bottom + 'px';
                dropdownMenu.style.left = rect.left + 'px';
            }
        });
        
        document.addEventListener('click', function(e) {
            if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                dropdownMenu.style.display = 'none';
                dropdownBtn.classList.remove('active');
            }
        });
        
        document.querySelectorAll('.template-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const templateType = this.dataset.template;
                const template = emailTemplates[templateType];
                if (!template) return;
                dropdownMenu.style.display = 'none';
                dropdownBtn.classList.remove('active');
                openComposeModal();
                setTimeout(() => {
                    const subjectInput = document.getElementById('compose-subject');
                    const messageTextarea = document.getElementById('compose-message');
                    if (subjectInput) subjectInput.value = template.subject();
                    if (messageTextarea) messageTextarea.value = template.message();
                }, 100);
            });
        });
    }
    
    initializeFileAttachments();
});
    <script>
        document.getElementById('reply-form').addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);
            const messageId = '{{ root_message.id }}';
            const button = form.querySelector('button[type="submit"]');
            const originalButtonText = button.innerHTML;

            // Show loading state
            button.disabled = true;
            button.innerHTML = '<span>Sending...</span>';

            try {
            const response = await fetch(`/provider/messages/${messageId}/reply`, {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                    // Reload the page to show the new reply in the thread
                    location.reload();
                } else {
                    showToast('error', result.error || 'An error occurred.');
                }
            } catch (error) {
                showToast('error', 'An error occurred while sending your reply.');
            } finally {
                button.disabled = false;
                button.innerHTML = originalButtonText;
            }
        });
    </script>
{% endblock %}
