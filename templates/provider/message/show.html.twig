                                    <span style="font-size: 12px; color: #5f6368; margin-left: auto;">{{ threadMsg.createdAt|date('M j, Y, g:i A') }}</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="gmail-message-actions" style="display: flex; align-items: center; gap: 8px; margin-left: 12px;">
