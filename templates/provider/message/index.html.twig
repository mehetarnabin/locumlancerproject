{% block footer_scripts %}
<script>
// ============================================================================
// MESSAGES SYSTEM - TRASH MANAGEMENT
// ============================================================================

// Draft functionality
let currentDraftId = null;

// File attachment management
let selectedFiles = [];

// Email Templates Configuration
const emailTemplates = {
    request: {
        subject: () => 'Quick check-in on this opportunity',
        message: () => `Hi there,\n\nI hope you're doing well. I'm reaching out to check in on this opportunity. I'm still very interested and would be happy to provide any additional information you might need from me.\n\nThanks so much for your time!\n\nBest,\n[YOUR NAME]`
    },
    thank: {
        subject: () => 'Thank you for the conversation',
        message: () => `Hi there,\n\nThank you again for the time you spent discussing this position. I appreciated the conversation and learning more about the team.\n\nIf there's anything else you need from me, please let me know—I'm excited about the opportunity.\n\nWarm regards,\n[YOUR NAME]`
    },
    follow: {
        subject: () => 'Following up on this opportunity',
        message: () => `Hi there,\n\nI wanted to follow up regarding this role. I'm still very enthusiastic about the opportunity and happy to share any additional information that would be helpful.\n\nThanks again for your time and consideration.\n\nBest,\n[YOUR NAME]`
    },
    details: {
        subject: () => 'Request for additional details',
        message: () => `Hi there,\n\nThanks for the update on this role. Could you share any additional details or next steps so I can prepare accordingly?\n\nI appreciate the guidance and look forward to hearing from you.\n\nBest regards,\n[YOUR NAME]`
    },
    review: {
        subject: () => 'Feedback on the process',
        message: () => `Hi there,\n\nI wanted to share feedback on the recent process. Below are a few notes that might be helpful. Please feel free to edit or add your own comments.\n\n[Add your review or feedback here]\n\nThank you for the experience!\n\nBest,\n[YOUR NAME]`
    }
};

// ============================================================================
// FILE ATTACHMENT MANAGEMENT
// ============================================================================

// Initialize file attachment handling
function initializeFileAttachments() {
    const fileInput = document.getElementById('compose-attachment');
    const attachmentBtn = document.getElementById('attachment-btn');

    if (fileInput) {
        fileInput.addEventListener('change', function(e) {
            handleFileSelection(e.target.files);
        });
    }
}

// Handle file selection
function handleFileSelection(files) {
    if (!files || files.length === 0) return;

    // Convert FileList to array and add to selectedFiles
    const newFiles = Array.from(files);
    selectedFiles = [...selectedFiles, ...newFiles];
    
    updateFileDisplay();
    updateAttachmentButton();
}

// Update file display UI
function updateFileDisplay() {
    const attachmentDisplay = document.getElementById('file-attachment-display');
    const attachmentList = document.getElementById('file-attachment-list');
    
    if (!attachmentDisplay || !attachmentList) return;

    // Clear current list
    attachmentList.innerHTML = '';

    if (selectedFiles.length === 0) {
        attachmentDisplay.classList.remove('visible');
        return;
    }

    // Add each file to the display
    selectedFiles.forEach((file, index) => {
        // Check if this is a draft file (has draftFile property)
        const isDraftFile = file.draftFile || false;
        const fileSize = file.size > 0 ? formatFileSize(file.size) : 'Unknown size';
        
        const listItem = document.createElement('li');
        listItem.className = 'file-attachment-item';
        listItem.innerHTML = `
            <div class="file-attachment-info">
                <svg class="file-attachment-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="file-attachment-name" title="${file.name}">${file.name}</span>
                <span class="file-attachment-size">${fileSize}</span>
                ${isDraftFile ? '<span class="badge" style="background: #85BB65; margin-left: 8px; font-size: 10px;">From Draft</span>' : ''}
            </div>
            <button type="button" class="file-attachment-remove" data-index="${index}" title="Remove file">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        `;
        attachmentList.appendChild(listItem);
        
        // Add click handler to remove button
        const removeBtn = listItem.querySelector('.file-attachment-remove');
        if (removeBtn) {
            removeBtn.addEventListener('click', function() {
                removeSelectedFile(index);
            });
        }
    });

    attachmentDisplay.classList.add('visible');
}

// Update attachment button state
function updateAttachmentButton() {
    const attachmentBtn = document.getElementById('attachment-btn');
    if (attachmentBtn) {
        if (selectedFiles.length > 0) {
            attachmentBtn.classList.add('has-attachment');
            attachmentBtn.title = `${selectedFiles.length} file(s) attached`;
        } else {
            attachmentBtn.classList.remove('has-attachment');
            attachmentBtn.title = 'Attach files';
        }
    }
}

// Remove selected file
function removeSelectedFile(index) {
    if (index >= 0 && index < selectedFiles.length) {
        selectedFiles.splice(index, 1);
        updateFileDisplay();
        updateAttachmentButton();
        updateFileInput();
    }
}

// Update the actual file input (since we can't directly set files for security reasons)
function updateFileInput() {
    const fileInput = document.getElementById('compose-attachment');
    if (!fileInput) return;

    // Clear the file input
    fileInput.value = '';
    
    // Note: We can't programmatically set files due to browser security
    // The files are stored in selectedFiles array and will be handled during form submission
}

// Format file size to human readable format
function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// Helper function to get file type from filename
function getFileType(filename) {
    const extension = filename.split('.').pop().toLowerCase();
    const typeMap = {
        'pdf': 'application/pdf',
        'doc': 'application/msword',
        'docx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'txt': 'text/plain',
        'jpg': 'image/jpeg',
        'jpeg': 'image/jpeg',
        'png': 'image/png',
        'gif': 'image/gif'
    };
    return typeMap[extension] || 'application/octet-stream';
}

// Clear all attachments when modal closes
function clearAttachments() {
    selectedFiles = [];
    updateFileDisplay();
    updateAttachmentButton();
    
    const fileInput = document.getElementById('compose-attachment');
    if (fileInput) {
        fileInput.value = '';
    }
}

// ============================================================================
// TRASH MANAGEMENT FUNCTIONS
// ============================================================================

// Restore message from trash
async function restoreMessage(messageId, button) {
    if (!confirm('Are you sure you want to restore this message?')) return;

    const originalContent = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<span class="loading-spinner"></span>';

    try {
        const response = await fetch(`/provider/messages/restore/${messageId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        const result = await response.json();

        if (result.success) {
            // Remove the message item from UI
            const messageItem = button.closest('.message-item');
            messageItem.style.transition = 'all 0.3s ease';
            messageItem.style.opacity = '0';
            messageItem.style.transform = 'translateX(-20px)';
            
            setTimeout(() => {
                messageItem.remove();
                updateTrashCount();
                showToast('success', result.message || 'Message restored successfully');
                
                // If no more messages, show empty state
                if (document.querySelectorAll('.message-item').length === 0) {
                    showEmptyState();
                }
            }, 300);
        } else {
            showToast('error', result.message || 'Failed to restore message');
            button.innerHTML = originalContent;
            button.disabled = false;
        }
    } catch (error) {
        console.error('Error restoring message:', error);
        showToast('error', 'An error occurred while restoring the message');
        button.innerHTML = originalContent;
        button.disabled = false;
    }
}

// Permanently delete message from trash
async function permanentlyDeleteMessage(messageId, button) {
    if (!confirm('Are you sure you want to permanently delete this message? This action cannot be undone.')) return;

    const originalContent = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<span class="loading-spinner"></span>';

    try {
        const response = await fetch(`/provider/messages/permanent-delete/${messageId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        const result = await response.json();

        if (result.success) {
            // Remove the message item from UI
            const messageItem = button.closest('.message-item');
            messageItem.style.transition = 'all 0.3s ease';
            messageItem.style.opacity = '0';
            messageItem.style.transform = 'translateX(20px)';
            
            setTimeout(() => {
                messageItem.remove();
                updateTrashCount();
                showToast('success', result.message || 'Message permanently deleted');
                
                // If no more messages, show empty state
                if (document.querySelectorAll('.message-item').length === 0) {
                    showEmptyState();
                }
            }, 300);
        } else {
            showToast('error', result.message || 'Failed to delete message');
            button.innerHTML = originalContent;
            button.disabled = false;
        }
    } catch (error) {
        console.error('Error permanently deleting message:', error);
        showToast('error', 'An error occurred while deleting the message');
        button.innerHTML = originalContent;
        button.disabled = false;
    }
}

// Empty entire trash
async function emptyTrash() {
    if (!confirm('Are you sure you want to empty the entire trash? This action cannot be undone.')) return;

    try {
        const response = await fetch('/provider/messages/empty-trash', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const result = await response.json();

        if (result.success) {
            // Remove all message items from UI
            const messageItems = document.querySelectorAll('.message-item');
            messageItems.forEach((item, index) => {
                setTimeout(() => {
                    item.style.transition = 'all 0.3s ease';
                    item.style.opacity = '0';
                    item.style.transform = 'translateX(20px)';
                    
                    setTimeout(() => item.remove(), 300);
                }, index * 100);
            });

            // Show empty state after animation
            setTimeout(() => {
                updateTrashCount();
                showEmptyState();
                showToast('success', `Trash emptied successfully (${result.deleted_count || 0} messages deleted)`);
            }, (messageItems.length * 100) + 300);
        } else {
            showToast('error', result.message || 'Failed to empty trash');
        }
    } catch (error) {
        console.error('Error emptying trash:', error);
        showToast('error', 'An error occurred while emptying trash');
    }
}

// Restore selected messages
async function restoreSelectedMessages() {
    const selectedIds = getSelectedMessageIds();
    if (selectedIds.length === 0) return;

    if (!confirm(`Are you sure you want to restore ${selectedIds.length} selected message(s)?`)) return;

    try {
        const restoreBtn = document.getElementById('restore-selected-btn');
        const originalContent = restoreBtn.innerHTML;
        restoreBtn.disabled = true;
        restoreBtn.innerHTML = '<span class="loading-spinner"></span> Restoring...';

        // Restore each selected message
        const promises = selectedIds.map(id => 
            fetch(`/provider/messages/restore/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            }).then(response => response.json())
        );

        const results = await Promise.all(promises);
        const successCount = results.filter(result => result.success).length;

        // Remove successfully restored messages from UI
        selectedIds.forEach(id => {
            const messageItem = document.querySelector(`[data-message-id="${id}"]`);
            if (messageItem) {
                messageItem.style.transition = 'all 0.3s ease';
                messageItem.style.opacity = '0';
                messageItem.style.transform = 'translateX(-20px)';
                setTimeout(() => messageItem.remove(), 300);
            }
        });

        // Update UI
        setTimeout(() => {
            updateTrashCount();
            updateTrashActionButtons();
            
            if (document.querySelectorAll('.message-item').length === 0) {
                showEmptyState();
            }
            
            showToast('success', `${successCount} message(s) restored successfully`);
        }, 300);

    } catch (error) {
        console.error('Error restoring selected messages:', error);
        showToast('error', 'An error occurred while restoring messages');
    }
}

// Permanently delete selected messages
async function permanentlyDeleteSelectedMessages() {
    const selectedIds = getSelectedMessageIds();
    if (selectedIds.length === 0) return;

    if (!confirm(`Are you sure you want to permanently delete ${selectedIds.length} selected message(s)? This action cannot be undone.`)) return;

    try {
        const deleteBtn = document.getElementById('delete-selected-btn');
        const originalContent = deleteBtn.innerHTML;
        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<span class="loading-spinner"></span> Deleting...';

        // Delete each selected message
        const promises = selectedIds.map(id => 
            fetch(`/provider/messages/permanent-delete/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                }
            }).then(response => response.json())
        );

        const results = await Promise.all(promises);
        const successCount = results.filter(result => result.success).length;

        // Remove successfully deleted messages from UI
        selectedIds.forEach(id => {
            const messageItem = document.querySelector(`[data-message-id="${id}"]`);
            if (messageItem) {
                messageItem.style.transition = 'all 0.3s ease';
                messageItem.style.opacity = '0';
                messageItem.style.transform = 'translateX(20px)';
                setTimeout(() => messageItem.remove(), 300);
            }
        });

        // Update UI
        setTimeout(() => {
            updateTrashCount();
            updateTrashActionButtons();
            
            if (document.querySelectorAll('.message-item').length === 0) {
                showEmptyState();
            }
            
            showToast('success', `${successCount} message(s) permanently deleted`);
        }, 300);

    } catch (error) {
        console.error('Error deleting selected messages:', error);
        showToast('error', 'An error occurred while deleting messages');
    }
}

// Get selected message IDs
function getSelectedMessageIds() {
    const checkboxes = document.querySelectorAll('.message-checkbox:checked');
    return Array.from(checkboxes).map(checkbox => checkbox.getAttribute('data-message-id'));
}

// Toggle select all checkboxes
function toggleSelectAll(selectAllCheckbox) {
    const checkboxes = document.querySelectorAll('.message-checkbox');
    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAllCheckbox.checked;
    });
    updateTrashActionButtons();
    updateMessageActionsToolbar();
}

// Update trash action buttons state
function updateTrashActionButtons() {
    const selectedCount = getSelectedMessageIds().length;
    const toolbar = document.getElementById('trash-actions-toolbar');
    const restoreBtn = document.getElementById('restore-selected-btn');
    const deleteBtn = document.getElementById('delete-selected-btn');
    
    // Show/hide toolbar based on selection
    if (toolbar) {
        if (selectedCount > 0) {
            toolbar.style.display = 'flex';
        } else {
            toolbar.style.display = 'none';
        }
    }
    
    if (restoreBtn) {
        restoreBtn.disabled = selectedCount === 0;
    }
    
    if (deleteBtn) {
