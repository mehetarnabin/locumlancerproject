// Load draft from server with attachment support
async function loadDraftFromServer(draftId) {
    try {
        const response = await fetch(`/provider/messages/draft/${draftId}`);
        const result = await response.json();
        
        if (result.success) {
            const draft = result.draft;
            document.getElementById('compose-receiver').value = draft.receiver_id || '';
            document.getElementById('compose-subject').value = draft.subject || '';
            document.getElementById('compose-message').value = draft.message || '';
            document.getElementById('compose-draft-id').value = draftId;
            currentDraftId = draftId;
            
            document.getElementById('draft-indicator').classList.add('visible');
            openComposeModal();
            
            // Clear any existing files first
            selectedFiles = [];
            
            // Handle attachment if exists
            if (draft.attachment && draft.attachment_info) {
                console.log('Loading draft with attachment:', draft.attachment_info);
                
                // Create a mock file object with the attachment info
                const mockFile = {
                    name: draft.attachment_info.original_filename,
                    size: draft.attachment_info.file_exists ? draft.attachment_info.file_size || 0 : 0,
                    type: getFileType(draft.attachment_info.original_filename),
                    draftFile: true,
                    actualFilename: draft.attachment // Store the actual filename for later use
                };
                
                selectedFiles = [mockFile];
                
                // Update file display
                updateFileDisplay();
                updateAttachmentButton();
                
                showToast('info', `Loaded draft with attachment: ${draft.attachment_info.original_filename}`);
            } else {
                // No attachment, ensure display is cleared
                updateFileDisplay();
                updateAttachmentButton();
            }
            
            // Auto-resize textarea
            setTimeout(() => {
                autoResizeTextarea(document.getElementById('compose-message'));
            }, 100);
        }
    } catch (error) {
        console.error('Error loading draft:', error);
        showToast('error', 'Error loading draft');
    }
}

// Delete draft from server - Now moves to trash
