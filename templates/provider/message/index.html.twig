// Handle template dropdown toggle
document.addEventListener('DOMContentLoaded', function() {
    const dropdownBtn = document.getElementById('templatesDropdownBtn');
    const dropdownMenu = document.getElementById('templatesDropdownMenu');
    const dropdownContainer = document.querySelector('.templates-dropdown-container');
    
    if (dropdownBtn && dropdownMenu && dropdownContainer) {
        // Function to position dropdown
        function positionDropdown() {
            const rect = dropdownBtn.getBoundingClientRect();
            const containerRect = dropdownContainer.getBoundingClientRect();
            
            // Center the dropdown horizontally within the container
            const dropdownWidth = 220; // max-width from CSS
            const leftOffset = (rect.width - dropdownWidth) / 2;
            
            dropdownMenu.style.top = (rect.bottom + 4) + 'px';
            dropdownMenu.style.left = (containerRect.left + leftOffset) + 'px';
            dropdownMenu.style.width = dropdownWidth + 'px';
            dropdownMenu.style.border = 'none';
            dropdownMenu.style.outline = 'none';
            dropdownMenu.style.boxShadow = 'none';
        }
        
        // Toggle dropdown
        dropdownBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isOpen = dropdownMenu.style.display === 'block';
            
            if (!isOpen) {
                positionDropdown();
                dropdownMenu.style.display = 'block';
                dropdownMenu.style.border = 'none';
                dropdownMenu.style.outline = 'none';
                dropdownMenu.style.boxShadow = 'none';
                dropdownBtn.classList.add('active');
            } else {
                dropdownMenu.style.display = 'none';
                dropdownBtn.classList.remove('active');
            }
        });
        
        // Reposition on scroll/resize
        window.addEventListener('scroll', function() {
            if (dropdownMenu.style.display === 'block') {
                positionDropdown();
            }
        }, true);
        
        window.addEventListener('resize', function() {
            if (dropdownMenu.style.display === 'block') {
                positionDropdown();
            }
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                dropdownMenu.style.display = 'none';
                dropdownBtn.classList.remove('active');
            }
        });
        
        // Handle template selection
        document.querySelectorAll('.template-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const templateType = this.dataset.template;
                const template = emailTemplates[templateType];
                
                if (!template) return;
                
                // Close dropdown
                dropdownMenu.style.display = 'none';
                dropdownBtn.classList.remove('active');
                
                // Open compose modal
                openComposeModal();
                
                // Populate with template data
                setTimeout(() => {
                    const subjectInput = document.getElementById('compose-subject');
                    const messageTextarea = document.getElementById('compose-message');
                    
                    if (subjectInput) {
                        subjectInput.value = template.subject();
                    }
                    
                    if (messageTextarea) {
                        const templateMessage = template.message();
                        messageTextarea.value = templateMessage;
                        
                        // Auto-resize textarea to fit content
                        setTimeout(() => {
                            autoResizeTextarea(messageTextarea);
                        }, 150);
                    }
                }, 100);
            });
        });
    }

    // Auto-resize textarea on input
    const messageTextarea = document.getElementById('compose-message');
    if (messageTextarea) {
        messageTextarea.addEventListener('input', function() {
            autoResizeTextarea(this);
        });
    }

    // Initialize counts
    updateDraftsCount();
    
    // Initialize message actions toolbar
    updateMessageActionsToolbar();
    updateTrashCount();
    
    // Initialize trash action buttons if in trash view
    if (window.location.href.includes('type=trash')) {
        updateTrashActionButtons();
    } else {
        // Initialize message actions toolbar for non-trash views
        updateMessageActionsToolbar();
    }
    
    // Handle message item clicks - load in split view instead of navigating
    document.addEventListener('click', function(e) {
        // Don't intercept if clicking on checkbox, button, or other interactive elements
        if (e.target.type === 'checkbox' || 
            e.target.closest('input[type="checkbox"]') || 
            e.target.closest('button') || 
            e.target.tagName === 'BUTTON' ||
            e.target.closest('.message-forward-btn') ||
            e.target.closest('.btn-new-message')) {
            return;
        }
        
        // Find the closest message-item link
        const messageLink = e.target.closest('a.message-item');
        
        if (messageLink) {
            // Prevent default navigation
            e.preventDefault();
            e.stopPropagation();
            
            // Get message ID from data attribute or href
            const messageId = messageLink.getAttribute('data-message-id') || 
                            messageLink.getAttribute('href')?.match(/\/message\/([^\/]+)/)?.[1];
            
            if (messageId && typeof loadMessageInPanel === 'function') {
                loadMessageInPanel(messageId);
            }
        }
    });
});

// Load message in detail panel - make it globally accessible
window.loadMessageInPanel = async function(messageId) {
    const panel = document.getElementById('email-detail-panel');
    const content = document.getElementById('email-detail-content');
    const messagesContainer = document.querySelector('.messages-container');
    
    if (!panel || !content) {
        return;
    }
    
    // Helper function to escape HTML to prevent XSS and syntax errors
    const escapeHtml = (str) => {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    };
    
    // Show loading state
    content.innerHTML = '<div class="email-detail-loading">Loading message...</div>';
    panel.classList.add('active');
    if (messagesContainer) {
        messagesContainer.classList.add('has-detail');
    }
    
    try {
        // Fetch message details using the show route
        const response = await fetch(`/provider/message/${messageId}/show`);
        const html = await response.text();
        
        if (response.ok) {
            // Parse the HTML
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            
            // Find the messages-content-body container (where all message content is)
            const contentContainer = doc.querySelector('.messages-content-body');
            
            if (!contentContainer) {
                console.error('Could not find .messages-content-body in response');
                content.innerHTML = '<div class="email-detail-loading">Error: Could not find message content. Please try again.</div>';
                return;
            }
            
            // Extract the entire content from messages-content-body, but remove the back button header
            const backButtonHeader = contentContainer.querySelector('.message-detail-header');
            const messageDetailContent = contentContainer.querySelector('.message-detail-content');
            const repliesSection = contentContainer.querySelector('.replies-section');
            const replyForm = contentContainer.querySelector('.reply-form-section');
            
            // Build the content HTML
            let contentHTML = '';
            
            // Extract message header and body from message-detail-content
            if (messageDetailContent) {
                const messageHeader = messageDetailContent.querySelector('.message-header-info');
                const messageBody = messageDetailContent.querySelector('.message-body');
                const attachment = messageDetailContent.querySelector('.message-attachment');
                
                if (messageHeader) {
                    const avatarImg = messageHeader.querySelector('img.message-sender-avatar, img');
                    const avatar = avatarImg ? (avatarImg.getAttribute('src') || avatarImg.src) : '';
                    const senderNameEl = messageHeader.querySelector('.message-sender-name');
                    const senderName = senderNameEl ? senderNameEl.textContent.trim() : '';
                    const dateEl = messageHeader.querySelector('.message-date');
                    const date = dateEl ? dateEl.textContent.trim() : '';
                    
                    const safeAvatar = escapeHtml(avatar);
                    const safeSenderName = escapeHtml(senderName);
                    const safeDate = escapeHtml(date);
                    
                    contentHTML += `
                        <div class="email-detail-message-header">
                            <img src="${safeAvatar}" alt="${safeSenderName}" class="email-detail-avatar">
                            <div class="email-detail-sender-info">
                                <div class="email-detail-sender-name">${safeSenderName}</div>
                                <div class="email-detail-date">${safeDate}</div>
                            </div>
                        </div>
                    `;
                }
                
                if (messageBody) {
                    const bodyText = messageBody.innerHTML || messageBody.textContent || '';
                    if (bodyText.trim()) {
                        contentHTML += `<div class="email-detail-body">${bodyText}</div>`;
                    }
                }
                
                if (attachment) {
                    let attachmentHTML = attachment.outerHTML;
                    attachmentHTML = attachmentHTML.replace(/message-attachment/g, 'email-detail-attachment');
                    contentHTML += attachmentHTML;
                }
            }
            
            // Add replies section
            if (repliesSection) {
                const repliesTitle = repliesSection.querySelector('.replies-section-title');
                const repliesTitleText = repliesTitle ? repliesTitle.textContent.trim() : 'Replies';
                const repliesList = repliesSection.querySelector('.replies-list');
                
                const safeRepliesTitleText = escapeHtml(repliesTitleText);
                
                contentHTML += `
                    <div class="email-detail-replies">
                        <div class="email-detail-replies-title">${safeRepliesTitleText}</div>
                `;
                
                if (repliesList && repliesList.children.length > 0) {
                    Array.from(repliesList.children).forEach(replyItem => {
                        let replyHTML = replyItem.outerHTML;
                        replyHTML = replyHTML.replace(/reply-item/g, 'email-detail-reply-item')
                            .replace(/reply-header/g, 'email-detail-reply-header')
                            .replace(/reply-avatar/g, 'email-detail-reply-avatar')
                            .replace(/reply-sender/g, 'email-detail-reply-sender')
                            .replace(/reply-date/g, 'email-detail-reply-date')
                            .replace(/reply-text/g, 'email-detail-reply-text')
                            .replace(/reply-attachment/g, 'email-detail-attachment');
                        contentHTML += replyHTML;
                    });
                } else {
                    contentHTML += '<div class="empty-replies">No replies yet.</div>';
                }
                
                contentHTML += '</div>';
            }
            
            // Add reply form
            if (replyForm) {
                let formHTML = replyForm.outerHTML;
                formHTML = formHTML.replace(/reply-form-section/g, 'email-detail-reply-form')
                    .replace(/id="reply-form"/g, 'id="email-detail-reply-form"')
                    .replace(/reply-form(?![^<]*>)/g, 'email-detail-reply-form');
                
                // Add forward button next to the reply button
                // Create a temporary DOM element to manipulate the form
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = formHTML;
                const form = tempDiv.querySelector('form');
                
                if (form) {
                    const submitButton = form.querySelector('button[type="submit"]');
                    if (submitButton) {
                        // Create actions container
                        const actionsContainer = document.createElement('div');
                        actionsContainer.className = 'email-detail-reply-form-actions';
                        
                        // Create forward button
                        const forwardBtn = document.createElement('a');
                        forwardBtn.href = `/provider/messages/${messageId}/forward-message`;
                        forwardBtn.className = 'email-detail-forward-btn';
                        forwardBtn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Forward
                        `;
                        
                        // Add forward button and submit button to actions container
                        actionsContainer.appendChild(forwardBtn);
                        actionsContainer.appendChild(submitButton.cloneNode(true));
                        
                        // Replace submit button with actions container
                        submitButton.parentNode.replaceChild(actionsContainer, submitButton);
                    }
                    
                    formHTML = tempDiv.innerHTML;
                }
                
                contentHTML += formHTML;
                
                // Re-initialize reply form handler
                setTimeout(() => {
                    const replyFormElement = document.querySelector('#email-detail-content #email-detail-reply-form, #email-detail-content .email-detail-reply-form form');
                    if (replyFormElement) {
                        // Remove any existing listeners by cloning
                        const newForm = replyFormElement.cloneNode(true);
                        replyFormElement.parentNode.replaceChild(newForm, replyFormElement);
                        
                        newForm.addEventListener('submit', async function(e) {
                            e.preventDefault();
                            const formData = new FormData(this);
                            
                            // Find the submit button - it might be in the actions container now
                            const actionsContainer = this.querySelector('.email-detail-reply-form-actions');
                            const button = actionsContainer ? actionsContainer.querySelector('button[type="submit"]') : this.querySelector('button[type="submit"]');
                            
                            if (!button) {
                                console.error('Submit button not found');
                                if (typeof showToast === 'function') {
                                    showToast('error', 'Submit button not found. Please refresh the page.');
                                }
                                return;
                            }
                            
                            const originalButtonText = button.innerHTML;
                            
                            button.disabled = true;
                            button.innerHTML = '<span>Sending...</span>';
                            
                            try {
                                const response = await fetch(`/provider/messages/${messageId}/reply`, {
                                    method: 'POST',
                                    body: formData
                                });
                                
                                if (!response.ok) {
                                    throw new Error(`HTTP error! status: ${response.status}`);
                                }
                                
                                const result = await response.json();
                                
                                if (result.success) {
                                    this.reset();
                                    if (typeof showToast === 'function') {
                                        showToast('success', 'Reply sent successfully');
                                    }
                                    // Reload the message to show the new reply
                                    loadMessageInPanel(messageId);
                                } else {
                                    if (typeof showToast === 'function') {
                                        showToast('error', result.error || 'An error occurred.');
                                    }
                                }
                            } catch (error) {
                                console.error('Error sending reply:', error);
                                if (typeof showToast === 'function') {
                                    showToast('error', 'An error occurred while sending your reply.');
                                }
                            } finally {
                                button.disabled = false;
                                button.innerHTML = originalButtonText;
                            }
                        });
                    }
                }, 100);
            }
            
            if (contentHTML.trim() === '') {
                content.innerHTML = '<div class="email-detail-loading">Error: Could not extract message content. Please try again.</div>';
            } else {
                content.innerHTML = contentHTML;
                
                // Mark message as read
                const messageItem = document.querySelector(`[data-message-id="${messageId}"]`);
                if (messageItem) {
                    messageItem.classList.remove('unread');
                    messageItem.classList.add('read');
                    const newBadge = messageItem.querySelector('.btn-new-message');
                    if (newBadge) {
                        newBadge.remove();
                    }
                }
            }
        } else {
            content.innerHTML = '<div class="email-detail-loading">Error loading message (Status: ' + response.status + '). Please try again.</div>';
        }
    } catch (error) {
        content.innerHTML = '<div class="email-detail-loading">Error loading message. Please try again.</div>';
    }
};

// Close email detail panel
function closeEmailDetailPanel() {
    const panel = document.getElementById('email-detail-panel');
    const messagesContainer = document.querySelector('.messages-container');
    
    if (panel) {
        panel.classList.remove('active');
    }
    if (messagesContainer) {
        messagesContainer.classList.remove('has-detail');
    }
}

</script>
