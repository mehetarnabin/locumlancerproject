// Delete selected messages (for inbox/sent/drafts)
async function deleteSelectedMessages() {
    const selectedIds = getSelectedMessageIds();
    
    if (selectedIds.length === 0) {
        showToast('error', 'Please select at least one message to delete');
        return;
    }
    
    const isDrafts = '{{ current_type }}' === 'drafts';
    const confirmMessage = isDrafts 
        ? `Are you sure you want to delete ${selectedIds.length} selected draft(s)? It will be moved to trash.`
        : `Are you sure you want to delete ${selectedIds.length} selected message(s)?`;
    
    if (!confirm(confirmMessage)) {
        return;
    }
    
    const deleteBtn = document.getElementById('delete-selected-messages-btn');
    const originalContent = deleteBtn.innerHTML;
    deleteBtn.disabled = true;
    deleteBtn.innerHTML = '<span class="loading-spinner"></span> Deleting...';
    
    try {
        let successCount = 0;
        let failCount = 0;
        
        // Delete each selected message/draft
        for (const messageId of selectedIds) {
            try {
                const messageItem = document.querySelector(`[data-message-id="${messageId}"]`) || 
                                   document.querySelector(`[data-draft-id="${messageId}"]`);
                
                let response;
                let result;
                
                if (isDrafts) {
                    // Delete draft using DELETE method - Now moves to trash
                    response = await fetch(`/provider/messages/draft/${messageId}`, {
                        method: 'DELETE'
                    });
                    result = await response.json();
                } else {
                    // Delete message using POST with CSRF token
                    const formData = new FormData();
                    formData.append('_token', '{{ csrf_token('delete') }}');
                    
                    response = await fetch(`/provider/message/${messageId}/delete`, {
                        method: 'POST',
                        body: formData
                    });
                    result = await response.json();
                }
                
                if (result.success) {
                    successCount++;
                    // Remove the message item with animation
                    if (messageItem) {
                        messageItem.style.transition = 'all 0.3s ease';
                        messageItem.style.opacity = '0';
                        messageItem.style.transform = 'translateX(-20px)';
                        setTimeout(() => {
                            messageItem.remove();
                        }, 300);
                    }
                } else {
                    failCount++;
                }
            } catch (error) {
                console.error(`Error deleting message ${messageId}:`, error);
                failCount++;
            }
        }
        
        // Update UI
        updateMessageActionsToolbar();
        updateTrashCount();
        if (isDrafts) {
            updateDraftsCount();
        }
        
        if (successCount > 0) {
            const successMessage = isDrafts 
                ? `Successfully moved ${successCount} draft(s) to trash`
                : `Successfully deleted ${successCount} message(s)`;
            showToast('success', successMessage);
        }
        if (failCount > 0) {
            const failMessage = isDrafts 
                ? `Failed to delete ${failCount} draft(s)`
                : `Failed to delete ${failCount} message(s)`;
            showToast('error', failMessage);
        }
        
        // Check if we need to show empty state
        setTimeout(() => {
            const messagesList = document.querySelector('.messages-list');
            if (messagesList && messagesList.children.length === 0) {
                showEmptyState();
            }
        }, 350);
        
    } catch (error) {
        console.error('Error deleting messages:', error);
        showToast('error', 'An error occurred while deleting messages');
    } finally {
        deleteBtn.innerHTML = originalContent;
        deleteBtn.disabled = false;
    }
}

