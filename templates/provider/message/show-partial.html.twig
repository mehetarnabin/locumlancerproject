<div class="messages-content-body">
    <!-- Message Detail -->
    <div class="message-detail-content">
        <div class="message-header-info">
            {% set senderName = message.sender.name|default(message.sender.email) %}
            {% set senderAvatar = message.sender.profilePictureFilename ? '/uploads/' ~ message.sender.id ~ '/' ~ message.sender.profilePictureFilename : '/assets/img/user-image.png' %}
            
            <img src="{{ senderAvatar }}" alt="{{ senderName }}" class="message-sender-avatar" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;">
            <div class="message-header-details">
                <div class="message-sender-name">{{ senderName }}</div>
                <div class="message-date">{{ message.createdAt|date('F j, Y \\a\\t g:i A') }}</div>
            </div>
        </div>

        <div class="message-body" style="margin-top: 20px; padding: 15px; background: #f9f9f9; border-radius: 4px;">
            {{ message.text|raw }}
        </div>

        {% if message.attachment %}
            <div style="margin-top: 15px;">
                <a href="/uploads/{{ message.sender.id }}/{{ message.attachment }}" target="_blank" class="btn btn-sm btn-outline-primary">
                    📎 {{ message.attachment }}
                </a>
            </div>
        {% endif %}
    </div>

    <!-- Replies Section -->
    <div class="replies-section" style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
        <h5 class="replies-section-title" style="margin-bottom: 15px;">Replies</h5>
        
        {% if replies is defined and replies|length > 0 %}
            <div class="replies-list">
                {% for reply in replies %}
                    {% set replySenderName = reply.sender.name|default(reply.sender.email) %}
                    {% set replySenderAvatar = reply.sender.profilePictureFilename ? '/uploads/' ~ reply.sender.id ~ '/' ~ reply.sender.profilePictureFilename : '/assets/img/user-image.png' %}
                    
                    <div class="reply-item" style="margin-bottom: 15px; padding: 12px; background: #f5f5f5; border-radius: 4px;">
                        <div class="reply-header" style="display: flex; align-items: center; margin-bottom: 10px;">
                            <img src="{{ replySenderAvatar }}" alt="{{ replySenderName }}" class="reply-avatar" style="width: 35px; height: 35px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
                            <div class="reply-sender" style="font-weight: 500; margin-right: 10px;">{{ replySenderName }}</div>
                            <div class="reply-date" style="color: #999; font-size: 0.9em;">{{ reply.createdAt|date('M j, Y g:i A') }}</div>
                        </div>
                        <div class="reply-text" style="margin-bottom: 8px; line-height: 1.5;">{{ reply.text|nl2br }}</div>
                        {% if reply.attachment %}
                            <div>
                                <a href="/uploads/{{ reply.sender.id }}/{{ reply.attachment }}" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    📎 {{ reply.attachment }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-replies" style="padding: 15px; color: #999; text-align: center;">No replies yet.</div>
        {% endif %}
    </div>

    <!-- Reply Form -->
    <div class="reply-form-section" style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
        <h5 class="reply-form-title" style="margin-bottom: 15px;">Write a Reply</h5>
        <form id="reply-form" enctype="multipart/form-data" class="reply-form">
            <textarea name="message" placeholder="Type your reply here..." required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; min-height: 120px;"></textarea>
            <div style="margin-top: 10px;">
                <input type="file" name="attachment" class="form-control" style="margin-bottom: 10px;">
                <button type="submit" class="btn btn-primary">Send Reply</button>
            </div>
        </form>
        <div id="reply-status" class="mt-2"></div>
    </div>
</div>
