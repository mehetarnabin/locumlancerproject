<div class="reply-item-professional" style="
    background: #ffffff;
    border: 1px solid #e6eef6;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
        <div style="
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #85BB65 0%, #6fa050 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 600;
            font-size: 16px;
            flex-shrink: 0;
        ">
            {{ reply.sender|first|upper }}
        </div>
        <div style="flex: 1;">
            <div style="font-weight: 600; font-size: 15px; color: #000000; margin-bottom: 4px;">
                {{ reply.sender }}
            </div>
            <div style="font-size: 12px; color: #6b7280;">
                {{ reply.createdAt|date('M j, Y \\a\\t g:i A') }}
            </div>
        </div>
    </div>
    <div style="
        font-size: 14px;
        line-height: 1.7;
        color: #202124;
        white-space: pre-wrap;
        word-wrap: break-word;
        margin-bottom: 12px;
        padding-left: 52px;
    ">
        {{ reply.text|nl2br }}
    </div>
    {% if reply.attachment %}
        <div style="padding-left: 52px;">
            <a href="/uploads/{{ reply.employer.id }}/{{ reply.attachment }}" target="_blank" style="
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 16px;
                background: #f4f9f1;
                border: 1px solid #85BB65;
                border-radius: 8px;
                text-decoration: none;
                color: #85BB65;
                font-size: 13px;
                font-weight: 500;
                transition: all 0.2s ease;
            ">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ reply.attachment }}</span>
            </a>
        </div>
    {% endif %}
</div>

<style>
.reply-item-professional:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
    border-color: #85BB65;
}
</style>
