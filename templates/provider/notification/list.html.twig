<div class="container-xl">
    <div class="notification-page">
    <section class="notification-hero">
        <div class="hero-summary">
            <div class="hero-title-block">
                <h1>Notifications</h1>
                <p>Track every credentialing request, job milestone, and platform update across dedicated internal pages.</p>
            </div>
            <div class="hero-tags">
                <span class="hero-tag">Job activity</span>
                <span class="hero-tag">Compliance &amp; docs</span>
                <span class="hero-tag">Messages &amp; reviews</span>
            </div>
        </div>
        <div class="hero-metrics">
            <div class="metric-card">
                <span>{{ notificationStats.unread }}</span>
                <small>Unread alerts</small>
            </div>
            <div class="metric-card">
                <span>{{ notificationStats.weekly }}</span>
                <small>New this week</small>
            </div>
            <div class="metric-card">
                <span>{{ notificationStats.total }}</span>
                <small>Total notifications</small>
            </div>
            <div class="metric-card">
                <span>
                    {% if notificationStats.lastActivity %}
                        {{ notificationStats.lastActivity|time_diff }}
                    {% else %}
                        —
                    {% endif %}
                </span>
                <small>Last update</small>
            </div>
        </div>
    </section>

    <div class="notification-toolbar">
        <div class="filter-group">
            <button class="filter-pill active" data-notification-filter="all">All</button>
            <button class="filter-pill" data-notification-filter="unread">Unread</button>
            {% for sectionKey, section in preferenceSections %}
                <button class="filter-pill" data-notification-filter="{{ sectionKey }}">{{ section.title }}</button>
            {% endfor %}
        </div>
            <button class="btn-preferences" type="button" id="openPreferencesBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Edit preferences
        </button>
    </div>

    <div class="notification-nav">
        {% for sectionKey, section in preferenceSections %}
            <a href="#section-{{ sectionKey }}" data-filter-trigger="{{ sectionKey }}">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>{{ section.title }}</strong>
                    <span class="badge bg-light text-dark">{{ (notificationsBySection[sectionKey] ?? [])|length }} updates</span>
                </div>
                <small>{{ section.description }}</small>
            </a>
        {% endfor %}
    </div>

    {% for sectionKey, section in preferenceSections %}
        <section class="notification-section" id="section-{{ sectionKey }}" data-notification-section="{{ sectionKey }}">
            <div class="section-header">
                <div>
                    <h3 class="mb-1">{{ section.title }}</h3>
                    <p class="text-muted mb-0">{{ section.description }}</p>
                </div>
                <span class="badge bg-light text-dark">{{ (notificationsBySection[sectionKey] ?? [])|length }} updates</span>
            </div>
            <div class="section-feed" data-section-feed="{{ sectionKey }}">
                {% set sectionNotifications = notificationsBySection[sectionKey] ?? [] %}
                {% if sectionNotifications is not empty %}
                    {% for notification in sectionNotifications %}
                        {% set notificationLink = '#' %}
                        {% if notification.notificationType in ['job_applied', 'bookmark_created', 'job_matching'] %}
                            {% set notificationLink = path('app_provider_jobs_detail', {'id': notification.extraData.job}) %}
                        {% elseif notification.notificationType in ['provider_in_review', 'provider_shortlist', 'provider_hired', 'review_request', 'provider_offered'] %}
                            {% set notificationLink = path('app_provider_jobs_application_detail', {'id': notification.extraData.application}) %}
                        {% elseif notification.notificationType in ['provider_reviewed'] %}
                            {% set notificationLink = path('app_provider_reviews') %}
                        {% elseif notification.notificationType in ['message_received'] %}
                            {% set notificationLink = path('app_provider_messages') %}
                        {% elseif notification.notificationType in ['interview_scheduled'] %}
                            {% set notificationLink = path('app_provider_jobs_applications') ~ '?status=interview' %}
                        {% endif %}
                        <a href="{{ notificationLink }}" class="notification-card {{ notification.seen ? '' : 'unread' }}" data-section="{{ sectionKey }}" data-read="{{ notification.seen ? 1 : 0 }}">
                            <div class="app-icon-holder">
                                {% include 'provider/partials/_notification_icon.html.twig' with {'notificationType': notification.notificationType} %}
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="notification-badge">{{ section.title }}</span>
                                        <strong>{{ notification.notificationType | replace({'_': ' '}) | title }}</strong>
                                    </div>
                                    <small class="text-muted">{{ notification.createdAt|time_diff }}</small>
                                </div>
                                <p class="mb-0 text-secondary">{{ notification.message }}</p>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
                <div class="notification-empty{% if sectionNotifications is not empty %} d-none{% endif %}" data-empty-state>
                    <p class="mb-1 fw-bold">No {{ section.title|lower }} updates yet.</p>
                        <p class="text-muted mb-0">We'll surface alerts here as soon as something changes.</p>
                </div>
            </div>
        </section>
    {% endfor %}

    {% if notificationStats.total > 0 %}
        <div class="align-self-center">
            {{ pagerfanta(notificationsPager, 'twitter_bootstrap5') }}
        </div>
    {% endif %}

        <!-- Notification Preferences Modal -->
        <div class="modal" id="notificationPrefModal" tabindex="-1" aria-labelledby="notificationPrefModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: 760px;">
            <div class="modal-content" style="border-radius: 18px;">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="notificationPrefModalLabel">Notification Preferences</h5>
                        <p class="text-muted mb-0">Fine-tune how Locumlancer notifies you across internal pages.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between flex-wrap gap-3 align-items-center mb-3">
                        <span class="fw-semibold">Toggle entire notification feed</span>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="toggle-all">
                            <label class="form-check-label fw-semibold" for="toggle-all">Toggle all</label>
                        </div>
                    </div>
                    <div class="preferences-grid">
                        {% for sectionKey, section in preferenceSections %}
                            <div class="preference-group">
                                <h4>{{ section.title }}</h4>
                                <p class="text-muted small mb-3">{{ section.description }}</p>
                                {% if section.options is not empty %}
                                    {% for key, label in section.options %}
                                        <div class="form-check form-switch mb-2">
                                            <input
                                                class="form-check-input preference-toggle"
                                                type="checkbox"
                                                id="pref-{{ sectionKey }}-{{ key }}"
                                                data-key="{{ key }}"
                                                {% if (provider.notificationPreferences[key] ?? false) %}checked{% endif %}>
                                            <label class="form-check-label" for="pref-{{ sectionKey }}-{{ key }}">{{ label }}</label>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <p class="text-muted small mb-0">No granular preferences available yet.</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>
{% endblock %}

{% block footer_scripts %}
<script>
// Force apply styles via JavaScript - Run multiple times to ensure it sticks
function applyNotificationSpacingStyles() {
    // Reset and apply container-xl styles
    const container = document.querySelector('.container-xl');
    if (container) {
        container.style.setProperty('position', 'relative', 'important');
        container.style.setProperty('padding-left', '0', 'important');
        container.style.setProperty('padding-right', '30px', 'important');
        container.style.setProperty('margin-left', '0', 'important');
        container.style.setProperty('margin-right', '0', 'important');
        container.style.setProperty('transform', 'none', 'important');
        container.style.setProperty('max-width', '100%', 'important');
        container.style.setProperty('width', '100%', 'important');
    }
    
    // Reset app-content
    const appContent = document.querySelector('.app-content');
    if (appContent) {
        appContent.style.setProperty('position', 'relative', 'important');
        appContent.style.setProperty('padding-left', '0', 'important');
        appContent.style.setProperty('padding-right', '0', 'important');
        appContent.style.setProperty('margin-left', '0', 'important');
        appContent.style.setProperty('margin-right', '0', 'important');
        appContent.style.setProperty('max-width', '100%', 'important');
        appContent.style.setProperty('width', '100%', 'important');
    }
    
    // Reset app-wrapper
    const appWrapper = document.querySelector('.app-wrapper');
    if (appWrapper) {
        appWrapper.style.setProperty('position', 'relative', 'important');
        if (window.innerWidth >= 1200) {
            appWrapper.style.setProperty('margin-left', '250px', 'important');
            appWrapper.style.setProperty('transform', 'translateX(-150px)', 'important');
            appWrapper.style.setProperty('width', 'calc(100% - 250px + 150px)', 'important');
        } else {
            appWrapper.style.setProperty('margin-left', '0', 'important');
            appWrapper.style.setProperty('transform', 'none', 'important');
            appWrapper.style.setProperty('width', '100%', 'important');
        }
        appWrapper.style.setProperty('margin-right', '0', 'important');
        appWrapper.style.setProperty('padding-left', '0', 'important');
        appWrapper.style.setProperty('padding-right', '0', 'important');
    }
}

// Run immediately
document.addEventListener('DOMContentLoaded', applyNotificationSpacingStyles);

// Run after a short delay to override any late-loading styles
setTimeout(applyNotificationSpacingStyles, 100);
setTimeout(applyNotificationSpacingStyles, 500);

// Re-apply on window resize to override any responsive changes
window.addEventListener('resize', function() {
    setTimeout(applyNotificationSpacingStyles, 50);
});

document.addEventListener('DOMContentLoaded', function () {
    // Modal functionality - Centered popup
    const modal = document.getElementById('notificationPrefModal');
    const openBtn = document.getElementById('openPreferencesBtn');
    
    function openModal() {
        if (modal) {
            // Ensure modal is visible and centered
            modal.style.setProperty('display', 'flex', 'important');
            modal.style.setProperty('align-items', 'center', 'important');
            modal.style.setProperty('justify-content', 'center', 'important');
            modal.style.setProperty('position', 'fixed', 'important');
            modal.style.setProperty('top', '0', 'important');
            modal.style.setProperty('left', '0', 'important');
            modal.style.setProperty('right', '0', 'important');
            modal.style.setProperty('bottom', '0', 'important');
            modal.style.setProperty('z-index', '99999', 'important');
            modal.classList.add('show');
            
            // Lock body scroll
            document.body.style.overflow = 'hidden';
            document.body.style.paddingRight = '0';
            
            // Force reflow to ensure display
            void modal.offsetHeight;
            
            // Ensure dialog is centered
            const dialog = modal.querySelector('.modal-dialog');
            if (dialog) {
                dialog.style.setProperty('margin', '0 auto', 'important');
                dialog.style.setProperty('max-width', '900px', 'important');
                dialog.style.setProperty('width', '100%', 'important');
                dialog.style.setProperty('position', 'relative', 'important');
            }
            
            // Ensure content is visible
            const content = modal.querySelector('.modal-content');
            if (content) {
                content.style.setProperty('background', '#fff', 'important');
                content.style.setProperty('display', 'flex', 'important');
            }
        }
    }
    
    function closeModal() {
        if (modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        }
    }
    
    if (openBtn) {
        openBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            console.log('Opening modal...');
            openModal();
        });
    }
    
    // Close buttons
    if (modal) {
        const closeBtns = modal.querySelectorAll('[data-bs-dismiss="modal"], .btn-close, .btn-secondary');
        closeBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeModal();
            });
        });
        
        // Close on backdrop click (only on modal backdrop, not content)
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeModal();
            }
        });
    }
    
    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('show')) {
            closeModal();
        }
    });

    // Existing functionality
    const preferenceToggles = document.querySelectorAll('.preference-toggle');
    const toggleAll = document.getElementById('toggle-all');
    const filterButtons = document.querySelectorAll('[data-notification-filter]');
    const filterNavLinks = document.querySelectorAll('[data-filter-trigger]');
    const notificationCards = document.querySelectorAll('.notification-card');
    const sectionFeeds = document.querySelectorAll('[data-section-feed]');
    const notificationSections = document.querySelectorAll('[data-notification-section]');

    function updateEmptyStates() {
        sectionFeeds.forEach(feed => {
            const visibleCards = feed.querySelectorAll('.notification-card:not(.filter-hidden)');
            const emptyState = feed.querySelector('[data-empty-state]');
            if (emptyState) {
                emptyState.classList.toggle('d-none', visibleCards.length > 0);
            }
        });
    }

    function updateSectionsVisibility(filter) {
        notificationSections.forEach(section => {
            const sectionKey = section.dataset.notificationSection;
            let showSection = true;

            if (filter === 'unread') {
                const visibleCards = section.querySelectorAll('.notification-card:not(.filter-hidden)');
                showSection = visibleCards.length > 0;
            } else if (filter !== 'all') {
                showSection = sectionKey === filter;
            }

            section.classList.toggle('d-none', !showSection);
        });
    }

    function updateAllPreferences(state) {
        preferenceToggles.forEach(toggle => {
            toggle.checked = state;
        });

        fetch('{{ path('app_provider_notification_update_preferences_all') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': '{{ csrf_token('update_notification') }}'
            },
            body: JSON.stringify({
                value: state ? 1 : 0
            })
        }).catch(error => {
            console.error('Error updating all preferences:', error);
        });
    }

    function applyFilter(filter) {
        notificationCards.forEach(card => {
            const cardSection = card.dataset.section;
            const cardRead = card.dataset.read === '1';

            let isVisible = true;
            if (filter === 'unread') {
                isVisible = !cardRead;
            } else if (filter !== 'all') {
                isVisible = cardSection === filter;
            }

            card.classList.toggle('filter-hidden', !isVisible);
        });

        updateSectionsVisibility(filter);
        updateEmptyStates();
    }

    function setActiveFilter(filter) {
        filterButtons.forEach(btn => {
            const isActive = btn.dataset.notificationFilter === filter;
            btn.classList.toggle('active', isActive);
        });
        applyFilter(filter);
    }

    if (toggleAll) {
        const allChecked = Array.from(preferenceToggles).every(toggle => toggle.checked);
        toggleAll.checked = allChecked;

        toggleAll.addEventListener('change', function () {
            updateAllPreferences(this.checked);
        });
    }

    preferenceToggles.forEach(function (toggle) {
        toggle.addEventListener('change', function () {
            const preferenceKey = this.getAttribute('data-key');
            const isEnabled = this.checked ? 1 : 0;

            fetch('{{ path('app_provider_notification_update_preferences_single') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-TOKEN': '{{ csrf_token('update_notification') }}'
                },
                body: JSON.stringify({
                    key: preferenceKey,
                    value: isEnabled
                })
            }).catch(error => {
                console.error('There was a problem updating the preference:', error);
            });
        });
    });

    filterButtons.forEach(button => {
        button.addEventListener('click', function () {
            setActiveFilter(this.dataset.notificationFilter);
        });
    });

    filterNavLinks.forEach(link => {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            const filter = this.dataset.filterTrigger;
            setActiveFilter(filter);
            const targetSection = document.getElementById(`section-${filter}`);
            if (targetSection) {
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    setActiveFilter('all');
});
</script>
{% endblock %}
