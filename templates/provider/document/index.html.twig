                    console.log('Found', documentSelects.length, 'request selects');
                    
                        documentSelects.forEach(select => {
                        const requestName = select.dataset.requestName;
                        if (!requestName || select.value) {
                            console.log('Skipping request:', requestName, '(already has value or no name)');
                            return; // Skip if already has a value
                        }
                        
                        console.log('Processing request:', requestName);
                        
                        // Find matching document
                        const options = select.querySelectorAll('option[data-doc-name]');
                        let matched = false;
                        
                        console.log('  Available documents:', Array.from(options).map(o => o.dataset.docName));
                        
                        options.forEach(option => {
                            const docName = option.dataset.docName;
                            if (!docName || matched) return;
                            
                            // Improved fuzzy matching logic
                            const normalizedDocName = docName.toLowerCase().trim();
                            const normalizedRequestName = requestName.toLowerCase().trim();
                            
                            // Try multiple matching strategies
                            const exactMatch = normalizedDocName === normalizedRequestName;
                            const containsMatch = normalizedDocName.includes(normalizedRequestName) || normalizedRequestName.includes(normalizedDocName);
                            
                            // Remove common words and try matching
                            const cleanDocName = normalizedDocName.replace(/\b(upload|document|copy|of|the|a|an)\b/g, '').trim();
                            const cleanRequestName = normalizedRequestName.replace(/\b(upload|document|copy|of|the|a|an)\b/g, '').trim();
                            const cleanMatch = cleanDocName === cleanRequestName || cleanDocName.includes(cleanRequestName) || cleanRequestName.includes(cleanDocName);
                            
                            if (exactMatch || containsMatch || cleanMatch) {
                                console.log('  ✓ MATCHED:', docName, 'with request:', requestName);
                                select.value = option.value;
                                matched = true;
                                matchedCount++;
                                
                                // Create a promise for this match submission
                                const requestId = select.dataset.requestId;
                                const documentId = option.value;
                                
                                if (requestId && documentId) {
                                    const matchPromise = fetch(`/provider/document-request/${requestId}/assign-document`, {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'X-Requested-With': 'XMLHttpRequest'
                                        },
                                        body: JSON.stringify({ documentId: documentId })
                                    })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data.success) {
                                            // Remove the request card after successful match
                                            const requestCard = container.querySelector(`[data-request-id="${requestId}"]`);
                                            if (requestCard) {
                                                requestCard.closest('.request-card')?.remove();
                                            }
                                        }
                                        return data;
                                    })
                                    .catch(error => {
                                        console.error('Error matching document:', error);
                                        return { success: false };
                                    });
                                    
                                    matchPromises.push(matchPromise);
                                }
                            }
                        });
                        
                        if (!matched) {
                            console.log('  ✗ No match found for:', requestName);
                        }
                    });
                    
                    // Wait for all matches to complete
                    Promise.all(matchPromises).then(results => {
                        const successCount = results.filter(r => r.success).length;
                        
                        // Update button state
                        this.disabled = false;
                        this.innerHTML = originalText;
                        
                        // Show success message
                        if (successCount > 0) {
                            if (typeof showSuccessAlert !== 'undefined') {
                                showSuccessAlert('Success!', `Successfully matched and submitted ${successCount} document(s).`);
                            } else {
                                alert(`Successfully matched and submitted ${successCount} document(s).`);
                            }
                            
                            // Reload page after a short delay to show updated state
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                        } else if (matchedCount > 0) {
                            // Matched but submission failed
                            if (typeof showWarningAlert !== 'undefined') {
                                showWarningAlert('Warning', 'Documents were matched but some submissions failed. Please try again.');
                            } else {
                                alert('Documents were matched but some submissions failed. Please try again.');
                    }
                    window.updateRequestsSubmitButton();
                        } else {
                            // No matches found
                            if (typeof showWarningAlert !== 'undefined') {
                                showWarningAlert('No Matches', 'No matching documents found for the pending requests.');
                            } else {
                                alert('No matching documents found for the pending requests.');
                            }
                        }
                    });
                });
            }

            // Deselect All functionality for requests - clears all selections
            if (deselectAllRequestsBtn) {
                deselectAllRequestsBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const container = document.getElementById('requests-grid-view-container');
                    if (!container) return;
                    const documentSelects = container.querySelectorAll('.document-select');
                    documentSelects.forEach(select => {
                        select.value = '';
                    });
                    window.updateRequestsSubmitButton();
                });
            }

            // Submit Selected Documents for requests
            if (submitSelectedRequestsBtn) {
                submitSelectedRequestsBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const selectedPairs = window.getSelectedRequestPairs();
                    
                    if (selectedPairs.length === 0) {
                        showWarningAlert('No Selection', 'Please select at least one document and request pair.');
                        return;
                    }

                    // Show confirmation
                    if (typeof Swal !== 'undefined') {
                        const container = document.getElementById('requests-grid-view-container');
                        const uniqueCompanies = new Set();
                        selectedPairs.forEach(p => {
                            const requestCard = container ? container.querySelector(`[data-request-id="${p.requestId}"]`) : null;
                            if (requestCard) {
                                uniqueCompanies.add(requestCard.dataset.company || '');
                            }
                        });
                        
                        Swal.fire({
                            title: 'Submit Documents?',
                            text: `You are about to submit ${selectedPairs.length} document(s) to ${uniqueCompanies.size} company/companies. Continue?`,
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#85BB65',
                            cancelButtonColor: '#6b7280',
                            confirmButtonText: 'Yes, Submit',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.submitRequestDocuments(selectedPairs);
                            }
                        });
                    } else {
                        if (confirm('Submit ' + selectedPairs.length + ' document(s)?')) {
                            window.submitRequestDocuments(selectedPairs);
                        }
                    }
                });
            }

            window.submitRequestDocuments = function(pairs) {
                const submitSelectedBtn = document.getElementById('submit-selected-requests-btn');
                if (!submitSelectedBtn) return;

                // Disable button and show loading
                submitSelectedBtn.disabled = true;
                const originalText = submitSelectedBtn.innerHTML;
                submitSelectedBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

                const requestIds = pairs.map(p => p.requestId);
                const documentIds = pairs.map(p => p.documentId);

                fetch('/provider/documents/assign-multiple', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': '{{ csrf_token("assign_document") }}'
                    },
                    body: JSON.stringify({
                        requestIds: requestIds,
                        documentIds: documentIds
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showSuccessAlert('Success!', `Successfully submitted ${data.assignedRequestIds.length} document(s).`);
                        
                        // Reload page after a short delay
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        showErrorAlert('Error', data.message || 'An error occurred while submitting documents.');
                        submitSelectedBtn.disabled = false;
                        submitSelectedBtn.innerHTML = originalText;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showErrorAlert('Error', 'An error occurred while submitting documents. Please try again.');
                    submitSelectedBtn.disabled = false;
                    submitSelectedBtn.innerHTML = originalText;
                });
            };

            // Function to select document card and render preview (only for documents section now)
            function selectDocumentCard(card, section) {
                const isRequests = section === 'requests';
                // Requests now uses grid view, so skip split view logic for requests
                if (isRequests) return;
                
                const splitList = documentsSplitList;
                const splitDetails = documentsSplitDetails;
                const documentContent = documentsDocumentContent;
                const noDocumentSelected = documentsNoDocumentSelected;
                const linkedDocumentId = card.dataset.documentId;
                const linkedDocumentUrl = card.dataset.documentUrl;
                const formatValue = (val) => {
                    if (!val) return '—';
                    const normalized = String(val).trim();
                    return normalized.length ? normalized : '—';
                };
                
                // Remove active class from all cards
                splitList.querySelectorAll('.split-document-card').forEach(c => {
                    c.classList.remove('active');
                });
                
                // Add active class to selected card
                card.classList.add('active');
                
                // Get document ID and name
                const documentName = card.dataset.documentName || card.querySelector('.split-document-card-title')?.textContent || 'Document';
                const documentId = linkedDocumentId;
                const documentUrl = linkedDocumentUrl;

                
                if (documentId && documentUrl) {
                    // Hide empty state, show content
                    if (noDocumentSelected) noDocumentSelected.style.display = 'none';
                    documentContent.style.display = 'block';
                    
                    // Determine file type and render accordingly
                    const fileExtension = documentUrl.split('.').pop().toLowerCase();
                    let previewHTML = '';
                    
                    if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(fileExtension)) {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="/provider/documents/view/${documentId}" class="action-btn" title="View Full Page">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            View Full Page
                                        </a>
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            Open in New Tab
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame">
                                    <img src="${documentUrl}" alt="${documentName}" />
                                </div>
                            </div>
                        `;
                    } else if (['pdf'].includes(fileExtension)) {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="/provider/documents/view/${documentId}" class="action-btn" title="View Full Page">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            View Full Page
                                        </a>
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            Open in New Tab
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame">
                                    <iframe src="${documentUrl}" type="application/pdf"></iframe>
                                </div>
                            </div>
                        `;
                    } else {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame" style="display: flex; align-items: center; justify-content: center; padding: 40px;">
                                    <div style="text-align: center;">
                                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 16px; opacity: 0.5;">
                                            <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <p style="color: #6b7280; margin-bottom: 16px;">Preview not available for this file type</p>
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            <a href="/provider/documents/view/${documentId}" class="action-btn" style="display: inline-flex; padding: 8px 16px;">
                                                View Full Page
                                            </a>
                                            <a href="${documentUrl}" target="_blank" class="action-btn" style="display: inline-flex; padding: 8px 16px;">
                                                Open in New Tab
                                            </a>
                                        </div>
