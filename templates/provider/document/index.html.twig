                    <div id="documents-document-content" style="display: none;"></div>
                </div>
        </div>
    </div>

            {# Document History Tab Content #}
            <div class="tab-content" id="document-history-tab">
                <div class="document-table-wrapper">
                            {% set historyEntries = [] %}
                            
                            {# Add document upload history #}
                            {% for document in documents %}
                                {% set historyEntries = historyEntries|merge([{
                                    'name': document.category ?: document.name,
                                    'action': 'uploaded',
                                    'date': document.createdAt,
                                    'details': 'Document uploaded to your library',
                                    'employer': null
                                }]) %}
                                
                                {% if document.updatedAt and document.updatedAt != document.createdAt %}
                                    {% set historyEntries = historyEntries|merge([{
                                        'name': document.category ?: document.name,
                                        'action': 'updated',
                                        'date': document.updatedAt,
                                        'details': 'Document information updated',
                                        'employer': null
                                    }]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Add document assignment history #}
                            {% for documentRequest in documentRequests %}
                                {% if documentRequest.providedAt %}
                                    {% set employerName = documentRequest.application.employer.companyName ?? 'employer' %}
                                    {% set historyEntries = historyEntries|merge([{
                                        'name': documentRequest.name,
                                        'action': 'assigned',
                                        'date': documentRequest.providedAt,
                                        'details': 'Document assigned to ' ~ employerName,
                                        'employer': employerName
                                    }]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Sort history by date (newest first) #}
                            {% set historyEntries = historyEntries|sort((a, b) => b.date <=> a.date) %}
                            
                            {# Group entries into bundles based on employer and time window (1 hour) #}
                            {% set bundles = [] %}
                            {% set processedIndices = [] %}
                            
                            {% for i, entry in historyEntries %}
                                {% if i not in processedIndices and entry.employer %}
                                    {# Find all entries for the same employer within the time window (1 hour) #}
                                    {% set bundleEntries = [entry] %}
                                    {% set processedIndices = processedIndices|merge([i]) %}
                                    {% set bundleStartDate = entry.date %}
                                    
                                    {% for j, otherEntry in historyEntries %}
                                        {% if j not in processedIndices and otherEntry.employer == entry.employer %}
                                            {# Check if within 1 hour window - compare timestamps #}
                                            {% set startTimestamp = bundleStartDate.timestamp %}
                                            {% set otherTimestamp = otherEntry.date.timestamp %}
                                            {% set timeDiff = (otherTimestamp - startTimestamp)|abs %}
                                            {% if timeDiff <= 3600 %}
                                                {% set bundleEntries = bundleEntries|merge([otherEntry]) %}
                                                {% set processedIndices = processedIndices|merge([j]) %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    
                                    {# Create bundle if 2+ entries, otherwise keep as individual #}
                                    {% if bundleEntries|length >= 2 %}
                                        {% set sortedBundleEntries = bundleEntries|sort((a, b) => b.date <=> a.date) %}
                                        {% set bundles = bundles|merge([{
                                            'type': 'bundle',
                                            'entries': sortedBundleEntries,
                                            'employer': entry.employer,
                                            'date': sortedBundleEntries|first.date,
                                            'count': bundleEntries|length
                                        }]) %}
                                    {% else %}
                                        {# Add individual entries that don't form bundles #}
                                        {% for bundleEntry in bundleEntries %}
                                            {% set bundles = bundles|merge([{
                                                'type': 'individual',
                                                'entry': bundleEntry
                                            }]) %}
                                        {% endfor %}
                                    {% endif %}
                                {% elseif i not in processedIndices %}
                                    {# Entry without employer (uploaded/updated) - keep as individual #}
                                    {% set bundles = bundles|merge([{
                                        'type': 'individual',
                                        'entry': entry
                                    }]) %}
                                    {% set processedIndices = processedIndices|merge([i]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Sort bundles by date (newest first) - using date comparison #}
                            {% set bundles = bundles|sort((a, b) => 
                                (a.type == 'bundle' ? a.date : a.entry.date) > (b.type == 'bundle' ? b.date : b.entry.date) ? -1 : 1
                            ) %}
                    
                    <div class="document-header">
                        <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">S. No</div>
                        <div class="col-history-name" style="flex: 2; justify-content: flex-start;">Document Name</div>
                        <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">Action</div>
                        <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">Date & Time</div>
                        <div class="col-history-details" style="flex: 2; justify-content: flex-start;">Details</div>
                    </div>
                            
                            <div id="history-entries-container">
                            {% if bundles|length > 0 %}
                                {% set historyEntriesPerPage = 10 %}
                                {% set currentIndex = 0 %}
                                {% for bundle in bundles %}
                                    {% if bundle.type == 'bundle' %}
                                        {# Bundle tile #}
                                        {% set currentIndex = currentIndex + 1 %}
                                        <div class="history-bundle-wrapper" data-bundle-index="{{ loop.index0 }}" {% if currentIndex > historyEntriesPerPage %}style="display: none;"{% endif %}>
                                            <div class="document-row history-bundle-tile" data-bundle-id="bundle-{{ loop.index0 }}" style="cursor: pointer; background-color: #f8f9fa; border-left: 4px solid #85BB65;">
                                                <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">{{ currentIndex }}</div>
                                                <div class="col-history-name" style="flex: 2; justify-content: flex-start;">
                                                    <strong>
                                                        {{ bundle.count }} documents submitted to {{ bundle.employer }}
                                                    </strong>
                                                </div>
                                                <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">
                                                    <span class="action-badge assigned">Bundle</span>
                                                </div>
                                                <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">{% if bundle.date %}{{ bundle.date|date('m/d/Y g:i A') }}{% else %}—{% endif %}</div>
                                                <div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000; display: flex; align-items: center; gap: 8px;">
                                                    <span>Click to expand</span>
                                                    <span class="bundle-arrow" style="transition: transform 0.3s ease;">▼</span>
                                                </div>
                                            </div>
                                            {# Bundle content (hidden by default) #}
                                            <div class="history-bundle-content" id="bundle-content-{{ loop.index0 }}" style="display: none;">
                                                {% for entry in bundle.entries %}
                                                    <div class="document-row history-entry bundle-entry" style="padding-left: 40px; background-color: #ffffff; border-left: 2px solid #e6eef6;">
                                                        <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">—</div>
                                <div class="col-history-name" style="flex: 2; justify-content: flex-start;">
                                            <strong>{{ entry.name }}</strong>
                                </div>
                                <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">
                                            {% if entry.action == 'uploaded' %}
                                                <span class="action-badge uploaded">Uploaded</span>
                                            {% elseif entry.action == 'updated' %}
                                                <span class="action-badge updated">Updated</span>
                                            {% elseif entry.action == 'assigned' %}
                                                <span class="action-badge assigned">Assigned</span>
                                            {% endif %}
                                </div>
                                <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">{% if entry.date %}{{ entry.date|date('m/d/Y g:i A') }}{% else %}—{% endif %}</div>
                                <div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000;">{{ entry.details }}</div>
                            </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% else %}
                                        {# Individual entry #}
                                        {% set currentIndex = currentIndex + 1 %}
                                        <div class="document-row history-entry" data-entry-index="{{ loop.index0 }}" {% if currentIndex > historyEntriesPerPage %}style="display: none;"{% endif %}>
                                            <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">{{ currentIndex }}</div>
                                            <div class="col-history-name" style="flex: 2; justify-content: flex-start;">
                                                <strong>{{ bundle.entry.name }}</strong>
                                            </div>
                                            <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">
                                                {% if bundle.entry.action == 'uploaded' %}
                                                    <span class="action-badge uploaded">Uploaded</span>
                                                {% elseif bundle.entry.action == 'updated' %}
                                                    <span class="action-badge updated">Updated</span>
                                                {% elseif bundle.entry.action == 'assigned' %}
                                                    <span class="action-badge assigned">Assigned</span>
                                                {% endif %}
                                            </div>
                                            <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">{% if bundle.entry.date %}{{ bundle.entry.date|date('m/d/Y g:i A') }}{% else %}—{% endif %}</div>
                                            <div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000;">{{ bundle.entry.details }}</div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                        <div class="document-row" style="justify-content: center; align-items: center; padding: 40px; display: flex;">
                            <div style="text-align: center; width: 100%;">
                                <div class="empty-state-icon" style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5; display: flex; justify-content: center;">📊</div>
                                <p class="mb-0" style="font-size: 14px; color: #000000 !important; text-align: center;">No history available</p>
                            </div>
                        </div>
                            {% endif %}
                            </div>
                            
                            {# Store bundles data for JavaScript pagination #}
                            <script type="application/json" id="history-bundles-data">{{ bundles|json_encode|raw }}</script>
                            
                            {# Pagination Controls #}
                            {% set totalBundles = bundles|length %}
                            {% set historyEntriesPerPage = 10 %}
                            {% set totalPages = (totalBundles / historyEntriesPerPage)|round(0, 'ceil') %}
                            {% if totalBundles > historyEntriesPerPage %}
                            <div class="history-pagination-wrapper" style="margin-top: 20px; padding-top: 16px; border-top: 1px solid #e6eef6;" id="history-pagination-wrapper">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div class="pagination-info" style="font-size: 14px; color: #6b7280;">
                                        Showing <span id="history-start-index">1</span> - <span id="history-end-index">{{ totalBundles > historyEntriesPerPage ? historyEntriesPerPage : totalBundles }}</span> of <span id="history-total-count">{{ totalBundles }}</span> entries
                                    </div>
                                    <nav aria-label="History pagination">
                                        <ul class="pagination mb-0" id="history-pagination">
                                            <li class="page-item" id="history-prev-page">
                                                <a class="page-link" href="#" aria-label="Previous">
                                                    <span aria-hidden="true">&laquo;</span>
                                                </a>
                                            </li>
                                            {% for page in 1..totalPages %}
                                            <li class="page-item history-page-item {% if page == 1 %}active{% endif %}" data-page="{{ page }}">
                                                <a class="page-link" href="#">{{ page }}</a>
                                            </li>
                                            {% endfor %}
                                            <li class="page-item" id="history-next-page">
                                                <a class="page-link" href="#" aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                            {% endif %}
                </div>
            </div>
        </div>
    </div>
    </div>
{% endblock %}

{% block footer_scripts %}
    <script src="{{ asset('assets/admin/js/form-validation.js') }}"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Alert helper functions using SweetAlert2
        function showSuccessAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: title,
                    text: message,
                    confirmButtonColor: '#85BB65'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showErrorAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: title,
                    text: message,
                    confirmButtonColor: '#dc3545'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showWarningAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: title,
                    text: message,
                    confirmButtonColor: '#ffc107'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showInfoAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'info',
                    title: title,
                    text: message,
                    confirmButtonColor: '#0dcaf0'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showConfirmAlert(title, message, confirmText, cancelText, callback) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: confirmText || 'Yes',
                    cancelButtonText: cancelText || 'Cancel'
                }).then((result) => {
                    if (callback) {
                        callback(result.isConfirmed);
                    }
                });
            } else {
                if (confirm(title + ': ' + message)) {
                    if (callback) callback(true);
                } else {
                    if (callback) callback(false);
                }
            }
        }

        // Tab functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Function to switch to a specific tab
            function switchToTab(tabName) {
                // Remove active class from all tabs and contents
                document.querySelectorAll('.documents-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                
                // Find and activate the target tab
                const targetTab = document.querySelector(`.documents-tab[data-tab="${tabName}"]`);
                if (targetTab) {
                    targetTab.classList.add('active');
                }
                
                // Show/hide split view button based on active tab
                const splitViewBtn = document.getElementById('documents-split-view-btn');
                if (splitViewBtn) {
                    if (tabName === 'document-history' || tabName === 'credentials') {
                        splitViewBtn.style.display = 'none';
                    } else {
                        splitViewBtn.style.display = 'flex';
                    }
                }
                
                // Show corresponding content
                const content = document.getElementById(`${tabName}-tab`);
                if (content) {
                    content.classList.add('active');
                    // Scroll to the tab section
                    setTimeout(() => {
                        content.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }
            }
            
            // Handle hash navigation (for dropdown links)
            if (window.location.hash) {
                const hash = window.location.hash.substring(1); // Remove #
                if (hash === 'uploaded-documents-tab' || hash === 'document-history-tab') {
                    const tabName = hash.replace('-tab', '');
                    switchToTab(tabName);
                }
            }
            
            // Listen for hash changes
            window.addEventListener('hashchange', function() {
                const hash = window.location.hash.substring(1);
                if (hash === 'uploaded-documents-tab' || hash === 'document-history-tab') {
                    const tabName = hash.replace('-tab', '');
                    switchToTab(tabName);
                }
            });
            
            // Tab switching - only for Documents section tabs, not Document Requests
            document.querySelectorAll('.documents-tab').forEach(tab => {
                const parentCard = tab.closest('.card.app-card-settings');
                const cardTitle = parentCard ? parentCard.querySelector('.card-title') : null;
                // Skip tabs in Document Requests section
                if (cardTitle && cardTitle.textContent.includes('Pending Document Requests')) {
                    return;
                }
                tab.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    switchToTab(tabId);
                });
            });
            
            // Initialize split view button visibility based on active tab
            const activeTab = document.querySelector('.documents-tab.active');
            if (activeTab) {
                const activeTabName = activeTab.getAttribute('data-tab');
                const splitViewBtn = document.getElementById('documents-split-view-btn');
                if (splitViewBtn) {
                    if (activeTabName === 'document-history' || activeTabName === 'credentials') {
                    splitViewBtn.style.display = 'none';
                    } else {
                        splitViewBtn.style.display = 'flex';
                    }
                }
            }

            // Tab functionality for Document Requests section
            const documentRequestsCard = document.querySelector('.card.app-card-settings .card-title');
            if (documentRequestsCard && documentRequestsCard.textContent.includes('Pending Document Requests')) {
                const requestsCard = documentRequestsCard.closest('.card.app-card-settings');
                const matchAllBtn = document.getElementById('match-all-requests-btn');
                
                function switchDocumentRequestTab(tabName) {
                    // Remove active class from all tabs in this card only
                    requestsCard.querySelectorAll('.documents-tab').forEach(t => {
                        t.classList.remove('active');
                    });
                    
                    // Remove active class from all tab contents in requests grid container
                    const requestsContainer = document.getElementById('requests-grid-view-container');
                    if (requestsContainer) {
                        requestsContainer.querySelectorAll('.tab-content').forEach(c => {
                            c.classList.remove('active');
                        });
                    }
                    
                    // Find and activate the target tab
                    const targetTab = requestsCard.querySelector(`.documents-tab[data-tab="${tabName}"]`);
                    if (targetTab) {
                        targetTab.classList.add('active');
                    }
                    
                    // Show corresponding content
                    const content = document.getElementById(`${tabName}-tab`);
                    if (content) {
                        content.classList.add('active');
                    }
                    
                    // Update button text based on active tab
                    if (matchAllBtn) {
                        if (tabName === 'documents-requests') {
                            matchAllBtn.textContent = 'Match and Send All';
                        } else if (tabName === 'links-requests' || tabName === 'sign-document-requests') {
                            matchAllBtn.textContent = 'Send All';
                        }
                    }
                }
                
                // Tab switching for document requests - stop propagation to prevent conflicts
                requestsCard.querySelectorAll('.documents-tab').forEach(tab => {
                    tab.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const tabId = this.getAttribute('data-tab');
                        // Only handle document request tabs
                        if (tabId === 'documents-requests' || tabId === 'links-requests' || tabId === 'sign-document-requests') {
                            switchDocumentRequestTab(tabId);
                        }
                    });
                });
                
                // Initialize button text based on default active tab
                const activeTab = requestsCard.querySelector('.documents-tab.active');
                if (activeTab && matchAllBtn) {
                    const activeTabName = activeTab.getAttribute('data-tab');
                    if (activeTabName === 'documents-requests') {
                        matchAllBtn.textContent = 'Match and Send All';
                    } else if (activeTabName === 'links-requests' || activeTabName === 'sign-document-requests') {
                        matchAllBtn.textContent = 'Send All';
                    }
                }
            }

            // Initialize flatpickr
            if (typeof flatpickr !== 'undefined') {
                document.querySelectorAll('.js-datepicker').forEach(function(input) {
                    if (!input._flatpickr) {
                        flatpickr(input, {
                            dateFormat: "Y-m-d"
                        });
                    }
                });
            } else if (typeof $ !== 'undefined' && $.fn.flatpickr) {
                $(".js-datepicker").flatpickr();
            }

            // File upload dropzone functionality
            const dropzone = document.getElementById('uploadDropzone');
            const fileInput = document.getElementById('fileInput');

            if (dropzone && fileInput) {
                // Click to upload
                dropzone.addEventListener('click', function(e) {
                    if (e.target.closest('.file-badge') || e.target.closest('.file-remove-btn')) {
                        return;
                    }
                    fileInput.click();
                });

                // Drag and drop
                dropzone.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#e8f4e8';
                });

                dropzone.addEventListener('dragleave', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#F4F9F1';
                });

                dropzone.addEventListener('drop', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#F4F9F1';
                    
                    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleFileChange(fileInput);
                    }
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            initializeDocumentCategoryLogic();
        });

        function initializeDocumentCategoryLogic() {
            const categorySelect = document.getElementById('document_category');
            const issueWrapper = document.getElementById('issue-date-wrapper');
            const expiryWrapper = document.getElementById('expiration-date-wrapper');
            const issueInput = document.getElementById('document_issueDate');
            const expiryInput = document.getElementById('document_expirationDate');
            const expiryHelp = document.getElementById('expiration-date-help');

            if (!categorySelect || !issueWrapper || !expiryWrapper || !issueInput || !expiryInput) {
                return;
            }

            const defaultConfig = { showIssue: true, showExpiry: true, autoExpiryDays: 0 };
            const documentConfigs = {
                "Driver's license": { showIssue: true, showExpiry: true },
                "Copy of passport": { showIssue: true, showExpiry: true },
                'Passport photo 2" x 2"': { showIssue: false, showExpiry: false },
                'USMLE Step 1-3/COMLEX': { showIssue: true, showExpiry: true },
                'Specialty and Subspecialty Exam Certification': { showIssue: false, showExpiry: false },
                'Medical school diploma': { showIssue: false, showExpiry: false },
                'Postgraduate certificates (eg: Residency and Fellowship completion)': { showIssue: false, showExpiry: false },
                'Life support certifications': { showIssue: false, showExpiry: false },
                'Active and Inactive medical licenses': { showIssue: true, showExpiry: true },
                'All DEAs': { showIssue: true, showExpiry: true },
                'CSR (Controlled Substance Registration)': { showIssue: true, showExpiry: true },
                'Copy of undergraduate transcript': { showIssue: false, showExpiry: false },
                'Vaccine titers: Hepatitis B, Varicella, MMR': { showIssue: false, showExpiry: false },
                'Negative TB test (TST vs IGRA) in the last 12 months (or if positive a CXR is required)': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'Influenza vaccine proof': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'COVID-19 vaccine proof': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'Mask fit testing': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'MALPRACTICE (COI = CERTIFICATE OF INSURANCE of the last 10 years)': { showIssue: true, showExpiry: true },
                'PROCEDURE LOGS last 2 years': { showIssue: true, showExpiry: true },
                'Case Logs last 2 years': { showIssue: true, showExpiry: true },
                'Application/ Certification: A list of everywhere lived for the last 10 years': { showIssue: true, showExpiry: true },
                'All Hospital Affiliations and Training Programs': { showIssue: true, showExpiry: true },
                'Miscellaneous': { showIssue: false, showExpiry: false, optionalDates: true }
            };

            function applyDocumentConfig(type) {
                const config = documentConfigs[type] || defaultConfig;
                const showIssue = config.showIssue !== false;
                const showExpiry = config.showExpiry !== false;
                const autoDays = config.autoExpiryDays || 0;
                const optionalDates = config.optionalDates || false;
                const isMiscellaneous = type === 'Miscellaneous';
                const isDEA = type === 'All DEAs';

                // Handle document name field for Miscellaneous
                const nameWrapper = document.getElementById('document-name-wrapper');
                const nameInput = document.getElementById('document_name');
                if (nameWrapper && nameInput) {
                    if (isMiscellaneous) {
                        nameWrapper.style.display = 'block';
                        nameInput.required = true;
                    } else {
                        nameWrapper.style.display = 'none';
                        nameInput.required = false;
                        nameInput.value = '';
                    }
                }

                // Handle DEA name field
                const deaNameWrapper = document.getElementById('dea-name-wrapper');
                const deaNameInput = document.getElementById('dea_name');
                if (deaNameWrapper && deaNameInput) {
                    if (isDEA) {
                        deaNameWrapper.style.display = 'block';
                        deaNameInput.required = true;
                    } else {
                        deaNameWrapper.style.display = 'none';
                        deaNameInput.required = false;
                        deaNameInput.value = '';
                    }
                }

                // Handle "Add More DEA" button
                const addMoreDEABtn = document.getElementById('add-more-dea-btn');
                if (addMoreDEABtn) {
                    addMoreDEABtn.style.display = isDEA ? 'inline-block' : 'none';
                }

                // Handle issue date
                if (optionalDates) {
                    // For Miscellaneous, show dates but make them optional
                    issueWrapper.classList.remove('d-none');
                    if (issueInput) {
                        issueInput.required = false;
                    }
                } else {
                issueWrapper.classList.toggle('d-none', !showIssue);
                if (issueInput) {
                    issueInput.required = showIssue;
                    if (!showIssue) {
                        issueInput.value = '';
                    }
                    issueInput.dataset.autoExpiryDays = autoDays ? String(autoDays) : '';
                }
                }

                // Handle expiration date
                if (optionalDates) {
                    // For Miscellaneous, show dates but make them optional
                    expiryWrapper.classList.remove('d-none');
                    if (expiryInput) {
                        expiryInput.required = false;
                    }
                } else {
                expiryWrapper.classList.toggle('d-none', !showExpiry);
                if (expiryInput) {
                    expiryInput.required = showExpiry && !autoDays;
                    expiryInput.readOnly = !!autoDays;
                    expiryInput.classList.toggle('bg-light', !!autoDays);
                    if (!showExpiry) {
                        expiryInput.value = '';
                        }
                    }
                }

                if (expiryHelp) {
                    if (autoDays > 0) {
                        expiryHelp.style.display = 'block';
                        expiryHelp.textContent = 'Expiration automatically set to ' + (autoDays / 365) + ' year(s) after the issue date.';
                    } else if (optionalDates) {
                        expiryHelp.style.display = 'block';
                        expiryHelp.textContent = 'Optional: Enter expiration date if applicable.';
                    } else {
                        expiryHelp.style.display = showExpiry ? 'block' : 'none';
                        expiryHelp.textContent = showExpiry ? 'Enter the expiration date as it appears on the document.' : '';
                    }
                }

                if (autoDays > 0) {
                    updateAutoExpiration(issueInput, expiryInput, autoDays);
                }
            }

            function updateAutoExpiration(issueInput, expiryInput, days) {
                if (!issueInput || !expiryInput) return;
                if (!issueInput.value) {
                    expiryInput.value = '';
                    return;
                }
                const baseDate = new Date(issueInput.value);
                if (isNaN(baseDate.getTime())) {
                    expiryInput.value = '';
                    return;
                }
                const expiryDate = new Date(baseDate);
                expiryDate.setDate(expiryDate.getDate() + Number(days));
                expiryInput.value = expiryDate.toISOString().split('T')[0];
            }

            issueInput.addEventListener('change', function() {
                const autoDays = Number(issueInput.dataset.autoExpiryDays || 0);
                if (autoDays > 0) {
                    updateAutoExpiration(issueInput, expiryInput, autoDays);
                }
            });

            categorySelect.addEventListener('change', function() {
                applyDocumentConfig(this.value);
            });

            applyDocumentConfig(categorySelect.value);

            // Handle "Add More DEA" button - Dynamic form sections
            const addMoreDEABtn = document.getElementById('add-more-dea-btn');
            const deaFormsContainer = document.getElementById('dea-forms-container');
            const storedDEAContainer = document.getElementById('stored-dea-documents');
            let deaFormIndex = 0;

            function storeCurrentDEA() {
                const currentSection = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="' + deaFormIndex + '"]');
                if (!currentSection) return;

                const categoryInput = currentSection.querySelector('#document_category');
                const deaNameInput = currentSection.querySelector('#dea_name');
                const issueInput = currentSection.querySelector('#document_issueDate');
                const expiryInput = currentSection.querySelector('#document_expirationDate');
                const fileInput = currentSection.querySelector('#fileInput');
                const fileNameText = currentSection.querySelector('#fileNameText');

                // Check if current form has data
                const hasData = (fileInput && fileInput.files && fileInput.files.length > 0) ||
                               (issueInput && issueInput.value) ||
                               (expiryInput && expiryInput.value) ||
                               (deaNameInput && deaNameInput.value);

                if (hasData) {
                    // Store the current DEA data
                    const storedItem = document.createElement('div');
                    storedItem.className = 'stored-dea-item';
                    storedItem.dataset.deaIndex = deaFormIndex;
                    var deaIndexPlusOne = deaFormIndex + 1;
                    var deaNameHtml = (deaNameInput && deaNameInput.value) ? '<span style="margin-left: 8px; color: #000000;">' + deaNameInput.value + '</span>' : '';
                    var fileNameHtml = (fileNameText && fileNameText.textContent) ? '<span style="margin-left: 8px; color: #000000;">' + fileNameText.textContent + '</span>' : '';
                    var issueHtml = (issueInput && issueInput.value) ? '<span style="margin-left: 8px; color: #000000;">Issue: ' + issueInput.value + '</span>' : '';
                    var expiryHtml = (expiryInput && expiryInput.value) ? '<span style="margin-left: 8px; color: #000000;">Expiry: ' + expiryInput.value + '</span>' : '';
                    storedItem.innerHTML = '<div style="display: flex; justify-content: space-between; align-items: center;">' +
                        '<div>' +
                        '<strong>DEA ' + deaIndexPlusOne + '</strong>' +
                        deaNameHtml +
                        fileNameHtml +
                        issueHtml +
                        expiryHtml +
                        '</div>' +
                        '<button type="button" class="dea-form-section-remove" onclick="removeStoredDEA(' + deaFormIndex + ')">Remove</button>' +
                        '</div>';
                    storedDEAContainer.appendChild(storedItem);
                    storedDEAContainer.style.display = 'block';
                }
            }

            function createNewDEAForm() {
                deaFormIndex++;
                const currentSection = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="0"]');
                if (!currentSection) return;

                // Clone the first form section
                const newSection = currentSection.cloneNode(true);
                newSection.setAttribute('data-dea-index', deaFormIndex);
                
                // Update IDs and names to be unique
                const allInputs = newSection.querySelectorAll('input, select, textarea, label');
                allInputs.forEach(input => {
                    if (input.id) {
                        // Handle DEA name field separately
                        if (input.id === 'dea_name') {
                            input.id = 'dea_name_' + deaFormIndex;
                            if (input.name) {
                                input.name = 'dea_documents[' + deaFormIndex + '][deaName]';
                            }
                        } else {
                        input.id = input.id.replace('document_', 'document_' + deaFormIndex + '_');
                        if (input.name && input.name.startsWith('document[')) {
                            input.name = input.name.replace('document[', 'dea_documents[' + deaFormIndex + '][');
                            }
                        }
                    }
                    if (input.getAttribute('for')) {
                        const forAttr = input.getAttribute('for');
                        if (forAttr === 'dea_name') {
                            input.setAttribute('for', 'dea_name_' + deaFormIndex);
                        } else {
                            input.setAttribute('for', forAttr.replace('document_', 'document_' + deaFormIndex + '_'));
                        }
                    }
                });

                // Update DEA name wrapper ID
                const deaNameWrapper = newSection.querySelector('#dea-name-wrapper');
                if (deaNameWrapper) {
                    deaNameWrapper.id = 'dea-name-wrapper_' + deaFormIndex;
                    // Show it since it's a DEA form
                    deaNameWrapper.style.display = 'block';
                }

                // Update file input handler
                const newFileInput = newSection.querySelector('input[type="file"]');
                if (newFileInput) {
                    newFileInput.id = 'fileInput_' + deaFormIndex;
                    newFileInput.name = 'dea_documents[' + deaFormIndex + '][fileName]';
                    newFileInput.onchange = function() {
                        handleFileChange(this, deaFormIndex);
                    };
                }

                // Update badge IDs
                const newBadge = newSection.querySelector('#fileBadge');
                if (newBadge) newBadge.id = 'fileBadge_' + deaFormIndex;
                const newFileNameText = newSection.querySelector('#fileNameText');
                if (newFileNameText) newFileNameText.id = 'fileNameText_' + deaFormIndex;

                // Clear all values in new section
                newSection.querySelectorAll('input, select, textarea').forEach(input => {
                    if (input.type !== 'hidden') {
                        input.value = '';
                    }
                });

                // Set category to DEA
                const newCategoryInput = newSection.querySelector('select[name*="category"]');
                if (newCategoryInput) {
                    newCategoryInput.value = 'All DEAs';
                    newCategoryInput.dispatchEvent(new Event('change'));
                }

                // Add remove button
                const sectionHeader = document.createElement('div');
                sectionHeader.className = 'dea-form-section-header';
                sectionHeader.innerHTML = `
                    <span class="dea-form-section-title">DEA ${deaFormIndex + 1}</span>
                    <button type="button" class="dea-form-section-remove" onclick="removeDEAForm(${deaFormIndex})">Remove</button>
                `;
                newSection.insertBefore(sectionHeader, newSection.firstChild);

                // Insert before the form actions
                deaFormsContainer.appendChild(newSection);

                // Scroll to new section
                newSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            window.removeDEAForm = function(index) {
                const section = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="' + index + '"]');
                if (section) {
