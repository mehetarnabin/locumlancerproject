        // Grid View Functionality for Document Requests
        document.addEventListener('DOMContentLoaded', function() {
            // Grid view is now default for requests - no toggle button needed
            // Ensure grid view is visible and list view is hidden
            const requestsListView = document.getElementById('requests-list-view');
            const requestsGridViewContainer = document.getElementById('requests-grid-view-container');

            if (requestsListView && requestsGridViewContainer) {
                requestsListView.style.display = 'none';
                requestsGridViewContainer.style.display = 'block';
            }

            // Auto-match documents by name (case-insensitive)
            function autoMatchDocuments() {
                document.querySelectorAll('.document-select[data-request-name]').forEach(select => {
                    const requestName = select.dataset.requestName;
                    if (!requestName || select.value) return; // Skip if already has a value

                    // Find matching document
                    const options = select.querySelectorAll('option[data-doc-name]');
                    let matched = false;
                    
                    options.forEach(option => {
                        const docName = option.dataset.docName;
                        if (docName && docName === requestName && !matched) {
                            select.value = option.value;
                            matched = true;
                            
                            // Auto-submit if in grid view
                            const gridContainer = document.getElementById('requests-grid-view-container');
                            if (gridContainer && gridContainer.contains(select)) {
                                // Just select, don't auto-submit - user can use bulk submit
                                if (typeof window.updateRequestsSubmitButton === 'function') {
                                    window.updateRequestsSubmitButton();
                                }
                    } else {
                                // Auto-submit for list view
                                select.dispatchEvent(new Event('change'));
                            }
                        }
                    });
                });
            }

            // Run auto-match on page load
            autoMatchDocuments();

            // Accordion functionality for company groups - Hover to open, Click to stay
            document.querySelectorAll('.company-group-header[data-accordion-toggle]').forEach(function(header) {
                const toggleBtn = header.querySelector('.accordion-toggle-btn');
                const content = header.nextElementSibling;
                
                if (!toggleBtn || !content) return;
                
                let isLocked = false; // Track if accordion is locked open by click
                let hoverTimeout = null;
                
                // Expand function
                function expandAccordion() {
                    toggleBtn.setAttribute('aria-expanded', 'true');
                    content.classList.remove('collapsed');
                    if (content.classList.contains('requests-grid')) {
                        content.style.display = 'grid';
                    } else {
                        content.style.display = 'block';
                    }
                }
                
                // Collapse function
                function collapseAccordion() {
                    if (!isLocked) {
                        toggleBtn.setAttribute('aria-expanded', 'false');
                        content.classList.add('collapsed');
                        content.style.display = 'none';
                    }
                }
                
                // Click handler - lock/unlock the accordion
                function handleClick(e) {
                    e.stopPropagation();
                    isLocked = !isLocked;
                    if (isLocked) {
                        expandAccordion();
                    } else {
                        collapseAccordion();
                    }
                }
                
                // Hover handler - expand on hover (if not locked)
                header.addEventListener('mouseenter', function() {
                    if (!isLocked) {
                    clearTimeout(hoverTimeout);
                    expandAccordion();
                    }
                });
                
                // Mouse leave handler - collapse after delay (if not locked)
                header.addEventListener('mouseleave', function() {
                    if (!isLocked) {
                        clearTimeout(hoverTimeout);
                    hoverTimeout = setTimeout(function() {
                        collapseAccordion();
                        }, 200); // Small delay to allow moving to content
                    }
                });
                
                // Also handle mouse events on content to keep it open when hovering over it
                content.addEventListener('mouseenter', function() {
                    if (!isLocked) {
                        clearTimeout(hoverTimeout);
                        expandAccordion();
                    }
                });
                
                content.addEventListener('mouseleave', function() {
                    if (!isLocked) {
                        clearTimeout(hoverTimeout);
                        hoverTimeout = setTimeout(function() {
                        collapseAccordion();
                        }, 200);
                    }
                });
                
                // Click handlers
                header.addEventListener('click', handleClick);
                toggleBtn.addEventListener('click', handleClick);
            });

