{% extends 'provider/base.html.twig' %}

{% block title %}Documents{% endblock %}

{% block provider_body %}
<style>
/* Override base template animations for document section parent card containers with titles */
/* Target parent containers only, not embedded divs - must be more specific than base template */
#requests-grid-view-container .request-card,
#requests-grid-view-container .grid-document-card,
#requests-grid-view-container .company-group-header,
#requests-grid-view-container .grid-view-header,
#requests-grid-view-container .request-card-header,
#requests-grid-view-container .grid-document-title-wrapper,
#requests-grid-view-container .company-name-wrapper {
    transition: none !important;
    animation: none !important;
    transform: none !important;
    will-change: auto !important;
}

#requests-grid-view-container .request-card:hover,
#requests-grid-view-container .grid-document-card:hover,
#requests-grid-view-container .company-group-header:hover,
#requests-grid-view-container .grid-view-header:hover {
    transform: none !important;
    box-shadow: none !important;
}

/* Override base template card animations specifically for document section parent cards */
/* More specific selector to override base template's [class*="card"] selector */
#requests-grid-view-container [class*="card"]:not([class*="checkbox"]):not([class*="accordion"]):not(.is-card):not(.application [class*="card"]) {
    transition: none !important;
    animation: none !important;
    transform: none !important;
    will-change: auto !important;
}

#requests-grid-view-container [class*="card"]:not([class*="checkbox"]):not([class*="accordion"]):not(.is-card):not(.application [class*="card"]):hover {
    transform: none !important;
    box-shadow: none !important;
}

/* Override any flexbox animations from base template for title flexboxes */
#requests-grid-view-container [class*="header"],
#requests-grid-view-container [class*="wrapper"] {
    transition: none !important;
    animation: none !important;
    transform: none !important;
    will-change: auto !important;
}

/* Layout reset to match dashboard spacing */
body.app .app-wrapper,
.app-wrapper {
    display: block !important;
    justify-content: unset !important;
    align-items: unset !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

@media (min-width: 1200px) {
    body.app .app-wrapper,
    .app-wrapper {
        margin-left: 250px !important;
        transform: translateX(-150px) !important;
        width: calc(100% - 250px + 150px) !important;
    }
}

body.app .app-wrapper .app-content,
.app-wrapper .app-content,
.app-content {
    padding-top: 80px !important;
    padding-bottom: 48px !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
}

@media (min-width: 1200px) {
    body.app .app-wrapper .app-content,
    .app-wrapper .app-content,
    .app-content {
        width: 100% !important;
        max-width: 100% !important;
    }
}

body.app .app-wrapper .app-content .container-xl,
.app-wrapper .app-content .container-xl,
.app-content .container-xl,
body .app-content .container-xl,
div.container-xl,
[class*="container-xl"],
.container-xl {
    position: relative !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 30px !important;
    max-width: 100% !important;
    width: 100% !important;
    transform: none !important;
    box-sizing: border-box !important;
}

@media (max-width: 1199.98px) {
    body.app .app-wrapper .app-content .container-xl,
    .app-wrapper .app-content .container-xl,
    .app-content .container-xl,
    body .app-content .container-xl,
    div.container-xl,
    [class*="container-xl"],
    .container-xl {
        padding-left: 20px !important;
        padding-right: 20px !important;
    }
}

/* Modern card styles matching profile page */
.card.app-card-settings {
    border: none;
    background: #fff;
    margin-bottom: 0;
    margin-top: 0;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(16,24,40,0.06);
    padding: 0;
    display: flex;
    flex-direction: column;
}

/* Spacing between separate container sections */
.container-xl:not(:first-of-type) {
    margin-top: 24px;
}

.card.app-card-settings .card-body {
    padding: 24px !important;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px !important;
}

.card-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    color: #000000;
}

.app-page-title {
    color: #000000;
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 32px 4px;
}

/* Form styling */
.form-label-wrapper {
    padding-left: 16px;
    margin-bottom: 8px;
}

.form-label {
    font-weight: 500;
    color: #000000;
    margin-bottom: 0;
    font-size: 0.9rem;
    display: block;
    padding-left: 16px;
}

.form-control, .form-select {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
}

.form-control:focus, .form-select:focus {
    border-color: #85BB65;
    box-shadow: 0 0 0 3px rgba(133, 187, 101, 0.1);
    outline: none;
}

/* Upload dropzone styling */
.upload-dropzone {
    border: 2px dashed #85BB65;
    border-radius: 12px;
    background: #F4F9F1;
    padding: 40px 20px;
    text-align: center;
    position: relative;
    cursor: pointer;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.upload-dropzone:hover {
    background: #f0f5ec;
    border-color: #6FA050;
}

.dropzone-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
}

.dropzone-content {
    position: relative;
    z-index: 1;
}

.upload-text {
    font-size: 1rem;
    font-weight: 500;
    margin-top: 12px;
    color: #000000;
}

.upload-subtext {
    font-size: 0.85rem;
    color: #6B7280;
    margin-top: 6px;
}

.file-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #85BB65;
    color: white;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
    font-weight: 500;
}

.file-remove-btn {
    background: none;
    border: none;
    color: white;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    margin-left: 8px;
}

/* Button styling */
.btn-primary, .btn-upload {
    background: #85BB65;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 500;
    color: white;
    transition: all 0.2s ease;
}

.btn-primary:hover, .btn-upload:hover {
    background: #6FA050;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(133, 187, 101, 0.3);
}

.btn-upload {
    background: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #e5e7eb !important;
}

.btn-upload:hover {
    background: #ffffff !important;
    color: #85BB65 !important;
    border-color: #85BB65 !important;
    transform: none !important;
    box-shadow: none !important;
}

.btn-secondary {
    background: transparent;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 500;
    color: #000000;
    transition: all 0.2s ease;
}

.btn-secondary:hover {
    background: transparent;
    border-color: #85BB65;
    color: #000000;
}

.btn-outline-primary, .btn-outline-secondary {
    background: transparent;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    color: #000000;
    font-weight: 500;
    transition: all 0.2s ease;
}

.btn-outline-primary:hover, .btn-outline-secondary:hover {
    background: transparent;
    border-color: #85BB65;
    color: #000000;
}

/* Table styling */
.table {
    margin-bottom: 0;
}

.table thead th {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-weight: 600;
    font-size: 0.92rem;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 14px 16px;
    text-align: center;
}

.document-table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
}

.document-table tbody tr {
    background: #fff;
    transition: none !important;
    animation: none !important;
    transform: none !important;
}

.document-table tbody tr:hover {
    background: #F8FAF9;
    transform: none !important;
    box-shadow: none !important;
}

.document-table td {
    padding: 12px 8px;
    font-size: 12px;
    color: #000000;
    vertical-align: middle;
    border-bottom: 1px solid #f3f4f6;
}

.document-table th {
    padding: 12px 8px;
    font-size: 13px;
    font-weight: 600;
    color: #000000;
    background: #F8FAF9;
    border-bottom: 2px solid #e6eef6;
    text-align: center;
}


.document-table td div {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.document-table td small {
    text-align: center;
    display: block;
    font-size: 0.875rem;
    color: #000000;
}

/* Ensure all text-muted elements in tables have consistent styling */
.document-table .text-muted {
    font-size: 0.875rem;
    color: #000000;
}

/* Ensure all strong tags in tables have consistent styling */
.document-table td strong {
    font-weight: 500;
    color: #000000;
    font-size: 12px;
}

.document-table .text-muted {
    font-size: 12px;
    color: #000000;
}

/* Document table styling matching saved.html */
.document-table-wrapper {
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
}

.document-table-wrapper::-webkit-scrollbar {
    height: 8px;
}

.document-table-wrapper::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.document-table-wrapper::-webkit-scrollbar-thumb {
    background: #85BB65;
    border-radius: 10px;
}

.document-table-wrapper::-webkit-scrollbar-thumb:hover {
    background: #6fa852;
}

.document-header,
.document-row {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    padding: 0 8px 0 0;
}

.col-uploaded-at,
.col-doc-name,
.col-issue-date,
.col-expiry-date,
.col-actions {
    flex: 1;
    min-width: 120px;
    padding: 0 8px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
}

.col-doc-name {
    flex: 2;
    justify-content: flex-start;
}

.col-uploaded-at,
.col-issue-date,
.col-expiry-date {
    justify-content: center;
    text-align: center;
}

.col-actions {
    justify-content: center;
    min-width: 120px;
    max-width: 120px;
    flex-shrink: 0;
}

.document-header {
    font-size: 13px;
    font-weight: 600;
    color: #000000;
    letter-spacing: 0.01em;
    line-height: 1.5;
    background: #F8FAF9;
    border-bottom: 2px solid #e6eef6;
    border-radius: 10px 10px 0 0;
    border: 1px solid #e6eef6;
    border-bottom: 2px solid #e6eef6;
    height: 40px;
    margin-bottom: 2px;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
}

.document-row {
    font-size: 12px;
    font-weight: 400;
    color: #000000;
    line-height: 1.5;
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    margin-bottom: 2px;
    min-height: 48px;
    height: 48px;
}

/* Bundle styles */
.history-bundle-wrapper {
    margin-bottom: 2px;
}

.history-bundle-tile {
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.history-bundle-tile:hover {
    background-color: #f0f4f0 !important;
    box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15);
}

.history-bundle-content {
    animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
    from {
        opacity: 0;
        max-height: 0;
    }
    to {
        opacity: 1;
        max-height: 2000px;
    }
}

.bundle-entry {
    border-top: none !important;
    border-radius: 0 !important;
    margin-bottom: 0 !important;
}

.bundle-entry:last-child {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-bottom: 2px;
}

.bundle-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
}

.history-bundle-tile.expanded .bundle-arrow {
    transform: rotate(180deg);
}

.document-header > div,
.document-row > div {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    height: 48px;
}

.table tbody tr:hover {
    background: #F9FAFB;
}

.table tbody tr:last-child td {
    border-bottom: none;
}

/* Action buttons */
.action-buttons {
    display: flex;
    gap: 4px;
    align-items: center;
    flex-wrap: nowrap;
    min-width: 0;
    max-width: 100%;
}

.action-btn {
    min-width: 24px;
    min-height: 24px;
    width: auto;
    height: auto;
    padding: 3px 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border-radius: 4px;
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    transition: all 0.2s ease;
    text-decoration: none;
    font-size: 10px;
    color: #000000;
    cursor: pointer;
    flex-shrink: 0;
}

.action-btn:has(img) {
    width: 24px;
    height: 24px;
    padding: 0;
}

.action-btn:hover {
    color: #85BB65;
    border-color: #85BB65;
    transform: translateY(-1px);
}

.action-btn:hover svg {
    color: #85BB65;
    stroke: #85BB65;
}

.action-btn.active {
    color: #85BB65;
    border-color: #85BB65;
}

.action-btn.active svg {
    color: #85BB65;
    stroke: #85BB65;
}

.action-btn img {
    width: 12px;
    height: 12px;
    transition: filter 0.2s ease;
    object-fit: contain;
}

.action-btn:hover img {
    filter: brightness(0) saturate(100%) invert(48%) sepia(79%) saturate(2476%) hue-rotate(86deg) brightness(118%) contrast(119%);
}

/* DEA Multiple Upload Styles */
.dea-form-section {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    position: relative;
}

.dea-form-section:not(:first-child) {
    margin-top: 12px;
}

.dea-form-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e6eef6;
}

.dea-form-section-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #000000;
}

.dea-form-section-remove {
    background: #fee2e2;
    border: 1px solid #fecaca;
    color: #dc2626;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    cursor: pointer;
}

.dea-form-section-remove:hover {
    background: #fecaca;
}

.stored-dea-item {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 8px;
    font-size: 0.75rem;
    color: #000000;
}

/* Split View Styles */
.split-view-container {
    display: none;
    grid-template-columns: minmax(350px, 1fr) 1.5fr;
    gap: 20px;
    margin-top: 20px;
    height: 85vh;
    position: relative;
    transition: none !important;
}

.split-view-container.list-collapsed {
    grid-template-columns: 1fr !important;
    gap: 0 !important;
}

.split-view-container.list-collapsed > .split-document-list {
    display: none !important;
    grid-column: none !important;
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
    opacity: 0 !important;
    visibility: hidden !important;
    position: absolute !important;
    left: -9999px !important;
}

.split-view-container.list-collapsed > .split-document-details {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
}

.split-view-container .split-document-list {
    width: 100%;
    opacity: 1;
    position: relative;
    display: block;
}

.list-toggle-btn {
    display: none;
    position: fixed;
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    padding: 0;
    cursor: pointer;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(11,22,40,0.15);
    transition: all 0.3s ease;
    align-items: center;
    justify-content: center;
}

.list-toggle-btn:hover {
    background: #F4F9F1;
    border-color: #85BB65;
    box-shadow: 0 4px 12px rgba(133, 187, 101, 0.3);
}

.list-toggle-btn:hover svg {
    transform: scale(1.1);
}

.split-view-container.list-collapsed .list-toggle-btn:hover svg {
    transform: rotate(180deg) scale(1.1);
}

.list-toggle-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
}

.split-view-container.list-collapsed .list-toggle-btn svg {
    transform: rotate(180deg);
}

.split-document-list {
    background: #F4F9F1;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 16px;
    overflow-y: auto;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
}

.split-document-card {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: none !important;
    animation: none !important;
    transform: none !important;
}

.split-document-card:hover {
    transform: none !important;
    box-shadow: none !important;
}


.split-document-card.active {
    border-color: #85BB65;
    background: #F4F9F1;
    box-shadow: 0 2px 8px rgba(133, 187, 101, 0.2);
}

.split-document-card-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 8px;
    transition: none !important;
    animation: none !important;
    transform: none !important;
}

.split-document-card-title {
    font-size: 14px;
    font-weight: 600;
    color: #000000;
    margin-bottom: 4px;
    transition: none !important;
    animation: none !important;
    transform: none !important;
}

.split-document-card-company {
    font-size: 12px;
    color: #000000;
}

.split-document-summary {
    display: flex;
    gap: 16px;
    margin-top: 8px;
}

.split-document-summary-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.split-document-meta-label {
    font-size: 11px;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.split-document-meta-value {
    font-size: 12px;
    color: #000000;
    font-weight: 500;
}

.split-document-details {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 20px;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03);
    position: relative;
}

.no-document-selected {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: #9ca3af;
}

.request-preview-container {
    background: #F9FAFB;
    border: 1px dashed #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 260px;
}

.request-status-badge {
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.request-status-badge.status-provided {
    background: #E1F5E0;
    color: #1F7A1F;
}

/* Link status badges */
.link-status-badge {
    display: inline-block;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 0.7rem;
    font-weight: 600;
    margin-left: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.link-status-badge.status-opened {
    background: #E3F2FD;
    color: #1976D2;
}

.link-status-badge.status-submitted {
    background: #E8F5E9;
    color: #2E7D32;
}

.submit-link-btn {
    background: #85BB65;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
    margin-left: 8px;
}

.submit-link-btn:hover {
    background: #6FA050;
}

.request-status-badge.status-pending {
    background: #FFF4D9;
    color: #A45D00;
}

.request-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 16px;
}

.request-meta-item {
    background: #fff;
    border: 1px solid #e6eef6;
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
