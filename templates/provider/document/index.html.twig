                            <td colspan="7" class="empty-state">
                                <div class="empty-state-icon">📋</div>
                                <p class="mb-0">No pending document requests found.</p>
                                <p class="text-muted small mt-2">All document requests have been provided.</p>
                            </td>
                        </tr>
                    `;
                }
            };

            window.updateSplitViewEmptyState = function() {
                const splitList = document.getElementById('requests-split-list');
                if (splitList && splitList.children.length === 0) {
                    const noDocumentSelected = document.querySelector('#requests-split-details .no-document-selected');
                    const documentContent = document.getElementById('requests-document-content');
                    if (noDocumentSelected) noDocumentSelected.style.display = 'flex';
                    if (documentContent) documentContent.style.display = 'none';
                }
            };

            // Copy link functionality for credentialing links
            document.querySelectorAll('.copy-link-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const url = this.getAttribute('data-url');
                    navigator.clipboard.writeText(url).then(() => {
                        // Show temporary success feedback
                        const originalHtml = this.innerHTML;
                        this.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M20 6L9 17l-5-5"/>
                            </svg>
                            Copied!
                        `;
                        this.classList.add('btn-success');
                        
                        setTimeout(() => {
                            this.innerHTML = originalHtml;
                            this.classList.remove('btn-success');
                        }, 2000);
                    }).catch(err => {
                        console.error('Failed to copy: ', err);
                        alert('Failed to copy link to clipboard');
                    });
                });
            });

            // Track link opens and manage badges
            function getLinkStorageKey(linkId) {
                return `link_${linkId}_status`;
            }

            function updateLinkStatus(linkId, status) {
                const storageKey = getLinkStorageKey(linkId);
                const currentStatus = localStorage.getItem(storageKey);
                const statusData = currentStatus ? JSON.parse(currentStatus) : {};
                
                if (status === 'opened') {
                    statusData.opened = true;
                } else if (status === 'submitted') {
                    statusData.submitted = true;
                }
                
                localStorage.setItem(storageKey, JSON.stringify(statusData));
                updateLinkUI(linkId);
            }

            function updateLinkUI(linkId) {
                const storageKey = getLinkStorageKey(linkId);
                const statusData = localStorage.getItem(storageKey);
                
                if (!statusData) return;
                
                const status = JSON.parse(statusData);
                const openedBadge = document.getElementById(`opened-badge-${linkId}`);
                const submittedBadge = document.getElementById(`submitted-badge-${linkId}`);
                const submitBtn = document.getElementById(`submit-btn-${linkId}`);
                
                if (status.opened && openedBadge) {
                    openedBadge.style.display = 'inline-block';
                }
                
                if (status.opened && submitBtn && !status.submitted) {
                    submitBtn.style.display = 'inline-block';
                }
                
                if (status.submitted && submittedBadge) {
                    submittedBadge.style.display = 'inline-block';
                    if (submitBtn) {
                        submitBtn.style.display = 'none';
                    }
                }
            }

            // Initialize all link statuses
            function initializeAllLinkStatuses() {
                // Find all link cards (both in grid and table views)
                const linkCards = document.querySelectorAll('[data-request-id^="link-"]');
                linkCards.forEach(card => {
                    const linkId = card.getAttribute('data-request-id');
                    if (linkId) {
                        updateLinkUI(linkId);
                    }
                });
                
                // Also check for links in table rows
                document.querySelectorAll('tr[data-request-id^="link-"]').forEach(row => {
                    const linkId = row.getAttribute('data-request-id');
                    if (linkId) {
                        updateLinkUI(linkId);
                    }
                });
            }

            // Initialize link statuses on page load (with delay to ensure DOM is ready)
            setTimeout(function() {
                initializeAllLinkStatuses();
            }, 100);
            
            // Also initialize when window loads
            window.addEventListener('load', function() {
                initializeAllLinkStatuses();
            });

            // Re-initialize when accordions are opened (using event delegation)
            document.addEventListener('click', function(e) {
                // Check if accordion was opened
                if (e.target.closest('.company-group-header[data-accordion-toggle]') || 
                    e.target.closest('.accordion-toggle-btn')) {
                    setTimeout(initializeAllLinkStatuses, 200);
                }
            });

            // Also watch for when accordion content becomes visible
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                        const target = mutation.target;
                        if (target.classList.contains('requests-grid') || target.classList.contains('accordion-content')) {
                            const isVisible = target.style.display !== 'none' && 
                                            !target.classList.contains('collapsed');
                            if (isVisible) {
                                setTimeout(initializeAllLinkStatuses, 100);
                            }
                        }
                    }
                });
            });

            // Observe all accordion content elements
            document.querySelectorAll('.accordion-content, .requests-grid').forEach(function(element) {
                observer.observe(element, {
                    attributes: true,
                    attributeFilter: ['style', 'class']
                });
            });

            // Use event delegation for link opens (works even for dynamically shown content)
            document.addEventListener('click', function(e) {
                const openLinkBtn = e.target.closest('.open-link-btn');
                if (openLinkBtn) {
                    const linkId = openLinkBtn.getAttribute('data-link-id');
                    if (linkId) {
                        updateLinkStatus(linkId, 'opened');
                    }
                }
            });

            // Use event delegation for Submitted button clicks
            document.addEventListener('click', function(e) {
                const submitBtn = e.target.closest('.submit-link-btn');
                if (submitBtn) {
                    e.preventDefault();
                    e.stopPropagation();
                    const linkId = submitBtn.getAttribute('data-link-id');
                    if (linkId) {
                        updateLinkStatus(linkId, 'submitted');
                    }
                }
            });
        });

        function clearFile() {
