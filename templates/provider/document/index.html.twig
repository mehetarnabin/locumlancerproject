                });
            }
            
            // Use document-level delegation for select changes
            document.addEventListener('change', function(e) {
                if (e.target.classList.contains('document-select')) {
                    const container = document.getElementById('requests-grid-view-container');
                    if (container && container.contains(e.target)) {
                        window.updateRequestsSubmitButton();
                    }
