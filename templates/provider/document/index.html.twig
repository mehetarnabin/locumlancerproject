                                           class="action-btn edit-document-btn"
                                           title="Edit Document"
                                           data-document-id="{{ document.id }}"
                                           data-document-category="{{ document.category ?: document.name }}"
                                           data-document-issue-date="{{ document.issueDate ? document.issueDate|date('Y-m-d') : '' }}"
                                           data-document-expiration-date="{{ document.expirationDate ? document.expirationDate|date('Y-m-d') : '' }}"
                                           data-document-name="{{ document.name }}">
                                            <img src="{{ asset('assets/icons/compose.png') }}" alt="Edit"/>
                                        </button>
                                        <a href="{{ path('app_provider_document_delete', {'id': document.id}) }}"
                                           class="action-btn delete-document-btn"
                                           title="Delete Document"
                                           data-document-name="{{ document.category ?: document.name }}"
                                           data-document-id="{{ document.id }}">
                                            <img src="{{ asset('assets/icons/trash-bin.png') }}" alt="Delete"/>
                                        </a>
                                    </div>
                            </div>
