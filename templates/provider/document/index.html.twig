                                {{ form_label(form.issueDate, null, {'label_attr': {'class': 'form-label', 'style': 'font-size: 0.875rem; margin-bottom: 4px;'}}) }}
                                {{ form_widget(form.issueDate, {'attr': {'class': 'form-control js-datepicker', 'id': 'document_issueDate', 'style': 'padding: 6px 10px; font-size: 0.875rem;'}}) }}
                                {{ form_errors(form.issueDate) }}
                            </div>
                        </div>

                        {# Expiration Date #}
                        <div class="col-12 col-md-6" id="expiration-date-wrapper">
                            <div class="mb-2">
                                {{ form_label(form.expirationDate, null, {'label_attr': {'class': 'form-label', 'style': 'font-size: 0.875rem; margin-bottom: 4px;'}}) }}
                                {{ form_widget(form.expirationDate, {'attr': {'class': 'form-control js-datepicker', 'id': 'document_expirationDate', 'style': 'padding: 6px 10px; font-size: 0.875rem;'}}) }}
                                <span id="expiration-date-help" class="text-muted small d-block mt-1" style="display: none; font-size: 0.75rem;"></span>
                                {{ form_errors(form.expirationDate) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Right Side: File Upload Dropzone (Small and Cute) #}
                <div class="col-12 col-lg-4">
                    <div class="mb-2">
                        <div class="form-label-wrapper" style="padding-left: 0; margin-bottom: 4px;">
                        <label class="form-label" style="font-size: 0.875rem; padding-left: 0;">Choose File</label>
                        </div>
                        <div class="upload-dropzone position-relative" id="uploadDropzone" style="min-height: 140px; padding: 12px; border: 2px dashed #85BB65; border-radius: 8px; background: #F4F9F1;">
                            {{ form_widget(form.fileName, {
                                'attr': {
                                    'class': 'dropzone-input',
                                    'id': 'fileInput',
                                    'accept': '.pdf,.doc,.docx',
                                    'onchange': 'handleFileChange(this)'
                                }
                            }) }}
                            
                            <div id="fileBadge" class="file-badge" style="display:none;">
                                <span id="fileNameText"></span>
                                <button type="button" class="file-remove-btn" onclick="clearFile()">×</button>
                            </div>

                            <div class="dropzone-content" style="padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                </svg>
                                <p class="upload-text mb-1" style="font-size: 0.75rem; margin-top: 0; text-align: center; color: #6b7280;">Click to upload</p>
                                <p class="upload-subtext mb-0" style="font-size: 0.65rem; text-align: center; color: #9ca3af;">Max: 8MB</p>
                            </div>
                        </div>
                        {{ form_errors(form.fileName) }}
                    </div>
                </div>
                    </div>
                </div>
                </div>

            <div class="d-flex justify-content-end gap-2 mt-3" id="form-actions-container">
                {% if editMode is defined %}
                    <a href="{{ path('app_provider_documents') }}" class="btn btn-secondary">Cancel</a>
                {% endif %}
                <button type="button" class="btn btn-outline-primary btn-sm" id="add-more-dea-btn" style="display: none; font-size: 0.75rem; padding: 4px 12px;">
                    + Add More DEA
                </button>
                <button type="submit" class="btn btn-primary btn-upload btn-sm" style="font-size: 0.75rem; padding: 4px 12px;">
                    {{ editMode is defined ? 'Update Document' : 'Upload Document' }}
                </button>
            </div>
            
                {{ form_end(form) }}
            </div>
        </div>

    {# Add Document Modal #}
    <div class="modal fade" id="addDocumentModal" tabindex="-1" aria-labelledby="addDocumentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addDocumentModalLabel">Add New Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="add-document-modal-form" action="{{ path('app_provider_documents') }}" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="document[_token]" value="{{ form.vars.value is null ? csrf_token('form') : form._token.vars.value }}">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Document Name (Category)</label>
                                <select class="form-control form-select" id="modal_document_category" name="document[category]" required>
                                    <option value="">Select Document Name</option>
                                    <option value="CV Upload">CV Upload</option>
                                    <option value="Driver's license">Driver's license</option>
                                    <option value="Copy of passport">Copy of passport</option>
                                    <option value="Passport photo 2&quot; x 2&quot;">Passport photo 2" x 2"</option>
                                    <option value="USMLE Step 1-3/COMLEX">USMLE Step 1-3/COMLEX</option>
                                    <option value="Specialty and Subspecialty Exam Certification">Specialty and Subspecialty Exam Certification</option>
                                    <option value="Medical school diploma">Medical school diploma</option>
                                    <option value="Postgraduate certificates (eg: Residency and Fellowship completion)">Postgraduate certificates (eg: Residency and Fellowship completion)</option>
                                    <option value="Life support certifications">Life support certifications</option>
                                    <option value="Active and Inactive medical licenses">Active and Inactive medical licenses</option>
                                    <option value="All DEAs">All DEAs</option>
                                    <option value="CSR (Controlled Substance Registration)">CSR (Controlled Substance Registration)</option>
                                    <option value="Copy of undergraduate transcript">Copy of undergraduate transcript</option>
                                    <option value="Vaccine titers: Hepatitis B, Varicella, MMR">Vaccine titers: Hepatitis B, Varicella, MMR</option>
                                    <option value="Negative TB test (TST vs IGRA) in the last 12 months (or if positive a CXR is required)">Negative TB test (TST vs IGRA) in the last 12 months (or if positive a CXR is required)</option>
                                    <option value="Influenza vaccine proof">Influenza vaccine proof</option>
                                    <option value="COVID-19 vaccine proof">COVID-19 vaccine proof</option>
                                    <option value="Mask fit testing">Mask fit testing</option>
                                    <option value="MALPRACTICE (COI = CERTIFICATE OF INSURANCE of the last 10 years)">MALPRACTICE (COI = CERTIFICATE OF INSURANCE of the last 10 years)</option>
                                    <option value="PROCEDURE LOGS last 2 years">PROCEDURE LOGS last 2 years</option>
                                    <option value="Case Logs last 2 years">Case Logs last 2 years</option>
                                    <option value="Application/ Certification: A list of everywhere lived for the last 10 years">Application/ Certification: A list of everywhere lived for the last 10 years</option>
                                    <option value="All Hospital Affiliations and Training Programs">All Hospital Affiliations and Training Programs</option>
                                    <option value="Miscellaneous">Miscellaneous</option>
                                </select>
                                <small class="text-muted d-block mt-1">Selecting a document auto-fills the required dates.</small>
                            </div>
                            <div class="col-12" id="modal_document-name-wrapper" style="display: none;">
                                <label class="form-label">Document Name <span class="text-danger">*</span></label>
                                <input type="text" 
                                       class="form-control" 
                                       id="modal_document_name" 
                                       name="document[name]" 
                                       placeholder="Enter document name">
                                <small class="text-muted" style="font-size: 0.75rem;">Enter a custom name for this miscellaneous document</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Choose File (PDF or DOCX)</label>
                                <div class="upload-dropzone position-relative" id="modalUploadDropzone" style="min-height: 120px;">
                                    <input type="file" class="dropzone-input" id="modal_fileInput" name="document[fileName]" accept=".pdf,.doc,.docx" required>
                                    <div id="modal_fileBadge" class="file-badge" style="display:none;">
                                        <span id="modal_fileNameText"></span>
                                        <button type="button" class="file-remove-btn" onclick="clearModalFile()">×</button>
                                    </div>
                                    <div class="dropzone-content">
                                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                            <line x1="16" y1="13" x2="8" y2="13"/>
                                            <line x1="16" y1="17" x2="8" y2="17"/>
                                        </svg>
                                        <p class="upload-text mb-1">Drag and drop or click to upload</p>
                                        <p class="upload-subtext mb-0">Max File Size: 8MB | Allowed Types: PDF, DOC, DOCX</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6" id="modal_issue-date-wrapper">
                                <label class="form-label">Issue Date</label>
                                <input type="text" class="form-control js-datepicker" id="modal_document_issueDate" name="document[issueDate]">
                            </div>
                            <div class="col-12 col-md-6" id="modal_expiration-date-wrapper">
                                <label class="form-label">Expiration Date</label>
                                <input type="text" class="form-control js-datepicker" id="modal_document_expirationDate" name="document[expirationDate]">
                                <span id="modal_expiration-date-help" class="text-muted small d-block mt-1" style="display: none;"></span>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submit-modal-document">Upload Document</button>
                </div>
            </div>
        </div>
    </div>

    {# Uploaded Documents Table #}
    <div class="card app-card-settings">
        <div class="card-body">
            <div class="card-header-row">
                <h5 class="card-title">Uploaded Documents</h5>
                <button id="documents-split-view-btn" class="action-btn" title="Split View">
                    <svg class="icon-image" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3H10V10H3V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 3H21V10H14V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 14H10V21H3V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Split View
                </button>
            </div>
            
            <div class="document-table-wrapper" id="documents-list-view">
                <div class="document-header">
                    <div class="col-uploaded-at">Uploaded At</div>
                    <div class="col-doc-name">Document Name</div>
                    <div class="col-issue-date">Issue Date</div>
                    <div class="col-expiry-date">Expiration Date</div>
                    <div class="col-actions">Actions</div>
                </div>
                {% if documents|length > 0 %}
                        {% for document in documents %}
                        <div class="document-row">
                            <div class="col-uploaded-at">{{ document.createdAt|date('m/d/Y') }}</div>
                            <div class="col-doc-name">
                                    <strong>{{ document.name ?: document.category }}</strong>
                            </div>
                            <div class="col-issue-date">{{ document.issueDate ? document.issueDate|date('m/d/Y') : '-' }}</div>
                            <div class="col-expiry-date">
                                    {% if document.expirationDate %}
                                        {% set daysUntilExpiry = (document.expirationDate|date('U') - 'now'|date('U')) / 86400 %}
                                        {% if daysUntilExpiry < 0 %}
                                            <span class="text-danger">{{ document.expirationDate|date('m/d/Y') }} <small>(Expired)</small></span>
                                        {% elseif daysUntilExpiry <= 30 %}
                                            <span class="text-warning">{{ document.expirationDate|date('m/d/Y') }} <small>(Expiring Soon)</small></span>
                                        {% else %}
                                            {{ document.expirationDate|date('m/d/Y') }}
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                            </div>
                            <div class="col-actions">
                                <div class="action-buttons" style="display: flex; gap: 8px; justify-content: center;">
                                        <a href="{{ path('app_provider_document_view', {'id': document.id}) }}"
                                           class="action-btn" 
                                           title="View Document">
                                            <img src="{{ asset('assets/icons/shared-folder.png') }}" alt="View"/>
                                        </a>
                                        <a href="{{ path('app_provider_document_edit', {'id': document.id}) }}"
                                           class="action-btn"
                                           title="Edit Document">
                                            <img src="{{ asset('assets/icons/compose.png') }}" alt="Edit"/>
                                        </a>
                                        <a href="{{ path('app_provider_document_delete', {'id': document.id}) }}"
                                           class="action-btn delete-document-btn"
                                           title="Delete Document"
                                           data-document-name="{{ document.category ?: document.name }}"
                                           data-document-id="{{ document.id }}">
                                            <img src="{{ asset('assets/icons/trash-bin.png') }}" alt="Delete"/>
                                        </a>
                                    </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="document-row" style="justify-content: center; padding: 40px;">
                        <div style="text-align: center;">
                            <div class="empty-state-icon" style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5;">📄</div>
                            <p class="mb-0" style="font-size: 14px; color: #6b7280;">No documents uploaded yet.</p>
                            <p class="text-muted small mt-2" style="font-size: 12px;">Upload your first document using the form above.</p>
                        </div>
                    </div>
                {% endif %}
                </div>
            </div>
            
            {# Split View for Uploaded Documents #}
            <div class="split-view-container" id="documents-split-view-container" style="display: none;">
                <button class="list-toggle-btn" id="documents-list-toggle-btn" style="display: none;" title="Toggle document list">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <!-- Left Side: Document List -->
                <div class="split-document-list" id="documents-split-list">
                    {% for document in documents %}
                        <div class="split-document-card" data-document-id="{{ document.id }}" data-document-url="{{ asset('uploads/' ~ document.user.id ~ '/' ~ document.fileName) }}" data-document-name="{{ document.name ?: document.category }}">
                            <div class="split-document-card-header">
                                <div class="flex-grow-1">
                                    <div class="split-document-card-title">{{ document.name ?: document.category }}</div>
                                    <div class="split-document-card-company">{{ document.issueDate ? document.issueDate|date('m/d/Y') : 'No Issue Date' }}</div>
                                </div>
                            </div>
                            <div class="split-document-summary">
                                <div class="split-document-summary-item">
                                    <span class="split-document-meta-label">Issue:</span>
                                    <span class="split-document-meta-value">{{ document.issueDate ? document.issueDate|date('m/d/Y') : '-' }}</span>
                                </div>
                                <div class="split-document-summary-item">
                                    <span class="split-document-meta-label">Expires:</span>
                                    <span class="split-document-meta-value">
                                        {% if document.expirationDate %}
                                            {{ document.expirationDate|date('m/d/Y') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                
                <!-- Right Side: Document Preview -->
                <div class="split-document-details" id="documents-split-details">
                    <div class="no-document-selected">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 12H16M8 16H16M8 8H12M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <h4>Select a document to view</h4>
                        <p>Click on any document from the list to see its preview here.</p>
                    </div>
                    <div id="documents-document-content" style="display: none;"></div>
                </div>
            </div>

        </div>
    </div>

    

    {# History Section #}
    <div class="tab-content active" id="history-tab">
        <div class="card app-card-settings">
            <div class="card-body">
                <div class="card-header-row">
                    <h5 class="card-title">Document History</h5>
                </div>

                <div class="document-table-wrapper">
                            {% set historyEntries = [] %}
                            
                            {# Add document upload history #}
                            {% for document in documents %}
                                {% set historyEntries = historyEntries|merge([{
                                    'name': document.category ?: document.name,
                                    'action': 'uploaded',
                                    'date': document.createdAt,
                                    'details': 'Document uploaded to your library'
                                }]) %}
                                
                                {% if document.updatedAt and document.updatedAt != document.createdAt %}
                                    {% set historyEntries = historyEntries|merge([{
                                        'name': document.category ?: document.name,
                                        'action': 'updated',
                                        'date': document.updatedAt,
                                        'details': 'Document information updated'
                                    }]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Add document assignment history #}
                            {% for documentRequest in documentRequests %}
                                {% if documentRequest.providedAt %}
                                    {% set historyEntries = historyEntries|merge([{
                                        'name': documentRequest.name,
                                        'action': 'assigned',
                                        'date': documentRequest.providedAt,
                                        'details': 'Document assigned to ' ~ (documentRequest.application.employer.companyName ?? 'employer')
                                    }]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Sort history by date (newest first) #}
                            {% set historyEntries = historyEntries|sort((a, b) => b.date <=> a.date) %}
                    
                    <div class="document-header">
                        <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">S. No</div>
                        <div class="col-history-name" style="flex: 2; justify-content: flex-start;">Document Name</div>
                        <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">Action</div>
                        <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">Date & Time</div>
                        <div class="col-history-details" style="flex: 2; justify-content: flex-start;">Details</div>
                    </div>
                            
                            {% if historyEntries|length > 0 %}
                                {% for entry in historyEntries %}
                            <div class="document-row">
                                <div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">{{ loop.index }}</div>
                                <div class="col-history-name" style="flex: 2; justify-content: flex-start;">
                                            <strong>{{ entry.name }}</strong>
                                </div>
                                <div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">
                                            {% if entry.action == 'uploaded' %}
                                                <span class="action-badge uploaded">Uploaded</span>
                                            {% elseif entry.action == 'updated' %}
                                                <span class="action-badge updated">Updated</span>
                                            {% elseif entry.action == 'assigned' %}
                                                <span class="action-badge assigned">Assigned</span>
                                            {% endif %}
                                </div>
                                <div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">{{ entry.date|date('m/d/Y g:i A') }}</div>
                                <div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #6b7280;">{{ entry.details }}</div>
                            </div>
                                {% endfor %}
                            {% else %}
                        <div class="document-row" style="justify-content: center; padding: 40px;">
                            <div style="text-align: center;">
                                <div class="empty-state-icon" style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5;">📊</div>
                                <p class="mb-0" style="font-size: 14px; color: #6b7280;">No history available</p>
                                <p class="text-muted small mt-2" style="font-size: 12px;">Your document activities will appear here</p>
                            </div>
                        </div>
                            {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Credentials Tab - Updated with Credentialing Links #}
    <div class="tab-content" id="credentials-tab">
        <div class="card app-card-settings">
            <div class="card-body">
                <div class="card-header-row">
                    <h5 class="card-title">External Links</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">{{ credentialingLinks|length }} Links</span>
                    </div>
                </div>

                {% if credentialingLinks|length > 0 %}
                    <div class="credentials-grid">
                        {% for link in credentialingLinks %}
                            <div class="credential-card">
                                <div class="credential-header">
                                    <div class="credential-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                                        </svg>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="credential-title">{{ link.title }}</h6>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            {% if link.sender %}
                                                <small class="text-muted">From: {{ link.sender }}</small>
                                            {% endif %}
                                            <small class="text-muted">•</small>
                                            <small class="text-muted">{{ link.createdAt|date('M d, Y') }}</small>
                                        </div>
                                    </div>
                                </div>
                                
                                {% if link.description %}
                                    <p class="credential-description">{{ link.description }}</p>
                                {% endif %}
                                
                                <div class="credential-meta mb-3">
                                    <div class="d-flex align-items-center gap-2 text-sm text-muted">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                                        </svg>
                                        <span class="url-preview">{{ link.url|replace({'https://': '', 'http://': ''})|slice(0, 50) }}{{ link.url|length > 50 ? '...' : '' }}</span>
                                    </div>
                                </div>

                                <div class="credential-actions">
                                    <a href="{{ link.url }}" 
                                       target="_blank" 
                                       rel="noopener noreferrer"
                                       class="action-btn btn-primary"
                                       title="Open this external link in a new tab">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                            <polyline points="15 3 21 3 21 9"/>
                                            <line x1="10" y1="14" x2="21" y2="3"/>
                                        </svg>
                                        Open Link
                                    </a>
                                    
                                    <button type="button" 
                                            class="action-btn btn-secondary copy-link-btn"
                                            data-url="{{ link.url }}"
                                            title="Copy link to clipboard">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                        </svg>
                                        Copy URL
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state-compact">
                        <div class="empty-state-icon">🔗</div>
                        <h4>No External Links</h4>
                        <p class="text-muted">You don't have any external links shared with you yet.</p>
                        <div class="mt-3">
                            <p class="small text-info">
                                <strong>About External Links:</strong><br>
                                • Employers or systems may share links with you here<br>
                                • Links can open forms, upload pages, or any external service<br>
                                • All links open in new browser tabs for security<br>
                                • You can copy links to access them later
                            </p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block footer_scripts %}
    <script src="{{ asset('assets/admin/js/form-validation.js') }}"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Alert helper functions using SweetAlert2
        function showSuccessAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: title,
                    text: message,
                    confirmButtonColor: '#85BB65'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showErrorAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: title,
                    text: message,
                    confirmButtonColor: '#dc3545'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showWarningAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: title,
                    text: message,
                    confirmButtonColor: '#ffc107'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showInfoAlert(title, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'info',
                    title: title,
                    text: message,
                    confirmButtonColor: '#0dcaf0'
                });
            } else {
                alert(title + ': ' + message);
            }
        }

        function showConfirmAlert(title, message, confirmText, cancelText, callback) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: confirmText || 'Yes',
                    cancelButtonText: cancelText || 'Cancel'
                }).then((result) => {
                    if (callback) {
                        callback(result.isConfirmed);
                    }
                });
            } else {
                if (confirm(title + ': ' + message)) {
                    if (callback) callback(true);
                } else {
                    if (callback) callback(false);
                }
            }
        }

        // Tab functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Function to switch to a specific tab
            function switchToTab(tabName) {
                // Remove active class from all tabs and contents
                document.querySelectorAll('.documents-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                
                // Find and activate the target tab
                const targetTab = document.querySelector(`.documents-tab[data-tab="${tabName}"]`);
                if (targetTab) {
                    targetTab.classList.add('active');
                }
                
                // Show corresponding content
                const content = document.getElementById(`${tabName}-tab`);
                if (content) {
                    content.classList.add('active');
                    // Scroll to the tab section
                    setTimeout(() => {
                        content.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }
            }
            
            // Handle hash navigation (for dropdown links)
            if (window.location.hash) {
                const hash = window.location.hash.substring(1); // Remove #
                if (hash === 'my-documents-tab' || hash === 'history-tab') {
                    const tabName = hash.replace('-tab', '');
                    switchToTab(tabName);
                }
            }
            
            // Listen for hash changes
            window.addEventListener('hashchange', function() {
                const hash = window.location.hash.substring(1);
                if (hash === 'my-documents-tab' || hash === 'history-tab') {
                    const tabName = hash.replace('-tab', '');
                    switchToTab(tabName);
                }
            });
            
            // Tab switching
            document.querySelectorAll('.documents-tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    switchToTab(tabId);
                });
            });

            // Initialize flatpickr
            if (typeof flatpickr !== 'undefined') {
                document.querySelectorAll('.js-datepicker').forEach(function(input) {
                    if (!input._flatpickr) {
                        flatpickr(input, {
                            dateFormat: "Y-m-d"
                        });
                    }
                });
            } else if (typeof $ !== 'undefined' && $.fn.flatpickr) {
                $(".js-datepicker").flatpickr();
            }

            // File upload dropzone functionality
            const dropzone = document.getElementById('uploadDropzone');
            const fileInput = document.getElementById('fileInput');

            if (dropzone && fileInput) {
                // Click to upload
                dropzone.addEventListener('click', function(e) {
                    if (e.target.closest('.file-badge') || e.target.closest('.file-remove-btn')) {
                        return;
                    }
                    fileInput.click();
                });

                // Drag and drop
                dropzone.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#e8f4e8';
                });

                dropzone.addEventListener('dragleave', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#F4F9F1';
                });

                dropzone.addEventListener('drop', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.background = '#F4F9F1';
                    
                    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleFileChange(fileInput);
                    }
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            // Form validation - highlight invalid fields
            const documentForm = document.getElementById('document-upload-form');
            if (documentForm) {
                documentForm.addEventListener('submit', function(e) {
                    console.log('Form submit triggered');
                    console.log('Form is valid:', documentForm.checkValidity());
                    
                    // Remove previous validation states
                    documentForm.querySelectorAll('.is-invalid').forEach(el => {
                        el.classList.remove('is-invalid');
                    });
                    documentForm.querySelectorAll('.invalid-feedback').forEach(el => {
                        el.remove();
                    });

                    // Check HTML5 validity
                    if (!documentForm.checkValidity()) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        console.log('Form validation failed');

                        // Find and highlight all invalid fields
                        const invalidFields = documentForm.querySelectorAll(':invalid');
                        console.log('Invalid fields:', invalidFields);
                        let firstInvalidField = null;

                        invalidFields.forEach(field => {
                            // Skip the form itself
                            if (field === documentForm) return;
                            
                            console.log('Invalid field:', field.name, field);

                            // Add invalid class
                            field.classList.add('is-invalid');

                            // Add red border
                            field.style.borderColor = '#dc3545';
                            field.style.borderWidth = '2px';

                            // Create error message
                            const errorDiv = document.createElement('div');
                            errorDiv.className = 'invalid-feedback d-block';
                            errorDiv.style.color = '#dc3545';
                            errorDiv.style.fontSize = '0.875rem';
                            errorDiv.style.marginTop = '0.25rem';

                            // Get field name for error message
                            const fieldLabel = field.closest('.mb-2, .mb-3')?.querySelector('label')?.textContent?.trim() || 'This field';
                            errorDiv.textContent = `${fieldLabel} is required.`;

                            // Insert error message after field
                            field.parentNode.insertBefore(errorDiv, field.nextSibling);

                            // Store first invalid field for scrolling
                            if (!firstInvalidField) {
                                firstInvalidField = field;
                            }
                        });

                        // Scroll to first invalid field
                        if (firstInvalidField) {
                            firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstInvalidField.focus();
                        }

                        return false;
                    }

                    console.log('Form validation passed, submitting...');
                    
                    // Use AJAX submission for all modes
                    e.preventDefault();
                    
                    const formData = new FormData(documentForm);
                    const submitBtn = documentForm.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;
                    const isEditMode = documentForm.action.includes('/edit/');
                    
                    // Show loading state
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + (isEditMode ? 'Updating...' : 'Uploading...');
                    
                    fetch(documentForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => {
                        console.log('Response status:', response.status);
                        console.log('Response Content-Type:', response.headers.get('Content-Type'));
                        
                        // Check if response is JSON
                        const contentType = response.headers.get('Content-Type');
                        if (contentType && contentType.includes('application/json')) {
                            return response.json();
                        }
                        
                        // Not JSON, return as text
                        return response.text().then(html => ({ html, status: response.status }));
                    })
                    .then(data => {
                        // Check if we got a JSON success response
                        if (data && data.success) {
                            console.log('Success! Document saved.');
                            
                            const successMessage = data.message || (isEditMode ? 'Document updated successfully.' : 'Document uploaded successfully.');
                            
                            if (typeof showSuccessAlert !== 'undefined') {
                                showSuccessAlert('Success!', successMessage);
                            } else {
                                alert(successMessage);
                            }
                            
                            // Reload the page to show updated documents list
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                            
                            return;
                        }
                        
                        // Check if we got a JSON error response
                        if (data && data.success === false && data.errors) {
                            console.log('Validation errors:', data.errors);
                            
                            let errorMessage = 'Please fix the following errors:\n';
                            data.errors.forEach(err => {
                                errorMessage += '- ' + err + '\n';
                            });
                            
                            if (typeof showErrorAlert !== 'undefined') {
                                showErrorAlert('Validation Error', errorMessage);
                            } else {
                                alert(errorMessage);
                            }
                            
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnText;
                            return;
                        }
                        
                        // HTML response - parse for errors
                        if (data && data.html) {
                            console.log('Got HTML response, checking for errors...');
                            
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(data.html, 'text/html');
                            
                            const flashErrors = doc.querySelectorAll('.alert-danger');
                            const formErrors = doc.querySelectorAll('.invalid-feedback');
                            
                            console.log('Flash errors found:', flashErrors.length);
                            console.log('Form errors found:', formErrors.length);
                            
                            if (flashErrors.length > 0 || formErrors.length > 0) {
                                let errorMessage = 'Please fix the following errors:\n';
                                
                                flashErrors.forEach(err => {
                                    const text = err.textContent.trim();
                                    if (text) {
                                        errorMessage += '- ' + text + '\n';
                                    }
                                });
                                
                                formErrors.forEach(err => {
                                    const text = err.textContent.trim();
                                    if (text) {
                                        errorMessage += '- ' + text + '\n';
                                    }
                                });
                                
                                if (typeof showErrorAlert !== 'undefined') {
                                    showErrorAlert('Validation Error', errorMessage);
                                } else {
                                    alert(errorMessage);
                                }
                            } else {
                                console.error('Form returned HTML but no errors found.');
                                if (typeof showErrorAlert !== 'undefined') {
                                    showErrorAlert('Error', 'Unable to save document. Please check all required fields.');
                                } else {
                                    alert('Unable to save document. Please check all required fields.');
                                }
                            }
                            
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnText;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        if (typeof showErrorAlert !== 'undefined') {
                            showErrorAlert('Error', 'An error occurred. Please try again.');
                        } else {
                            alert('An error occurred. Please try again.');
                        }
                        
                        // Reset button
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    });
                    
                    return false;
                });

                // Remove invalid state when user starts typing/selecting
                documentForm.addEventListener('input', function(e) {
                    if (e.target.classList.contains('is-invalid')) {
                        e.target.classList.remove('is-invalid');
                        e.target.style.borderColor = '';
                        e.target.style.borderWidth = '';
                        const errorMsg = e.target.nextElementSibling;
                        if (errorMsg && errorMsg.classList.contains('invalid-feedback')) {
                            errorMsg.remove();
                        }
                    }
                });

                documentForm.addEventListener('change', function(e) {
                    if (e.target.classList.contains('is-invalid')) {
                        e.target.classList.remove('is-invalid');
                        e.target.style.borderColor = '';
                        e.target.style.borderWidth = '';
                        const errorMsg = e.target.nextElementSibling;
                        if (errorMsg && errorMsg.classList.contains('invalid-feedback')) {
                            errorMsg.remove();
                        }
                    }
                });
            }

            initializeDocumentCategoryLogic();
        });

        function initializeDocumentCategoryLogic() {
            const categorySelect = document.getElementById('document_category');
            const issueWrapper = document.getElementById('issue-date-wrapper');
            const expiryWrapper = document.getElementById('expiration-date-wrapper');
            const issueInput = document.getElementById('document_issueDate');
            const expiryInput = document.getElementById('document_expirationDate');
            const expiryHelp = document.getElementById('expiration-date-help');

            if (!categorySelect || !issueWrapper || !expiryWrapper || !issueInput || !expiryInput) {
                return;
            }

            const defaultConfig = { showIssue: true, showExpiry: true, autoExpiryDays: 0 };
            const documentConfigs = {
                "Driver's license": { showIssue: true, showExpiry: true },
                "Copy of passport": { showIssue: true, showExpiry: true },
                'Passport photo 2" x 2"': { showIssue: false, showExpiry: false },
                'USMLE Step 1-3/COMLEX': { showIssue: true, showExpiry: true },
                'Specialty and Subspecialty Exam Certification': { showIssue: false, showExpiry: false },
                'Medical school diploma': { showIssue: false, showExpiry: false },
                'Postgraduate certificates (eg: Residency and Fellowship completion)': { showIssue: false, showExpiry: false },
                'Life support certifications': { showIssue: false, showExpiry: false },
                'Active and Inactive medical licenses': { showIssue: true, showExpiry: true },
                'All DEAs': { showIssue: true, showExpiry: true },
                'CSR (Controlled Substance Registration)': { showIssue: true, showExpiry: true },
                'Copy of undergraduate transcript': { showIssue: false, showExpiry: false },
                'Vaccine titers: Hepatitis B, Varicella, MMR': { showIssue: false, showExpiry: false },
                'Negative TB test (TST vs IGRA) in the last 12 months (or if positive a CXR is required)': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'Influenza vaccine proof': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'COVID-19 vaccine proof': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'Mask fit testing': { showIssue: true, showExpiry: true, autoExpiryDays: 365 },
                'MALPRACTICE (COI = CERTIFICATE OF INSURANCE of the last 10 years)': { showIssue: true, showExpiry: true },
                'PROCEDURE LOGS last 2 years': { showIssue: true, showExpiry: true },
                'Case Logs last 2 years': { showIssue: true, showExpiry: true },
                'Application/ Certification: A list of everywhere lived for the last 10 years': { showIssue: true, showExpiry: true },
                'All Hospital Affiliations and Training Programs': { showIssue: true, showExpiry: true },
                'Miscellaneous': { showIssue: false, showExpiry: false, optionalDates: true }
            };

            function applyDocumentConfig(type) {
                const config = documentConfigs[type] || defaultConfig;
                const showIssue = config.showIssue !== false;
                const showExpiry = config.showExpiry !== false;
                const autoDays = config.autoExpiryDays || 0;
                const optionalDates = config.optionalDates || false;
                const isMiscellaneous = type === 'Miscellaneous';
                const isDEA = type === 'All DEAs';

                // Handle document name field for Miscellaneous
                const nameWrapper = document.getElementById('document-name-wrapper');
                const nameInput = document.getElementById('document_name');
                if (nameWrapper && nameInput) {
                    if (isMiscellaneous) {
                        nameWrapper.style.display = 'block';
                        nameInput.required = true;
                    } else {
                        nameWrapper.style.display = 'none';
                        nameInput.required = false;
                        nameInput.value = '';
                    }
                }

                // Handle "Add More DEA" button
                const addMoreDEABtn = document.getElementById('add-more-dea-btn');
                if (addMoreDEABtn) {
                    addMoreDEABtn.style.display = isDEA ? 'inline-block' : 'none';
                }

                // Handle issue date
                if (optionalDates) {
                    // For Miscellaneous, show dates but make them optional
                    issueWrapper.classList.remove('d-none');
                    if (issueInput) {
                        issueInput.required = false;
                    }
                } else {
                issueWrapper.classList.toggle('d-none', !showIssue);
                if (issueInput) {
                    issueInput.required = showIssue;
                    if (!showIssue) {
                        issueInput.value = '';
                    }
                    issueInput.dataset.autoExpiryDays = autoDays ? String(autoDays) : '';
                }
                }

                // Handle expiration date
                if (optionalDates) {
                    // For Miscellaneous, show dates but make them optional
                    expiryWrapper.classList.remove('d-none');
                    if (expiryInput) {
                        expiryInput.required = false;
                    }
                } else {
                expiryWrapper.classList.toggle('d-none', !showExpiry);
                if (expiryInput) {
                    expiryInput.required = showExpiry && !autoDays;
                    expiryInput.readOnly = !!autoDays;
                    expiryInput.classList.toggle('bg-light', !!autoDays);
                    if (!showExpiry) {
                        expiryInput.value = '';
                        }
                    }
                }

                if (expiryHelp) {
                    if (autoDays > 0) {
                        expiryHelp.style.display = 'block';
                        expiryHelp.textContent = 'Expiration automatically set to ' + (autoDays / 365) + ' year(s) after the issue date.';
                    } else if (optionalDates) {
                        expiryHelp.style.display = 'block';
                        expiryHelp.textContent = 'Optional: Enter expiration date if applicable.';
                    } else {
                        expiryHelp.style.display = showExpiry ? 'block' : 'none';
                        expiryHelp.textContent = showExpiry ? 'Enter the expiration date as it appears on the document.' : '';
                    }
                }

                if (autoDays > 0) {
                    updateAutoExpiration(issueInput, expiryInput, autoDays);
                }
            }

            function updateAutoExpiration(issueInput, expiryInput, days) {
                if (!issueInput || !expiryInput) return;
                if (!issueInput.value) {
                    expiryInput.value = '';
                    return;
                }
                const baseDate = new Date(issueInput.value);
                if (isNaN(baseDate.getTime())) {
                    expiryInput.value = '';
                    return;
                }
                const expiryDate = new Date(baseDate);
                expiryDate.setDate(expiryDate.getDate() + Number(days));
                expiryInput.value = expiryDate.toISOString().split('T')[0];
            }

            issueInput.addEventListener('change', function() {
                const autoDays = Number(issueInput.dataset.autoExpiryDays || 0);
                if (autoDays > 0) {
                    updateAutoExpiration(issueInput, expiryInput, autoDays);
                }
            });

            categorySelect.addEventListener('change', function() {
                applyDocumentConfig(this.value);
            });

            applyDocumentConfig(categorySelect.value);

            // Handle "Add More DEA" button - Dynamic form sections
            const addMoreDEABtn = document.getElementById('add-more-dea-btn');
            const deaFormsContainer = document.getElementById('dea-forms-container');
            const storedDEAContainer = document.getElementById('stored-dea-documents');
            let deaFormIndex = 0;

            function storeCurrentDEA() {
                const currentSection = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="' + deaFormIndex + '"]');
                if (!currentSection) return;

                const categoryInput = currentSection.querySelector('#document_category');
                const issueInput = currentSection.querySelector('#document_issueDate');
                const expiryInput = currentSection.querySelector('#document_expirationDate');
                const fileInput = currentSection.querySelector('#fileInput');
                const fileNameText = currentSection.querySelector('#fileNameText');

                // Check if current form has data
                const hasData = (fileInput && fileInput.files && fileInput.files.length > 0) ||
                               (issueInput && issueInput.value) ||
                               (expiryInput && expiryInput.value);

                if (hasData) {
                    // Store the current DEA data
                    const storedItem = document.createElement('div');
                    storedItem.className = 'stored-dea-item';
                    storedItem.dataset.deaIndex = deaFormIndex;
                    storedItem.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong>DEA ${deaFormIndex + 1}</strong>
                                ${fileNameText && fileNameText.textContent ? '<span style="margin-left: 8px; color: #6b7280;">' + fileNameText.textContent + '</span>' : ''}
                                ${issueInput && issueInput.value ? '<span style="margin-left: 8px; color: #6b7280;">Issue: ' + issueInput.value + '</span>' : ''}
                                ${expiryInput && expiryInput.value ? '<span style="margin-left: 8px; color: #6b7280;">Expiry: ' + expiryInput.value + '</span>' : ''}
                            </div>
                            <button type="button" class="dea-form-section-remove" onclick="removeStoredDEA(${deaFormIndex})">Remove</button>
                        </div>
                    `;
                    storedDEAContainer.appendChild(storedItem);
                    storedDEAContainer.style.display = 'block';
                }
            }

            function createNewDEAForm() {
                deaFormIndex++;
                const currentSection = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="0"]');
                if (!currentSection) return;

                // Clone the first form section
                const newSection = currentSection.cloneNode(true);
                newSection.setAttribute('data-dea-index', deaFormIndex);
                
                // Update IDs and names to be unique
                const allInputs = newSection.querySelectorAll('input, select, textarea, label');
                allInputs.forEach(input => {
                    if (input.id) {
                        input.id = input.id.replace('document_', 'document_' + deaFormIndex + '_');
                        if (input.name && input.name.startsWith('document[')) {
                            input.name = input.name.replace('document[', 'dea_documents[' + deaFormIndex + '][');
                        }
                    }
                    if (input.getAttribute('for')) {
                        input.setAttribute('for', input.getAttribute('for').replace('document_', 'document_' + deaFormIndex + '_'));
                    }
                });

                // Update file input handler
                const newFileInput = newSection.querySelector('input[type="file"]');
                if (newFileInput) {
                    newFileInput.id = 'fileInput_' + deaFormIndex;
                    newFileInput.name = 'dea_documents[' + deaFormIndex + '][fileName]';
                    newFileInput.onchange = function() {
                        handleFileChange(this, deaFormIndex);
                    };
                }

                // Update badge IDs
                const newBadge = newSection.querySelector('#fileBadge');
                if (newBadge) newBadge.id = 'fileBadge_' + deaFormIndex;
                const newFileNameText = newSection.querySelector('#fileNameText');
                if (newFileNameText) newFileNameText.id = 'fileNameText_' + deaFormIndex;

                // Clear all values in new section
                newSection.querySelectorAll('input, select, textarea').forEach(input => {
                    if (input.type !== 'hidden') {
                        input.value = '';
                    }
                });

                // Set category to DEA
                const newCategoryInput = newSection.querySelector('select[name*="category"]');
                if (newCategoryInput) {
                    newCategoryInput.value = 'All DEAs';
                    newCategoryInput.dispatchEvent(new Event('change'));
                }

                // Add remove button
                const sectionHeader = document.createElement('div');
                sectionHeader.className = 'dea-form-section-header';
                sectionHeader.innerHTML = `
                    <span class="dea-form-section-title">DEA ${deaFormIndex + 1}</span>
                    <button type="button" class="dea-form-section-remove" onclick="removeDEAForm(${deaFormIndex})">Remove</button>
                `;
                newSection.insertBefore(sectionHeader, newSection.firstChild);

                // Insert before the form actions
                deaFormsContainer.appendChild(newSection);

                // Scroll to new section
                newSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                // Initialize datepickers on cloned inputs
                try {
                    if (typeof flatpickr !== 'undefined') {
                        newSection.querySelectorAll('.js-datepicker').forEach(function(input){
                            if (!input._flatpickr) {
                                flatpickr(input, { dateFormat: 'Y-m-d' });
                            }
                        });
                    } else if (typeof $ !== 'undefined' && $.fn.flatpickr) {
                        $(newSection).find('.js-datepicker').flatpickr();
                    }
                } catch(_) {}
            }

            window.removeDEAForm = function(index) {
                const section = deaFormsContainer.querySelector('.dea-form-section[data-dea-index="' + index + '"]');
                if (section) {
                    section.remove();
                }
            };

            window.removeStoredDEA = function(index) {
                const storedItem = storedDEAContainer.querySelector('.stored-dea-item[data-dea-index="' + index + '"]');
                if (storedItem) {
                    storedItem.remove();
                }
                if (storedDEAContainer.children.length === 0) {
                    storedDEAContainer.style.display = 'none';
                }
            };

