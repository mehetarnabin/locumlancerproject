                    // Check for DEA name field
                    const deaNameInput = document.getElementById('dea_name');
                    if (categoryInput && categoryInput.value === 'All DEAs') {
                        if (!deaNameInput || !deaNameInput.value.trim()) {
                            e.preventDefault();
                            e.stopPropagation();
                            this.classList.add('was-validated');
                            showWarningAlert('Validation Error', 'Please enter a DEA name for DEA documents.');
                            if (deaNameInput) deaNameInput.focus();
                            return false;
                        }
                    }
                    
                    // Validate form before submission
                    if (!this.checkValidity()) {
                        e.preventDefault();
                        e.stopPropagation();
                        this.classList.add('was-validated');
