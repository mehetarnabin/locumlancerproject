    <div class="container-xl">
    

   {# Document Requests Table - Only Pending Requests #}
<div class="card app-card-settings">
    <div class="card-body">
        <div class="card-header-row">
            <h5 class="card-title">Pending Document Requests</h5>
        </div>

        <div class="table-responsive" id="requests-list-view" style="display: none;">
            <table class="table document-table align-middle">
                <thead>
                    <tr>
                        <th>Requested At</th>
                        <th>Document Name</th>
                        <th>Job</th>
                        <th>Requested By</th>
                        <th>Requested At</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% set pendingDocumentRequests = documentRequests|filter(request => request.providedAt is null) %}
                    {% set rowIndex = 0 %}
                    {% set hasRows = (pendingDocumentRequests|length > 0) or (credentialingLinks|length > 0) %}
                    {% if hasRows %}
                        {% for documentRequest in pendingDocumentRequests %}
                            {% set rowIndex = rowIndex + 1 %}
                            <tr>
                                <td>{{ documentRequest.createdAt|date('m/d/Y') }}</td>
                                <td><strong>{{ documentRequest.name }}</strong></td>
                                <td>
                                    {% if documentRequest.application and documentRequest.application.job %}
                                        {{ documentRequest.application.job.title }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if documentRequest.application and documentRequest.application.employer %}
                                        <div>
                                            <strong>{{ documentRequest.application.employer.companyName }}</strong><br/>
                                            <small class="text-muted">
                                                {% if documentRequest.application.employer.contactEmail %}
                                                    {{ documentRequest.application.employer.contactEmail }}
                                                {% elseif documentRequest.application.employer.email %}
                                                    {{ documentRequest.application.employer.email }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </small>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>{{ documentRequest.createdAt|date('m/d/Y') }}</td>
                                <td><span class="text-warning">Pending</span></td>
                                <td>
                                    <div class="document-select-wrapper" style="min-width: 200px;">
                                    <select class="form-control form-select document-select" 
                                            data-request-id="{{ documentRequest.id }}"
                                                data-request-name="{{ documentRequest.name|lower }}">
                                        <option value="">Select Document</option>
                                        {% for documentObj in documents %}
                                                <option value="{{ documentObj.id }}" 
                                                        data-doc-name="{{ (documentObj.category ?: documentObj.name)|lower }}"
                                                        {% if documentObj == documentRequest.document %}selected{% endif %}>
                                                {{ documentObj.category ?: documentObj.name }}
                                            </option>
                                        {% endfor %}
                                            <option value="__add_document__" class="add-document-option" data-request-id="{{ documentRequest.id }}">+ Add New Document</option>
                                    </select>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}

                        {% for link in credentialingLinks %}
                            {% set rowIndex = rowIndex + 1 %}
                            <tr>
                                <td>{{ link.createdAt|date('m/d/Y') }}</td>
                                <td>
                                    <div>
                                        <strong>{{ link.title }}</strong>
                                        {% if link.description %}
                                            <small class="text-muted d-block">{{ link.description }}</small>
                                        {% endif %}
                                        <small class="text-muted d-block">{{ link.url|replace({'https://': '', 'http://': ''})|slice(0, 60) }}{{ link.url|length > 60 ? '...' : '' }}</small>
                                    </div>
                                </td>
                                <td><span class="text-muted">-</span></td>
                                <td>
                                    <div>
                                        <strong>External Source</strong><br/>
                                        <small class="text-muted">{{ link.sender ?: 'System' }}</small>
                                    </div>
                                </td>
                                <td>{{ link.createdAt|date('m/d/Y') }}</td>
                                <td><span class="text-warning">Pending</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" class="action-btn" title="Open Link">
                                            Open Link
                                        </a>
                                        <button type="button" class="action-btn copy-link-btn" data-url="{{ link.url }}" title="Copy URL">Copy</button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="empty-state">
                                <div class="empty-state-icon">📋</div>
                                <p class="mb-0">No pending document requests found.</p>
                                <p class="text-muted small mt-2">All document requests have been provided.</p>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
        
        </div>
        
        {# Grid View for Document Requests - Grouped by Company #}
        <div class="documents-grid-view-container" id="requests-grid-view-container">
            <div class="grid-view-header">
                <h5>Select Documents to Submit</h5>
                <div class="grid-view-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="match-all-requests-btn">Match All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="deselect-all-requests-btn">Deselect All</button>
                    <button type="button" class="btn btn-sm btn-primary" id="submit-selected-requests-btn" disabled>Submit Selected</button>
                </div>
            </div>
            <div class="documents-grid-wrapper" id="requests-grid-wrapper">
                {% set companyGroups = {} %}
                {% for documentRequest in documentRequests %}
                    {% if documentRequest.providedAt is null and documentRequest.application and documentRequest.application.employer %}
                        {% set companyName = documentRequest.application.employer.companyName %}
                        {% if companyGroups[companyName] is not defined %}
                            {% set companyGroups = companyGroups|merge({(companyName): []}) %}
                    {% endif %}
                        {% set companyGroups = companyGroups|merge({(companyName): companyGroups[companyName]|merge([documentRequest])}) %}
                    {% endif %}
                {% endfor %}
                
                {% if companyGroups|length > 0 %}
                    {% for companyName, requests in companyGroups %}
                        <div class="company-document-group">
                            <div class="company-group-header">
                                <h6 class="company-name">{{ companyName }}</h6>
                                <span class="request-count">{{ requests|length }} request(s)</span>
                            </div>
                            <div class="requests-grid">
                                {% for request in requests %}
                                    <div class="request-card" data-request-id="{{ request.id }}" data-company="{{ companyName }}">
                                        <div class="request-card-header">
                                            <div class="request-title">{{ request.name }}</div>
                                            <div class="request-document-select">
                                                <select class="form-select document-select" 
                                                        data-request-id="{{ request.id }}"
                                                        data-request-name="{{ request.name|lower }}"
                                                        id="request-{{ request.id }}-document">
                                                    <option value="">Select Document</option>
                                                    {% for document in documents %}
                                                        <option value="{{ document.id }}" 
                                                                data-doc-name="{{ (document.category ?: document.name)|lower }}"
                                                                {% if request.document and request.document.id == document.id %}selected{% endif %}>
                                                            {{ document.category ?: document.name }}
                                                        </option>
                                                    {% endfor %}
                                                    <option value="__add_document__" class="add-document-option" data-request-id="{{ request.id }}">+ Add New Document</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-grid-state">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                        <h4>No pending document requests</h4>
                        <p>There are no pending document requests from companies at this time.</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

        {# Document Upload Form - Compact Version #}
    <div class="card app-card-settings">
            <div class="card-body" style="padding: 16px;">
            <div class="card-header-row" style="margin-bottom: 12px;">
                <h5 class="card-title" style="font-size: 1rem; margin: 0;">{{ editMode is defined ? 'Edit Document' : 'Upload Document' }}</h5>
            </div>
            
            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data', 'id': 'document-upload-form'}}) }}
            
            {# Container for stored DEA documents #}
            <div id="stored-dea-documents" style="display: none;"></div>
            
            {# Active DEA form sections container #}
            <div id="dea-forms-container">
                <div class="dea-form-section" data-dea-index="0">
            <div class="row g-3">
                {# Left Side: Text and Date Fields #}
                <div class="col-12 col-lg-8">
                    <div class="row g-3">
                {# Document Name Field (Category) #}
                <div class="col-12">
                            <div class="mb-2">
                                {{ form_label(form.category, null, {'label_attr': {'class': 'form-label', 'style': 'font-size: 0.875rem; margin-bottom: 4px;'}}) }}
                                {{ form_widget(form.category, {'attr': {'class': 'form-select', 'id': 'document_category', 'style': 'padding: 6px 10px; font-size: 0.875rem;'}}) }}
                        {{ form_errors(form.category) }}
                    </div>
                </div>

                        {# Document Name Field (Only for Miscellaneous) #}
                        <div class="col-12" id="document-name-wrapper" style="display: none;">
                            <div class="mb-2">
                                <label class="form-label" style="font-size: 0.875rem; margin-bottom: 4px;">Document Name <span class="text-danger">*</span></label>
                                <input type="text" 
                                       class="form-control" 
                                       id="document_name" 
                                       name="document[name]" 
                                       placeholder="Enter document name"
                                       style="padding: 6px 10px; font-size: 0.875rem;">
                                <small class="text-muted" style="font-size: 0.75rem;">Enter a custom name for this miscellaneous document</small>
                        </div>
                        </div>

                        {# Issue Date #}
                        <div class="col-12 col-md-6" id="issue-date-wrapper">
