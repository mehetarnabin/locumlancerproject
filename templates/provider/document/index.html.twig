            }

            window.submitRequestDocuments = function(pairs) {
                const submitSelectedBtn = document.getElementById('submit-selected-requests-btn');
                if (!submitSelectedBtn) return;

                // Disable button and show loading
                submitSelectedBtn.disabled = true;
                const originalText = submitSelectedBtn.innerHTML;
                submitSelectedBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

                const requestIds = pairs.map(p => p.requestId);
                const documentIds = pairs.map(p => p.documentId);

                fetch('/provider/documents/assign-multiple', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': '{{ csrf_token("assign_document") }}'
                    },
                    body: JSON.stringify({
                        requestIds: requestIds,
                        documentIds: documentIds
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showSuccessAlert('Success!', `Successfully submitted ${data.assignedRequestIds.length} document(s).`);
                        
                        // Reload page after a short delay
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        showErrorAlert('Error', data.message || 'An error occurred while submitting documents.');
                        submitSelectedBtn.disabled = false;
                        submitSelectedBtn.innerHTML = originalText;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showErrorAlert('Error', 'An error occurred while submitting documents. Please try again.');
                    submitSelectedBtn.disabled = false;
                    submitSelectedBtn.innerHTML = originalText;
                });
            };

            // Function to select document card and render preview (only for documents section now)
            function selectDocumentCard(card, section) {
                const isRequests = section === 'requests';
                // Requests now uses grid view, so skip split view logic for requests
                if (isRequests) return;
                
                const splitList = documentsSplitList;
                const splitDetails = documentsSplitDetails;
                const documentContent = documentsDocumentContent;
                const noDocumentSelected = documentsNoDocumentSelected;
                const linkedDocumentId = card.dataset.documentId;
                const linkedDocumentUrl = card.dataset.documentUrl;
                const formatValue = (val) => {
                    if (!val) return '—';
                    const normalized = String(val).trim();
                    return normalized.length ? normalized : '—';
                };
                
                // Remove active class from all cards
                splitList.querySelectorAll('.split-document-card').forEach(c => {
                    c.classList.remove('active');
                });
                
                // Add active class to selected card
                card.classList.add('active');
                
                // Get document ID and name
                const documentName = card.dataset.documentName || card.querySelector('.split-document-card-title')?.textContent || 'Document';
                const documentId = linkedDocumentId;
                const documentUrl = linkedDocumentUrl;

                
                if (documentId && documentUrl) {
                    // Hide empty state, show content
                    if (noDocumentSelected) noDocumentSelected.style.display = 'none';
                    documentContent.style.display = 'block';
                    
                    // Determine file type and render accordingly
                    const fileExtension = documentUrl.split('.').pop().toLowerCase();
                    let previewHTML = '';
                    
                    if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(fileExtension)) {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="/provider/documents/view/${documentId}" class="action-btn" title="View Full Page">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            View Full Page
                                        </a>
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            Open in New Tab
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame">
                                    <img src="${documentUrl}" alt="${documentName}" />
                                </div>
                            </div>
                        `;
                    } else if (['pdf'].includes(fileExtension)) {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="/provider/documents/view/${documentId}" class="action-btn" title="View Full Page">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            View Full Page
                                        </a>
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            Open in New Tab
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame">
                                    <iframe src="${documentUrl}" type="application/pdf"></iframe>
                                </div>
                            </div>
                        `;
                    } else {
                        previewHTML = `
                            <div class="document-preview-container">
                                <div class="document-preview-header">
                                    <div class="document-preview-title">${documentName}</div>
                                    <div class="document-preview-actions">
                                        <a href="${documentUrl}" target="_blank" class="action-btn" title="Open in New Tab">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13 3H21V11M21 3L11 13M21 3V7M21 3H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="document-preview-frame" style="display: flex; align-items: center; justify-content: center; padding: 40px;">
                                    <div style="text-align: center;">
                                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 16px; opacity: 0.5;">
                                            <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <p style="color: #000000; margin-bottom: 16px;">Preview not available for this file type</p>
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            <a href="/provider/documents/view/${documentId}" class="action-btn" style="display: inline-flex; padding: 8px 16px;">
                                                View Full Page
                                            </a>
                                            <a href="${documentUrl}" target="_blank" class="action-btn" style="display: inline-flex; padding: 8px 16px;">
                                                Open in New Tab
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                    
                    documentContent.innerHTML = previewHTML;
                } else {
                    // No document URL, show message
                    if (noDocumentSelected) noDocumentSelected.style.display = 'flex';
                    documentContent.style.display = 'none';
                }
            }

            // Toggle button functionality for documents
            if (documentsToggleBtn && documentsSplitViewContainer) {
                setupListToggle('documents', documentsToggleBtn, documentsSplitViewContainer, documentsSplitList, documentsSplitDetails);
            }

            function setupListToggle(section, toggleBtn, container, splitList, splitDetails) {
                toggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isCollapsed = container.classList.contains('list-collapsed');
                    
                    if (isCollapsed) {
                        expandList(container, splitList, splitDetails);
                    } else {
                        collapseList(container, splitList, splitDetails);
                    }
                    
                    setTimeout(() => updateToggleButtonPosition(section), 100);
                });

                // Update position on resize and scroll
                window.addEventListener('resize', () => updateToggleButtonPosition(section));
                window.addEventListener('scroll', () => updateToggleButtonPosition(section), true);
            }

            function collapseList(container, splitList, splitDetails) {
                if (!container.classList.contains('list-collapsed')) {
                    container.classList.add('list-collapsed');
                    if (splitList) {
                        splitList.style.display = 'none';
                        splitList.style.width = '0';
                        splitList.style.minWidth = '0';
                        splitList.style.maxWidth = '0';
                        splitList.style.padding = '0';
                        splitList.style.margin = '0';
                        splitList.style.visibility = 'hidden';
                    }
                    if (splitDetails) {
                        splitDetails.style.gridColumn = '1 / -1';
                        splitDetails.style.width = '100%';
                        splitDetails.style.maxWidth = '100%';
                    }
                }
            }

            function expandList(container, splitList, splitDetails) {
                if (container.classList.contains('list-collapsed')) {
                    container.classList.remove('list-collapsed');
                    if (splitList) {
                        splitList.style.display = 'block';
                        splitList.style.width = '';
                        splitList.style.minWidth = '';
                        splitList.style.maxWidth = '';
                        splitList.style.padding = '';
                        splitList.style.margin = '';
                        splitList.style.visibility = 'visible';
                    }
                    if (splitDetails) {
                        splitDetails.style.gridColumn = '';
                        splitDetails.style.width = '';
                        splitDetails.style.maxWidth = '';
                    }
                }
            }

            function updateToggleButtonPosition(section) {
                // Only handle documents section now (requests uses grid view)
                const toggleBtn = documentsToggleBtn;
                const container = documentsSplitViewContainer;
                const splitDetails = documentsSplitDetails;
                
                if (!toggleBtn || !container || container.style.display !== 'grid') {
                    if (toggleBtn) toggleBtn.style.display = 'none';
                    return;
                }
                
                const isCollapsed = container.classList.contains('list-collapsed');
                
                if (isCollapsed) {
                    toggleBtn.style.display = 'flex';
                    if (splitDetails) {
                        const detailsRect = splitDetails.getBoundingClientRect();
                        toggleBtn.style.position = 'fixed';
                        toggleBtn.style.left = (detailsRect.left - 18) + 'px';
                        toggleBtn.style.top = (detailsRect.top + 60) + 'px';
                        toggleBtn.style.transform = 'none';
                    }
                } else {
                    toggleBtn.style.display = 'none';
                }
            }

            // Document History Pagination with Bundle Support
            (function() {
                const historyBundlesData = document.getElementById('history-bundles-data');
                if (!historyBundlesData) return;
                
                try {
                    const jsonText = historyBundlesData.textContent || historyBundlesData.innerText || '';
                    if (!jsonText) return;
                    const allBundles = JSON.parse(jsonText);
                    const entriesPerPage = 10;
                    let currentPage = 1;
                    const totalPages = Math.ceil(allBundles.length / entriesPerPage);
                    
                    const historyContainer = document.getElementById('history-entries-container');
                    const paginationWrapper = document.getElementById('history-pagination-wrapper');
                    const pagination = document.getElementById('history-pagination');
                    let prevBtn = document.getElementById('history-prev-page');
                    let nextBtn = document.getElementById('history-next-page');
                    const startIndexEl = document.getElementById('history-start-index');
                    const endIndexEl = document.getElementById('history-end-index');
                    
                    if (!historyContainer) return;
                    
                    // If no pagination needed, show all entries and hide pagination controls
                    if (totalPages <= 1) {
                        if (paginationWrapper) paginationWrapper.style.display = 'none';
                        // Still need to initialize bundle click handlers
                        initializeBundleHandlers();
                        return;
                    }
                    
                    // Show pagination wrapper
                    if (paginationWrapper) paginationWrapper.style.display = 'block';
                    
                    // Generate page number buttons
                    if (pagination) {
                        let pageButtonsHtml = '<li class="page-item" id="history-prev-page"><a class="page-link" href="#" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>';
                        for (let i = 1; i <= totalPages; i++) {
                            pageButtonsHtml += '<li class="page-item history-page-item' + (i === 1 ? ' active' : '') + '" data-page="' + i + '"><a class="page-link" href="#">' + i + '</a></li>';
                        }
                        pageButtonsHtml += '<li class="page-item" id="history-next-page"><a class="page-link" href="#" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>';
                        pagination.innerHTML = pageButtonsHtml;
                        
                        // Update button references after regenerating HTML
                        prevBtn = document.getElementById('history-prev-page');
                        nextBtn = document.getElementById('history-next-page');
                    }
                    
                    // Helper functions
                    function escapeHtml(text) {
                        const div = document.createElement('div');
                        div.textContent = text;
                        return div.innerHTML;
                    }
                    
                    function formatDate(dateString) {
                        if (!dateString) return '—';
                        const date = new Date(dateString);
                        if (isNaN(date.getTime())) return '—';
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        const year = date.getFullYear();
                        let hours = date.getHours();
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        const ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12;
                        hours = hours ? hours : 12;
                        return month + '/' + day + '/' + year + ' ' + hours + ':' + minutes + ' ' + ampm;
                    }
                    
                    function getActionBadge(action) {
                        const badges = {
                            'uploaded': '<span class="action-badge uploaded">Uploaded</span>',
                            'updated': '<span class="action-badge updated">Updated</span>',
                            'assigned': '<span class="action-badge assigned">Assigned</span>'
                        };
                        return badges[action] || '';
                    }
                    
                    function renderBundle(bundle, bundleIndex, displayIndex) {
                        if (bundle.type === 'bundle') {
                            let bundleHTML = '<div class="history-bundle-wrapper" data-bundle-index="' + bundleIndex + '">';
                            bundleHTML += '<div class="document-row history-bundle-tile" data-bundle-id="bundle-' + bundleIndex + '" style="cursor: pointer; background-color: #f8f9fa; border-left: 4px solid #85BB65;">';
                            bundleHTML += '<div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">' + displayIndex + '</div>';
                            bundleHTML += '<div class="col-history-name" style="flex: 2; justify-content: flex-start;">';
                            bundleHTML += '<strong>' + bundle.count + ' documents submitted to ' + escapeHtml(bundle.employer) + '</strong>';
                            bundleHTML += '</div>';
                            bundleHTML += '<div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">';
                            bundleHTML += '<span class="action-badge assigned">Bundle</span>';
                            bundleHTML += '</div>';
                            bundleHTML += '<div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">' + formatDate(bundle.date) + '</div>';
                            bundleHTML += '<div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000; display: flex; align-items: center; gap: 8px;">';
                            bundleHTML += '<span>Click to expand</span>';
                            bundleHTML += '<span class="bundle-arrow" style="transition: transform 0.3s ease;">▼</span>';
                            bundleHTML += '</div></div>';
                            
                            // Bundle content (hidden by default)
                            bundleHTML += '<div class="history-bundle-content" id="bundle-content-' + bundleIndex + '" style="display: none;">';
                            bundle.entries.forEach(function(entry) {
                                bundleHTML += '<div class="document-row history-entry bundle-entry" style="padding-left: 40px; background-color: #ffffff; border-left: 2px solid #e6eef6;">';
                                bundleHTML += '<div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">—</div>';
                                bundleHTML += '<div class="col-history-name" style="flex: 2; justify-content: flex-start;">';
                                bundleHTML += '<strong>' + escapeHtml(entry.name) + '</strong>';
                                bundleHTML += '</div>';
                                bundleHTML += '<div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">';
                                bundleHTML += getActionBadge(entry.action);
                                bundleHTML += '</div>';
                                bundleHTML += '<div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">' + formatDate(entry.date) + '</div>';
                                bundleHTML += '<div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000;">' + escapeHtml(entry.details) + '</div>';
                                bundleHTML += '</div>';
                            });
                            bundleHTML += '</div></div>';
                            return bundleHTML;
                        } else {
                            // Individual entry
                            let entryHTML = '<div class="document-row history-entry" data-entry-index="' + bundleIndex + '">';
                            entryHTML += '<div class="col-history-sno" style="width: 60px; flex-shrink: 0; justify-content: center;">' + displayIndex + '</div>';
                            entryHTML += '<div class="col-history-name" style="flex: 2; justify-content: flex-start;">';
                            entryHTML += '<strong>' + escapeHtml(bundle.entry.name) + '</strong>';
                            entryHTML += '</div>';
                            entryHTML += '<div class="col-history-action" style="width: 120px; flex-shrink: 0; justify-content: center;">';
                            entryHTML += getActionBadge(bundle.entry.action);
                            entryHTML += '</div>';
                            entryHTML += '<div class="col-history-date" style="width: 180px; flex-shrink: 0; justify-content: center;">' + formatDate(bundle.entry.date) + '</div>';
                            entryHTML += '<div class="col-history-details" style="flex: 2; justify-content: flex-start; font-size: 12px; color: #000000;">' + escapeHtml(bundle.entry.details) + '</div>';
                            entryHTML += '</div>';
                            return entryHTML;
                        }
                    }
                    
                    function renderHistoryPage(page) {
                        const startIndex = (page - 1) * entriesPerPage;
                        const endIndex = Math.min(startIndex + entriesPerPage, allBundles.length);
                        const pageBundles = allBundles.slice(startIndex, endIndex);
                        
                        // Clear container
                        historyContainer.innerHTML = '';
                        
                        // Render bundles and entries
                        pageBundles.forEach(function(bundle, index) {
                            const bundleIndex = startIndex + index;
                            const displayIndex = bundleIndex + 1;
                            historyContainer.innerHTML += renderBundle(bundle, bundleIndex, displayIndex);
                        });
                        
                        // Initialize bundle click handlers after rendering
                        initializeBundleHandlers();
                        
                        // Update pagination info
                        if (startIndexEl) startIndexEl.textContent = startIndex + 1;
                        if (endIndexEl) endIndexEl.textContent = endIndex;
                        
                        // Update active page
                        document.querySelectorAll('.history-page-item').forEach(function(item) {
                            item.classList.remove('active');
                            if (parseInt(item.dataset.page) === page) {
                                item.classList.add('active');
                            }
                        });
                        
                        // Update prev/next buttons
                        if (prevBtn) {
                            if (page === 1) {
                                prevBtn.classList.add('disabled');
                                const prevLink = prevBtn.querySelector('a');
                                if (prevLink) prevLink.style.pointerEvents = 'none';
                            } else {
                                prevBtn.classList.remove('disabled');
                                const prevLink = prevBtn.querySelector('a');
                                if (prevLink) prevLink.style.pointerEvents = 'auto';
                            }
                        }
                        if (nextBtn) {
                            if (page === totalPages) {
                                nextBtn.classList.add('disabled');
                                const nextLink = nextBtn.querySelector('a');
                                if (nextLink) nextLink.style.pointerEvents = 'none';
                            } else {
                                nextBtn.classList.remove('disabled');
                                const nextLink = nextBtn.querySelector('a');
                                if (nextLink) nextLink.style.pointerEvents = 'auto';
                            }
                        }
                    }
                    
                    // Initialize bundle expand/collapse handlers
                    function initializeBundleHandlers() {
                        document.querySelectorAll('.history-bundle-tile').forEach(function(tile) {
                            tile.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                
                                const bundleId = this.getAttribute('data-bundle-id');
                                const content = document.getElementById('bundle-content-' + bundleId.replace('bundle-', ''));
                                const arrow = this.querySelector('.bundle-arrow');
                                
                                if (content) {
                                    if (content.style.display === 'none') {
                                        content.style.display = 'block';
                                        if (arrow) {
                                            arrow.style.transform = 'rotate(180deg)';
                                        }
                                    } else {
                                        content.style.display = 'none';
                                        if (arrow) {
                                            arrow.style.transform = 'rotate(0deg)';
                                        }
                                    }
                                }
                            });
                        });
                    }
                    
                    // Initial render
                    renderHistoryPage(1);
                    
                    // Page click handlers (using event delegation for dynamically created buttons)
                    if (pagination) {
                        pagination.addEventListener('click', function(e) {
                            e.preventDefault();
                            
                            // Handle page number clicks
                            const pageItem = e.target.closest('.history-page-item');
                            if (pageItem && !pageItem.classList.contains('disabled')) {
                                const page = parseInt(pageItem.dataset.page);
                                if (page !== currentPage && !isNaN(page)) {
                                    currentPage = page;
                                    renderHistoryPage(currentPage);
                                }
                                return;
                            }
                            
                            // Handle prev button
                            const prevBtnClicked = e.target.closest('#history-prev-page') || 
                                                   (e.target.tagName === 'A' && e.target.closest('li#history-prev-page')) ||
                                                   (e.target.tagName === 'SPAN' && e.target.closest('li#history-prev-page'));
                            if (prevBtnClicked && !prevBtnClicked.classList.contains('disabled')) {
                                if (currentPage > 1) {
                                    currentPage--;
                                    renderHistoryPage(currentPage);
                                }
                                return;
                            }
                            
                            // Handle next button
                            const nextBtnClicked = e.target.closest('#history-next-page') || 
                                                   (e.target.tagName === 'A' && e.target.closest('li#history-next-page')) ||
                                                   (e.target.tagName === 'SPAN' && e.target.closest('li#history-next-page'));
                            if (nextBtnClicked && !nextBtnClicked.classList.contains('disabled')) {
                                if (currentPage < totalPages) {
                                    currentPage++;
                                    renderHistoryPage(currentPage);
                                }
                                return;
                            }
                        });
                    }
                } catch (e) {
                    console.warn('History pagination error:', e);
                }
            })();

            // Deep-link: open a specific document request in grid view if provided via query param
            (function() {
                try {
                    const params = new URLSearchParams(window.location.search);
                    const openRequestId = params.get('openRequest');
                    if (openRequestId) {
                        // Grid view is always active for requests now
                        const requestsGridViewContainer = document.getElementById('requests-grid-view-container');
                        if (requestsGridViewContainer) {
                            requestsGridViewContainer.style.display = 'block';
                        }
                        // Scroll to the request in grid view
                        setTimeout(() => {
                            const requestItem = document.querySelector(`[data-request-id="${openRequestId}"]`);
                            if (requestItem) {
                                requestItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                requestItem.style.background = '#fff3cd';
                                setTimeout(() => {
                                    requestItem.style.background = '';
                                }, 2000);
                            }
                        }, 300);
                    }
                } catch (e) {
                    console.warn('Deep-link openRequest handler error:', e);
                }
            })();
        });
    </script>
{% endblock %}
