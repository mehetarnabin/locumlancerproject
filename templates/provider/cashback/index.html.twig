{% extends 'provider/base.html.twig' %}

{% block title %}Cashback History{% endblock %}

{% block provider_body %}
<style>
/* Reset container-xl to match other sections */
.container-xl {
    margin-left: 0 !important;
    padding-left: 0 !important;
    padding-right: 30px !important;
    max-width: 100% !important;
    transform: none !important;
}

/* Enhanced table alignment and typography */
.job-header {
  font-size: 13px;
  font-weight: 600;
  color: #121C0C;
  letter-spacing: 0.01em;
  line-height: 1.5;
  background: #F8FAF9;
  border-bottom: 2px solid #e6eef6;
  padding-left: 10px;
  padding-right: 10px;
  box-shadow: 0 2px 6px rgba(11,22,40,0.03);
  border-radius: 10px;
  border: 1px solid #e6eef6;
  height: 40px;
  min-height: 40px;
  margin-bottom: 2px;
}

.job-row {
  font-size: 12px;
  font-weight: 400;
  color: #1a1a1a;
  line-height: 1.5;
  transition: background-color 0.2s ease;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  margin: 2px 0;
  border-radius: 10px;
  background: #F4F9F1;
  border: 1px solid #e6eef6;
  box-shadow: 0 2px 6px rgba(11,22,40,0.03);
  min-height: 40px;
  height: 40px;
}

.job-row:hover {
  background-color: #F8FAF9;
}

/* Perfect alignment between headers and rows */
.job-header {
  display: flex;
  align-items: center;
  padding-left: 14px;
  padding-right: 14px;
}

.job-header > div,
.job-row > div {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
  min-height: 40px;
  height: 40px;
}

.job-header .col-start.col-center,
.job-row .col-start.col-center {
  justify-content: center;
  text-align: center;
}

/* Job column specific styling */
.col-job {
  font-weight: 500;
}

/* Improve text truncation */
.job-title {
  font-size: 12px;
  font-weight: 500;
  color: #121C0C;
  line-height: 1.4;
}

.job-row > div {
  font-size: 12px;
  color: #1a1a1a;
}

.col-job,
.col-location,
.col-schedule,
.col-expiry,
.col-start,
.col-action {
    flex: 1;
    min-width: 130px;
}
.col-job {
    flex: 2;
}

.job-section {
    background-color: #fff;
}

.col-center {
    text-align: center;
}
</style>
    <div class="container-xl">
        <div class="job-section shadow-lg p-3 rounded-3">
            <h6 class="app-card-title mb-3" style="padding-left: 14px;">Cashback History</h6>

            {% if cashbacks|length > 0 %}
            <div class="job-list-container bg-light p-3 rounded-3">
                <div class="d-flex align-items-center job-lists">
                    <div class="d-flex align-items-center flex-grow-1" style="padding-left: 0;">
                        <div class="job-header d-flex align-items-center fw-semibold flex-grow-1" style="padding-left: 14px; padding-right: 14px;">
                            <div class="col-job" style="flex: 2; padding-left: 8px; padding-right: 8px;">Job</div>
                            <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">Employer</div>
                            <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">Amount($)</div>
                            <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">CreatedAt</div>
                            <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">Status</div>
                        </div>
                    </div>
                </div>
                {% for cashback in cashbacks %}
                <div class="d-flex align-items-center job-lists">
                    <div class="job-row d-flex align-items-center flex-grow-1" style="padding-left: 14px; padding-right: 14px;">
                        <div class="col-job d-flex align-items-center gap-2" style="flex: 2; padding-left: 8px; padding-right: 8px;">
                            <img src="{{ asset('assets/icons/job.png') }}"
                                 alt="Logo"
                                 style="width: 40px; height: 40px; border-radius: 8px; flex-shrink: 0;" />
                            <div>
                                <a href="{{ path('app_provider_cashback_detail', {'id': cashback.id}) }}">{{ cashback.job }}</a>
                            </div>
                        </div>
                        <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">{{ cashback.employer }}</div>
                        <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">{{ cashback.amount|number_format }}</div>
                        <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;">{{ cashback.createdAt ? cashback.createdAt|date('m/d/Y') : '' }}</div>
                        <div class="col-start col-center" style="flex: 1; padding-left: 8px; padding-right: 8px;"><span class="badge badge-pill {% if cashback.status == 'pending' %}is-review{% elseif cashback.status == 'paid' %}is-hired{% endif %}">
                                    {{ cashback.status }}
                                </span></div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
                <p class="mb-0">No records found</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
