{% include 'includes/header.html.twig' %}

<main>
    {% block body %}{% endblock %}
</main>

{% include 'includes/footer.html.twig' %}

<script src="{{ asset('assets/frontend/js/jquery-2.0.0.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" ></script>
<script src="{{ asset('assets/frontend/js/main.js') }}"></script>

<script>
    // Page fade-in to hide JavaScript loading irregularities - only on actual page navigation
    (function() {
        // Fade in on page load
        function fadeIn() {
            document.body.classList.add('page-loaded');
        }
        
        if (document.readyState === 'complete') {
            fadeIn();
        } else {
            window.addEventListener('load', fadeIn);
            document.addEventListener('DOMContentLoaded', function() {
                // Small delay to ensure JS has initialized
                setTimeout(fadeIn, 50);
            });
        }
        
        // Handle page navigation - fade out before leaving (only for actual page changes)
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (!link || !link.href) return;
            
            // Skip if:
            // - Has target attribute (opens in new window/tab)
            // - Is same page anchor (#)
            // - Has data attributes indicating it's not a page change (popup, modal, dropdown, etc.)
            // - Is a JavaScript link (href="#", href="javascript:", etc.)
            if (link.target || 
                link.href === window.location.href || 
                link.href.endsWith('#') ||
                link.href.startsWith('javascript:') ||
                link.hasAttribute('data-bs-toggle') ||
                link.hasAttribute('data-bs-target') ||
                link.hasAttribute('data-popup') ||
                link.hasAttribute('data-no-fade') ||
                link.closest('.dropdown-menu') ||
                link.closest('[data-bs-toggle="dropdown"]') ||
                link.closest('.modal') ||
                link.closest('[role="button"]:not(a)')) {
                return;
            }
            
            try {
                const url = new URL(link.href);
                // Only fade if it's a same-origin navigation (actual page change)
                if (url.origin === window.location.origin && 
                    url.pathname !== window.location.pathname) {
                    document.body.style.opacity = '0';
                }
            } catch (err) {
                // Invalid URL, ignore
            }
        });
        
        // Handle browser back/forward
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) {
                // Page was loaded from cache
                fadeIn();
            }
        });
    })();
</script>

<script>
    function showToast(type, message) {
        console.log(`${type.toUpperCase()}: ${message}`);
        Toastify({
            text: message,
            duration: 3000,
            close: true,
            gravity: "top", // `top` or `bottom`
            position: "right", // `left`, `center` or `right`
            stopOnFocus: true, // Prevents dismissing of toast on hover
            style: {
                background: "linear-gradient(to right, #9AC77F, #9AC77F)",
            },
            onClick: function(){} // Callback after click
        }).showToast();
    }
</script>

{% block footer_scripts %}{% endblock %}

</body>
</html>
