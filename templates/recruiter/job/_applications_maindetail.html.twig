                        </p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
// Filter Panel functionality - following the same pattern as _application_detail.html.twig
// Use IIFE to prevent duplicate initialization
(function() {
    'use strict';
    
    // Guard: Only initialize once
    if (window._filterPanelInitialized) {
        return;
    }
    window._filterPanelInitialized = true;
    
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize filter panel functions (scoped to this callback)
        function switchFilterTab(tabName, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            // Handle "coming soon" tabs
            if (tabName === 'recruiter-assigned' || tabName === 'recruiter-applied') {
                alert('Coming soon');
                return;
            }
            
            // Remove active class from all tabs
            const tabs = document.querySelectorAll('.filter-tab');
            tabs.forEach(function(tab) {
                tab.classList.remove('active');
                tab.style.borderBottomColor = 'transparent';
                tab.style.color = '#6b7280';
                tab.style.fontWeight = '500';
            });
            
            // Hide all tab contents
            const contents = document.querySelectorAll('.filter-tab-content');
            contents.forEach(function(content) {
                content.style.display = 'none';
            });
            
            // Activate selected tab
            const activeTab = document.querySelector('[data-tab="' + tabName + '"]');
            if (activeTab) {
                activeTab.classList.add('active');
                activeTab.style.borderBottomColor = '#85BB65';
                activeTab.style.color = '#85BB65';
                activeTab.style.fontWeight = '600';
            }
            
            // Show selected tab content
            const activeContent = document.getElementById(tabName + '-content');
            if (activeContent) {
                activeContent.style.display = 'block';
            }
        }
        
        function toggleFilterPanel(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const filterPanelEl = document.getElementById('filter-panel');
            
            if (filterPanelEl) {
                const isHidden = filterPanelEl.classList.contains('hidden');
                if (isHidden) {
                    filterPanelEl.classList.remove('hidden');
                    filterPanelEl.style.display = 'block';
                } else {
                    filterPanelEl.classList.add('hidden');
                    filterPanelEl.style.display = 'none';
                }
            }
        }
        
        function applyFilters(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const form = document.getElementById('filter-form');
            if (!form) return;
            
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            // Add all filter values
            formData.forEach(function(value, key) {
                if (value && value.trim() !== '') {
                    params.append(key, value.trim());
                }
            });
            
            // Preserve job ID and application ID if present
            const urlParams = new URLSearchParams(window.location.search);
            const jobId = urlParams.get('id') || window.location.pathname.split('/').pop();
            const applicationId = urlParams.get('applicationId');
            
            // Build new URL
            const baseUrl = window.location.pathname.split('?')[0];
            let newUrl = baseUrl;
            if (jobId) {
                newUrl = baseUrl.replace(/\/[^\/]+$/, '/' + jobId);
            }
            if (params.toString()) {
                newUrl += '?' + params.toString();
                if (applicationId) {
                    newUrl += '&applicationId=' + applicationId;
                }
            } else if (applicationId) {
                newUrl += '?applicationId=' + applicationId;
            }
            
            // Reload page with filters
            window.location.href = newUrl;
        }
        
        function clearFilters() {
            // Clear all filter inputs
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                filterForm.reset();
            }
            
            // Get current URL without filter params
            const urlParams = new URLSearchParams(window.location.search);
            const jobId = urlParams.get('id') || window.location.pathname.split('/').pop();
            const applicationId = urlParams.get('applicationId');
            
            // Build new URL with only job ID and application ID if present
            const baseUrl = window.location.pathname.split('?')[0];
            let newUrl = baseUrl;
            if (jobId) {
                newUrl = baseUrl.replace(/\/[^\/]+$/, '/' + jobId);
            }
            if (applicationId) {
                newUrl += '?applicationId=' + applicationId;
            }
            
            // Reload page without filters
            window.location.href = newUrl;
        }
        
        // Make functions globally available for onclick handlers (only if not already set)
        if (!window.toggleFilterPanel) {
            window.toggleFilterPanel = toggleFilterPanel;
        }
        if (!window.applyFilters) {
            window.applyFilters = applyFilters;
        }
        if (!window.clearFilters) {
            window.clearFilters = clearFilters;
        }
        if (!window.switchFilterTab) {
            window.switchFilterTab = switchFilterTab;
        }
        
        // Close filter panel when clicking outside (only add once)
        if (!window._filterPanelClickHandlerAdded) {
            document.addEventListener('click', function(event) {
                const filterBtnEl = document.getElementById('filter-btn');
                const filterPanelEl = document.getElementById('filter-panel');
                
                if (filterBtnEl && filterPanelEl && !filterBtnEl.contains(event.target) && !filterPanelEl.contains(event.target)) {
                    filterPanelEl.classList.add('hidden');
                    filterPanelEl.style.display = 'none';
                }
            });
            window._filterPanelClickHandlerAdded = true;
        }
    });
})();

// Toggle Candidate Section (Hide/Show entire left column)
function toggleCandidateSection() {
    const mainLayout = document.getElementById('applications-main-layout');
    const candidateColumn = document.getElementById('candidate-column');
    const collapseBtn = document.getElementById('candidate-collapse-btn');
    const arrow = collapseBtn ? collapseBtn.querySelector('.candidate-collapse-arrow') : null;
    
    if (mainLayout && candidateColumn && collapseBtn) {
        if (mainLayout.classList.contains('candidate-collapsed')) {
            // Expand - show candidates
            mainLayout.classList.remove('candidate-collapsed');
            mainLayout.style.gridTemplateColumns = '250px 1fr';
            if (arrow) {
                arrow.style.transform = 'rotate(0deg)';
            }
        } else {
            // Collapse - hide candidates
            mainLayout.classList.add('candidate-collapsed');
            mainLayout.style.gridTemplateColumns = '0 1fr';
            if (arrow) {
                arrow.style.transform = 'rotate(180deg)';
            }
        }
    }
}

// Make function available globally
window.toggleCandidateSection = toggleCandidateSection;

// Toggle Status Dropdown
function toggleStatusDropdown(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    
    const statusBtn = document.getElementById('status-switch-btn');
    const statusPanel = document.getElementById('status-dropdown-panel');
    
    if (statusBtn && statusPanel) {
        const isHidden = statusPanel.classList.contains('hidden');
        if (isHidden) {
            statusPanel.classList.remove('hidden');
            statusPanel.style.display = 'block';
        } else {
            statusPanel.classList.add('hidden');
            statusPanel.style.display = 'none';
        }
    }
}

// Close status dropdown when clicking outside
document.addEventListener('click', function(event) {
    const statusBtn = document.getElementById('status-switch-btn');
    const statusPanel = document.getElementById('status-dropdown-panel');
    
    if (statusPanel && statusBtn && !statusPanel.contains(event.target) && !statusBtn.contains(event.target)) {
        statusPanel.classList.add('hidden');
        statusPanel.style.display = 'none';
    }
});

// Change Application Status
function changeApplicationStatus(transition, applicationId) {
    if (!transition || !applicationId) {
        console.error('Missing transition or applicationId');
        return;
    }
    
    // Build the transition URL using the job ID from the template
    const jobId = '{{ job.id }}';
    const baseUrl = '{{ path('app_recruiter_job_application_transition', {'id': job.id, 'transition': 'PLACEHOLDER_TRANSITION', 'applicationId': 'PLACEHOLDER_APP_ID'}) }}';
    const transitionUrl = baseUrl
        .replace('PLACEHOLDER_TRANSITION', transition)
        .replace('PLACEHOLDER_APP_ID', applicationId);
    
    // Show loading state
    const statusBtn = document.getElementById('status-switch-btn');
    const statusPanel = document.getElementById('status-dropdown-panel');
    if (statusBtn) {
        const statusText = statusBtn.querySelector('#status-switch-text');
        if (statusText) {
            statusText.textContent = 'Updating...';
        }
        statusBtn.disabled = true;
        
        // Close dropdown
        if (statusPanel) {
            statusPanel.classList.add('hidden');
            statusPanel.style.display = 'none';
        }
        
        // Redirect to transition URL
        window.location.href = transitionUrl;
    }
}

// Make functions available globally
window.toggleStatusDropdown = toggleStatusDropdown;
window.changeApplicationStatus = changeApplicationStatus;
</script>
