{# Job Applications Main Detail Section #}
{# This file controls the entire main detail layout: Top Action Buttons, Left (Candidates + Search), Right (Application Detail) #}

<style>
/* CRITICAL: Conditional buttons are hidden by default - STRONGEST OVERRIDE */
.actions-container .conditional-btn,
.actions-container #action-request-file-btn,
.actions-container #action-schedule-interview-btn,
.actions-container #action-request-documents-btn,
.actions-container #action-send-offer-btn,
.actions-container #action-send-contract-btn,
.actions-container #action-send-credential-btn,
.actions-container #action-write-review-btn,
.job-actions-left .conditional-btn,
.job-actions-left #action-request-file-btn,
.job-actions-left #action-schedule-interview-btn,
.job-actions-left #action-request-documents-btn,
.job-actions-left #action-send-offer-btn,
.job-actions-left #action-send-contract-btn,
.job-actions-left #action-send-credential-btn,
.job-actions-left #action-write-review-btn {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    position: absolute !important;
    left: -9999px !important;
    width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
    max-width: 0 !important;
    max-height: 0 !important;
}

/* Show conditional button ONLY when it has the 'show' class AND display is set to flex */
.actions-container .conditional-btn.show,
.actions-container #action-request-file-btn.show,
.actions-container #action-schedule-interview-btn.show,
.actions-container #action-request-documents-btn.show,
.actions-container #action-send-offer-btn.show,
.actions-container #action-send-contract-btn.show,
.actions-container #action-send-credential-btn.show,
.actions-container #action-write-review-btn.show,
.job-actions-left .conditional-btn.show,
.job-actions-left #action-request-file-btn.show,
.job-actions-left #action-schedule-interview-btn.show,
.job-actions-left #action-request-documents-btn.show,
.job-actions-left #action-send-offer-btn.show,
.job-actions-left #action-send-contract-btn.show,
.job-actions-left #action-send-credential-btn.show,
.job-actions-left #action-write-review-btn.show {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    position: static !important;
    left: auto !important;
    width: auto !important;
    max-width: none !important;
    max-height: none !important;
    height: 34px !important;
    padding: 6px 14px !important;
    margin: 0 !important;
    overflow: visible !important;
    border: 1px solid #D8D8D8 !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
    background: #fff !important;
    border-radius: 10px !important;
    color: #333333 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
    outline: none !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
}

/* Action Buttons - Consistent 34px height and hover effects */
.action-btn:not(.conditional-btn),
.menu-dropdown-btn.dropdown-cstm {
    height: 34px !important;
    padding: 6px 14px !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    border: 1px solid #D8D8D8 !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
    background: #fff !important;
    border-radius: 10px !important;
    color: #333333 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
}

/* Menu button has special background */
.menu-dropdown-btn.dropdown-cstm {
    background: #D9F2D9 !important;
}

.action-btn svg,
.menu-dropdown-btn.dropdown-cstm svg {
    stroke: #000000 !important;
    transition: stroke 0.2s ease !important;
}

/* Hover effect - highlight both text and SVG */
.action-btn:hover,
.menu-dropdown-btn.dropdown-cstm:hover,
.conditional-btn.show:hover {
    color: #85BB65 !important;
    border-color: #85BB65 !important;
}

.action-btn:hover svg,
.menu-dropdown-btn.dropdown-cstm:hover svg,
.conditional-btn.show:hover svg {
    stroke: #85BB65 !important;
}

.action-btn:hover span,
.menu-dropdown-btn.dropdown-cstm:hover span,
.action-btn:hover,
.menu-dropdown-btn.dropdown-cstm:hover,
.conditional-btn.show:hover span {
    color: #85BB65 !important;
}

/* Specific styles for Request Documents button */
#action-request-documents-btn {
    width: 85px !important;
    height: 35px !important;
    border-radius: 10px !important;
}

/* Remove black borders from conditional buttons - override all possible sources */
.conditional-btn,
.conditional-btn.show,
.conditional-btn:focus,
.conditional-btn:active,
#action-request-file-btn,
#action-request-file-btn.show,
#action-request-file-btn:focus,
#action-request-file-btn:active,
#action-schedule-interview-btn,
#action-schedule-interview-btn.show,
#action-schedule-interview-btn:focus,
#action-schedule-interview-btn:active,
#action-request-documents-btn,
#action-request-documents-btn.show,
#action-request-documents-btn:focus,
#action-request-documents-btn:active,
#action-send-offer-btn,
#action-send-offer-btn.show,
#action-send-offer-btn:focus,
#action-send-offer-btn:active,
#action-send-contract-btn,
#action-send-contract-btn.show,
#action-send-contract-btn:focus,
#action-send-contract-btn:active,
#action-send-credential-btn,
#action-send-credential-btn.show,
#action-send-credential-btn:focus,
#action-send-credential-btn:active,
#action-write-review-btn,
#action-write-review-btn.show,
#action-write-review-btn:focus,
#action-write-review-btn:active {
    border: 1px solid #D8D8D8 !important;
    outline: none !important;
    outline-offset: 0 !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
}


/* Candidate Section Collapse Styles */
.applications-main-layout.candidate-collapsed {
    grid-template-columns: 0 1fr !important;
}

.applications-main-layout.candidate-collapsed .candidate-column {
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    padding: 0;
    margin: 0;
}

.candidate-collapse-btn {
    color: #000000;
}

.candidate-collapse-btn:hover {
    background: #F4F9F1 !important;
    border-color: #85BB65 !important;
    color: #85BB65;
}

.candidate-collapse-btn {
    transition: all 0.3s ease;
}

.candidate-collapse-btn:hover {
    background: #F4F9F1 !important;
    border-color: #85BB65 !important;
    color: #85BB65;
}

.candidate-collapse-btn:hover svg {
    stroke: #85BB65 !important;
}

/* Arrow rotation - starts pointing right, rotates to point left when collapsed */
.candidate-collapse-arrow {
    transform: rotate(0deg);
    transition: transform 0.3s ease;
}

/* When layout is collapsed, rotate the arrow */
.applications-main-layout.candidate-collapsed ~ .actions-container .candidate-collapse-arrow,
body:has(.applications-main-layout.candidate-collapsed) .candidate-collapse-arrow {
    transform: rotate(180deg);
}

/* When layout is expanded, arrow points right */
.applications-main-layout:not(.candidate-collapsed) ~ .actions-container .candidate-collapse-arrow,
body:has(.applications-main-layout:not(.candidate-collapsed)) .candidate-collapse-arrow {
    transform: rotate(0deg);
}

.conditional-btn.show:focus,
.conditional-btn.show:active,
#action-request-file-btn.show:focus,
#action-request-file-btn.show:active,
#action-schedule-interview-btn.show:focus,
#action-schedule-interview-btn.show:active,
#action-request-documents-btn.show:focus,
#action-request-documents-btn.show:active,
#action-send-offer-btn.show:focus,
#action-send-offer-btn.show:active,
#action-send-contract-btn.show:focus,
#action-send-contract-btn.show:active,
#action-send-credential-btn.show:focus,
#action-send-credential-btn.show:active,
#action-write-review-btn.show:focus,
#action-write-review-btn.show:active {
    border-color: #D8D8D8 !important;
    outline: none !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
}

/* Ensure all conditional buttons when shown have proper border styling (no black border) */
.actions-container .conditional-btn.show,
.actions-container #action-request-file-btn.show,
.actions-container #action-schedule-interview-btn.show,
.actions-container #action-request-documents-btn.show,
.actions-container #action-send-offer-btn.show,
.actions-container #action-send-contract-btn.show,
.actions-container #action-send-credential-btn.show,
.actions-container #action-write-review-btn.show,
.job-actions-left .conditional-btn.show,
.job-actions-left #action-request-file-btn.show,
.job-actions-left #action-schedule-interview-btn.show,
.job-actions-left #action-request-documents-btn.show,
.job-actions-left #action-send-offer-btn.show,
.job-actions-left #action-send-contract-btn.show,
.job-actions-left #action-send-credential-btn.show,
.job-actions-left #action-write-review-btn.show {
    border: 1px solid #D8D8D8 !important;
    border-color: #D8D8D8 !important;
    outline: none !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
    border-radius: 10px !important;
}

/* Override any default button borders that might be black */
.conditional-btn,
.conditional-btn.show,
#action-request-file-btn,
#action-schedule-interview-btn,
#action-request-documents-btn,
#action-send-offer-btn,
#action-send-contract-btn,
#action-send-credential-btn,
#action-write-review-btn {
    border: 1px solid #D8D8D8 !important;
    border-color: #D8D8D8 !important;
    outline: none !important;
}

/* Status Switch Button Styling */
#status-switch-btn {
    height: 34px !important;
    padding: 6px 14px !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    border: 1px solid #D8D8D8 !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
    background: #fff !important;
    border-radius: 10px !important;
    color: #333333 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
}

#status-switch-btn:hover {
    color: #85BB65 !important;
    border-color: #85BB65 !important;
}

#status-switch-btn:hover svg {
    stroke: #85BB65 !important;
}

#status-switch-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* Status Dropdown Panel */
.status-dropdown.custom-dropdown {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    margin-top: 8px !important;
    z-index: 9999 !important;
    overflow: visible !important;
    background: #fff !important;
    border: 1px solid #e6eef6 !important;
    box-shadow: 0 2px 6px rgba(11,22,40,0.03) !important;
    border-radius: 10px !important;
    padding: 12px !important;
    min-width: 200px !important;
}

.status-dropdown.hidden {
    display: none !important;
}

.status-change-btn {
    transition: all 0.2s ease !important;
}

.status-change-btn:hover {
    background: #75a855 !important;
    transform: translateX(2px);
}

.status-change-btn:active {
    transform: translateX(4px);
}

/* Filter Tabs */
.filter-tab {
    position: relative;
}

.filter-tab:hover:not(.active) {
    background: #f8f9fa;
    color: #121C0C;
}

.filter-tab.active {
    border-bottom-color: #85BB65 !important;
    color: #85BB65 !important;
    font-weight: 600 !important;
}
</style>

<!-- Status Cards (Light Green Cards Style) -->
<div class="application mb-3">
    <div class="row g-2">
        <div class="col">
            <a href="{{ path('app_recruiter_job_applications', {'id': job.id}) }}">
                <div class="card is-card mb-3 is-applied {% if app.request.get('status') == '' or app.request.get('status') is empty %}active{% endif %}">
                    <div class="card-body">
                        <h6 class="card-title">All</h6>
                        <p class="card-text">{{ totalApplications|number_format }}</p>
                    </div>
                </div>
            </a>
        </div>

        {% for status in allStatuses %}
            {% set count = 0 %}
            {# Use statusCountsFormatted from repository if available (more accurate and up-to-date) #}
            {% if statusCountsFormatted is defined and statusCountsFormatted is not empty %}
                {% set count = statusCountsFormatted[status]|default(0) %}
            {% elseif statusCounts is defined and statusCounts is not empty %}
                {# Fallback to raw statusCounts array #}
                {% for statusCount in statusCounts %}
                    {% set dbStatus = statusCount.status|lower %}
                    {# Map old status names to new ones for counting #}
                    {% if status == 'shortlisted' and (dbStatus == 'in_review' or dbStatus == 'shortlisted') %}
                        {% set count = statusCount.count %}
                    {% elseif status == 'interviewing' and (dbStatus == 'interview' or dbStatus == 'interviewing') %}
                        {% set count = statusCount.count %}
                    {% elseif status == 'negotiating' and (dbStatus == 'in_review' or dbStatus == 'offered' or dbStatus == 'negotiating') %}
                        {% set count = statusCount.count %}
                    {% elseif status == 'accepted' and (dbStatus == 'hired' or dbStatus == 'accepted') %}
                        {% set count = statusCount.count %}
                    {% elseif dbStatus == status|lower %}
                        {% set count = statusCount.count %}
                    {% endif %}
                {% endfor %}
            {% else %}
                {# Fallback to manual counting from allApplications #}
                {% for application in allApplications|default(applications) %}
                    {% set appStatus = application.status|lower %}
                    {# Map old status names to new ones for counting #}
                    {% if status == 'shortlisted' and (appStatus == 'in_review' or appStatus == 'shortlisted') %}
                        {% set count = count + 1 %}
                    {% elseif status == 'interviewing' and (appStatus == 'interview' or appStatus == 'interviewing') %}
                        {% set count = count + 1 %}
                    {% elseif status == 'negotiating' and (appStatus == 'in_review' or appStatus == 'offered' or appStatus == 'negotiating') %}
                        {% set count = count + 1 %}
                    {% elseif status == 'accepted' and (appStatus == 'hired' or appStatus == 'accepted') %}
                        {% set count = count + 1 %}
                    {% elseif appStatus == status|lower %}
                        {% set count = count + 1 %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <div class="col">
                <a href="{{ path('app_recruiter_job_applications', {'id': job.id, 'status': status}) }}">
                    <div class="card is-card mb-3 is-{{ statusColors[status] }} {% if app.request.get('status') == status %}active{% endif %}">
                        <div class="card-body">
                            <h6 class="card-title">
                                {{ status | title }}
                            </h6>
                            <p class="card-text">{{ count }}</p>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Action Buttons (Below Status Cards) -->
<div class="actions-container" style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
    <!-- Left Group: Filter, View Candidates, Email, and Status-based Action Buttons -->
    <div class="job-actions-left" style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
        <!-- Filter Button (moved to first position) -->
        {% include 'recruiter/job/_filter_panel.html.twig' %}
        
        <!-- View Candidates Button -->
        <button id="candidate-collapse-btn" class="candidate-collapse-btn action-btn" onclick="toggleCandidateSection()" title="View Candidates" style="background: #fff; border: 1px solid #D8D8D8; border-radius: 10px; padding: 6px 14px; height: 34px; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.3s ease; font-size: 14px; font-weight: 500; color: #333333; white-space: nowrap;">
            <span class="candidate-btn-text">View Candidates</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="candidate-collapse-arrow" style="transition: transform 0.3s ease; stroke: #000000;">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        
        <!-- Status Switch Button -->
        {% set activeApplication = applicationDetail %}
        {% if not activeApplication and applications|length > 0 %}
            {% set activeApplication = applications|first %}
        {% endif %}
        
        {% if activeApplication %}
            {% set currentStatus = activeApplication.status|lower %}
            {% set nextPhase = null %}
            {% set nextTransition = null %}
            {% set nextPhaseLabel = null %}
            
            {# Determine next phase based on current status #}
            {% if currentStatus == 'applied' %}
                {% set nextPhase = 'negotiating' %}
                {% set nextTransition = 'review' %}
                {% set nextPhaseLabel = 'Negotiating' %}
            {% elseif currentStatus == 'in_review' or currentStatus == 'shortlisted' %}
                {% set nextPhase = 'interview' %}
                {% set nextTransition = 'interview' %}
                {% set nextPhaseLabel = 'Interview' %}
            {% elseif currentStatus == 'interview' or currentStatus == 'interviewing' %}
                {% set nextPhase = 'offered' %}
                {% set nextTransition = 'offer' %}
                {% set nextPhaseLabel = 'Offered' %}
            {% elseif currentStatus == 'offered' or currentStatus == 'negotiating' %}
                {% set nextPhase = 'hired' %}
                {% set nextTransition = 'hire' %}
                {% set nextPhaseLabel = 'Hired' %}
            {% elseif currentStatus == 'hired' or currentStatus == 'accepted' %}
                {% set nextPhase = 'completed' %}
                {% set nextTransition = 'complete' %}
                {% set nextPhaseLabel = 'Completed' %}
            {% endif %}
            
            {# Format current status for display #}
            {% set currentStatusLabel = currentStatus|replace({'_': ' '})|title %}
            {% if currentStatus == 'in_review' or currentStatus == 'shortlisted' %}
                {% set currentStatusLabel = 'Negotiating' %}
            {% elseif currentStatus == 'offered' or currentStatus == 'negotiating' %}
                {% set currentStatusLabel = 'Negotiating' %}
            {% elseif currentStatus == 'hired' or currentStatus == 'accepted' %}
                {% set currentStatusLabel = 'Accepted' %}
            {% endif %}
            
            {% if nextPhase %}
                <div class="position-relative" style="flex-shrink: 0;">
                    <button id="status-switch-btn" class="action-btn" title="Switch Status" onclick="toggleStatusDropdown(event)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span id="status-switch-text">{{ currentStatusLabel }}</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-left: 4px;">
                            <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <!-- Status Dropdown Panel -->
                    <div id="status-dropdown-panel" class="status-dropdown custom-dropdown hidden" style="position: absolute; top: 100%; left: 0; margin-top: 8px; min-width: 200px; z-index: 9999; background: #fff; border: 1px solid #e6eef6; box-shadow: 0 2px 6px rgba(11,22,40,0.03); border-radius: 10px; padding: 12px; display: none;">
                        <div style="margin-bottom: 8px;">
                            <div style="font-size: 12px; color: #666; margin-bottom: 4px;">Current Status:</div>
                            <div style="font-size: 14px; font-weight: 600; color: #000000;">{{ currentStatusLabel }}</div>
                        </div>
                        <div style="height: 1px; background: #e6eef6; margin: 8px 0;"></div>
                        <div style="margin-bottom: 8px;">
                            <div style="font-size: 12px; color: #666; margin-bottom: 4px;">Move to:</div>
                            <button type="button" onclick="changeApplicationStatus('{{ nextTransition }}', '{{ activeApplication.id }}')" class="status-change-btn" style="width: 100%; padding: 8px 12px; background: #85BB65; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-align: left; display: flex; align-items: center; justify-content: space-between; transition: all 0.2s;">
                                <span>{{ nextPhaseLabel }}</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
        
        <button id="email-btn" class="action-btn" title="Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Email</span>
        </button>

        <!-- Status-based Action Buttons (Hidden by default, shown based on application status) -->
        <button id="action-request-file-btn" class="action-btn conditional-btn" style="display: none;" data-bs-toggle="modal" data-bs-target="#askDocumentModal" title="Request One File">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>Request One File</span>
        </button>

        <button id="action-schedule-interview-btn" class="action-btn conditional-btn" style="display: none;" data-bs-toggle="modal" data-bs-target="#scheduleInterviewModal" title="Schedule Interview">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Schedule Interview</span>
        </button>

        <button id="action-request-documents-btn" class="action-btn conditional-btn" style="display: none;" data-bs-toggle="modal" data-bs-target="#askDocumentModal" title="Request Documents">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
