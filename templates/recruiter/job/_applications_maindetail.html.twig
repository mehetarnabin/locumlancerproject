                            {% if job.status == 'published' %}
                                {% set jobStatusClass = 'job-status-badge job-status-published' %}
                            {% elseif job.status == 'draft' %}
                                {% set jobStatusClass = 'job-status-badge job-status-draft' %}
                            {% elseif job.status == 'paused' %}
                                {% set jobStatusClass = 'job-status-badge job-status-paused' %}
                            {% elseif job.status == 'closed' %}
                                {% set jobStatusClass = 'job-status-badge job-status-closed' %}
                            {% endif %}
                            <span class="badge badge-pill {{ jobStatusClass }}" style="font-size: 11px; padding: 4px 8px; background: {% if job.status == 'published' %}#85BB65{% elseif job.status == 'draft' %}#6b7280{% elseif job.status == 'paused' %}#f59e0b{% elseif job.status == 'closed' %}#ef4444{% else %}#6b7280{% endif %}; color: #fff; border: none;">{{ job.status|capitalize }}</span>
                        </div>
                    </div>
                </div>

                <div id="application-detail-content">
                    {% include 'recruiter/job/_application_detail.html.twig' with {
                        'application': applicationDetail,
                        'provider': applicationDetail.provider,
                        'user': applicationDetail.provider.user,
                        'educations': educations,
                        'experiences': experiences,
                        'insurances': insurances,
                        'documentRequests': documentRequests,
                        'review': review,
                        'jobApplicationTransitions': jobApplicationTransitions,
                        'healthAssessment': healthAssessment,
                        'riskAssessment': riskAssessment
                    } %}
                </div>
            </div>
        {% else %}
            <!-- View Job Details Panel (Hidden by default, shown when button is clicked) -->
            <div class="right-aside" style="padding-left: 15px;">
                <div id="view-job-details-panel" style="display: none; background: #fff; border: 1px solid #e6eef6; border-radius: 10px; padding: 14px; margin-bottom: 16px;">
                    <div style="margin-bottom: 16px;">
                        <h3 style="margin: 0 0 12px 0; font-size: 20px; font-weight: 600; color: #000000; text-transform: lowercase;">
                            <a href="{{ path('app_recruiter_job_show', {'id': job.id}) }}" style="color: #85BB65; text-decoration: none; text-transform: lowercase;">{{ job.title }}</a>
                        </h3>
                        <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 14px; color: #000000; margin-bottom: 12px;">
                            {% if job.workType %}<span style="text-transform: lowercase;">{{ job.workType }}</span>{% endif %}
                            {% if job.need %}<span style="text-transform: lowercase;">{{ job.need }}</span>{% endif %}
                            {% if job.schedule %}<span style="text-transform: lowercase;">{{ job.schedule }}</span>{% endif %}
                            {% if job.state or job.city %}<span style="text-transform: lowercase;">{{ job.state }}{% if job.city %}, {{ job.city }}{% endif %}</span>{% endif %}
