                            {% elseif job.status == 'draft' %}
                                {% set jobStatusClass = 'job-status-badge job-status-draft' %}
                            {% elseif job.status == 'paused' %}
                                {% set jobStatusClass = 'job-status-badge job-status-paused' %}
                            {% elseif job.status == 'closed' %}
                                {% set jobStatusClass = 'job-status-badge job-status-closed' %}
