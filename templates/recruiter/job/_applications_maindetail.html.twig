    </div>
    
    <!-- Right Group: Menu, Search, View Job Details -->
    <div class="job-actions-right" style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
        <div class="position-relative" style="flex-shrink: 0;">
            <button id="search-toggle-btn-top" class="action-btn" title="Search" onclick="toggleSearchPanel(event)">
