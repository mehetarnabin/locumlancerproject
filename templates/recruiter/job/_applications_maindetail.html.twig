                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="#85BB65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3 class="app-detail-section-title" style="justify-content: center; border-bottom: none; margin-bottom: 16px; padding-bottom: 0;">
                            <span style="color: #000000 !important; font-size: 28px; font-weight: 700;">No Applications Found</span>
                        </h3>
                        <p style="color: #000000; font-size: 17px; margin: 0; line-height: 1.6; max-width: 500px;">
