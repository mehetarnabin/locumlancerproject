<!-- Main Layout: Left Column (Candidates), Right Column (Application Detail) -->
<div class="applications-main-layout candidate-collapsed" id="applications-main-layout" style="display: grid; grid-template-columns: 0 1fr; gap: 20px; align-items: start; margin-top: 10px; position: relative; transition: grid-template-columns 0.3s ease;">
    <!-- Left Column: Candidate List -->
    <div id="candidate-column" class="candidate-column" style="display: flex; flex-direction: column; gap: 12px; transition: all 0.3s ease; overflow: hidden;">
        <!-- Candidate Field (Application List) -->
        <div class="candidate-field" style="background: #fff; border: 1px solid #e6eef6; border-radius: 10px; padding: 16px; min-height: 400px;">
            <div class="job-list-container candidates-content" id="list-view-container" style="display: block; margin: 0; padding: 0; margin-left: 0;">
                <div class="left-aside" style="margin: 0; padding: 0; margin-left: 0;">
                            {% if applications|length > 0 %}
                            {% for application in applications %}
                                {% set provider = application.provider %}
                                {% set user = provider.user %}
                                {% set statusLower = application.status|lower|replace({'_': ''}) %}
                                {% set todoTask = null %}
                                {% if statusLower == 'applied' %}
                                    {% set todoTask = 'Revisit Alert' %}
                                {% elseif statusLower == 'shortlisted' %}
                                    {% set todoTask = 'Open Response' %}
                                {% elseif statusLower == 'interview' or statusLower == 'interviewing' %}
                                    {% set todoTask = 'Confirm interview from the list of interview dates' %}
                                {% elseif statusLower == 'negotiating' %}
                                    {% set todoTask = 'Review signed offer/contract' %}
                                {% elseif statusLower == 'accepted' %}
                                    {% set todoTask = 'Request Credentialing Docs' %}
                                {% elseif statusLower == 'completed' %}
                                    {% set todoTask = 'Write your review' %}
                                {% endif %}
                                {% set sentItems = [] %}
                                {% if application.documentProvidedAt %}{% set sentItems = sentItems|merge(['Document']) %}{% endif %}
                                {% if application.oneFileProvidedAt %}{% set sentItems = sentItems|merge(['OneFile']) %}{% endif %}
                                {% if application.contractSignedAt %}{% set sentItems = sentItems|merge(['Contract Signed']) %}{% elseif application.contractSentAt %}{% set sentItems = sentItems|merge(['Contract Sent']) %}{% endif %}

                                <a href="{{ path('app_recruiter_job_applications', {'id': job.id, 'applicationId': application.id}) }}" style="text-decoration: none; color: inherit;">
                                    <div class="card card-v2 {% if app.request.get('applicationId') == application.id or app.request.get('applicationId') is empty and loop.index == 1 %}active-card{% endif %}" id="{{ application.id }}" data-application-id="{{ application.id }}" data-status="{{ application.status }}" style="background: #fff; border: 1px solid #e6eef6; border-radius: 10px; padding: 14px; margin-bottom: 10px; color: #000; transition: all 0.2s ease; {% if app.request.get('applicationId') == application.id or app.request.get('applicationId') is empty and loop.index == 1 %}border-color: #85BB65; box-shadow: 0 2px 8px rgba(133, 187, 101, 0.15);{% endif %}">
                                        <div class="card-body" style="padding: 0;">
                                            <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 10px;">
                                                {% if provider.user.profilePicture %}
                                                    <img src="{{ provider.user.profilePicture }}" width="48px" height="48px" style="border-radius: 50%; object-fit: cover; flex-shrink: 0;" />
                                                {% else %}
                                                    <div style="width: 48px; height: 48px; border-radius: 50%; background: #e6eef6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #000000; font-weight: 600; font-size: 19px;">
                                                        {{ user.name|slice(0, 1)|upper }}
                                                    </div>
                                                {% endif %}
                                                <div style="flex: 1; min-width: 0; overflow: hidden;">
                                                    <h4 style="margin: 0 0 6px 0; font-size: 16px; font-weight: 600; color: #000000; line-height: 1.3; text-transform: lowercase;">{{ user.name }}</h4>
                                                    <div style="display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #000000; text-transform: lowercase;">
                                                        <span style="display: flex; align-items: center; gap: 4px; color: #000000; text-transform: lowercase;"><i class="fa fa-clock" style="width: 14px; color: #000000;"></i> <span style="color: #000000; text-transform: lowercase;">{{ application.createdAt|time_diff }}</span></span>
                                                        <span style="display: flex; align-items: center; gap: 4px; color: #000000; text-transform: lowercase;"><i class="fa fa-star" style="width: 14px; color: #000000;"></i> <span style="color: #000000; text-transform: lowercase;">{{ application.provider.averagePoint ?: 'Not Rated Yet' }}</span></span>
                                                        <span style="display: flex; align-items: center; gap: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #000000; text-transform: lowercase;"><i class="fa fa-map-marked" style="width: 14px; color: #000000;"></i> <span style="overflow: hidden; text-overflow: ellipsis; color: #000000; text-transform: lowercase;">{{ provider.country~' '~provider.state~' '~provider.city }}</span></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #f0f0f0; overflow: hidden;">
                                                <span class="badge badge-pill is-{{ statusColors[application.status] }}" style="font-size: 11px; padding: 4px 8px; background: {% if statusColors[application.status] == 'review' %}#3b82f6{% elseif statusColors[application.status] == 'interview' %}#85BB65{% elseif statusColors[application.status] == 'offered' %}#f59e0b{% elseif statusColors[application.status] == 'hired' %}#10b981{% elseif statusColors[application.status] == 'completed' %}#6b7280{% else %}#6b7280{% endif %}; color: #fff; border: none; border-radius: 12px; display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    {% if application.status == 'in_review' %}
                                                        Negotiating
                                                    {% else %}
                                                        {{ application.status | replace({'_': ' '}) | title }}
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
