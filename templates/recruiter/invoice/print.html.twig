<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice #{{ invoice.invoiceNumber }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        .header {
            margin-bottom: 30px;
        }
        .logo {
            max-width: 150px;
            margin-bottom: 10px;
        }
        .invoice-details {
            text-align: right;
        }
        .invoice-details h1 {
            margin: 0;
            font-size: 24px;
            color: #000;
        }
        .bill-to {
            margin-bottom: 30px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }
        th {
            background-color: #f9f9f9;
            font-weight: bold;
        }
        .text-end {
            text-align: right;
        }
        .totals {
            margin-left: auto;
            width: 300px;
        }
        .totals table {
            margin-bottom: 0;
        }
        .totals td {
            border-bottom: none;
        }
        .footer {
            margin-top: 50px;
            text-align: center;
            color: #777;
            font-size: 12px;
        }
        @media print {
            body {
                padding: 0;
            }
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <table style="border: none;">
                <tr style="border: none;">
                    <td style="border: none; padding: 0;">
                        <h2>{{ getConfig('legal_name') }}</h2>
                        <p>{{ getConfig('office_address') }}<br>Phone: {{ getConfig('office_phone1') }}<br>Email: {{ getConfig('office_email') }}</p>
                    </td>
                    <td style="border: none; padding: 0; text-align: right;">
                        <h1>INVOICE</h1>
                        <p>
                            <strong>Invoice #:</strong> {{ invoice.invoiceNumber }}<br>
                            <strong>Date:</strong> {{ invoice.createdAt ? invoice.createdAt|date('m/d/Y') : '' }}<br>
                            <strong>Status:</strong> {{ invoice.status|capitalize }}
                        </p>
                    </td>
                </tr>
            </table>
        </div>

        <div class="bill-to">
            <h3>Bill To:</h3>
            <p>
                <strong>{{ invoice.employer.name }}</strong><br>
                {{ invoice.employer.address }}<br>
                {{ invoice.employer.phone1 }}
            </p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ invoice.particular }} ({{ invoice.provider }}) for job {{ invoice.job }}</td>
                    <td class="text-end">${{ invoice.amount|number_format(2, '.', ',') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="totals">
            <table>
                <tr>
                    <td><strong>Subtotal:</strong></td>
                    <td class="text-end">${{ invoice.amount|number_format(2, '.', ',') }}</td>
                </tr>
                {% if commissionAmount > 0 %}
                <tr>
                    <td><strong>Commission (10%):</strong></td>
                    <td class="text-end">${{ commissionAmount|number_format(2, '.', ',') }}</td>
                </tr>
                <tr>
                    <td><strong>Total to Pay:</strong></td>
                    <td class="text-end"><strong>${{ (invoice.amount - commissionAmount)|number_format(2, '.', ',') }}</strong></td>
                </tr>
                 {% else %}
                 <tr>
                    <td><strong>Total:</strong></td>
                    <td class="text-end"><strong>${{ invoice.amount|number_format(2, '.', ',') }}</strong></td>
                </tr>
                {% endif %}
            </table>
        </div>

        <div class="footer">
            <p>Thank you for your business!</p>
        </div>
    </div>
    <script>
        window.onload = function() {
            window.print();
        }
    </script>
</body>
</html>
