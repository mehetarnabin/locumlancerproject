{% extends 'recruiter/base.html.twig' %}

{% block title %}Pending Invoices{% endblock %}

{% block employer_body %}
    <div class="container-xl">

        <h1 class="app-page-title">Pending Invoices</h1>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>Number</th>
                    <th>Job</th>
                    <th>Provider</th>
                    <th>Particular</th>
                    <th>Amount($)</th>
                    <th>CreatedAt</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for invoice in invoices %}
                    <tr>
                        <td>
                            {% if invoice.status == 'paid' %}
                                <a href="{{ path('app_recruiter_invoice_show', {'id': invoice.id}) }}">{{ invoice.invoiceNumber }}</a>
                            {% elseif invoice.status == 'pending' %}
                                <a href="{{ path('app_recruiter_invoice_show', {'id': invoice.id}) }}">{{ invoice.invoiceNumber }}</a>
                            {% endif %}
                        </td>
                        <td class="cell">{{ invoice.createdAt|date('d/m/Y') }}</td>
                        <td class="cell">{{ invoice.dueDate|date('d/m/Y') }}</td>
                        <td class="cell"><span class="badge bg-warning">Pending</span></td>
                        <td class="cell">${{ invoice.amount }}</td>
                        <td class="cell text-end">
                            <a href="{{ path('app_recruiter_invoice_show', {'id': invoice.id}) }}" title="Details"><img src="{{ asset('assets/icons/list-search.png') }}" class="icon-image" /></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="12">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
