                <!-- Chart Container -->
                <div class="analytics-chart flex-grow-1 d-flex justify-content-center align-items-center">
                    <!-- Application to Interview Ratio Chart -->
                    <div class="chart-content d-none" id="chart-ratio">
                        {% set totalCount = appliedCount + interviewCount %}
                        {% if totalCount > 0 %}
                            {% set interviewPercentage = (interviewCount / totalCount) * 100 %}
                            {% set appliedPercentage = (appliedCount / totalCount) * 100 %}
                        {% else %}
                            {% set interviewPercentage = 0 %}
                            {% set appliedPercentage = 0 %}
                        {% endif %}
                        {% if totalCount > 0 %}
                            {% set calculatedRatio = (interviewCount / totalCount) * 100 %}
                        {% else %}
                            {% set calculatedRatio = 0 %}
                        {% endif %}
                        <div style="position: relative; display: inline-block; width: 150px; height: 150px; margin: 0 auto;">
                            <svg viewBox="0 0 160 160" width="150" height="150" style="display: block; margin: 0 auto;">
                                <g transform="rotate(-90 80 80)">
                                    <circle cx="80" cy="80" r="56" stroke="#06b6d4" stroke-width="14" fill="none"
                                            stroke-dasharray="{{ appliedPercentage * 3.51 }}, 351"
                                            stroke-dashoffset="0"/>
                                    <circle cx="80" cy="80" r="56" stroke="#85BB65" stroke-width="14" fill="none"
                                            stroke-dasharray="{{ interviewPercentage * 3.51 }}, 351"
                                            stroke-dashoffset="{{ -appliedPercentage * 3.51 }}"/>
                                </g>
                            </svg>
                            <div class="donut-center" style="position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; text-align: center !important; pointer-events: none !important; width: auto !important; max-width: 120px !important; min-width: 80px !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; margin: 0 !important; padding: 0 !important; z-index: 10 !important;">
                                <div class="donut-number" style="font-weight: 800 !important; font-size: 18px !important; line-height: 1 !important; color: #000000 !important; margin: 0 !important; padding: 0 !important; text-align: center !important; display: flex !important; align-items: center !important; justify-content: center !important; width: 100% !important; white-space: nowrap !important;">{{ calculatedRatio|number_format(1) }}%</div>
                                <div class="donut-sub" style="font-size: 10px !important; color: #6b7280 !important; margin-top: 2px !important; line-height: 1.2 !important; text-align: center !important; width: 100% !important;">Interview Rate</div>
                            </div>
                        </div>
                    </div>
                    <div class="chart-content d-none" id="chart-interview-ratio">
                        {% set totalAppliedInterview = appliedCount + interviewCount %}
                        {% if totalAppliedInterview > 0 %}
                            {% set applicationShareTotal = (appliedCount / totalAppliedInterview) * 100 %}
                            {% set interviewShareTotal = (interviewCount / totalAppliedInterview) * 100 %}
                        {% else %}
                            {% set applicationShareTotal = 0 %}
                            {% set interviewShareTotal = 0 %}
                        {% endif %}
                        {% set interviewToApplicationDisplay = interviewCount > 0 ? (appliedCount / interviewCount)|number_format(1, '.', ',') : '0.0' %}
                        <div style="position: relative; display: inline-block; width: 150px; height: 150px; margin: 0 auto;">
                            <svg viewBox="0 0 160 160" width="150" height="150" style="display: block;">
                                <g transform="rotate(-90 80 80)">
                                    <circle cx="80" cy="80" r="56" stroke="#06b6d4" stroke-width="14" fill="none"
                                            stroke-dasharray="{{ applicationShareTotal * 3.51 }}, 351"
                                            stroke-dashoffset="0"/>
                                    <circle cx="80" cy="80" r="56" stroke="#85BB65" stroke-width="14" fill="none"
                                            stroke-dasharray="{{ interviewShareTotal * 3.51 }}, 351"
                                            stroke-dashoffset="{{ -applicationShareTotal * 3.51 }}"/>
                                </g>
                            </svg>
                            <div class="donut-center" style="position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; text-align: center !important; pointer-events: none !important; width: auto !important; max-width: 120px !important; min-width: 80px !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; margin: 0 !important; padding: 0 !important; z-index: 10 !important;">
                                <div class="donut-number" style="font-weight: 800 !important; font-size: 18px !important; line-height: 1 !important; color: #000000 !important; margin: 0 !important; padding: 0 !important; text-align: center !important; display: flex !important; align-items: center !important; justify-content: center !important; width: 100% !important; white-space: nowrap !important;">{{ interviewToApplicationDisplay }}x</div>
                                <div class="donut-sub" style="font-size: 10px !important; color: #6b7280 !important; margin-top: 2px !important; line-height: 1.2 !important; text-align: center !important; width: 100% !important;">Apps / Interview</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Skills Chart -->
                    <div class="chart-content d-none" id="chart-skills">
                        <div class="skills-chart w-100">
                            {% if skills is defined and skills|length > 0 %}
                                {% for skill in skills|slice(0, 4) %}
                                    <div class="skill-item mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="skill-name fw-medium" style="font-size: 12px; color: #121C0C;">{{ skill.name }}</span>
                                            <span class="skill-percent fw-bold" style="font-size: 11px; color: #85BB65;">{{ skill.percentage }}%</span>
                                        </div>
                                        <div class="skill-progress" style="height: 6px; background: #F4F9F1; border-radius: 3px; overflow: hidden;">
                                            <div class="skill-progress-bar" style="height: 100%; width: {{ skill.percentage }}%; background: {{ skill.color }}; border-radius: 3px;"></div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="text-center text-muted py-4">
                                    <small>No skills data available</small>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Resume Insight Chart -->
                    <div class="chart-content d-none" id="chart-resume">
                        {% if resume is defined %}
                            {% set profileCompleteness = resume.profileCompleteness|default(0) %}
                            <div class="resume-metric text-center">
                                <div class="resume-circle" style="border-color: {% if profileCompleteness >= 80 %}#10b981{% elseif profileCompleteness >= 60 %}#f59e0b{% else %}#ef4444{% endif %};">
                                    <span>{{ profileCompleteness }}%</span>
                                </div>
                                <p class="mt-2 mb-0">Profile Completeness</p>
                                {% if resume.missingFields is defined and resume.missingFields|length > 0 %}
                                    <div class="mt-2">
                                        <small class="text-muted">Missing:</small>
                                        <div class="small">
                                            {% for field in resume.missingFields|slice(0, 2) %}
                                                <span class="badge bg-warning text-dark me-1">{{ field }}</span>
                                            {% endfor %}
                                            {% if resume.missingFields|length > 2 %}
                                                <small class="text-muted">+{{ resume.missingFields|length - 2 }} more</small>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="resume-metric text-center">
                                <div class="resume-circle" style="border-color: #ef4444;">
                                    <span>0%</span>
                                </div>
                                <p class="mt-2 mb-0">Profile Completeness</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Interview Schedule -->
        <div class="col-12 col-lg-4 interview-schedule-column">
            <div class="interview-card shadow-lg rounded-3 p-3 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Interview Schedule</h6>
                    <a href="{{ path('app_recruiter_interview_calendar') }}" class="link-plain">
                        <svg class="icon-image" width="32px" height="32px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
