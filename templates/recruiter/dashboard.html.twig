                        </svg>
                    </a>
                </div>

                <div class="interview-list flex-grow-1">
                    <ul class="list-unstyled m-0 p-0">
                        {% if upcomingInterviews is defined and upcomingInterviews|length > 0 %}
                            {% for interview in upcomingInterviews %}
                                <li class="interview-item">
                                    <div class="d-flex justify-content-between">
                                        <div class="schedule-left">
                                            <div class="fw-semibold">{{ interview.company }}</div>
                                            <div class="small">
                                                {% if interview.jobId %}
                                                    <a href="{{ path('app_recruiter_job_show', {'id': interview.jobId}) }}" style="text-decoration:none; color: inherit;">
                                                        {{ interview.position }}
                                                    </a>
                                                {% else %}
                                                    {{ interview.position }}
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="schedule-right text-end">
                                            <div class="small fw-semibold" style="font-size:12px;">{{ interview.date|date('M d, Y') }}</div>
                                            <div class="small" style="font-size:12px;">{{ interview.date|date('h:i A') }}</div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        {% else %}
