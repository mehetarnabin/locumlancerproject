{% extends 'recruiter/base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{% block employer_body %}
<style>
/* COMPLETE RESET - Remove ALL conflicting styles and apply clean spacing to match provider dashboard */

/* Reset app-wrapper - allow base template to handle sidebar animation */
/* Don't override margin-left - let base template JavaScript handle it */
body.app .app-wrapper,
.app-wrapper {
    display: block !important;
    justify-content: unset !important;
    align-items: unset !important;
    width: 100% !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    z-index: 1 !important; /* Ensure content is above sidebar */
}

/* On small screens, reset margin-left */
@media (max-width: 1199.98px) {
    body.app .app-wrapper,
    .app-wrapper {
        margin-left: 0 !important;
    }
}

/* Sidebar animation - let base template handle margin-left transitions */
/* Only ensure transition is smooth and content doesn't go behind sidebar */
@media (min-width: 1200px) {
    body.app .app-wrapper,
    .app-wrapper {
        /* Don't set margin-left here - let base template JavaScript handle it */
        transform: none !important; /* Remove transform to allow animation */
        width: auto !important; /* Remove width constraints */
        transition: margin-left 0.4s ease-in-out !important; /* Smooth animation */
        position: relative !important;
        z-index: 1 !important; /* Ensure content is above sidebar */
    }
    
    /* When sidebar is hovered (expanded) or nav item is hovered */
    /* Base template JavaScript will handle margin-left changes */
    body.nav-hover-active .app-wrapper,
    body.nav-hover-active body.app .app-wrapper,
    body.sidebar-hovered .app-wrapper,
    body.sidebar-hovered body.app .app-wrapper {
        transform: none !important;
        width: auto !important;
        position: relative !important;
        z-index: 1 !important;
    }
}

/* Reset app-content - remove all custom.css overrides */
/* Keep consistent left/right padding from base template */
body.app .app-wrapper .app-content,
.app-wrapper .app-content,
.app-content {
    padding-left: 2rem !important; /* Match base template spacing */
    padding-right: 2rem !important; /* Match base template spacing */
    padding-top: 20px !important;
    padding-bottom: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
}

/* Override custom.css width constraints at 1200px breakpoint */
/* Ensure padding is maintained from base template */
@media (min-width: 1200px) {
    body.app .app-wrapper .app-content,
    .app-wrapper .app-content,
    .app-content {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 2rem !important; /* Explicitly maintain padding from base template */
        padding-right: 2rem !important; /* Explicitly maintain padding from base template */
    }
}

/* Reset container-xl - apply clean spacing matching provider dashboard */
body.app .app-wrapper .app-content .container-xl,
.app-wrapper .app-content .container-xl,
.app-content .container-xl,
body .app-content .container-xl,
.dashboard .container-xl,
div.container-xl,
[class*="container-xl"],
.container-xl {
    position: relative !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 30px !important;
    max-width: 100% !important;
    width: 100% !important;
    transform: none !important;
    box-sizing: border-box !important;
}

/* Remove left padding from application status tracker to match provider dashboard */
.container-xl .application {
    padding-left: 0 !important;
    margin-left: 0 !important;
}

/* Adjust column widths to better fill space - match provider dashboard */
.container-xl .row.g-2 > .col-12.col-lg-7 {
    flex: 0 0 58.333333% !important;
    max-width: 58.333333% !important;
}

.container-xl .row.g-2 > .col-12.col-lg-5 {
    flex: 0 0 41.666667% !important;
    max-width: 41.666667% !important;
}

/* Ensure rows fill the container width */
.container-xl .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

/* Remove left padding from first column only - keep gaps between columns */
.container-xl .row > [class*="col-"]:first-child {
    padding-left: 0 !important;
    margin-left: 0 !important;
}

/* Adjust gap between columns */
.container-xl .row.g-2 {
    --bs-gutter-x: 0.5rem !important;
    --bs-gutter-y: 0.5rem !important;
}

/* Override ALL media queries from custom.css */
@media (min-width: 576px) {
    body.app .app-wrapper .app-content .container-xl,
    .app-wrapper .app-content .container-xl,
    .app-content .container-xl,
    body .app-content .container-xl,
    .dashboard .container-xl,
    div.container-xl,
    [class*="container-xl"],
    .container-xl {
        padding-left: 0 !important;
        padding-right: 30px !important;
    }
}

@media (min-width: 992px) {
    body.app .app-wrapper .app-content .container-xl,
    .app-wrapper .app-content .container-xl,
    .app-content .container-xl,
    body .app-content .container-xl,
    .dashboard .container-xl,
    div.container-xl,
    [class*="container-xl"],
    .container-xl {
        padding-left: 0 !important;
        padding-right: 30px !important;
    }
}

@media (min-width: 1200px) {
    /* Don't override margin-left - let base template JavaScript handle sidebar animation */
    body.app .app-wrapper {
        position: relative !important;
        /* margin-left will be set by base template JavaScript */
        transform: none !important; /* Remove transform to allow animation */
        width: auto !important; /* Remove width constraints */
        transition: margin-left 0.4s ease-in-out !important; /* Smooth animation */
        z-index: 1 !important; /* Ensure content is above sidebar */
    }
    
    /* When sidebar is hovered (expanded) or nav item is hovered */
    /* Base template JavaScript will handle margin-left changes */
    body.nav-hover-active .app-wrapper,
    body.nav-hover-active body.app .app-wrapper,
    body.sidebar-hovered .app-wrapper,
    body.sidebar-hovered body.app .app-wrapper {
        transform: none !important;
        width: auto !important;
        z-index: 1 !important;
    }
    
    /* Match provider dashboard: app-content padding structure */
    /* Ensure padding is maintained from base template */
    body.app .app-wrapper .app-content,
    .app-wrapper .app-content,
    .app-content {
        position: relative !important;
        max-width: 100% !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 2rem !important; /* Explicitly maintain padding from base template */
        padding-right: 2rem !important; /* Explicitly maintain padding from base template */
    }
    
    /* Match provider dashboard: container-xl padding structure */
    body.app .app-wrapper .app-content .container-xl,
    .app-wrapper .app-content .container-xl,
    .app-content .container-xl,
    body .app-content .container-xl,
    .dashboard .container-xl,
    div.container-xl,
    [class*="container-xl"],
    .container-xl {
        position: relative !important;
        padding-left: 0 !important;
        padding-right: 30px !important;
        max-width: 100% !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    .container-xl .application {
        padding-left: 0 !important;
        margin-left: 0 !important;
    }
}

@media (min-width: 1600px) {
    body.app .app-wrapper .app-content,
    .app-wrapper .app-content,
    .app-content {
        max-width: 100% !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    body.app .app-wrapper .app-content .container-xl,
    .app-wrapper .app-content .container-xl,
    .app-content .container-xl,
    body .app-content .container-xl,
    .dashboard .container-xl,
    div.container-xl,
    [class*="container-xl"],
    .container-xl {
        padding-left: 0 !important;
        padding-right: 30px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
}
</style>
<div class="container-xl">

    {% set statusColors = {
        'applied': 'applied',
        'shortlisted': 'shortlisted',
        'interviewing': 'interviewing',
        'negotiating': 'negotiating',
        'accepted': 'accepted',
        'completed': 'completed',
        # Backward compatibility mappings
        'in_review': 'shortlisted',
        'interview': 'interviewing',
        'offered': 'negotiating',
        'hired': 'accepted'
    } %}

    {% set allStatuses = ['applied', 'shortlisted', 'interviewing', 'negotiating', 'accepted', 'completed'] %}

       {% if totalJobs == 0 %}
          <div class="app-card shadow-sm mb-4 border-left-decoration" role="alert">
              <div class="inner">
                  <div class="app-card-body p-3 p-lg-4">
                      <h3 class="mb-3">Welcome, {{ app.user.name }}!</h3>
                      <div class="row gx-5 gy-3">
                          <div class="col-12 col-lg-9">
                              <div>We help employers find locums quickly while reducing the work burden for their recruiters. We also help reduce the cost of hiring locum with our sustainable model.</div>
                          </div><!--//col-->
                          <div class="col-12 col-lg-3">
                              <a class="btn btn-primary" href="{{ path('app_recruiter_job_new') }}"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-suitcase-lg" viewBox="0 0 16 16">
                                    <path d="M5 2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2h3.5A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5H14a.5.5 0 0 1-1 0H3a.5.5 0 0 1-1 0h-.5A1.5 1.5 0 0 1 0 12.5v-9A1.5 1.5 0 0 1 1.5 2zm1 0h4a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1M1.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5H3V3zM15 12.5v-9a.5.5 0 0 0-.5-.5H13v10h1.5a.5.5 0 0 0 .5-.5m-3 .5V3H4v10z"/>
                                 </svg> Post your first job</a>
                          </div><!--//col-->
                      </div><!--//row-->
                  </div><!--//app-card-body-->
              </div><!--//inner-->
          </div><!--//app-card-->
       {% endif %}

    <div class="application-wrapper">
        <div class="application">
            <div class="row g-2">
                <div class="col">
                    <a href="{{ path('app_recruiter_applications') }}">
                        <div class="card is-card mb-3 is-applied {% if app.request.get('status') and app.request.get('status') == '' %}active{% endif %}">
                            <div class="card-body">
                                <h6 class="card-title">All</h6>
                                <p class="card-text">{{ totalApplications|number_format }}</p>
                            </div>
                        </div>
                    </a>
                </div>

               {% for status in allStatuses %}
                   {% set count = 0 %}
                   {% for item in statusCounts %}
                       {% set dbStatus = item.status|lower %}
                       {# Map old status names to new ones for counting #}
                       {% if status == 'shortlisted' and (dbStatus == 'in_review' or dbStatus == 'shortlisted') %}
                           {% set count = item.count %}
                       {% elseif status == 'interviewing' and (dbStatus == 'interview' or dbStatus == 'interviewing') %}
                           {% set count = item.count %}
                       {% elseif status == 'negotiating' and (dbStatus == 'in_review' or dbStatus == 'offered' or dbStatus == 'negotiating') %}
                           {% set count = item.count %}
                       {% elseif status == 'accepted' and (dbStatus == 'hired' or dbStatus == 'accepted') %}
                           {% set count = item.count %}
                       {% elseif dbStatus == status|lower %}
                           {% set count = item.count %}
                       {% endif %}
                   {% endfor %}
                   <div class="col">
                       <a href="{{ path('app_recruiter_applications', {'status': status}) }}">
                           <div class="card is-card mb-3 is-{{ statusColors[status] }} {% if app.request.get('status') == status %}active{% endif %}">
                               <div class="card-body">
                                   <h6 class="card-title">
                                       {{ status | title }}
                                   </h6>
                                   <p class="card-text">{{ count }}</p>
                               </div>
                           </div>
                       </a>
                   </div>
               {% endfor %}
           </div>
        </div>

    </div>

    
    <!-- Row 1: Current Jobs and Messages Side by Side -->
    <div class="row g-3 mt-4 align-items-stretch">
        <!-- Current Jobs - Left Column -->
        <div class="col-12 col-lg-6 d-flex">
            <div class="job-section shadow-lg p-3 rounded-3 h-100 d-flex flex-column w-100">

                    <!-- Header with Tabs -->
                    <div class="d-flex justify-content-between align-items-center mb-10-px">
                        <div class="d-flex gap-2 align-items-center">
                            <button class="job-tab-btn active" data-tab="posted-jobs" role="tab" aria-selected="true" style="background: none; border: none; padding: 0; cursor: pointer; text-decoration: none;">
                                <h6 class="app-card-title mb-0" style="color: #85BB65; font-weight: 600;">Posted Jobs</h6>
                            </button>
                            <span style="color: #e5e7eb; margin: 0 8px;">|</span>
                            <button class="job-tab-btn" data-tab="recruiter-jobs" role="tab" aria-selected="false" style="background: none; border: none; padding: 0; cursor: pointer; text-decoration: none;">
                                <h6 class="app-card-title mb-0" style="color: #6b7280; font-weight: 500;">My Candidates</h6>
                            </button>
                        </div>

                        <!-- Eye Icon (View All) -->
                        <a id="view-all-link" href="{{ path('app_recruiter_applications') }}" class="link-plain">
                        <svg class="icon-image" width="29px" height="29px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4.75 9.233C4.75 9.64721 5.08579 9.983 5.5 9.983C5.91421 9.983 6.25 9.64721 6.25 9.233H4.75ZM6.25 5.5C6.25 5.08579 5.91421 4.75 5.5 4.75C5.08579 4.75 4.75 5.08579 4.75 5.5H6.25ZM5.5 4.75C5.08579 4.75 4.75 5.08579 4.75 5.5C4.75 5.91421 5.08579 6.25 5.5 6.25V4.75ZM9.233 6.25C9.64721 6.25 9.983 5.91421 9.983 5.5C9.983 5.08579 9.64721 4.75 9.233 4.75V6.25ZM6.03033 4.96967C5.73744 4.67678 5.26256 4.67678 4.96967 4.96967C4.67678 5.26256 4.67678 5.73744 4.96967 6.03033L6.03033 4.96967ZM9.96967 11.0303C10.2626 11.3232 10.7374 11.3232 11.0303 11.0303C11.3232 10.7374 11.3232 10.2626 11.0303 9.96967L9.96967 11.0303ZM15.767 18.75C15.3528 18.75 15.017 19.0858 15.017 19.5C15.017 19.9142 15.3528 20.25 15.767 20.25V18.75ZM19.5 20.25C19.9142 20.25 20.25 19.9142 20.25 19.5C20.25 19.0858 19.9142 18.75 19.5 18.75V20.25ZM18.75 19.5C18.75 19.9142 19.0858 20.25 19.5 20.25C19.9142 20.25 19.9142 20.25 19.5H18.75ZM20.25 15.767C20.25 15.3528 19.9142 15.017 19.5 15.017C19.0858 15.017 18.75 15.3528 18.75 15.767H20.25ZM18.9697 20.0303C19.2626 20.3232 19.7374 20.3232 20.0303 20.0303C20.3232 19.7374 20.3232 19.2626 20.0303 18.9697L18.9697 20.0303ZM15.0303 13.9697C14.7374 13.6768 14.2626 13.6768 13.9697 13.9697C13.6768 14.2626 13.6768 14.7374 13.9697 15.0303L15.0303 13.9697ZM6.25 15.767C6.25 15.3528 5.91421 15.017 5.5 15.017C5.08579 15.017 4.75 15.3528 4.75 15.767H6.25ZM4.75 19.5C4.75 19.9142 5.08579 20.25 5.5 20.25C5.91421 20.25 6.25 19.9142 6.25 19.5H4.75ZM5.5 18.75C5.08579 18.75 4.75 19.0858 4.75 19.5C4.75 19.9142 5.08579 20.25 5.5 20.25V18.75ZM9.233 20.25C9.64721 20.25 9.983 19.9142 9.983 19.5C9.983 19.0858 9.64721 18.75 9.233 18.75V20.25ZM4.96967 18.9697C4.67678 19.2626 4.67678 19.7374 4.96967 20.0303C5.26256 20.3232 5.73744 20.3232 6.03033 20.0303L4.96967 18.9697ZM11.0303 15.0303C11.3232 14.7374 11.3232 14.2626 11.0303 13.9697C10.7374 13.6768 10.2626 13.6768 9.96967 13.9697L11.0303 15.0303ZM15.767 4.75C15.3528 4.75 15.017 5.08579 15.017 5.5C15.017 5.91421 15.3528 6.25 15.767 6.25V4.75ZM19.5 6.25C19.9142 6.25 20.25 5.91421 20.25 5.5C20.25 5.08579 19.9142 4.75 19.5 4.75V6.25ZM20.25 5.5C20.25 5.08579 19.9142 4.75 19.5 4.75C19.0858 4.75 18.75 5.08579 18.75 5.5H20.25ZM18.75 9.233C18.75 9.64721 19.0858 9.983 19.5 9.983C19.9142 9.983 20.25 9.64721 20.25 9.233H18.75ZM20.0303 6.03033C20.3232 5.73744 20.3232 5.26256 20.0303 4.96967C19.7374 4.67678 19.2626 4.67678 18.9697 4.96967L20.0303 6.03033ZM13.9697 9.96967C13.6768 10.2626 13.6768 10.7374 13.9697 11.0303C14.2626 11.3232 14.7374 11.3232 15.0303 11.0303L13.9697 9.96967ZM6.25 9.233V5.5H4.75V9.233H6.25ZM5.5 6.25H9.233V4.75H5.5V6.25ZM4.96967 6.03033L9.96967 11.0303L11.0303 9.96967L6.03033 4.96967L4.96967 6.03033ZM15.767 20.25H19.5V18.75H15.767V20.25ZM20.25 19.5V15.767H18.75V19.5H20.25ZM20.0303 18.9697L15.0303 13.9697L13.9697 15.0303L18.9697 20.0303L20.0303 18.9697ZM4.75 15.767V19.5H6.25V15.767H4.75ZM5.5 20.25H9.233V18.75H5.5V20.25ZM6.03033 20.0303L11.0303 15.0303L9.96967 13.9697L4.96967 18.9697L6.03033 20.0303ZM15.767 6.25H19.5V4.75H15.767V6.25ZM18.75 5.5V9.233H20.25V5.5H18.75ZM18.9697 4.96967L13.9697 9.96967L15.0303 11.0303L20.0303 6.03033L18.9697 4.96967Z" fill="currentColor"/>
                            </svg>
                        </a>
                    </div>

                <!-- Tab Content -->
                <div class="job-tab-content">
                    <!-- Posted Jobs Tab -->
                    <div class="job-tab-pane active" id="posted-jobs-tab" role="tabpanel">
                        {% if currentJobs|length > 0 %}
                        <div class="job-list-container">
                        {% for job in currentJobs|slice(0,6) %}
                            {% set logo = job.companyLogo|default(job.employerLogo|default(job.employer.logo|default(asset('assets/icons/job.png')))) %}
                            {% set salary = job.salary|default(job.salaryText|default(null)) %}
                            {% set statusColors = {
                                'draft': 'secondary',
                                'published': 'primary',
                                'paused': 'warning',
                                'closed': 'dark'
                            } %}

                                <div class="job-card" style="position: relative;">
                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                    <div class="job-logo-box">
                                    <img src="{{ logo }}" class="job-logo-img" alt="" onerror="this.src='{{ asset('assets/icons/job.png') }}'" />
                                    </div>
                                <div class="flex-grow-1" style="min-width: 0; overflow: hidden;">
                                    <a class="job-title d-block fw-semibold text-decoration-none"
                                    href="{{ path('app_recruiter_job_show', {'id': job.id}) }}"
                                    style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            {{ job.title }}
                                        </a>
                                    <div class="job-meta small" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            {{ job.state }}, {{ job.city }} | {{ job.schedule }}{% if salary %} | {{ salary }}{% endif %}
                                        </div>
                                    </div>

                                <div class="d-flex flex-column align-items-start gap-2 flex-shrink-0">
                                    <div class="apply-within">
                                        <div class="apply-text">{{ job.workType }}</div>
                                        <div class="apply-value">
                                            {{ job.need }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span class="badge badge-pill badge-{{ statusColors[job.status] ?? 'secondary' }}" style="position: absolute; top: 8px; right: 14px; font-size: 11px; padding: 4px 8px;">
                                {{ job.status|capitalize }}
                            </span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="job-list-container">
                            <p class="mb-0">Posted jobs not found.</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- My Candidates Tab (formerly Recruiter Jobs) -->
                    <div class="job-tab-pane" id="recruiter-jobs-tab" role="tabpanel" style="display: none;">
                        {% if myApplications is defined and myApplications|length > 0 %}
                        <div class="job-list-container">
                            {% for app in myApplications|slice(0,6) %}
                            {% set candidate = app.provider %}
                            {% set avatar = candidate.avatar|default(asset('assets/img/user-image.png')) %}
                            {% set name = candidate.name|default('Candidate') %}
                            {% set jobTitle = app.job.title|default('Unknown Role') %}
                            
                             <div class="job-card" style="position: relative;">
                                <div class="d-flex align-items-center gap-2 flex-grow-1">
                                    <div class="job-logo-box">
                                        <img src="{{ avatar }}" class="job-logo-img" alt="" onerror="this.src='{{ asset('assets/img/user-image.png') }}'" />
                                    </div>
                                    <div class="flex-grow-1" style="min-width: 0; overflow: hidden;">
                                        <a class="job-title d-block fw-semibold text-decoration-none"
                                           href="#" 
                                           style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            {{ name }}
                                        </a>
                                        <div class="job-meta small" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            {{ jobTitle }}
                                        </div>
                                    </div>
                                     <div class="d-flex flex-column align-items-start gap-2 flex-shrink-0">
                                        <span class="badge badge-pill badge-info" style="font-size: 11px; padding: 4px 8px;">
                                            {{ app.status|capitalize }}
                                        </span>
                                    </div>
                                </div>
                             </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="job-list-container">
                            <p class="mb-0">No candidates found.</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Messages - Right Column -->
        <div class="col-12 col-lg-6 d-flex">
            <div class="job-section shadow-lg p-3 rounded-3 h-100 d-flex flex-column w-100">

                    <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-10-px">
                        <a href="{{ path('app_recruiter_messages') }}" style="text-decoration:none;"><h6 class="app-card-title mb-0">Messages</h6></a>
                        <a id="view-messages-link" href="{{ path('app_recruiter_messages') }}" class="link-plain">
