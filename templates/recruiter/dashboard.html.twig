<script>
(function() {
    function initProfileAnalytics() {
        const select = document.getElementById('profileAnalyticsSelect');
        
        if (!select) {
            return;
        }

        function showChart(chartType) {
            if (!chartType) {
                return;
            }
            
            // Get all charts dynamically each time to ensure we have the latest
            const charts = document.querySelectorAll('.analytics-chart .chart-content');
            
            // Hide all charts first - use both class and inline style to ensure it works
            charts.forEach(function(chart) {
                chart.classList.add('d-none');
                chart.style.display = 'none';
            });
            
            // Show the selected chart
            const chartId = 'chart-' + chartType;
            const activeChart = document.getElementById(chartId);
            if (activeChart) {
                activeChart.classList.remove('d-none');
                activeChart.style.display = '';
            }
        }

        // Set up change event listener
        select.addEventListener('change', function(event) {
            showChart(event.target.value);
        });

        // Initialize with the selected value
        const initialValue = select.value || 'ratio';
        showChart(initialValue);
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProfileAnalytics);
    } else {
        // DOM is already ready
        initProfileAnalytics();
    }
})();
</script>

<script>
// Define applySpacingStyles globally so base template can detect it and skip its own animation
// This prevents the base template from interfering with dashboard styles
window.applySpacingStyles = function() {
    const isLargeScreen = window.innerWidth >= 1200;
    const appWrapper = document.querySelector('.app-wrapper');
    const appContent = document.querySelector('.app-content');
    const container = document.querySelector('.container-xl');
    
    if (appWrapper) {
        if (isLargeScreen) {
            // Remove transform and width constraints to allow CSS animation to work
            // DO NOT set margin-left inline - let CSS transition handle it
            appWrapper.style.setProperty('transform', 'none', 'important');
            appWrapper.style.setProperty('width', 'auto', 'important');
            // Ensure transition is applied
            appWrapper.style.setProperty('transition', 'margin-left 0.4s ease-in-out', 'important');
        } else {
            // On small screens, reset everything
            appWrapper.style.setProperty('margin-left', '0', 'important');
            appWrapper.style.setProperty('transform', 'none', 'important');
            appWrapper.style.setProperty('width', 'auto', 'important');
        }
    }
    
    if (appContent) {
        // Don't override padding - let CSS handle it from base template
        // The base template sets padding-left: 2rem at 1200px+
    }
    
    if (container) {
        container.style.setProperty('padding-left', '0', 'important');
        container.style.setProperty('padding-right', isLargeScreen ? '30px' : '20px', 'important');
    }
};

// Apply once after page loads - but let base template handle sidebar animation
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        // Wait for base template to initialize first
        setTimeout(window.applySpacingStyles, 500);
    });
} else {
    setTimeout(window.applySpacingStyles, 500);
}

// Only re-apply on resize (debounced) - but don't interfere with animation
let resizeTimeout;
window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
        window.applySpacingStyles();
    }, 150);
});

// Watch for sidebar hover state changes - but don't interfere with CSS animation
// The CSS will handle the margin-left transition automatically based on body classes
const sidebarObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            // Only ensure transform and width are reset, let CSS handle margin-left
            const appWrapper = document.querySelector('.app-wrapper');
            if (appWrapper && window.innerWidth >= 1200) {
                appWrapper.style.setProperty('transform', 'none', 'important');
                appWrapper.style.setProperty('width', 'auto', 'important');
                appWrapper.style.setProperty('transition', 'margin-left 0.4s ease-in-out', 'important');
            }
        }
    });
});

if (document.body) {
    sidebarObserver.observe(document.body, {
        attributes: true,
        attributeFilter: ['class']
    });
}

// Job Tabs Functionality
document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.job-tab-btn');
    const tabPanes = document.querySelectorAll('.job-tab-pane');
    
    tabButtons.forEach(function(button) {
        button.addEventListener('click', function() {
            const targetTab = this.getAttribute('data-tab');
            
            // Remove active class from all buttons and panes
            tabButtons.forEach(function(btn) {
                btn.classList.remove('active');
                btn.setAttribute('aria-selected', 'false');
                const h6 = btn.querySelector('h6');
                if (h6) {
                    h6.style.color = '#6b7280';
                    h6.style.fontWeight = '500';
                }
            });
            
            tabPanes.forEach(function(pane) {
                pane.classList.remove('active');
                pane.style.display = 'none';
            });
            
            // Add active class to clicked button
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');
            const h6 = this.querySelector('h6');
            if (h6) {
                h6.style.color = '#85BB65';
                h6.style.fontWeight = '600';
            }
            
            // Show corresponding pane
            const targetPane = document.getElementById(targetTab + '-tab');
            if (targetPane) {
                targetPane.classList.add('active');
                targetPane.style.display = 'block';
            }
        });
    });
    
    // Initialize: ensure first tab is active
    const firstTab = document.querySelector('.job-tab-btn[data-tab="posted-jobs"]');
    if (firstTab) {
        const h6 = firstTab.querySelector('h6');
        if (h6) {
            h6.style.color = '#85BB65';
            h6.style.fontWeight = '600';
        }
    }
});
</script>

