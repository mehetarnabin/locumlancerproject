                <!-- Scrollable list -->
                <div class="todo-list flex-grow-1" id="todoListContainer">
                    <ul class="list-unstyled m-0 p-0" id="todoList">
                        {% if employerTodos is defined and employerTodos|length > 0 %}
                            {% for todo in employerTodos %}
                                <li class="todo-item {% if todo.id %}todo-id-{{ todo.id }}{% endif %}">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="todo-content-left flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="todo-title-section flex-grow-1">
                                                    <div class="todo-title fw-semibold {{ todo.isCompleted ? 'text-decoration-line-through text-muted' : '' }}" {% if todo.id %}id="todo-title-{{ todo.id }}"{% endif %} style="font-size: 13px; line-height: 1.3; color: #121C0C; margin-bottom: 3px;">
                                                        {{ todo.title }}
                                                    </div>
                                                    <div class="todo-meta-info mt-1">
                                                        <div class="small">{{ todo.description }}</div>
                                                    </div>
                                                </div>
                                                <div class="todo-badge-top">
                                                    <span class="todo-status-badge {{ todo.isCompleted ? 'completed' : 'pending' }}">{{ todo.isCompleted ? 'Completed' : 'Pending' }}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="todo-date-right">
                                            <div class="small fw-semibold text-end" style="font-size:12px;">{{ todo.createdAt|date('M d, Y') }}</div>
                                            <div class="small text-end" style="font-size:12px;">{{ todo.createdAt|date('h:i A') }}</div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li class="todo-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="todo-content-left flex-grow-1">
                                        <div class="todo-title fw-semibold" style="font-size: 13px; line-height: 1.3; color: #121C0C; margin-bottom: 3px;">
                                            No tasks found
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const todoList = document.getElementById('todoList');
                        
                        // Event Delegation for Toggle - click on status badge to toggle
                        todoList?.addEventListener('click', function(e) {
                            // Toggle via status badge click
                            const statusBadge = e.target.closest('.todo-status-badge');
                            if(statusBadge) {
                                e.preventDefault();
                                e.stopPropagation();
                                const todoItem = statusBadge.closest('.todo-item');
                                if(todoItem) {
                                    const idMatch = todoItem.className.match(/todo-id-([\w-]+)/);
                                    const id = idMatch ? idMatch[1] : null;
                                    if(id) {
                                        const isCompleted = statusBadge.classList.contains('completed');
                                        
                                        fetch(`/recruiter/todos/${id}/toggle`, { method: 'POST' })
                                        .then(res => res.json())
                                        .then(data => {
                                            if(data.success) {
                                                const newStatus = data.isCompleted;
                                                const titleEl = document.getElementById(`todo-title-${id}`);
                                                
                                                if(newStatus) {
                                                    if(titleEl) titleEl.classList.add('text-decoration-line-through', 'text-muted');
                                                    statusBadge.textContent = 'Completed';
                                                    statusBadge.className = 'todo-status-badge completed';
                                                } else {
                                                    if(titleEl) titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                                                    statusBadge.textContent = 'Pending';
                                                    statusBadge.className = 'todo-status-badge pending';
                                                }
                                            }
                                        })
                                        .catch(err => console.error('Error toggling todo:', err));
                                    }
                                }
                            }
                        });
                    });
                </script>
            </div>
