<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #85BB65;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f9f9f9;
            padding: 30px;
            border: 1px solid #ddd;
            border-top: none;
        }
        .footer {
            background-color: #f4f4f4;
            padding: 15px;
            text-align: center;
            font-size: 12px;
            color: #666;
            border-radius: 0 0 5px 5px;
        }
        .link-list {
            background-color: white;
            padding: 15px;
            margin: 20px 0;
            border-left: 4px solid #85BB65;
        }
        .link-list ul {
            margin: 10px 0;
            padding-left: 20px;
        }
        .link-list li {
            margin: 5px 0;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>LocumLancer Quick Links</h1>
    </div>
    
    <div class="content">
        <p>Hello,</p>
        
        <p><strong>{{ userName }}</strong> has shared their LocumLancer profile information with you.</p>
        
        {% if selectedLinks is not empty %}
        <div class="link-list">
            <p><strong>Included Sections:</strong></p>
            <ul>
                {% for link in selectedLinks %}
                <li>{{ link }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
        <p>Please find the attached PDF document containing {{ linksList }}.</p>
        
        <p>If you have any questions or need additional information, please don't hesitate to reach out.</p>
        
        <p>Best regards,<br>
        The LocumLancer Team</p>
    </div>
    
    <div class="footer">
        <p>&copy; {{ "now"|date("Y") }} LocumLancer. All rights reserved.</p>
        <p>This is an automated email. Please do not reply to this message.</p>
    </div>
</body>
</html>
